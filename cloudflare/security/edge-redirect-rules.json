[
  {
    "description": "Redirect thematic subdomain blog.arturonavax.dev to apex canonical /blog",
    "expression": "http.host eq \"blog.arturonavax.dev\"",
    "action": "redirect",
    "action_parameters": {
      "from_value": {
        "status_code": 308,
        "target_url": {
          "expression": "concat(\"https://arturonavax.dev/blog\", http.request.uri.path, (len(http.request.uri.query) > 0 ? concat(\"?\", http.request.uri.query) : \"\"))"
        },
        "preserve_query_string": true
      }
    }
  },
