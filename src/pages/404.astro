---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 — Page Not Found | Arturo Nava"
  description="The requested route does not exist on this edge node."
  locale="en"
  hideSubtleCoffee={true}
>
  <div class="geometric-box mx-auto my-16 max-w-xl p-8 sm:p-12 text-center rounded">
    <div class="font-mono text-xs font-semibold text-[var(--color-accent-gold)]">
      ERR_404_ROUTE_NOT_FOUND
    </div>
    <h1 class="mt-3 text-5xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-6xl">
      404
    </h1>
    <p class="mt-4 text-sm text-[var(--color-text-secondary)] leading-relaxed">
      The requested route or document could not be resolved across this edge
      node.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4 font-mono text-xs">
      <a
        href="/"
        class="btn-gold px-4 py-2.5 inline-flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent-gold)]"
      >
        <span>&larr;</span>
        <span>Return Home (EN)</span>
      </a>
      <a
        href="/es"
        class="btn-secondary px-4 py-2.5 inline-flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
      >
        <span>Inicio (ES)</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</BaseLayout>
