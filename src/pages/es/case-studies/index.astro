---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SimulationCard from "@/components/ui/SimulationCard.astro";
import CaseStudiesFilterBar from "@/components/ui/CaseStudiesFilterBar.astro";
import BackToHomeButton from "@/components/ui/BackToHomeButton.astro";
import { simulationsData } from "@/data/simulations";
import { useTranslations } from "@/i18n/utils";

const locale = "es";
const t = useTranslations(locale);

// Calculate companies and counts
const companyCounts: Record<string, number> = {};
simulationsData.forEach((sim) => {
  const comp = sim.company;
  companyCounts[comp] = (companyCounts[comp] || 0) + 1;
});

const companies = Object.entries(companyCounts).map(([name, count]) => ({
  name,
  count,
}));
---

<BaseLayout
  title="Casos de Estudio de Arquitectura & Telemetría — Arturo Nava"
  description="Simulaciones interactivas de arquitectura, telemetría de cargas en tiempo real y desgloses de métricas en producción para sistemas distribuidos y alta concurrencia."
  locale={locale}
>
  <div class="mx-auto max-w-5xl px-2 min-[360px]:px-4 pt-1 sm:pt-3.5 lg:pt-5 pb-8 sm:pb-12 sm:px-6 space-y-5 sm:space-y-8">
    <div>
      <BackToHomeButton locale={locale} />
      <header class="border-b border-[var(--color-surface-border)] pb-8">
        <div class="flex items-center gap-2 mb-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-accent-status)]/40 bg-[var(--color-accent-status)]/10 px-2.5 py-0.5 text-xs font-mono font-semibold text-[var(--color-accent-status)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent-status)] animate-pulse"></span>
            <span>Benchmarks Interactivos</span>
          </span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl">
          {t("section.caseStudies")}
        </h1>
        <p class="mt-3 max-w-2xl text-base text-[var(--color-text-secondary)]">
          Simulaciones de cargas distribuidas en tiempo real, micro-benchmarks
          sin alocaciones y desgloses de telemetría antes vs después modelados
          sobre iniciativas reales en producción.
        </p>
      </header>
    </div>

    <!-- Case Studies & Telemetry Filter Bar -->
    {simulationsData.length > 0 && (
      <CaseStudiesFilterBar
        locale={locale}
        companies={companies}
        totalSimulations={simulationsData.length}
      />
    )}

    {simulationsData.length > 0 ? (
      <div class="space-y-6">
        {simulationsData.map((simulation) => (
          <SimulationCard
            simulation={simulation}
            locale={locale}
            showCompany={true}
          />
        ))}
      </div>
    ) : (
      <div class="rounded-lg border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] p-8 text-center font-mono text-xs sm:text-sm text-[var(--color-text-secondary)]">
        No hay casos de estudio publicados aún. Vuelve pronto.
      </div>
    )}
  </div>
</BaseLayout>
