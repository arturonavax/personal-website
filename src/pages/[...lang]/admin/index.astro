---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandLogo from "@/components/common/BrandLogo.astro";
import type { SupportedLocale } from "@/i18n/config";

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { locale: "en" as const } },
    { params: { lang: "es" }, props: { locale: "es" as const } },
  ];
}

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const isEs = locale === "es";

const title = isEs
  ? "Admin Management Surface // Telemetría Edge & Zero Trust"
  : "Admin Management Surface // Edge Telemetry & Zero Trust";

const description = isEs
  ? "Panel administrativo y consola de telemetría de alta densidad protegido por Cloudflare Access Zero Trust."
  : "High-density administrative console and edge telemetry dashboard protected by Cloudflare Access Zero Trust.";
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  noindex={true}
  hideFooter={true}
>
  <div class="mx-auto max-w-7xl px-3 sm:px-6 lg:px-8 py-6 space-y-6">
    <!-- Admin Auth Notice (shown when 401 Unauthorized occurs) -->
    <div id="admin-auth-notice" class="hidden p-4 rounded-sm border border-red-500/40 bg-red-950/20 text-red-300 font-mono text-xs space-y-2">
      <div class="flex items-center gap-2 font-bold text-red-400">
        <span class="inline-block w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
        {isEs ? "401 ACCESO RESTRINGIDO // AUTENTICACIÓN ZERO TRUST REQUERIDA" : "401 UNAUTHORIZED // ZERO TRUST AUTHENTICATION REQUIRED"}
      </div>
      <p class="text-xs text-[var(--color-text-secondary)]">
        {isEs 
          ? "Esta superficie administrativa está protegida por Cloudflare Access Zero Trust. Inicie sesión para ver la telemetría perimetral."
          : "This administrative surface is protected by Cloudflare Access Zero Trust. Please sign in to access edge telemetry."}
      </p>
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a href="https://orange-art-1302.cloudflareaccess.com/cdn-cgi/access/login/admin.arturonavax.dev" class="px-3 py-1.5 rounded-xs bg-[var(--color-accent-gold)] text-[var(--color-bg-primary)] font-bold text-xs hover:bg-[var(--color-accent-gold-hover)] transition-colors">
          {isEs ? "Autenticar con Cloudflare Access" : "Authenticate with Cloudflare Access"}
        </a>
      </div>
    </div>

    <!-- Master Filter Toolbar (Banner with selectors at the very top of dashboard) -->
    <div class="geometric-box rounded-sm p-4 shadow-sm space-y-3">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 font-mono text-xs">
        <!-- Segment Filter Tabs -->
        <div
          class="flex flex-wrap items-center gap-1.5"
          role="tablist"
          aria-label="Filtro de segmento"
        >
          <button
            type="button"
            id="tab-all"
            class="filter-tab active rounded-xs px-3 py-1.5 border border-[var(--color-accent-gold)] bg-[var(--color-bg-primary)] text-[var(--color-accent-gold)] font-semibold cursor-pointer transition-colors"
            onclick="setSegmentFilter('all')"
          >
            {isEs ? "Todos los Eventos" : "All Events"}
          </button>
          <button
            type="button"
            id="tab-human"
            class="filter-tab rounded-xs px-3 py-1.5 border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-secondary)] cursor-pointer hover:border-[var(--color-accent-gold)] transition-colors"
            onclick="setSegmentFilter('human')"
          >
            {isEs ? "Solo Humanos (P0)" : "Humans Only (P0)"}
          </button>
          <button
            type="button"
            id="tab-bot"
            class="filter-tab rounded-xs px-3 py-1.5 border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-secondary)] cursor-pointer hover:border-[var(--color-accent-gold)] transition-colors"
            onclick="setSegmentFilter('bot')"
          >
            {isEs ? "Solo Robots" : "Bots & Indexers"}
          </button>
          <button
            type="button"
            id="tab-prefetch"
            class="filter-tab rounded-xs px-3 py-1.5 border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-secondary)] cursor-pointer hover:border-[var(--color-accent-gold)] transition-colors"
            onclick="setSegmentFilter('prefetch')"
          >
            {isEs ? "Prefetches (P1)" : "Prefetches (P1)"}
          </button>
        </div>

        <!-- Dropdown Controls: Range, Country, Path, Refresh Rate -->
        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Time Range Select -->
          <div class="flex items-center gap-1.5">
            <label
              for="select-range"
              class="text-[var(--color-text-muted)] text-[11px] uppercase tracking-wider"
            >
              {isEs ? "Plazo:" : "Range:"}
            </label>
            <select
              id="select-range"
              class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-primary)] focus:border-[var(--color-accent-gold)] focus:outline-none cursor-pointer"
              onchange="onRangeChange(this.value)"
            >
              <option value="24h">
                {isEs ? "Hace 1 día (24h)" : "Past 1 Day (24h)"}
              </option>
              <option value="7d" selected>
                {isEs ? "1 semana (7d)" : "Past 1 Week (7d)"}
              </option>
              <option value="30d">
                {isEs ? "1 mes (30d)" : "Past 1 Month (30d)"}
              </option>
              <option value="all">
                {isEs ? "Todo el tiempo" : "All Time"}
              </option>
              <option value="custom">
                {isEs ? "Personalizado..." : "Custom..."}
              </option>
            </select>
          </div>

          <!-- Country Filter Select -->
          <div class="flex items-center gap-1.5">
            <label
              for="select-country"
              class="text-[var(--color-text-muted)] text-[11px] uppercase tracking-wider"
            >
              {isEs ? "País:" : "Country:"}
            </label>
            <select
              id="select-country"
              class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-primary)] focus:border-[var(--color-accent-gold)] focus:outline-none cursor-pointer"
              onchange="onCountryChange(this.value)"
            >
              <option value="all">
                {isEs ? "Todos los Países" : "All Countries"}
              </option>
            </select>
          </div>

          <!-- Section / Path Select -->
          <div class="flex items-center gap-1.5">
            <label
              for="select-path"
              class="text-[var(--color-text-muted)] text-[11px] uppercase tracking-wider"
            >
              {isEs ? "Ruta:" : "Path:"}
            </label>
            <select
              id="select-path"
              class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-primary)] focus:border-[var(--color-accent-gold)] focus:outline-none cursor-pointer"
              onchange="onPathFilterChange(this.value)"
            >
              <option value="all">
                {isEs ? "Todas las Rutas" : "All Routes"}
              </option>
              <option value="/">{isEs ? "Portada (/)" : "Homepage (/)"}</option>
              <option value="/blog/">/blog/*</option>
              <option value="/projects/">/projects/*</option>
              <option value="/experience/">/experience/*</option>
              <option value="/services/">/services/*</option>
              <option value="/resume/">/resume/*</option>
              <option value="/case-studies/">/case-studies/*</option>
            </select>
          </div>

          <!-- Polling Select -->
          <div class="flex items-center gap-1.5">
            <label
              for="select-poll"
              class="text-[var(--color-text-muted)] text-[11px] uppercase tracking-wider"
            >
              {isEs ? "Refresco:" : "Polling:"}
            </label>
            <select
              id="select-poll"
              class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-primary)] focus:border-[var(--color-accent-gold)] focus:outline-none cursor-pointer"
              onchange="onPollIntervalChange(this.value)"
            >
              <option value="0" selected id="opt-poll-0">
                {isEs ? "Pausado (manual)" : "Paused (manual)"}
              </option>
              <option value="15000">15s</option>
              <option value="30000">30s</option>
              <option value="60000">60s</option>
            </select>
          </div>

          <!-- Explicit Apply Filters Button -->
          <button
            type="button"
            id="btn-apply-filters"
            class="btn-apply-filters rounded-xs px-3.5 py-1 font-semibold text-xs transition-all cursor-pointer flex items-center gap-1.5"
            onclick="applyFilters()"
          >
            {isEs ? "✓ Aplicar Filtros" : "✓ Apply Filters"}
          </button>

          <!-- Manual Refresh Button -->
          <button
            type="button"
            id="btn-refresh"
            class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-3 py-1 text-[var(--color-text-primary)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] transition-colors cursor-pointer flex items-center gap-1 font-semibold"
            onclick="fetchDashboardData(true)"
            title="Refrescar datos ahora"
          >
            <span id="refresh-icon">↻</span>
            <span>{isEs ? "Recargar" : "Refresh"}</span>
          </button>
        </div>
      </div>

      <!-- Custom Date Range Sub-Bar (Visible when select-range === 'custom') -->
      <div
        id="custom-range-bar"
        class="hidden pt-3 border-t border-[var(--color-surface-border)] flex flex-wrap items-center gap-3 font-mono text-xs"
      >
        <span class="text-[var(--color-accent-gold)] font-semibold">
          {isEs ? "Plazo Personalizado:" : "Custom Date Range:"}
        </span>
        <div class="flex items-center gap-1.5">
          <label
            for="custom-from"
            class="text-[var(--color-text-muted)] text-[11px]"
          >
            {isEs ? "Desde:" : "From:"}
          </label>
          <input
            type="date"
            id="custom-from"
            class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2 py-0.5 text-[var(--color-text-primary)] text-xs focus:border-[var(--color-accent-gold)] focus:outline-none"
          />
        </div>
        <div class="flex items-center gap-1.5">
          <label
            for="custom-to"
            class="text-[var(--color-text-muted)] text-[11px]"
          >
            {isEs ? "Hasta:" : "To:"}
          </label>
          <input
            type="date"
            id="custom-to"
            class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2 py-0.5 text-[var(--color-text-primary)] text-xs focus:border-[var(--color-accent-gold)] focus:outline-none"
          />
        </div>
        <button
          type="button"
          class="rounded-xs border border-[var(--color-accent-gold)] bg-[var(--color-accent-gold-subtle)] text-[var(--color-accent-gold)] px-3 py-0.5 font-semibold hover:bg-[var(--color-accent-gold)] hover:text-[var(--color-btn-gold-text)] transition-colors cursor-pointer"
          onclick="applyCustomDateRange()"
        >
          {isEs ? "Aplicar Plazo" : "Apply Range"}
        </button>
      </div>

      <!-- Secondary Controls: Timezone, Bots & Search -->
      <div class="pt-3 border-t border-[var(--color-surface-border)] flex flex-col md:flex-row md:items-center justify-between gap-3 font-mono text-xs">
        <div class="flex flex-wrap items-center gap-4">
          <label class="flex items-center gap-1.5 cursor-pointer select-none text-[11px] text-[var(--color-text-secondary)]">
            <input
              type="checkbox"
              id="chk-exclude-bots"
              onchange="toggleExcludeBots(this.checked)"
              class="accent-[var(--color-accent-gold)] cursor-pointer"
            />
            <span>
              {isEs ? "Excluir Bots de Gráficos" : "Exclude Bots from Charts"}
            </span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer select-none text-[11px] text-[var(--color-text-secondary)]">
            <input
              type="checkbox"
              id="chk-include-prefetch"
              checked
              onchange="toggleIncludePrefetch(this.checked)"
              class="accent-[var(--color-accent-gold)] cursor-pointer"
            />
            <span>{isEs ? "Incluir Prefetches" : "Include Prefetches"}</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer select-none text-[11px] text-[var(--color-text-secondary)]">
            <input
              type="checkbox"
              id="chk-local-tz"
              onchange="toggleTimezone(this.checked)"
              class="accent-[var(--color-accent-gold)] cursor-pointer"
            />
            <span>
              {isEs
                ? "Zona Horaria Local (Navegador)"
                : "Local Browser Timezone"}
            </span>
          </label>
        </div>

        <div class="flex items-center gap-3">
          <div class="relative w-full md:w-80">
            <input
              type="text"
              id="input-search"
              placeholder={
                isEs
                  ? "Filtrar por ruta, país, UTM, referrer o hash..."
                  : "Filter by path, country, UTM, referrer or hash..."
              }
              class="w-full rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-3 py-1.5 text-xs text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:border-[var(--color-accent-gold)] focus:outline-none"
              oninput="onSearchInput(this.value)"
            />
            <span
              id="search-counter"
              class="absolute right-2.5 top-1.5 text-[10px] text-[var(--color-text-muted)] pointer-events-none"
            >
              --
            </span>
          </div>

          <div class="flex items-center gap-1.5 shrink-0">
            <span class="text-[11px] text-[var(--color-text-muted)]">
              {isEs ? "Exportar:" : "Export:"}
            </span>
            <button
              type="button"
              class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-secondary)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] transition-colors cursor-pointer"
              onclick="exportData('json')"
            >
              JSON
            </button>
            <button
              type="button"
              class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-secondary)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] transition-colors cursor-pointer"
              onclick="exportData('csv')"
            >
              CSV
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Header & Surface Identity Strip with AN Monogram Token -->
    <div class="geometric-box rounded-sm p-4 sm:p-5 shadow-sm">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2.5">
            <BrandLogo class="h-6 w-6 shrink-0" />
            <h1 class="text-xl sm:text-2xl font-bold font-mono tracking-tight text-[var(--color-text-primary)]">
              {isEs
                ? "Admin Management Surface // Telemetría"
                : "Admin Management Surface // Telemetry"}
            </h1>
          </div>
          <p class="mt-1 text-xs font-mono text-[var(--color-text-dim)]">
            Host:{" "}
            <code class="text-[var(--color-accent-gold)]">
              admin.arturonavax.dev
            </code>{" "}
            &bull;
            {isEs
              ? "Aislamiento Zero Trust"
              : "Zero Trust Dual-Surface Isolation"}{" "}
            &bull;
            {isEs ? "Persistencia D1 Distribuida" : "D1 Distributed Database"}
          </p>
        </div>

        <!-- Badges & Live Controls -->
        <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
          <span class="inline-flex items-center gap-1.5 rounded-xs border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-emerald-400 font-medium">
            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="badge-live-status">{isEs ? "EN VIVO" : "LIVE"}</span>
          </span>
          <span
            id="badge-sync-time"
            class="inline-flex items-center gap-1 rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-muted)]"
          >
            {isEs ? "Sincronizado: manual" : "Synced: manual"}
          </span>
          <span
            id="badge-cache-mode"
            class="inline-flex items-center gap-1 rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-cyan-400"
          >
            ● Caché Edge (120s)
          </span>
          <span class="inline-flex items-center gap-1 rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-secondary)]">
            Zero Trust
          </span>
          <span
            id="badge-cf-user"
            class="inline-flex items-center gap-1 rounded-xs border border-[var(--color-accent-gold)]/40 bg-[var(--color-accent-gold-subtle)] px-2.5 py-1 text-[var(--color-accent-gold)]"
          >
            Cloudflare Access
          </span>
          <span
            id="badge-deployment"
            class="inline-flex items-center gap-1 rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-dim)]"
          >
            Rel: v1.4.3 (ultra-efficient)
          </span>
        </div>
      </div>
    </div>

    <!-- Hidden compatibility anchor for legacy test harness -->
    <div id="chart-svg" class="hidden" aria-hidden="true"></div>

    <!-- Master KPIs Grid (6 Key Metrics with True Counts) -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
      <div class="geometric-box rounded-sm p-3.5 shadow-sm">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-muted)]">
          {isEs ? "Total Eventos (D1)" : "Total Events (D1)"}
        </span>
        <div
          class="mt-1 text-2xl font-bold font-mono text-[var(--color-text-primary)]"
          id="kpi-total"
        >
          --
        </div>
        <p
          class="mt-0.5 text-[10px] font-mono text-[var(--color-text-muted)]"
          id="kpi-total-sub"
        >
          {isEs ? "Tráfico en período" : "Period traffic"}
        </p>
      </div>

      <div class="geometric-box rounded-sm p-3.5 shadow-sm">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-muted)]">
          {isEs ? "Visitas Humanas (P0)" : "Human Visits (P0)"}
        </span>
        <div
          class="mt-1 text-2xl font-bold font-mono text-emerald-400"
          id="kpi-human"
        >
          --
        </div>
        <p
          class="mt-0.5 text-[10px] font-mono text-[var(--color-text-muted)]"
          id="kpi-human-sub"
        >
          {isEs ? "Tráfico real validado" : "Verified human"}
        </p>
      </div>

      <div class="geometric-box rounded-sm p-3.5 shadow-sm">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-muted)]">
          {isEs ? "Robots & Crawlers" : "Bots & Crawlers"}
        </span>
        <div
          class="mt-1 text-2xl font-bold font-mono text-[var(--color-accent-gold)]"
          id="kpi-bot"
        >
          --
        </div>
        <p
          class="mt-0.5 text-[10px] font-mono text-[var(--color-text-muted)]"
          id="kpi-bot-sub"
        >
          {isEs ? "Rastreadores & SEO" : "Indexers & AI bots"}
        </p>
      </div>

      <div class="geometric-box rounded-sm p-3.5 shadow-sm">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-muted)]">
          {isEs ? "Visitantes Únicos" : "Unique Visitors"}
        </span>
        <div
          class="mt-1 text-2xl font-bold font-mono text-[var(--color-text-primary)]"
          id="kpi-unique"
        >
          --
        </div>
        <p
          class="mt-0.5 text-[10px] font-mono text-[var(--color-text-muted)]"
          id="kpi-unique-sub"
        >
          {isEs ? "Hashes GDPR anonimizados" : "GDPR anonymized"}
        </p>
      </div>

      <div class="geometric-box rounded-sm p-3.5 shadow-sm">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-muted)]">
          {isEs ? "Prefetches (P1)" : "Prefetches (P1)"}
        </span>
        <div
          class="mt-1 text-2xl font-bold font-mono text-cyan-400"
          id="kpi-prefetch"
        >
          --
        </div>
        <p
          class="mt-0.5 text-[10px] font-mono text-[var(--color-text-muted)]"
          id="kpi-prefetch-sub"
        >
          {isEs ? "Circuit Breaker: OK" : "Circuit Breaker: OK"}
        </p>
      </div>

      <div class="geometric-box rounded-sm p-3.5 shadow-sm">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-muted)]">
          {isEs ? "Contact Leads" : "Contact Leads"}
        </span>
        <div
          class="mt-1 text-2xl font-bold font-mono text-amber-300"
          id="kpi-leads"
        >
          --
        </div>
        <p
          class="mt-0.5 text-[10px] font-mono text-[var(--color-text-muted)]"
          id="kpi-leads-sub"
        >
          {isEs ? "Mensajes de contacto" : "Inbound messages"}
        </p>
      </div>
    </div>

    <!-- Comprehensive Cloudflare Free Tier Quotas Monitor -->
    <div class="geometric-box rounded-sm p-4 sm:p-5 shadow-sm space-y-4">
      <div class="border-b border-[var(--color-surface-border)] pb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h2 class="text-xs sm:text-sm font-bold font-mono uppercase tracking-wider text-[var(--color-accent-gold)]">
            {isEs
              ? "⚡ Monitoreo de Cuotas Cloudflare // Capa Gratuita"
              : "⚡ Cloudflare Free Tier Quotas Monitor"}
          </h2>
          <p class="text-[10px] font-mono text-[var(--color-text-muted)] mt-0.5">
            {isEs
              ? "Límites diarios y mensuales garantizados para Workers, D1, R2, Zero Trust y AI"
              : "Daily and monthly usage tracking for Workers, D1, R2, Zero Trust, and Workers AI"}
          </p>
        </div>
        <span id="quotas-global-badge" class="font-mono text-[11px] text-emerald-400 font-semibold">
          100% Free Tier Compliant
        </span>
      </div>

      <!-- Overrun Alert Banner -->
      <div id="quota-d1-overrun-banner" class="hidden p-3 rounded-sm border border-red-500/50 bg-red-950/30 text-red-300 font-mono text-xs flex items-center gap-2.5">
        <span class="inline-block w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
        <span>
          <strong>{isEs ? "ALERTA DE CUPO:" : "QUOTA ALERT:"}</strong>
          {isEs ? " Límite diario de escrituras D1 alcanzado/excedido (" : " D1 daily writes limit reached/exceeded ("}<span id="quota-d1-overrun-detail" class="font-bold underline"></span>{isEs ? "). Modo degradación R2 WAL activado para absorber telemetría sin coste adicional." : "). R2 WAL fallback activated to absorb telemetry without additional costs."}
        </span>
