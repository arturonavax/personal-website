---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { SupportedLocale } from "@/i18n/config";

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { locale: "en" as const } },
    { params: { lang: "es" }, props: { locale: "es" as const } },
  ];
}

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const isEs = locale === "es";

const title = isEs
  ? "Admin Management Surface // Telemetría Edge & Zero Trust"
  : "Admin Management Surface // Edge Telemetry & Zero Trust";

const description = isEs
  ? "Panel administrativo y consola de telemetría de alta densidad protegido por Cloudflare Access Zero Trust."
  : "High-density administrative console and edge telemetry dashboard protected by Cloudflare Access Zero Trust.";
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  noindex={true}
>
  <div class="mx-auto max-w-7xl px-3 sm:px-6 lg:px-8 py-6 space-y-6">
    <!-- Header & Surface Identity Strip -->
    <div class="geometric-box rounded-sm p-4 sm:p-5 shadow-sm">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2.5">
            <span class="flex h-6 w-6 items-center justify-center rounded bg-[var(--color-accent-gold-subtle)] text-[var(--color-accent-gold)] font-mono text-xs font-bold">
              ⚡
            </span>
            <h1 class="text-xl sm:text-2xl font-bold font-mono tracking-tight text-[var(--color-text-primary)]">
              Admin Management Surface // Telemetría
            </h1>
          </div>
          <p class="mt-1 text-xs font-mono text-[var(--color-text-dim)]">
            Host:{" "}
            <code class="text-[var(--color-accent-gold)]">
              admin.arturonavax.dev
            </code>{" "}
            &bull;
            {isEs
              ? "Aislamiento Zero Trust"
              : "Zero Trust Dual-Surface Isolation"}{" "}
            &bull;
            {isEs ? "Persistencia D1 Distribuida" : "D1 Distributed Database"}
          </p>
        </div>

        <!-- Badges & Live Controls -->
        <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
          <span class="inline-flex items-center gap-1.5 rounded-xs border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-emerald-400 font-medium">
            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="badge-live-status">{isEs ? "EN VIVO" : "LIVE"}</span>
          </span>
          <span
            id="badge-sync-time"
            class="inline-flex items-center gap-1 rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-muted)]"
          >
            {isEs ? "Sincronizado: ahora" : "Synced: now"}
          </span>
          <span class="inline-flex items-center gap-1 rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-secondary)]">
            Zero Trust
          </span>
          <span
            id="badge-cf-user"
            class="inline-flex items-center gap-1 rounded-xs border border-[var(--color-accent-gold)]/40 bg-[var(--color-accent-gold-subtle)] px-2.5 py-1 text-[var(--color-accent-gold)]"
          >
            Cloudflare Access
          </span>
          <span
            id="badge-deployment"
            class="inline-flex items-center gap-1 rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-dim)]"
          >
            Rel: v1.4.2 (edge)
          </span>
        </div>
      </div>
    </div>

    <!-- Hidden compatibility anchor for legacy test harness -->
    <div id="chart-svg" class="hidden" aria-hidden="true"></div>

    <!-- Master KPIs Grid (6 Key Metrics with True Counts) -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
      <div class="geometric-box rounded-sm p-3.5 shadow-sm">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-muted)]">
          {isEs ? "Total Eventos (D1)" : "Total Events (D1)"}
        </span>
        <div
          class="mt-1 text-2xl font-bold font-mono text-[var(--color-text-primary)]"
          id="kpi-total"
        >
          --
        </div>
        <p
          class="mt-0.5 text-[10px] font-mono text-[var(--color-text-muted)]"
          id="kpi-total-sub"
        >
          {isEs ? "Tráfico en período" : "Period traffic"}
        </p>
      </div>

      <div class="geometric-box rounded-sm p-3.5 shadow-sm">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-muted)]">
          {isEs ? "Visitas Humanas (P0)" : "Human Visits (P0)"}
        </span>
        <div
          class="mt-1 text-2xl font-bold font-mono text-emerald-400"
          id="kpi-human"
        >
          --
        </div>
        <p
          class="mt-0.5 text-[10px] font-mono text-[var(--color-text-muted)]"
          id="kpi-human-sub"
        >
          {isEs ? "Tráfico real validado" : "Verified human"}
        </p>
      </div>

      <div class="geometric-box rounded-sm p-3.5 shadow-sm">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-muted)]">
          {isEs ? "Robots & Crawlers" : "Bots & Crawlers"}
        </span>
        <div
          class="mt-1 text-2xl font-bold font-mono text-[var(--color-accent-gold)]"
          id="kpi-bot"
        >
          --
        </div>
        <p
          class="mt-0.5 text-[10px] font-mono text-[var(--color-text-muted)]"
          id="kpi-bot-sub"
        >
          {isEs ? "Rastreadores & SEO" : "Indexers & AI bots"}
        </p>
      </div>

      <div class="geometric-box rounded-sm p-3.5 shadow-sm">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-muted)]">
          {isEs ? "Visitantes Únicos" : "Unique Visitors"}
        </span>
        <div
          class="mt-1 text-2xl font-bold font-mono text-[var(--color-text-primary)]"
          id="kpi-unique"
        >
          --
        </div>
        <p
          class="mt-0.5 text-[10px] font-mono text-[var(--color-text-muted)]"
          id="kpi-unique-sub"
        >
          {isEs ? "Hashes GDPR anonimizados" : "GDPR anonymized"}
        </p>
      </div>

      <div class="geometric-box rounded-sm p-3.5 shadow-sm">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-muted)]">
          {isEs ? "Prefetches (P1)" : "Prefetches (P1)"}
        </span>
        <div
          class="mt-1 text-2xl font-bold font-mono text-cyan-400"
          id="kpi-prefetch"
        >
          --
        </div>
        <p
          class="mt-0.5 text-[10px] font-mono text-[var(--color-text-muted)]"
          id="kpi-prefetch-sub"
        >
          {isEs ? "Circuit Breaker: OK" : "Circuit Breaker: OK"}
        </p>
      </div>

      <div class="geometric-box rounded-sm p-3.5 shadow-sm">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-muted)]">
          {isEs ? "Contact Leads" : "Contact Leads"}
        </span>
        <div
          class="mt-1 text-2xl font-bold font-mono text-amber-300"
          id="kpi-leads"
        >
          --
        </div>
        <p
          class="mt-0.5 text-[10px] font-mono text-[var(--color-text-muted)]"
          id="kpi-leads-sub"
        >
          {isEs ? "Mensajes de contacto" : "Inbound messages"}
        </p>
      </div>
    </div>

    <!-- Master Filter Toolbar (Segment Buttons, Time Ranges, Country, Path, Search & Polling) -->
    <div class="geometric-box rounded-sm p-4 shadow-sm space-y-3">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 font-mono text-xs">
        <!-- Segment Filter Tabs -->
        <div
          class="flex flex-wrap items-center gap-1.5"
          role="tablist"
          aria-label="Filtro de segmento"
        >
          <button
            type="button"
            id="tab-all"
            class="filter-tab active rounded-xs px-3 py-1.5 border border-[var(--color-accent-gold)] bg-[var(--color-bg-primary)] text-[var(--color-accent-gold)] font-semibold cursor-pointer transition-colors"
            onclick="setSegmentFilter('all')"
          >
            {isEs ? "Todos los Eventos" : "All Events"}
          </button>
          <button
            type="button"
            id="tab-human"
            class="filter-tab rounded-xs px-3 py-1.5 border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-secondary)] cursor-pointer hover:border-[var(--color-accent-gold)] transition-colors"
            onclick="setSegmentFilter('human')"
          >
            {isEs ? "Solo Humanos (P0)" : "Humans Only (P0)"}
          </button>
          <button
            type="button"
            id="tab-bot"
            class="filter-tab rounded-xs px-3 py-1.5 border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-secondary)] cursor-pointer hover:border-[var(--color-accent-gold)] transition-colors"
            onclick="setSegmentFilter('bot')"
          >
            {isEs ? "Solo Robots" : "Bots & Indexers"}
          </button>
          <button
            type="button"
            id="tab-prefetch"
            class="filter-tab rounded-xs px-3 py-1.5 border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-secondary)] cursor-pointer hover:border-[var(--color-accent-gold)] transition-colors"
            onclick="setSegmentFilter('prefetch')"
          >
            {isEs ? "Prefetches (P1)" : "Prefetches (P1)"}
          </button>
        </div>

        <!-- Dropdown Controls: Range, Country, Path, Refresh Rate -->
        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Time Range Select -->
          <div class="flex items-center gap-1.5">
            <label
              for="select-range"
              class="text-[var(--color-text-muted)] text-[11px] uppercase tracking-wider"
            >
              {isEs ? "Plazo:" : "Range:"}
            </label>
            <select
              id="select-range"
              class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-primary)] focus:border-[var(--color-accent-gold)] focus:outline-none cursor-pointer"
              onchange="onRangeChange(this.value)"
            >
              <option value="1d">
                {isEs ? "Hace 1 día (24h)" : "Past 1 Day (24h)"}
              </option>
              <option value="2d">
                {isEs ? "Hace 2 días (48h)" : "Past 2 Days (48h)"}
              </option>
              <option value="3d">
                {isEs ? "Hace 3 días (72h)" : "Past 3 Days (72h)"}
              </option>
              <option value="7d" selected>
                {isEs ? "1 semana (7d)" : "Past 1 Week (7d)"}
              </option>
              <option value="30d">
                {isEs ? "1 mes (30d)" : "Past 1 Month (30d)"}
              </option>
              <option value="all">
                {isEs ? "Todo el tiempo" : "All Time"}
              </option>
              <option value="custom">
                {isEs ? "Personalizado..." : "Custom..."}
              </option>
            </select>
          </div>

          <!-- Country Filter Select -->
          <div class="flex items-center gap-1.5">
            <label
              for="select-country"
              class="text-[var(--color-text-muted)] text-[11px] uppercase tracking-wider"
            >
              {isEs ? "País:" : "Country:"}
            </label>
            <select
              id="select-country"
              class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-primary)] focus:border-[var(--color-accent-gold)] focus:outline-none cursor-pointer"
              onchange="onCountryChange(this.value)"
            >
              <option value="all">
                {isEs ? "Todos los Países" : "All Countries"}
              </option>
            </select>
          </div>

          <!-- Section / Path Select -->
          <div class="flex items-center gap-1.5">
            <label
              for="select-path"
              class="text-[var(--color-text-muted)] text-[11px] uppercase tracking-wider"
            >
              {isEs ? "Ruta:" : "Path:"}
            </label>
            <select
              id="select-path"
              class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-primary)] focus:border-[var(--color-accent-gold)] focus:outline-none cursor-pointer"
              onchange="onPathFilterChange(this.value)"
            >
              <option value="all">
                {isEs ? "Todas las Rutas" : "All Routes"}
              </option>
              <option value="/">{isEs ? "Portada (/)" : "Homepage (/)"}</option>
              <option value="/blog/">/blog/*</option>
              <option value="/projects/">/projects/*</option>
              <option value="/experience/">/experience/*</option>
              <option value="/services/">/services/*</option>
              <option value="/resume/">/resume/*</option>
              <option value="/case-studies/">/case-studies/*</option>
            </select>
          </div>

          <!-- Polling Select -->
          <div class="flex items-center gap-1.5">
            <label
              for="select-poll"
              class="text-[var(--color-text-muted)] text-[11px] uppercase tracking-wider"
            >
              {isEs ? "Refresco:" : "Polling:"}
            </label>
            <select
              id="select-poll"
              class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-primary)] focus:border-[var(--color-accent-gold)] focus:outline-none cursor-pointer"
              onchange="onPollIntervalChange(this.value)"
            >
              <option value="5000" selected>
                5s {isEs ? "(En vivo)" : "(Live)"}
              </option>
              <option value="15000">15s</option>
              <option value="30000">30s</option>
              <option value="0">{isEs ? "Pausado" : "Paused"}</option>
            </select>
          </div>

          <!-- Manual Refresh Button -->
          <button
            type="button"
            id="btn-refresh"
            class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-3 py-1 text-[var(--color-text-primary)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] transition-colors cursor-pointer flex items-center gap-1 font-semibold"
            onclick="fetchDashboardData(true)"
            title="Refrescar datos ahora"
          >
            <span id="refresh-icon">↻</span>
            <span>{isEs ? "Recargar" : "Refresh"}</span>
          </button>
        </div>
      </div>

      <!-- Custom Date Range Sub-Bar (Visible when select-range === 'custom') -->
      <div
        id="custom-range-bar"
        class="hidden pt-3 border-t border-[var(--color-surface-border)] flex flex-wrap items-center gap-3 font-mono text-xs"
      >
        <span class="text-[var(--color-accent-gold)] font-semibold">
          {isEs ? "Plazo Personalizado:" : "Custom Date Range:"}
        </span>
        <div class="flex items-center gap-1.5">
          <label
            for="custom-from"
            class="text-[var(--color-text-muted)] text-[11px]"
          >
            {isEs ? "Desde:" : "From:"}
          </label>
          <input
            type="date"
            id="custom-from"
            class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2 py-0.5 text-[var(--color-text-primary)] text-xs focus:border-[var(--color-accent-gold)] focus:outline-none"
          />
        </div>
        <div class="flex items-center gap-1.5">
          <label
            for="custom-to"
            class="text-[var(--color-text-muted)] text-[11px]"
          >
            {isEs ? "Hasta:" : "To:"}
          </label>
          <input
            type="date"
            id="custom-to"
            class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2 py-0.5 text-[var(--color-text-primary)] text-xs focus:border-[var(--color-accent-gold)] focus:outline-none"
          />
        </div>
        <button
          type="button"
          class="rounded-xs border border-[var(--color-accent-gold)] bg-[var(--color-accent-gold-subtle)] text-[var(--color-accent-gold)] px-3 py-0.5 font-semibold hover:bg-[var(--color-accent-gold)] hover:text-[var(--color-btn-gold-text)] transition-colors cursor-pointer"
          onclick="applyCustomDateRange()"
        >
          {isEs ? "Aplicar Plazo" : "Apply Range"}
        </button>
      </div>

      <!-- Secondary Controls: Search & Export -->
      <div class="pt-3 border-t border-[var(--color-surface-border)] flex flex-col md:flex-row md:items-center justify-between gap-3 font-mono text-xs">
        <div class="relative w-full md:w-96">
          <input
            type="text"
            id="input-search"
            placeholder={
              isEs
                ? "Filtrar por ruta, país, UTM, referrer o hash..."
                : "Filter by path, country, UTM, referrer or hash..."
            }
            class="w-full rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-3 py-1.5 text-xs text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:border-[var(--color-accent-gold)] focus:outline-none"
            oninput="onSearchInput(this.value)"
          />
          <span
            id="search-counter"
            class="absolute right-2.5 top-1.5 text-[10px] text-[var(--color-text-muted)] pointer-events-none"
          >
            --
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="text-[11px] text-[var(--color-text-muted)]">
            {isEs ? "Exportar:" : "Export:"}
          </span>
          <button
            type="button"
            class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-secondary)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] transition-colors cursor-pointer"
            onclick="exportData('json')"
          >
            JSON
          </button>
          <button
            type="button"
            class="rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-text-secondary)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] transition-colors cursor-pointer"
            onclick="exportData('csv')"
          >
            CSV
          </button>
        </div>
      </div>
    </div>

    <!-- Data Breakdown Grid (Top Pages + Country Distribution) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Panel 1: Top Pages (Páginas Destacadas) -->
      <div class="lg:col-span-7 geometric-box rounded-sm p-4 sm:p-5 shadow-sm space-y-3">
        <div class="border-b border-[var(--color-surface-border)] pb-3 flex items-center justify-between">
          <div>
            <h2 class="text-xs sm:text-sm font-bold font-mono uppercase tracking-wider text-[var(--color-accent-gold)]">
              {isEs
                ? "Páginas Destacadas // Ranking de Demanda"
                : "Top Visited Routes // Traffic Ranking"}
            </h2>
            <p class="text-[10px] font-mono text-[var(--color-text-muted)] mt-0.5">
              {isEs
                ? "Rutas más solicitadas con desglose de visitas humanas y únicos"
                : "Most requested paths with human vs unique breakdown"}
            </p>
          </div>
          <span
            id="top-pages-count"
            class="font-mono text-xs text-[var(--color-text-muted)]"
          >
            --
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left font-mono text-xs border-collapse">
            <thead>
              <tr class="border-b border-[var(--color-surface-border)] text-[10px] uppercase text-[var(--color-text-muted)]">
                <th class="py-2 px-2 w-8">#</th>
                <th class="py-2 px-2">{isEs ? "Ruta" : "Path"}</th>
                <th class="py-2 px-2 text-right">{isEs ? "Total" : "Total"}</th>
                <th class="py-2 px-2 text-right text-emerald-400">
                  {isEs ? "Humanos" : "Humans"}
                </th>
                <th class="py-2 px-2 text-right">
                  {isEs ? "Únicos" : "Uniques"}
                </th>
                <th class="py-2 px-2 w-28 text-right">
                  {isEs ? "Proporción" : "Share"}
                </th>
              </tr>
            </thead>
            <tbody id="top-pages-tbody">
              <tr>
                <td
                  colspan="6"
                  class="py-6 text-center text-[var(--color-text-muted)] italic"
                >
                  {isEs
                    ? "Consultando páginas más visitadas..."
                    : "Loading top pages..."}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Panel 2: Geographical Breakdown (Por País) -->
      <div class="lg:col-span-5 geometric-box rounded-sm p-4 sm:p-5 shadow-sm space-y-3">
        <div class="border-b border-[var(--color-surface-border)] pb-3 flex items-center justify-between">
          <div>
            <h2 class="text-xs sm:text-sm font-bold font-mono uppercase tracking-wider text-[var(--color-accent-gold)]">
              {isEs
                ? "Distribución Geográfica // Por País"
                : "Geographic Distribution // By Country"}
            </h2>
            <p class="text-[10px] font-mono text-[var(--color-text-muted)] mt-0.5">
              {isEs
                ? "Tráfico geolocalizado en borde Cloudflare"
                : "Edge geolocated traffic (CF-IPCountry)"}
            </p>
          </div>
          <span class="text-[10px] font-mono text-[var(--color-text-muted)]">
            {isEs ? "Clic para filtrar" : "Click to filter"}
          </span>
        </div>

        <div
          id="countries-list"
          class="space-y-2 font-mono text-xs max-h-96 overflow-y-auto"
        >
          <p class="text-[var(--color-text-muted)] text-center py-6 italic text-xs">
            {isEs ? "Consultando países..." : "Loading countries..."}
          </p>
        </div>
      </div>
    </div>

    <!-- Secondary Insights Grid: Attribution (UTM & Referrers) + Prefetchs -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Attribution & Marketing Channels -->
      <div class="geometric-box rounded-sm p-4 sm:p-5 shadow-sm space-y-3">
        <div class="border-b border-[var(--color-surface-border)] pb-3 flex items-center justify-between">
          <div>
            <h2 class="text-xs sm:text-sm font-bold font-mono uppercase tracking-wider text-[var(--color-accent-gold)]">
              {isEs
                ? "Atribuciones UTM & Referrers"
                : "UTM Attribution & Referrers"}
            </h2>
            <p class="text-[10px] font-mono text-[var(--color-text-muted)] mt-0.5">
              {isEs
                ? "Fuentes externas de tráfico y campañas"
                : "Traffic channels, campaigns & external referrers"}
            </p>
          </div>
        </div>

        <div id="attribution-list" class="space-y-2 font-mono text-xs">
          <p class="text-[var(--color-text-muted)] text-center py-4 italic text-xs">
            {isEs
              ? "Consultando atribuciones..."
              : "Loading attribution data..."}
          </p>
        </div>
      </div>

      <!-- Prefetch Analytics & Conversion -->
      <div class="geometric-box rounded-sm p-4 sm:p-5 shadow-sm space-y-3">
        <div class="border-b border-[var(--color-surface-border)] pb-3 flex items-center justify-between">
          <div>
            <h2 class="text-xs sm:text-sm font-bold font-mono uppercase tracking-wider text-[var(--color-accent-gold)]">
              {isEs
                ? "Telemetría de Prefetchs (P1)"
                : "Prefetch Telemetry & Conversion"}
            </h2>
            <p class="text-[10px] font-mono text-[var(--color-text-muted)] mt-0.5">
              {isEs
                ? "Precargas especulativas antes de navegación"
                : "Speculative link prefetching before navigation"}
            </p>
          </div>
          <span
            id="prefetch-ratio-badge"
            class="font-mono text-xs text-cyan-400"
          >
            --
          </span>
        </div>

        <div id="prefetch-list" class="space-y-2 font-mono text-xs">
          <p class="text-[var(--color-text-muted)] text-center py-4 italic text-xs">
            {isEs
              ? "Consultando eventos prefetch..."
              : "Loading prefetch records..."}
          </p>
        </div>
      </div>
    </div>

    <!-- Resilience Governance & System Health (Incidents, Deployments, Leads) -->
    <div class="geometric-box rounded-sm p-4 sm:p-5 shadow-sm space-y-4">
      <div class="border-b border-[var(--color-surface-border)] pb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h2 class="text-xs sm:text-sm font-bold font-mono uppercase tracking-wider text-[var(--color-accent-gold)]">
            {isEs
              ? "Gobernanza Edge & Resiliencia del Sistema"
              : "Edge Governance & System Resilience"}
          </h2>
          <p class="text-[10px] font-mono text-[var(--color-text-muted)] mt-0.5">
            Circuit Breaker Incidents &bull; Deployments Registry &bull; Inbound
            Leads
          </p>
        </div>

        <div class="flex items-center gap-2 font-mono text-xs">
          <button
            type="button"
            class="subtab-btn active px-3 py-1 rounded-xs border border-[var(--color-accent-gold)] bg-[var(--color-bg-primary)] text-[var(--color-accent-gold)] cursor-pointer"
            onclick="switchSubtab('cb', this)"
          >
            Circuit Breaker
          </button>
          <button
            type="button"
            class="subtab-btn px-3 py-1 rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-secondary)] cursor-pointer hover:border-[var(--color-accent-gold)]"
            onclick="switchSubtab('deploy', this)"
          >
            Deployments
          </button>
          <button
            type="button"
            class="subtab-btn px-3 py-1 rounded-xs border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-secondary)] cursor-pointer hover:border-[var(--color-accent-gold)]"
            onclick="switchSubtab('leads', this)"
          >
            Leads
          </button>
        </div>
      </div>

      <!-- Circuit Breaker Pane -->
      <div id="subtab-cb" class="subtab-pane font-mono text-xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-[var(--color-surface-border)] text-[10px] uppercase text-[var(--color-text-muted)]">
                <th class="py-2 px-3">Fecha</th>
                <th class="py-2 px-3">Subsistema</th>
                <th class="py-2 px-3">Motivo Trip</th>
                <th class="py-2 px-3">Eventos Mitigados</th>
                <th class="py-2 px-3">Completitud Datos</th>
              </tr>
            </thead>
            <tbody id="cb-tbody">
              <tr>
                <td
                  colspan="5"
                  class="py-4 text-center text-[var(--color-text-muted)] italic"
                >
                  {isEs
                    ? "Sin incidentes de circuit breaker registrados (100% integridad)"
                    : "No circuit breaker incidents recorded (100% integrity)"}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Deployments Pane -->
      <div id="subtab-deploy" class="subtab-pane hidden font-mono text-xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-[var(--color-surface-border)] text-[10px] uppercase text-[var(--color-text-muted)]">
                <th class="py-2 px-3">Versión</th>
                <th class="py-2 px-3">Git Commit</th>
                <th class="py-2 px-3">Fecha Despliegue</th>
                <th class="py-2 px-3">Entorno</th>
                <th class="py-2 px-3">Estado</th>
              </tr>
            </thead>
            <tbody id="deploy-tbody">
              <tr>
                <td
                  colspan="5"
                  class="py-4 text-center text-[var(--color-text-muted)] italic"
                >
                  {isEs
                    ? "Consultando registro de versiones..."
                    : "Loading deployments registry..."}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Leads Pane -->
      <div id="subtab-leads" class="subtab-pane hidden font-mono text-xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-[var(--color-surface-border)] text-[10px] uppercase text-[var(--color-text-muted)]">
                <th class="py-2 px-3">Fecha</th>
                <th class="py-2 px-3">Remitente</th>
                <th class="py-2 px-3">Asunto</th>
                <th class="py-2 px-3">Mensaje</th>
              </tr>
            </thead>
            <tbody id="leads-tbody">
              <tr>
                <td
                  colspan="4"
                  class="py-4 text-center text-[var(--color-text-muted)] italic"
                >
                  {isEs
                    ? "Sin leads registrados aún."
                    : "No leads received yet."}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Live Telemetry Stream (High-Density Event Log) -->
    <div class="geometric-box rounded-sm p-4 sm:p-5 shadow-sm space-y-3">
      <div class="border-b border-[var(--color-surface-border)] pb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h2 class="text-xs sm:text-sm font-bold font-mono uppercase tracking-wider text-[var(--color-accent-gold)]">
            {isEs
              ? "Registro de Eventos en Tiempo Real (Live Stream)"
              : "Live Telemetry Event Stream"}
          </h2>
          <p class="text-[10px] font-mono text-[var(--color-text-muted)] mt-0.5">
            {isEs
              ? "Eventos edge capturados en D1 (Zero PII, Hashes criptográficos unidireccionales)"
              : "Raw edge events stream stored in D1 (Zero PII, one-way cryptographic visitor hashes)"}
          </p>
        </div>
        <div class="font-mono text-xs text-[var(--color-text-muted)]">
          <span id="events-count-label">-- eventos</span>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left font-mono text-xs border-collapse">
          <thead>
            <tr class="border-b border-[var(--color-surface-border)] text-[10px] uppercase text-[var(--color-text-muted)]">
              <th class="py-2 px-2.5">Hora (UTC)</th>
              <th class="py-2 px-2.5">Tipo</th>
              <th class="py-2 px-2.5">Ruta</th>
              <th class="py-2 px-2.5">País</th>
              <th class="py-2 px-2.5">Referrer / Origen</th>
              <th class="py-2 px-2.5">Campaña UTM</th>
              <th class="py-2 px-2.5">Hash GDPR</th>
            </tr>
          </thead>
          <tbody id="telemetry-tbody">
            <tr>
              <td
                colspan="7"
                class="py-6 text-center text-[var(--color-text-muted)] italic"
              >
                {isEs
                  ? "Cargando eventos de telemetría..."
                  : "Loading live events..."}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var currentRange = "7d";
    var currentCountry = "all";
    var currentSegment = "all";
    var currentPathFilter = "all";
    var customFrom = "";
    var customTo = "";
    var searchQuery = "";
    var pollDelay = 5000;
    var pollIntervalId = null;
    var lastSyncTimestamp = Date.now();

    var cachedTelemetryData = null;
    var rawPageviews = [];
    var rawPrefetches = [];
    var rawTopPages = [];
    var rawTopCountries = [];
    var rawUtmAttributions = [];
    var rawTopReferrers = [];
    var rawIncidents = [];
    var rawDeployments = [];
    var rawLeads = [];
    var knownCountries = new Set();

    // Actualizador del badge de tiempo transcurrido
    setInterval(function () {
      var badge = document.getElementById("badge-sync-time");
      if (!badge) return;
      var elapsedSec = Math.floor((Date.now() - lastSyncTimestamp) / 1000);
      if (elapsedSec < 3) {
        badge.textContent = "Sincronizado: justo ahora";
      } else {
        badge.textContent = "Sincronizado: hace " + elapsedSec + "s";
      }
    }, 1000);

    async function fetchDashboardData(isManual) {
      var refreshIcon = document.getElementById("refresh-icon");
      if (refreshIcon) refreshIcon.classList.add("animate-spin");

      try {
        var queryParams = new URLSearchParams();
        queryParams.set("range", currentRange);
        if (currentCountry !== "all")
          queryParams.set("country", currentCountry);
        if (currentSegment !== "all")
          queryParams.set("segment", currentSegment);
        if (currentPathFilter !== "all")
          queryParams.set("path", currentPathFilter);
        if (searchQuery.trim()) queryParams.set("search", searchQuery.trim());
        if (currentRange === "custom") {
          if (customFrom) queryParams.set("from", customFrom);
          if (customTo) queryParams.set("to", customTo);
        }

        var results = await Promise.allSettled([
          fetch("/api/telemetry?" + queryParams.toString(), {
            cache: "no-store",
          }),
          fetch("/api/metrics", { cache: "no-store" }),
          fetch("/api/deployments", { cache: "no-store" }),
          fetch("/api/leads", { cache: "no-store" }),
        ]);

        var telemetryRes = results[0];
        var metricsRes = results[1];
        var deployRes = results[2];
        var leadsRes = results[3];

        if (telemetryRes.status === "fulfilled" && telemetryRes.value.ok) {
          var tData = await telemetryRes.value.json();
          cachedTelemetryData = tData;
          rawPageviews = tData.pageviews || [];
          rawPrefetches = tData.prefetches || [];
          rawTopPages = tData.top_pages || [];
          rawTopCountries = tData.top_countries || [];
          rawUtmAttributions = tData.utm_attributions || [];
          rawTopReferrers = tData.top_referrers || [];
        }

        if (metricsRes.status === "fulfilled" && metricsRes.value.ok) {
          var mData = await metricsRes.value.json();
          rawIncidents = mData.data_quality_warnings || [];
        }

        if (deployRes.status === "fulfilled" && deployRes.value.ok) {
          var dData = await deployRes.value.json();
          rawDeployments = dData.deployments || [];
        }

        if (leadsRes.status === "fulfilled" && leadsRes.value.ok) {
          var lData = await leadsRes.value.json();
          rawLeads = lData.leads || [];
        }

        lastSyncTimestamp = Date.now();
        renderDashboard();
      } catch (err) {
        console.warn("Error fetching dashboard telemetry:", err);
      } finally {
        if (refreshIcon) refreshIcon.classList.remove("animate-spin");
      }
    }

    function renderDashboard() {
      if (!cachedTelemetryData) return;

      var stats = cachedTelemetryData.stats || {};
      var totalViews = stats.total_pageviews || 0;
      var humanViews = stats.human_views || 0;
      var botViews = stats.bot_views || 0;
      var uniqueVisitors = stats.unique_visitors || 0;
      var prefetchesCount = stats.prefetches_count || 0;
      var leadsCount = rawLeads.length;

      var humanPct =
        totalViews > 0 ? Math.round((humanViews / totalViews) * 100) : 0;
      var botPct =
        totalViews > 0 ? Math.round((botViews / totalViews) * 100) : 0;

      // 1. KPIs
      var kpiTotal = document.getElementById("kpi-total");
      if (kpiTotal) kpiTotal.textContent = totalViews.toLocaleString();
      var kpiTotalSub = document.getElementById("kpi-total-sub");
      if (kpiTotalSub) {
        kpiTotalSub.textContent = stats.all_time_pageviews
          ? "Histórico acumulado: " + stats.all_time_pageviews.toLocaleString()
          : "Tráfico del período";
      }

      var kpiHuman = document.getElementById("kpi-human");
      if (kpiHuman) kpiHuman.textContent = humanViews.toLocaleString();
      var kpiHumanSub = document.getElementById("kpi-human-sub");
      if (kpiHumanSub) kpiHumanSub.textContent = humanPct + "% del total";

      var kpiBot = document.getElementById("kpi-bot");
      if (kpiBot) kpiBot.textContent = botViews.toLocaleString();
      var kpiBotSub = document.getElementById("kpi-bot-sub");
      if (kpiBotSub) kpiBotSub.textContent = botPct + "% del total";

      var kpiUnique = document.getElementById("kpi-unique");
      if (kpiUnique) kpiUnique.textContent = uniqueVisitors.toLocaleString();

      var kpiPrefetch = document.getElementById("kpi-prefetch");
      if (kpiPrefetch)
        kpiPrefetch.textContent = prefetchesCount.toLocaleString();

      var kpiLeads = document.getElementById("kpi-leads");
      if (kpiLeads) kpiLeads.textContent = leadsCount.toLocaleString();

      // 2. Poblar opciones de país si no se han poblado
      updateCountryDropdown();

      // 3. Render Top Pages
      renderTopPages(rawTopPages, totalViews);

      // 4. Render Countries
      renderCountries(rawTopCountries, totalViews);

      // 5. Render Attribution
      renderAttribution(rawUtmAttributions, rawTopReferrers);

      // 6. Render Prefetches
      renderPrefetches(rawPrefetches, prefetchesCount);

      // 7. Render Event Table
      renderTable(rawPageviews);

      // 8. Render Panes
      renderPanes();
    }

    function updateCountryDropdown() {
      var select = document.getElementById("select-country");
      if (!select) return;

      var currentVal = select.value;
      rawTopCountries.forEach(function (c) {
        if (c.country && c.country !== "UNKNOWN") knownCountries.add(c.country);
      });
      rawPageviews.forEach(function (p) {
        if (p.country && p.country !== "XX") knownCountries.add(p.country);
      });

      var existingOptions = new Set();
      for (var i = 0; i < select.options.length; i++) {
        existingOptions.add(select.options[i].value);
      }

      knownCountries.forEach(function (code) {
        if (!existingOptions.has(code)) {
          var opt = document.createElement("option");
          opt.value = code;
          opt.textContent = code;
          select.appendChild(opt);
        }
      });

      select.value = currentVal;
    }

    function renderTopPages(pages, totalViews) {
      var tbody = document.getElementById("top-pages-tbody");
      var countLabel = document.getElementById("top-pages-count");
      if (!tbody) return;

      if (countLabel) countLabel.textContent = pages.length + " rutas";

      if (!pages.length) {
        tbody.innerHTML =
          '<tr><td colspan="6" class="py-6 text-center text-[var(--color-text-muted)] italic">Sin datos para este filtro</td></tr>';
        return;
      }

      var maxViews = pages[0] ? pages[0].total_views : 1;

      tbody.innerHTML = pages
        .slice(0, 10)
        .map(function (p, idx) {
          var pct =
            totalViews > 0 ? Math.round((p.total_views / totalViews) * 100) : 0;
          var barPct = Math.round((p.total_views / maxViews) * 100);
          return (
            '<tr class="border-b border-[var(--color-surface-border)] hover:bg-[var(--color-accent-gold-subtle)] transition-colors">' +
            '<td class="py-2 px-2 text-[var(--color-text-dim)]">#' +
            (idx + 1) +
            "</td>" +
            '<td class="py-2 px-2 font-semibold text-[var(--color-text-primary)] max-w-xs truncate" title="' +
            escapeHtml(p.path) +
            '">' +
            escapeHtml(p.path) +
            "</td>" +
            '<td class="py-2 px-2 text-right font-bold text-[var(--color-text-primary)]">' +
            p.total_views.toLocaleString() +
            "</td>" +
            '<td class="py-2 px-2 text-right text-emerald-400">' +
            (p.human_views || 0).toLocaleString() +
            "</td>" +
            '<td class="py-2 px-2 text-right text-[var(--color-text-dim)]">' +
            (p.unique_visitors || 0).toLocaleString() +
            "</td>" +
            '<td class="py-2 px-2 text-right">' +
            '<div class="flex items-center justify-end gap-1.5">' +
            '<span class="text-[10px] text-[var(--color-text-muted)]">' +
            pct +
            "%</span>" +
            '<div class="w-12 h-1.5 rounded-full bg-[var(--color-surface-border)] overflow-hidden">' +
            '<div class="h-full bg-[var(--color-accent-gold)]" style="width:' +
            barPct +
            '%"></div>' +
            "</div>" +
            "</div>" +
            "</td>" +
            "</tr>"
          );
        })
        .join("");
    }

    function renderCountries(countries, totalViews) {
      var container = document.getElementById("countries-list");
      if (!container) return;

      if (!countries.length) {
        container.innerHTML =
          '<p class="py-6 text-center text-[var(--color-text-muted)] italic">Sin datos de geolocalización</p>';
        return;
      }

      var maxC = countries[0] ? countries[0].views : 1;

      container.innerHTML = countries
        .slice(0, 8)
        .map(function (c) {
          var pct =
            totalViews > 0 ? Math.round((c.views / totalViews) * 100) : 0;
          var barPct = Math.round((c.views / maxC) * 100);
          var isCurrent = currentCountry === c.country;
          return (
            '<div class="p-2 rounded border ' +
            (isCurrent
              ? "border-[var(--color-accent-gold)] bg-[var(--color-accent-gold-subtle)]"
              : "border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]") +
            ' hover:border-[var(--color-accent-gold)] cursor-pointer transition-colors" onclick="filterByCountry(\'' +
            escapeHtml(c.country) +
            "')\">" +
            '<div class="flex items-center justify-between text-xs">' +
            '<div class="flex items-center gap-2">' +
            '<span class="px-1.5 py-0.5 rounded-xs bg-[var(--color-accent-gold)] text-[var(--color-btn-gold-text)] font-bold text-[10px]">' +
            escapeHtml(c.country) +
            "</span>" +
            '<span class="text-[var(--color-text-primary)] font-semibold">' +
            escapeHtml(c.country) +
            "</span>" +
            "</div>" +
            '<div class="flex items-center gap-2 font-mono">' +
            '<span class="text-[var(--color-text-primary)] font-bold">' +
            c.views.toLocaleString() +
            "</span>" +
            '<span class="text-[10px] text-[var(--color-text-muted)]">(' +
            pct +
            "%)</span>" +
            "</div>" +
            "</div>" +
            '<div class="mt-1.5 w-full h-1 rounded-full bg-[var(--color-surface-border)] overflow-hidden">' +
            '<div class="h-full bg-emerald-400" style="width:' +
            barPct +
            '%"></div>' +
            "</div>" +
            "</div>"
          );
        })
        .join("");
    }

    function renderAttribution(utms, referrers) {
      var container = document.getElementById("attribution-list");
      if (!container) return;

      var html = "";

      if (utms.length) {
        html +=
          '<div class="space-y-1.5"><div class="text-[10px] uppercase text-[var(--color-text-muted)] tracking-wider font-semibold">Campañas UTM</div>';
        html += utms
          .slice(0, 5)
          .map(function (u) {
            return (
              '<div class="flex items-center justify-between p-1.5 rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]">' +
              '<div class="truncate max-w-xs">' +
              '<span class="text-[var(--color-accent-gold)] font-bold">' +
              escapeHtml(u.utm_source) +
              "</span>" +
              (u.utm_campaign && u.utm_campaign !== "-"
                ? ' <span class="text-[var(--color-text-dim)]">/ ' +
                  escapeHtml(u.utm_campaign) +
                  "</span>"
                : "") +
              "</div>" +
              '<span class="font-bold text-[var(--color-text-primary)]">' +
              u.count.toLocaleString() +
              "</span>" +
              "</div>"
            );
          })
          .join("");
        html += "</div>";
      }

      if (referrers.length) {
        html +=
          '<div class="space-y-1.5 mt-3"><div class="text-[10px] uppercase text-[var(--color-text-muted)] tracking-wider font-semibold">Top Referrers Externos</div>';
        html += referrers
          .slice(0, 5)
          .map(function (r) {
            return (
              '<div class="flex items-center justify-between p-1.5 rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]">' +
              '<span class="truncate max-w-xs text-[var(--color-text-secondary)]">' +
              escapeHtml(r.referrer) +
              "</span>" +
              '<span class="font-bold text-emerald-400">' +
              r.count.toLocaleString() +
              "</span>" +
              "</div>"
            );
          })
          .join("");
        html += "</div>";
      }

      if (!utms.length && !referrers.length) {
        html =
          '<p class="py-4 text-center text-[var(--color-text-muted)] italic">Sin atribución o referrers externos (Tráfico directo)</p>';
      }

      container.innerHTML = html;
    }

    function renderPrefetches(prefetches, totalCount) {
      var container = document.getElementById("prefetch-list");
      var badge = document.getElementById("prefetch-ratio-badge");
      if (!container) return;

      if (badge) badge.textContent = totalCount + " precargas";

      if (!prefetches.length) {
        container.innerHTML =
          '<p class="py-4 text-center text-[var(--color-text-muted)] italic">Sin eventos de prefetch registrados</p>';
        return;
      }

      // Conteo por ruta
      var counts = {};
      prefetches.forEach(function (p) {
        counts[p.path] = (counts[p.path] || 0) + 1;
      });
      var sorted = Object.entries(counts).sort(function (a, b) {
        return b[1] - a[1];
      });

      container.innerHTML = sorted
        .slice(0, 6)
        .map(function (item) {
          return (
            '<div class="flex items-center justify-between p-2 rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]">' +
            '<span class="truncate max-w-xs text-[var(--color-text-primary)] font-semibold">' +
            escapeHtml(item[0]) +
            "</span>" +
            '<span class="px-2 py-0.5 rounded-xs bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 font-bold">' +
            item[1] +
            "</span>" +
            "</div>"
          );
        })
        .join("");
    }

    function renderTable(items) {
      var tbody = document.getElementById("telemetry-tbody");
      var counter = document.getElementById("events-count-label");
      var searchCounter = document.getElementById("search-counter");
      if (!tbody) return;

      if (counter) counter.textContent = items.length + " eventos";
      if (searchCounter) searchCounter.textContent = items.length + " hits";

      if (!items.length) {
        tbody.innerHTML =
          '<tr><td colspan="7" class="py-6 text-center text-[var(--color-text-muted)] italic">No se encontraron eventos coincidentes.</td></tr>';
        return;
      }

      tbody.innerHTML = items
        .slice(0, 60)
        .map(function (item) {
          var isBot = Boolean(item.is_bot);
          var isPrefetch = Boolean(item.is_prefetch || item.purpose);
          var tagBadge = isPrefetch
            ? '<span class="px-2 py-0.5 rounded-xs border border-cyan-500/30 bg-cyan-500/10 text-cyan-400 font-bold text-[10px]">PREFETCH</span>'
            : isBot
              ? '<span class="px-2 py-0.5 rounded-xs border border-[var(--color-accent-gold)]/40 bg-[var(--color-accent-gold-subtle)] text-[var(--color-accent-gold)] font-bold text-[10px]">BOT</span>'
              : '<span class="px-2 py-0.5 rounded-xs border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 font-bold text-[10px]">HUMAN</span>';

          var country = item.country || "XX";
          var ref =
            item.utm_source && item.utm_source !== "direct"
              ? item.utm_source
              : item.referrer || "Direct";
          var campaign = item.utm_campaign
            ? escapeHtml(item.utm_campaign)
            : "--";
          var hash = item.visitor_hash
            ? item.visitor_hash.slice(0, 10) + "..."
            : "--";

          return (
            '<tr class="border-b border-[var(--color-surface-border)] hover:bg-[var(--color-accent-gold-subtle)] transition-colors">' +
            '<td class="py-2 px-2.5 text-[var(--color-text-dim)] whitespace-nowrap">' +
            formatTime(item.created_at) +
            "</td>" +
            '<td class="py-2 px-2.5 whitespace-nowrap">' +
            tagBadge +
            "</td>" +
            '<td class="py-2 px-2.5 font-semibold text-[var(--color-text-primary)] max-w-xs truncate" title="' +
            escapeHtml(item.path) +
            '">' +
            escapeHtml(item.path) +
            "</td>" +
            '<td class="py-2 px-2.5 whitespace-nowrap"><span class="px-1.5 py-0.5 rounded-xs bg-[var(--color-bg-primary)] border border-[var(--color-surface-border)] text-[var(--color-text-secondary)] font-bold text-[10px]">' +
            escapeHtml(country) +
            "</span></td>" +
            '<td class="py-2 px-2.5 text-[var(--color-text-secondary)] max-w-xs truncate">' +
            escapeHtml(ref) +
            "</td>" +
            '<td class="py-2 px-2.5 text-[var(--color-text-dim)]">' +
            campaign +
            "</td>" +
            '<td class="py-2 px-2.5 text-[var(--color-text-muted)] text-[10px]">' +
            escapeHtml(hash) +
            "</td>" +
            "</tr>"
          );
        })
        .join("");
    }

    function renderPanes() {
      // CB
      var cbTbody = document.getElementById("cb-tbody");
      if (cbTbody) {
        if (!rawIncidents.length) {
          cbTbody.innerHTML =
            '<tr><td colspan="5" class="py-4 text-center text-[var(--color-text-muted)] italic">Sin incidentes de circuit breaker (100% integridad de datos)</td></tr>';
        } else {
          cbTbody.innerHTML = rawIncidents
            .map(function (inc) {
              return (
                '<tr class="border-b border-[var(--color-surface-border)]">' +
                '<td class="py-2 px-3">' +
                escapeHtml(inc.date) +
                "</td>" +
                '<td class="py-2 px-3 text-[var(--color-accent-gold)]">' +
                escapeHtml(inc.subsystem) +
                "</td>" +
                '<td class="py-2 px-3 text-red-400">' +
                escapeHtml(inc.warning || inc.reason) +
                "</td>" +
                '<td class="py-2 px-3">' +
                (inc.shed_count || 0) +
                "</td>" +
                '<td class="py-2 px-3 font-bold">' +
                escapeHtml(inc.data_completeness || "partial") +
                "</td>" +
                "</tr>"
              );
            })
            .join("");
        }
      }

      // Deployments
      var depTbody = document.getElementById("deploy-tbody");
      if (depTbody) {
        if (!rawDeployments.length) {
          depTbody.innerHTML =
            '<tr><td colspan="5" class="py-4 text-center text-[var(--color-text-muted)] italic">v1.4.2 (Production Active)</td></tr>';
        } else {
          depTbody.innerHTML = rawDeployments
            .map(function (d) {
              return (
                '<tr class="border-b border-[var(--color-surface-border)]">' +
                '<td class="py-2 px-3 font-bold text-[var(--color-accent-gold)]">' +
                escapeHtml(d.release_version) +
                "</td>" +
                '<td class="py-2 px-3 text-[var(--color-text-dim)]">' +
                escapeHtml(d.git_commit || "--") +
                "</td>" +
                '<td class="py-2 px-3">' +
                formatTime(d.deployed_at) +
                "</td>" +
                '<td class="py-2 px-3">' +
                escapeHtml(d.environment || "production") +
                "</td>" +
                '<td class="py-2 px-3"><span class="px-1.5 py-0.5 rounded-xs ' +
                (d.status === "active"
                  ? "bg-emerald-500/20 text-emerald-400"
                  : "bg-neutral-500/20 text-neutral-400") +
                '">' +
                escapeHtml(d.status) +
                "</span></td>" +
                "</tr>"
              );
            })
            .join("");
        }
      }

      // Leads
      var leadsTbody = document.getElementById("leads-tbody");
      if (leadsTbody) {
        if (!rawLeads.length) {
          leadsTbody.innerHTML =
            '<tr><td colspan="4" class="py-4 text-center text-[var(--color-text-muted)] italic">Sin leads corporativos registrados aún.</td></tr>';
        } else {
          leadsTbody.innerHTML = rawLeads
            .map(function (l) {
              return (
                '<tr class="border-b border-[var(--color-surface-border)]">' +
                '<td class="py-2 px-3 text-[var(--color-text-dim)] whitespace-nowrap">' +
                formatTime(l.created_at) +
                "</td>" +
                '<td class="py-2 px-3 font-bold text-[var(--color-accent-gold)]">' +
                escapeHtml(l.from_email) +
                "</td>" +
                '<td class="py-2 px-3 font-semibold text-[var(--color-text-primary)]">' +
                escapeHtml(l.subject) +
                "</td>" +
                '<td class="py-2 px-3 text-[var(--color-text-secondary)] max-w-sm truncate">' +
                escapeHtml(l.body) +
                "</td>" +
                "</tr>"
              );
            })
            .join("");
        }
      }
    }

    // Handlers expuestos al window
    var win = typeof window !== "undefined" ? window : {};

    win["setSegmentFilter"] = function (seg) {
      currentSegment = seg;
      document.querySelectorAll(".filter-tab").forEach(function (tab) {
        tab.classList.remove(
          "active",
          "border-[var(--color-accent-gold)]",
          "text-[var(--color-accent-gold)]",
          "font-semibold",
        );
        tab.classList.add(
          "border-[var(--color-surface-border)]",
          "text-[var(--color-text-secondary)]",
        );
      });
      var activeBtn = document.getElementById("tab-" + seg);
      if (activeBtn) {
        activeBtn.classList.add(
          "active",
          "border-[var(--color-accent-gold)]",
          "text-[var(--color-accent-gold)]",
          "font-semibold",
        );
        activeBtn.classList.remove(
          "border-[var(--color-surface-border)]",
          "text-[var(--color-text-secondary)]",
        );
      }
      fetchDashboardData(true);
    };

    win["onRangeChange"] = function (val) {
      currentRange = val;
      var customBar = document.getElementById("custom-range-bar");
      if (val === "custom") {
        if (customBar) customBar.classList.remove("hidden");
      } else {
        if (customBar) customBar.classList.add("hidden");
        fetchDashboardData(true);
      }
    };

    win["applyCustomDateRange"] = function () {
      var fromInput = document.getElementById("custom-from");
      var toInput = document.getElementById("custom-to");
      customFrom = fromInput ? fromInput.value : "";
      customTo = toInput ? toInput.value : "";
      fetchDashboardData(true);
    };

    win["onCountryChange"] = function (val) {
      currentCountry = val;
      fetchDashboardData(true);
    };

    win["filterByCountry"] = function (c) {
      var select = document.getElementById("select-country");
      if (select) select.value = c;
      currentCountry = c;
      fetchDashboardData(true);
    };

    win["onPathFilterChange"] = function (val) {
      currentPathFilter = val;
      fetchDashboardData(true);
    };

    win["onPollIntervalChange"] = function (val) {
      pollDelay = parseInt(val, 10);
      if (pollIntervalId) clearInterval(pollIntervalId);
      if (pollDelay > 0) {
        pollIntervalId = setInterval(function () {
          fetchDashboardData(false);
        }, pollDelay);
      }
    };

    win["onSearchInput"] = function (val) {
      searchQuery = val;
      fetchDashboardData(false);
    };

    win["switchSubtab"] = function (tab, btnEl) {
      document.querySelectorAll(".subtab-btn").forEach(function (btn) {
        btn.classList.remove(
          "active",
          "border-[var(--color-accent-gold)]",
          "text-[var(--color-accent-gold)]",
        );
        btn.classList.add(
          "border-[var(--color-surface-border)]",
          "text-[var(--color-text-secondary)]",
        );
      });
      document.querySelectorAll(".subtab-pane").forEach(function (p) {
        p.classList.add("hidden");
      });

      var target = document.getElementById("subtab-" + tab);
      if (target) target.classList.remove("hidden");

      var btn = btnEl && (btnEl.currentTarget || btnEl);
      if (btn && btn.classList) {
        btn.classList.add(
          "active",
          "border-[var(--color-accent-gold)]",
          "text-[var(--color-accent-gold)]",
        );
        btn.classList.remove(
          "border-[var(--color-surface-border)]",
          "text-[var(--color-text-secondary)]",
        );
      }
    };

    win["exportData"] = function (fmt) {
      var items = rawPageviews;
      if (!items.length) return;

      if (fmt === "json") {
        var str =
          "data:text/json;charset=utf-8," +
          encodeURIComponent(JSON.stringify(items, null, 2));
        var a = document.createElement("a");
        a.href = str;
        a.download = "telemetry-" + Date.now() + ".json";
        a.click();
      } else {
        var headers = [
          "id",
          "created_at",
          "path",
          "country",
          "referrer",
          "utm_source",
          "is_bot",
        ];
        var rows = items.map(function (i) {
          return [
            i.id,
            '"' + (i.created_at || "") + '"',
            '"' + (i.path || "") + '"',
            '"' + (i.country || "") + '"',
            '"' + (i.referrer || "") + '"',
            '"' + (i.utm_source || "") + '"',
            i.is_bot ? 1 : 0,
          ].join(",");
        });
        var csv =
          "data:text/csv;charset=utf-8," +
          encodeURIComponent([headers.join(","), ...rows].join("\n"));
        var a2 = document.createElement("a");
        a2.href = csv;
        a2.download = "telemetry-" + Date.now() + ".csv";
        a2.click();
      }
    };

    function formatTime(isoStr) {
      if (!isoStr) return "--";
      try {
        var d = new Date(isoStr);
        return d.toISOString().replace("T", " ").slice(0, 19);
      } catch (_) {
        return isoStr;
      }
    }

    function escapeHtml(str) {
      if (!str) return "";
      return String(str).replace(/[&<>"']/g, function (m) {
        return {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        }[m];
      });
    }

    // Inicialización automática
    fetchDashboardData(false);
    if (pollDelay > 0) {
      pollIntervalId = setInterval(function () {
        fetchDashboardData(false);
      }, pollDelay);
    }
  })();
</script>
