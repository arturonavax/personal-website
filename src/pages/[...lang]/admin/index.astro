</style>

<script is:inline>
  (function () {
    var isEs = document.documentElement.lang === "es";

    // Automatic device/saved language detection for root /admin
    if (
      window.location.pathname === "/admin" ||
      window.location.pathname === "/admin/"
    ) {
      try {
        var savedAdminLang =
          localStorage.getItem("preferred_locale") ||
          localStorage.getItem("admin_lang");
        var userLangs = (navigator.languages || [navigator.language || ""]).map(
          function (l) {
            return (l || "").toLowerCase().split("-")[0];
          },
        );
        if (
          savedAdminLang === "es" ||
          (!savedAdminLang && userLangs[0] === "es")
        ) {
          window.location.replace(
            "/es/admin/" + window.location.search + window.location.hash,
          );
          return;
        }
      } catch (_) {}
    }

    // Filter staging states
    var stagedRange = "7d";
    var stagedCountry = "all";
    var stagedSegment = "all";
    var stagedPathFilter = "all";
    var stagedSearchQuery = "";
    var isFiltersStaged = false;

    // Active filter query states
    var currentRange = "7d";
    var currentCountry = "all";
    var currentSegment = "all";
    var currentPathFilter = "all";
    var customFrom = "";
    var customTo = "";
    var searchQuery = "";
    var currentPage = 1;
    var currentLimit = 50;
    var totalPages = 1;
    var totalFiltered = 0;

    var pollDelay = 0;
    var pollIntervalId = null;
    var lastSyncTimestamp = Date.now();

    // Local timezone state
    var useLocalTimezone = false;
    try {
      useLocalTimezone = localStorage.getItem("admin_local_tz") === "true";
    } catch (_) {}

    // Sub-paginations
    var pathsPage = 1;
    var PATHS_PAGE_SIZE = 5;
    var countriesPage = 1;
    var COUNTRIES_PAGE_SIZE = 5;
    var referrersPage = 1;
    var REFERRERS_PAGE_SIZE = 5;
    var leadsPage = 1;
    var LEADS_PAGE_SIZE = 5;

    var cachedTelemetryData = null;
    var cachedQuotas = null;
    var rawPageviews = [];
    var rawPrefetches = [];
    var rawTopPages = [];
    var rawTopCountries = [];
    var rawUtmAttributions = [];
    var rawTopReferrers = [];
    var rawIncidents = [];
    var rawDeployments = [];
    var rawLeads = [];
    var knownCountries = new Set();

    // Live Sync Elapsed Timer
    setInterval(function () {
      var badge = document.getElementById("badge-sync-time");
      if (!badge) return;
      if (pollDelay === 0) {
        badge.textContent = isEs
          ? "Sincronizado: manual (Pausado)"
          : "Synced: manual (Paused)";
        return;
      }
      var elapsedSec = Math.floor((Date.now() - lastSyncTimestamp) / 1000);
      if (elapsedSec < 3) {
        badge.textContent = isEs
          ? "Sincronizado: justo ahora"
          : "Synced: just now";
      } else {
        badge.textContent = isEs
          ? "Sincronizado: hace " + elapsedSec + "s"
          : "Synced: " + elapsedSec + "s ago";
      }
    }, 1000);

    // Initial timezone checkbox setup
    var tzChk = document.getElementById("chk-local-tz");
    if (tzChk) tzChk.checked = useLocalTimezone;
    updateTimeHeader();

    function updateTimeHeader() {
      var th = document.getElementById("th-time-header");
      if (!th) return;
      th.textContent = useLocalTimezone
        ? isEs
          ? "Fecha y Hora (Local)"
          : "Date & Time (Local)"
        : isEs
          ? "Fecha y Hora (UTC)"
          : "Date & Time (UTC)";
    }

    function toggleTimezone(checked) {
      useLocalTimezone = Boolean(checked);
      try {
        localStorage.setItem("admin_local_tz", String(useLocalTimezone));
      } catch (_) {}
      updateTimeHeader();
      renderTable(rawPageviews);
      renderLeads();
    }

    function formatDateTime(isoStr) {
      if (!isoStr) return "--";
      try {
        var s = String(isoStr).trim();
        var cleanIso = s.includes("T")
          ? s.endsWith("Z") || s.includes("+") || s.lastIndexOf("-") > 10
            ? s
            : s + "Z"
          : s.replace(" ", "T") + "Z";
        var d = new Date(cleanIso);
        if (isNaN(d.getTime())) return isoStr;

        var opts = {
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
          hour: "numeric",
          minute: "2-digit",
          second: "2-digit",
          hour12: true,
          ...(useLocalTimezone ? {} : { timeZone: "UTC" }),
        };
        return new Intl.DateTimeFormat(isEs ? "es-ES" : "en-US", opts).format(
          d,
        );
      } catch (_) {
        return isoStr;
      }
    }

    function formatTime(isoStr) {
      return formatDateTime(isoStr);
    }

    // Country Tooltip Support
    var countryNameCache = {};
    function getCountryFullName(code) {
      if (!code || code === "XX" || code === "--") {
        return isEs ? "País desconocido" : "Unknown country";
      }
      var key = (isEs ? "es" : "en") + ":" + code;
      if (countryNameCache[key]) return countryNameCache[key];
      try {
        var dn = new Intl.DisplayNames([isEs ? "es" : "en"], {
          type: "region",
        });
        var name = dn.of(code.toUpperCase()) || code;
        countryNameCache[key] = name;
        return name;
      } catch (_) {
        return code;
      }
    }

    function showCountryTooltip(e, code) {
      var tooltip = document.getElementById("country-tooltip");
      if (!tooltip) return;
      var name = getCountryFullName(code);
      tooltip.textContent =
        (code && code !== "XX" ? code.toUpperCase() + " — " : "") + name;
      tooltip.classList.add("active");

      var x =
        e && typeof e.clientX === "number"
          ? e.clientX
          : (e && e.touches && e.touches[0] && e.touches[0].clientX) || 0;
      var y =
        e && typeof e.clientY === "number"
          ? e.clientY
          : (e && e.touches && e.touches[0] && e.touches[0].clientY) || 0;

      var tooltipRect = tooltip.getBoundingClientRect();
      var left = x + 12;
      var top = y + 12;
      if (left + tooltipRect.width > window.innerWidth - 10) {
        left = x - tooltipRect.width - 12;
      }
      if (top + tooltipRect.height > window.innerHeight - 10) {
        top = y - tooltipRect.height - 12;
      }

      tooltip.style.left = Math.max(8, left) + "px";
      tooltip.style.top = Math.max(8, top) + "px";
    }

    function hideCountryTooltip() {
      var tooltip = document.getElementById("country-tooltip");
      if (tooltip) tooltip.classList.remove("active");
    }

    function attachCountryTooltipEvents() {
      document.querySelectorAll(".country-tag").forEach(function (el) {
        var code = el.getAttribute("data-country");
        el.onmouseenter = function (e) {
          showCountryTooltip(e, code);
        };
        el.onmousemove = function (e) {
          showCountryTooltip(e, code);
        };
        el.onmouseleave = hideCountryTooltip;
        el.onclick = function (e) {
          e.stopPropagation();
          showCountryTooltip(e, code);
        };
      });
    }

    document.addEventListener("click", function (e) {
      if (!e.target || !e.target.closest || !e.target.closest(".country-tag")) {
        hideCountryTooltip();
      }
    });

    // Staged Filtering Logic
    function markFiltersStaged(staged) {
      isFiltersStaged = staged;
      var btn = document.getElementById("btn-apply-filters");
      if (!btn) return;
      if (staged) {
        btn.classList.add("staged");
        btn.textContent = isEs ? "✓ Aplicar Filtros *" : "✓ Apply Filters *";
      } else {
        btn.classList.remove("staged");
        btn.textContent = isEs ? "✓ Aplicar Filtros" : "✓ Apply Filters";
      }
    }

    function applyFilters() {
      currentRange = stagedRange;
      currentSegment = stagedSegment;
      currentPathFilter = stagedPathFilter;
      currentCountry = stagedCountry;
      searchQuery = stagedSearchQuery;
      currentPage = 1;
      pathsPage = 1;
      countriesPage = 1;
      referrersPage = 1;
      leadsPage = 1;
      markFiltersStaged(false);
      fetchDashboardData(false, false);
    }

    // Sub-pagination logic
    function changePathsPage(delta) {
      var list = rawTopPages || [];
      var maxPages = Math.max(1, Math.ceil(list.length / PATHS_PAGE_SIZE));
      pathsPage = Math.max(1, Math.min(maxPages, pathsPage + delta));
      renderTopPages(
        rawTopPages,
        (cachedTelemetryData &&
          cachedTelemetryData.stats &&
          cachedTelemetryData.stats.total_pageviews) ||
          0,
      );
    }

    function changeCountriesPage(delta) {
      var list = rawTopCountries || [];
      var maxPages = Math.max(1, Math.ceil(list.length / COUNTRIES_PAGE_SIZE));
      countriesPage = Math.max(1, Math.min(maxPages, countriesPage + delta));
      renderCountries(
        rawTopCountries,
        (cachedTelemetryData &&
          cachedTelemetryData.stats &&
          cachedTelemetryData.stats.total_pageviews) ||
          0,
      );
    }

    function changeReferrersPage(delta) {
      var list = rawTopReferrers || [];
      var maxPages = Math.max(1, Math.ceil(list.length / REFERRERS_PAGE_SIZE));
      referrersPage = Math.max(1, Math.min(maxPages, referrersPage + delta));
      renderAttribution(rawUtmAttributions, rawTopReferrers);
    }

    function changeLeadsPage(delta) {
      var list = rawLeads || [];
      var maxPages = Math.max(1, Math.ceil(list.length / LEADS_PAGE_SIZE));
      leadsPage = Math.max(1, Math.min(maxPages, leadsPage + delta));
      renderLeads();
    }

    function goToPage(p) {
      if (p < 1 || p > totalPages || p === currentPage) return;
      currentPage = p;
      fetchDashboardData(false, true);
    }

    function setLimit(l) {
      currentLimit = parseInt(l, 10);
      currentPage = 1;
      fetchDashboardData(false, true);
    }

    async function fetchDashboardData(isManual, pageOnly) {
      var refreshIcon = document.getElementById("refresh-icon");
      if (refreshIcon) refreshIcon.classList.add("animate-spin");

      try {
        var queryParams = new URLSearchParams();
        queryParams.set("range", currentRange);
        if (currentCountry !== "all")
          queryParams.set("country", currentCountry);
        if (currentSegment !== "all")
          queryParams.set("segment", currentSegment);
        if (currentPathFilter !== "all")
          queryParams.set("path", currentPathFilter);
        if (searchQuery.trim()) queryParams.set("search", searchQuery.trim());
        queryParams.set("page", String(currentPage));
        queryParams.set("limit", String(currentLimit));
        if (pageOnly) queryParams.set("page_only", "1");
        if (isManual) queryParams.set("fresh", "true");

        if (currentRange === "custom") {
          if (customFrom) queryParams.set("from", customFrom);
          if (customTo) queryParams.set("to", customTo);
        }

        if (pageOnly) {
          var pageRes = await fetch("/api/telemetry?" + queryParams.toString());
          if (pageRes.ok) {
            var pData = await pageRes.json();
            rawPageviews = pData.pageviews || [];
            if (pData.quotas) cachedQuotas = pData.quotas;
            if (pData.pagination) {
              currentPage = pData.pagination.page;
              totalPages = pData.pagination.total_pages || 1;
              totalFiltered = pData.pagination.total_filtered || 0;
            }
          }
          lastSyncTimestamp = Date.now();
          renderDashboard();
          return;
        }

        var results = await Promise.allSettled([
          fetch("/api/telemetry?" + queryParams.toString()),
          fetch("/api/metrics"),
          fetch("/api/deployments"),
          fetch("/api/leads"),
        ]);

        var telemetryRes = results[0];
        var metricsRes = results[1];
        var deployRes = results[2];
        var leadsRes = results[3];

        if (telemetryRes.status === "fulfilled" && telemetryRes.value.status === 401) {
          var authNotice = document.getElementById("admin-auth-notice");
          if (authNotice) authNotice.classList.remove("hidden");
          var cacheBadge = document.getElementById("badge-cache-mode");
          if (cacheBadge) {
            cacheBadge.textContent = "● 401 No Autorizado (Zero Trust Requerido)";
            cacheBadge.style.color = "#ef4444";
          }
          return;
        }

        if (telemetryRes.status === "fulfilled" && telemetryRes.value.ok) {
          var tData = await telemetryRes.value.json();
          cachedTelemetryData = tData;
          rawPageviews = tData.pageviews || [];
          rawPrefetches = tData.prefetches || [];
          rawTopPages = tData.top_pages || [];
          rawTopCountries = tData.top_countries || [];
          rawUtmAttributions = tData.utm_attributions || [];
          rawTopReferrers = tData.top_referrers || [];
          if (tData.quotas) cachedQuotas = tData.quotas;
          if (tData.pagination) {
            currentPage = tData.pagination.page;
            totalPages = tData.pagination.total_pages || 1;
            totalFiltered = tData.pagination.total_filtered || 0;
          }
        }

        if (metricsRes.status === "fulfilled" && metricsRes.value.ok) {
          var mData = await metricsRes.value.json();
          rawIncidents = mData.data_quality_warnings || [];
          if (mData.quotas) cachedQuotas = mData.quotas;
        }

        if (deployRes.status === "fulfilled" && deployRes.value.ok) {
          var dData = await deployRes.value.json();
          rawDeployments = dData.deployments || [];
        }

        if (leadsRes.status === "fulfilled" && leadsRes.value.ok) {
          var lData = await leadsRes.value.json();
          rawLeads = lData.leads || [];
        }

        lastSyncTimestamp = Date.now();
        renderDashboard();
      } catch (err) {
        console.warn("Error fetching dashboard telemetry:", err);
      } finally {
        if (refreshIcon) refreshIcon.classList.remove("animate-spin");
      }
    }

    function fmtK(n) {
      if (typeof n !== "number" || isNaN(n)) return "0";
      if (n >= 1000000) return (n / 1000000).toFixed(n % 1000000 === 0 ? 0 : 2) + "M";
      if (n >= 1000) return (n / 1000).toFixed(n % 1000 === 0 ? 0 : 2) + "k";
      return n.toLocaleString();
    }

