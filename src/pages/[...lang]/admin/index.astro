    function renderDashboard() {
      if (!cachedTelemetryData) return;

      var stats = cachedTelemetryData.stats || {};
      var totalViews = stats.total_pageviews || 0;
      var humanViews = stats.human_views || 0;
      var botViews = stats.bot_views || 0;
      var uniqueVisitors = stats.unique_visitors || 0;
      var prefetchesCount = stats.prefetches_count || 0;
      var leadsCount = rawLeads.length;

      var humanPct =
        totalViews > 0 ? Math.round((humanViews / totalViews) * 100) : 0;
      var botPct =
        totalViews > 0 ? Math.round((botViews / totalViews) * 100) : 0;

      // 1. KPIs
      var kpiTotal = document.getElementById("kpi-total");
      if (kpiTotal) kpiTotal.textContent = totalViews.toLocaleString();
      var kpiTotalSub = document.getElementById("kpi-total-sub");
      if (kpiTotalSub) {
        kpiTotalSub.textContent = stats.all_time_pageviews
          ? (isEs ? "Histórico acumulado: " : "All-time total: ") +
            stats.all_time_pageviews.toLocaleString()
          : isEs
            ? "Tráfico del período"
            : "Period traffic";
      }

      var kpiHuman = document.getElementById("kpi-human");
      if (kpiHuman) kpiHuman.textContent = humanViews.toLocaleString();
      var kpiHumanSub = document.getElementById("kpi-human-sub");
      if (kpiHumanSub)
        kpiHumanSub.textContent =
          humanPct + (isEs ? "% del total" : "% of total");

      var kpiBot = document.getElementById("kpi-bot");
      if (kpiBot) kpiBot.textContent = botViews.toLocaleString();
      var kpiBotSub = document.getElementById("kpi-bot-sub");
      if (kpiBotSub)
        kpiBotSub.textContent = botPct + (isEs ? "% del total" : "% of total");

      var kpiUnique = document.getElementById("kpi-unique");
      if (kpiUnique) kpiUnique.textContent = uniqueVisitors.toLocaleString();
      var kpiUniqueSub = document.getElementById("kpi-unique-sub");
      var uniqueHuman = (stats && stats.unique_human_visitors) || 0;
      var uniqueHumanPct =
        uniqueVisitors > 0
          ? Math.round((uniqueHuman / uniqueVisitors) * 100)
          : 0;
      if (kpiUniqueSub) {
        kpiUniqueSub.textContent =
          uniqueHuman.toLocaleString() +
          " " +
          (isEs ? "humanos" : "humans") +
          " (" +
          uniqueHumanPct +
          "%)";
      }

      var kpiPrefetch = document.getElementById("kpi-prefetch");
      if (kpiPrefetch)
        kpiPrefetch.textContent = prefetchesCount.toLocaleString();

      var kpiLeads = document.getElementById("kpi-leads");
      if (kpiLeads) kpiLeads.textContent = leadsCount.toLocaleString();

      // Pagination indicators
      var pagInfo = document.getElementById("pagination-info");
      if (pagInfo) {
        pagInfo.textContent =
          (isEs ? "Página " : "Page ") +
          currentPage +
          (isEs ? " de " : " of ") +
          totalPages +
          " (" +
          totalFiltered.toLocaleString() +
          (isEs ? " eventos)" : " events)");
      }
      var pageInd = document.getElementById("page-indicator");
      if (pageInd) {
        pageInd.textContent = currentPage + " / " + totalPages;
      }
      var btnFirst = document.getElementById("btn-page-first");
      var btnPrev = document.getElementById("btn-page-prev");
      var btnNext = document.getElementById("btn-page-next");
      var btnLast = document.getElementById("btn-page-last");
      if (btnFirst) btnFirst.disabled = currentPage <= 1;
      if (btnPrev) btnPrev.disabled = currentPage <= 1;
      if (btnNext) btnNext.disabled = currentPage >= totalPages;
      if (btnLast) btnLast.disabled = currentPage >= totalPages;

      // Dropdowns & Renderers
      updateCountryDropdown();
      renderQuotas();
      renderTopPages(rawTopPages, totalViews);
      renderCountries(rawTopCountries, totalViews);
      renderAttribution(rawUtmAttributions, rawTopReferrers);
      renderPrefetches(rawPrefetches, prefetchesCount);
      renderLeads();
      renderTable(rawPageviews);
      renderPanes();
    }

    function updateCountryDropdown() {
      var select = document.getElementById("select-country");
      if (!select) return;

      var currentVal = select.value;
      rawTopCountries.forEach(function (c) {
        if (c.country && c.country !== "UNKNOWN") knownCountries.add(c.country);
      });
      rawPageviews.forEach(function (p) {
        if (p.country && p.country !== "XX") knownCountries.add(p.country);
      });

      var existingOptions = new Set();
      for (var i = 0; i < select.options.length; i++) {
        existingOptions.add(select.options[i].value);
      }

      knownCountries.forEach(function (code) {
        if (!existingOptions.has(code)) {
          var opt = document.createElement("option");
          opt.value = code;
          opt.textContent = code + " (" + getCountryFullName(code) + ")";
          select.appendChild(opt);
        }
      });

      select.value = currentVal;
    }

    function renderTopPages(pages, totalViews) {
      var tbody = document.getElementById("top-pages-tbody");
      var countLabel = document.getElementById("top-pages-count");
      var pageInfo = document.getElementById("paths-page-info");
      var btnPrev = document.getElementById("btn-paths-prev");
      var btnNext = document.getElementById("btn-paths-next");
      if (!tbody) return;

      var totalP = Math.max(1, Math.ceil(pages.length / PATHS_PAGE_SIZE));
      pathsPage = Math.max(1, Math.min(totalP, pathsPage));

      if (pageInfo) pageInfo.textContent = pathsPage + " / " + totalP;
      if (btnPrev) btnPrev.disabled = pathsPage <= 1;
      if (btnNext) btnNext.disabled = pathsPage >= totalP;
      if (countLabel)
        countLabel.textContent = pages.length + (isEs ? " rutas" : " routes");

      if (!pages.length) {
        tbody.innerHTML =
          '<tr><td colspan="6" class="py-6 text-center text-[var(--color-text-muted)] italic">' +
          (isEs ? "Sin datos para este filtro" : "No data for this filter") +
          "</td></tr>";
        return;
      }

      var maxViews = pages[0] ? pages[0].total_views : 1;
      var start = (pathsPage - 1) * PATHS_PAGE_SIZE;
      var paged = pages.slice(start, start + PATHS_PAGE_SIZE);

      tbody.innerHTML = paged
        .map(function (p, idx) {
          var count = p.total_views || 0;
          var hCount = p.human_views || 0;
          var uCount = p.unique_visitors || 0;
          var pct = totalViews > 0 ? Math.round((count / totalViews) * 100) : 0;
          var barPct = Math.round((count / maxViews) * 100);
          return (
            '<tr class="border-b border-[var(--color-surface-border)] hover:bg-[var(--color-accent-gold-subtle)] transition-colors">' +
            '<td class="py-2 px-2 text-[var(--color-text-dim)]">#' +
            (start + idx + 1) +
            "</td>" +
            '<td class="py-2 px-2 font-semibold text-[var(--color-text-primary)] max-w-xs truncate" title="' +
            escapeHtml(p.path) +
            '">' +
            escapeHtml(p.path) +
            "</td>" +
            '<td class="py-2 px-2 text-right font-bold text-[var(--color-text-primary)]">' +
            count.toLocaleString() +
            "</td>" +
            '<td class="py-2 px-2 text-right text-emerald-400">' +
            hCount.toLocaleString() +
            "</td>" +
            '<td class="py-2 px-2 text-right text-[var(--color-text-dim)]">' +
            uCount.toLocaleString() +
            "</td>" +
            '<td class="py-2 px-2 text-right">' +
            '<div class="flex items-center justify-end gap-1.5">' +
            '<span class="text-[10px] text-[var(--color-text-muted)]">' +
            pct +
            "%</span>" +
            '<div class="w-12 h-1.5 rounded-full bg-[var(--color-surface-border)] overflow-hidden">' +
            '<div class="h-full bg-[var(--color-accent-gold)]" style="width:' +
            barPct +
            '%"></div>' +
            "</div>" +
            "</div>" +
            "</td>" +
            "</tr>"
          );
        })
        .join("");
    }

    function renderCountries(countries, totalViews) {
      var container = document.getElementById("countries-list");
      var pageInfo = document.getElementById("countries-page-info");
      var btnPrev = document.getElementById("btn-countries-prev");
      var btnNext = document.getElementById("btn-countries-next");
      if (!container) return;

      var totalP = Math.max(
        1,
        Math.ceil(countries.length / COUNTRIES_PAGE_SIZE),
      );
      countriesPage = Math.max(1, Math.min(totalP, countriesPage));

      if (pageInfo) pageInfo.textContent = countriesPage + " / " + totalP;
      if (btnPrev) btnPrev.disabled = countriesPage <= 1;
      if (btnNext) btnNext.disabled = countriesPage >= totalP;

      if (!countries.length) {
        container.innerHTML =
          '<p class="py-6 text-center text-[var(--color-text-muted)] italic">' +
          (isEs ? "Sin datos de geolocalización" : "No geolocation data") +
          "</p>";
        return;
      }

      var maxC = countries[0] ? countries[0].views : 1;
      var start = (countriesPage - 1) * COUNTRIES_PAGE_SIZE;
      var paged = countries.slice(start, start + COUNTRIES_PAGE_SIZE);

      container.innerHTML = paged
        .map(function (c) {
          var pct =
            totalViews > 0 ? Math.round((c.views / totalViews) * 100) : 0;
          var barPct = Math.round((c.views / maxC) * 100);
          var isCurrent = stagedCountry === c.country;
          var fullName = getCountryFullName(c.country);
          return (
            '<div class="country-tag p-2 rounded border ' +
            (isCurrent
              ? "border-[var(--color-accent-gold)] bg-[var(--color-accent-gold-subtle)]"
              : "border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]") +
            ' hover:border-[var(--color-accent-gold)] transition-colors" data-country="' +
            escapeHtml(c.country) +
            '" title="' +
            escapeHtml(fullName) +
            '" onclick="filterByCountry(\'' +
            escapeHtml(c.country) +
            "')\">" +
            '<div class="flex items-center justify-between text-xs">' +
            '<div class="flex items-center gap-2">' +
            '<span class="px-1.5 py-0.5 rounded-xs bg-[var(--color-accent-gold)] text-[var(--color-btn-gold-text)] font-bold text-[10px]">' +
            escapeHtml(c.country) +
            "</span>" +
            '<span class="text-[var(--color-text-primary)] font-semibold truncate max-w-[140px]">' +
            escapeHtml(fullName) +
            "</span>" +
            "</div>" +
            '<div class="flex items-center gap-2 font-mono">' +
            '<span class="text-[var(--color-text-primary)] font-bold">' +
            c.views.toLocaleString() +
            "</span>" +
            '<span class="text-[10px] text-[var(--color-text-muted)]">(' +
            pct +
            "%)</span>" +
            "</div>" +
            "</div>" +
            '<div class="mt-1.5 w-full h-1 rounded-full bg-[var(--color-surface-border)] overflow-hidden">' +
            '<div class="h-full bg-emerald-400" style="width:' +
            barPct +
            '%"></div>' +
            "</div>" +
            "</div>"
          );
        })
        .join("");

      attachCountryTooltipEvents();
    }

    function renderAttribution(utms, referrers) {
      var container = document.getElementById("attribution-list");
      var pageInfo = document.getElementById("referrers-page-info");
      var btnPrev = document.getElementById("btn-referrers-prev");
      var btnNext = document.getElementById("btn-referrers-next");
      if (!container) return;

      var totalP = Math.max(
        1,
        Math.ceil(referrers.length / REFERRERS_PAGE_SIZE),
      );
      referrersPage = Math.max(1, Math.min(totalP, referrersPage));

      if (pageInfo) pageInfo.textContent = referrersPage + " / " + totalP;
      if (btnPrev) btnPrev.disabled = referrersPage <= 1;
      if (btnNext) btnNext.disabled = referrersPage >= totalP;

      var html = "";

      if (utms.length) {
        html +=
          '<div class="space-y-1.5"><div class="text-[10px] uppercase text-[var(--color-text-muted)] tracking-wider font-semibold">' +
          (isEs ? "Campañas UTM" : "UTM Campaigns") +
          "</div>";
        html += utms
          .slice(0, 5)
          .map(function (u) {
            var utmSrc = u.utm_source || "direct";
            if (utmSrc.toLowerCase() === "invalid") utmSrc = "direct";
            return (
              '<div class="flex items-center justify-between p-1.5 rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]">' +
              '<div class="truncate max-w-xs">' +
              '<span class="text-[var(--color-accent-gold)] font-bold">' +
              escapeHtml(utmSrc) +
              "</span>" +
              (u.utm_campaign && u.utm_campaign !== "-"
                ? ' <span class="text-[var(--color-text-dim)]">/ ' +
                  escapeHtml(u.utm_campaign) +
                  "</span>"
                : "") +
              "</div>" +
              '<span class="font-bold text-[var(--color-text-primary)]">' +
              u.count.toLocaleString() +
              "</span>" +
              "</div>"
            );
          })
          .join("");
        html += "</div>";
      }

      if (referrers.length) {
        var start = (referrersPage - 1) * REFERRERS_PAGE_SIZE;
        var pagedRefs = referrers.slice(start, start + REFERRERS_PAGE_SIZE);

        html +=
          '<div class="space-y-1.5 mt-3"><div class="text-[10px] uppercase text-[var(--color-text-muted)] tracking-wider font-semibold">' +
          (isEs ? "Top Referrers Externos" : "Top External Referrers") +
          "</div>";
        html += pagedRefs
          .map(function (r) {
            var rf = r.referrer || "Direct";
            if (rf.toLowerCase() === "invalid") rf = "Direct";
            return (
              '<div class="flex items-center justify-between p-1.5 rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]">' +
              '<span class="truncate max-w-xs text-[var(--color-text-secondary)]">' +
              escapeHtml(rf) +
              "</span>" +
              '<span class="font-bold text-emerald-400">' +
              r.count.toLocaleString() +
              "</span>" +
              "</div>"
            );
          })
          .join("");
        html += "</div>";
      }

      if (!utms.length && !referrers.length) {
        html =
          '<p class="py-4 text-center text-[var(--color-text-muted)] italic">' +
          (isEs
            ? "Sin atribución o referrers externos (Tráfico directo)"
            : "No attribution or external referrers (Direct traffic)") +
          "</p>";
      }

      container.innerHTML = html;
    }

    function renderPrefetches(prefetches, totalCount) {
      var container = document.getElementById("prefetch-list");
      var badge = document.getElementById("prefetch-ratio-badge");
      if (!container) return;

      if (badge)
        badge.textContent = totalCount + (isEs ? " precargas" : " prefetches");

      if (!prefetches.length) {
        container.innerHTML =
          '<p class="py-4 text-center text-[var(--color-text-muted)] italic">' +
          (isEs
            ? "Sin eventos de prefetch registrados"
            : "No prefetch events recorded") +
          "</p>";
        return;
      }

      var counts = {};
      prefetches.forEach(function (p) {
        counts[p.path] = (counts[p.path] || 0) + 1;
      });
      var sorted = Object.entries(counts).sort(function (a, b) {
        return b[1] - a[1];
      });

      container.innerHTML = sorted
        .slice(0, 6)
        .map(function (item) {
          return (
            '<div class="flex items-center justify-between p-2 rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]">' +
            '<span class="truncate max-w-xs text-[var(--color-text-primary)] font-semibold">' +
            escapeHtml(item[0]) +
            "</span>" +
            '<span class="px-2 py-0.5 rounded-xs bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 font-bold">' +
            item[1] +
            "</span>" +
            "</div>"
          );
        })
        .join("");
    }

    function renderLeads() {
      var tbody = document.getElementById("leads-tbody");
      var badge = document.getElementById("leads-count-badge");
      var pageInfo = document.getElementById("leads-page-info");
      var btnPrev = document.getElementById("btn-leads-prev");
      var btnNext = document.getElementById("btn-leads-next");

      if (badge) badge.textContent = rawLeads.length + " leads";

      var totalP = Math.max(1, Math.ceil(rawLeads.length / LEADS_PAGE_SIZE));
      leadsPage = Math.max(1, Math.min(totalP, leadsPage));

      if (pageInfo)
        pageInfo.textContent =
          (isEs ? "Página " : "Page ") +
          leadsPage +
          (isEs ? " de " : " of ") +
          totalP;
      if (btnPrev) btnPrev.disabled = leadsPage <= 1;
      if (btnNext) btnNext.disabled = leadsPage >= totalP;

      if (!tbody) return;

      if (!rawLeads.length) {
        tbody.innerHTML =
          '<tr><td colspan="6" class="py-4 text-center text-[var(--color-text-muted)] italic">' +
          (isEs
            ? "Sin leads registrados aún en el búfer D1."
            : "No leads received yet in D1 buffer.") +
          "</td></tr>";
        return;
      }

      var start = (leadsPage - 1) * LEADS_PAGE_SIZE;
      var pagedLeads = rawLeads.slice(start, start + LEADS_PAGE_SIZE);

      tbody.innerHTML = pagedLeads
        .map(function (l) {
          var dt = formatDateTime(l.created_at);
          var name = escapeHtml(l.name || "--");
          var email = escapeHtml(l.from_email || "--");
          var phone = l.phone
            ? '<br><small class="text-[var(--color-text-dim)] font-mono">📞 ' +
              escapeHtml(l.phone) +
              "</small>"
            : "";
          var loc = escapeHtml((l.locale || "en").toUpperCase());
          var geoParts = [l.city, l.country].filter(Boolean);
          var geoText = geoParts.length
            ? '<br><small class="text-[var(--color-text-primary)] font-semibold">📍 ' +
              escapeHtml(geoParts.join(", ")) +
              "</small>"
            : "";
          var ipText = l.ip
            ? '<br><small class="text-[var(--color-text-dim)] text-[10px]">IP: ' +
              escapeHtml(l.ip) +
              (l.as_organization ? " · " + escapeHtml(l.as_organization) : "") +
              "</small>"
            : "";
          var subj = escapeHtml(l.subject || "--");
          var rawBody = l.body || "";
          var msg = escapeHtml(rawBody.replace(/[\r\n]+/g, " ").slice(0, 100));

          return (
            '<tr class="border-b border-[var(--color-surface-border)] hover:bg-[var(--color-accent-gold-subtle)] transition-colors">' +
            '<td class="py-2.5 px-3 text-[var(--color-text-dim)] whitespace-nowrap">' +
            dt +
            "</td>" +
            '<td class="py-2.5 px-3 font-bold text-[var(--color-text-primary)]">' +
            name +
            "</td>" +
            '<td class="py-2.5 px-3"><span class="text-[var(--color-accent-gold)] font-medium">' +
            email +
            "</span>" +
            phone +
            "</td>" +
            '<td class="py-2.5 px-3"><span class="px-1.5 py-0.5 rounded-xs bg-[var(--color-bg-primary)] border border-[var(--color-surface-border)] font-bold text-[10px]">' +
            loc +
            "</span>" +
            geoText +
            ipText +
            "</td>" +
            '<td class="py-2.5 px-3 font-semibold text-[var(--color-text-primary)]">' +
            subj +
            "</td>" +
            '<td class="py-2.5 px-3 text-[var(--color-text-secondary)] max-w-xs truncate" title="' +
            escapeHtml(rawBody) +
            '">' +
            msg +
            "</td>" +
            "</tr>"
          );
        })
        .join("");
    }

    function renderTable(items) {
      var tbody = document.getElementById("telemetry-tbody");
      var counter = document.getElementById("events-count-label");
      var searchCounter = document.getElementById("search-counter");
      if (!tbody) return;

      if (counter)
        counter.textContent = totalFiltered + (isEs ? " eventos" : " events");
      if (searchCounter) searchCounter.textContent = totalFiltered + " hits";

      if (!items.length) {
        tbody.innerHTML =
          '<tr><td colspan="7" class="py-6 text-center text-[var(--color-text-muted)] italic">' +
          (isEs
            ? "No se encontraron eventos coincidentes."
            : "No matching events found.") +
          "</td></tr>";
        return;
      }

      tbody.innerHTML = items
        .map(function (item) {
          var isBot = Boolean(item.is_bot);
          var isPrefetch = Boolean(item.is_prefetch || item.purpose);
          var tagBadge = isPrefetch
            ? '<span class="px-2 py-0.5 rounded-xs border border-cyan-500/30 bg-cyan-500/10 text-cyan-400 font-bold text-[10px]">PREFETCH</span>'
            : isBot
              ? '<span class="px-2 py-0.5 rounded-xs border border-[var(--color-accent-gold)]/40 bg-[var(--color-accent-gold-subtle)] text-[var(--color-accent-gold)] font-bold text-[10px]">BOT</span>'
              : '<span class="px-2 py-0.5 rounded-xs border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 font-bold text-[10px]">HUMAN</span>';

          var country = item.country || "XX";
          var fullName = getCountryFullName(country);
          var ref =
            item.utm_source && item.utm_source !== "direct"
              ? item.utm_source
              : item.referrer || "Direct";
          if (typeof ref === "string" && ref.toLowerCase() === "invalid") {
            ref = "Direct";
          }
          var campaign = item.utm_campaign
            ? escapeHtml(item.utm_campaign)
            : "--";
          var hash = item.visitor_hash
            ? item.visitor_hash.slice(0, 10) + "..."
            : "--";

          return (
            '<tr class="border-b border-[var(--color-surface-border)] hover:bg-[var(--color-accent-gold-subtle)] transition-colors">' +
            '<td class="py-2 px-2.5 text-[var(--color-text-dim)] whitespace-nowrap">' +
            formatDateTime(item.created_at) +
            "</td>" +
            '<td class="py-2 px-2.5 whitespace-nowrap">' +
            tagBadge +
            "</td>" +
            '<td class="py-2 px-2.5 font-semibold text-[var(--color-text-primary)] max-w-xs truncate" title="' +
            escapeHtml(item.path) +
            '">' +
            escapeHtml(item.path) +
            "</td>" +
            '<td class="py-2 px-2.5 whitespace-nowrap"><span class="country-tag px-1.5 py-0.5 rounded-xs bg-[var(--color-bg-primary)] border border-[var(--color-surface-border)] text-[var(--color-text-secondary)] font-bold text-[10px]" data-country="' +
            escapeHtml(country) +
            '" title="' +
            escapeHtml(fullName) +
            '">' +
            escapeHtml(country) +
            "</span></td>" +
            '<td class="py-2 px-2.5 text-[var(--color-text-secondary)] max-w-xs truncate">' +
            escapeHtml(ref) +
            "</td>" +
            '<td class="py-2 px-2.5 text-[var(--color-text-dim)]">' +
            campaign +
            "</td>" +
            '<td class="py-2 px-2.5 text-[var(--color-text-muted)] text-[10px]">' +
            escapeHtml(hash) +
            "</td>" +
            "</tr>"
          );
        })
        .join("");

      attachCountryTooltipEvents();
    }

    function renderPanes() {
      // CB
      var cbTbody = document.getElementById("cb-tbody");
