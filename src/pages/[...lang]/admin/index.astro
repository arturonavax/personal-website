        if (!rawIncidents.length) {
          cbTbody.innerHTML =
            '<tr><td colspan="5" class="py-4 text-center text-[var(--color-text-muted)] italic">' +
            (isEs
              ? "Sin incidentes de circuit breaker (100% integridad de datos)"
              : "No circuit breaker incidents (100% data integrity)") +
            "</td></tr>";
