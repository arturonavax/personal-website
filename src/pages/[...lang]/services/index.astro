---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ServiceCard from "@/components/ui/ServiceCard.astro";
import PaginationController from "@/components/ui/PaginationController.astro";
import BackToHomeButton from "@/components/ui/BackToHomeButton.astro";
import type { SupportedLocale } from "@/i18n/config";
import { getVisibleCollection } from "@/utils/visibility";

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { locale: "en" as const } },
    { params: { lang: "es" }, props: { locale: "es" as const } },
  ];
}

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const isEs = locale === "es";
const basePath = isEs ? "/es" : "";

const allServices = await getVisibleCollection(
  "services",
  ({ data }) => data.locale === locale,
);
const sortedServices = allServices.sort((a, b) => a.data.order - b.data.order);

const pageTitle = isEs
  ? "Servicios Técnicos — Arturo Nava"
  : "Technical Services — Arturo Nava";
const pageDescription = isEs
  ? "Asesoría en arquitectura de producción, consultoría de sistemas distribuidos, auditorías de rendimiento, plantillas de código y mentoría Staff."
  : "Production engineering advisory, distributed systems consulting, performance audits, architectural blueprints, and 1-on-1 Staff mentorship.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  canonicalUrl={
    isEs
      ? "https://arturonavax.dev/es/services/"
      : "https://arturonavax.dev/services/"
  }
>
  <div class="mx-auto max-w-5xl px-2 min-[360px]:px-3 sm:px-6 pt-1.5 sm:pt-4 lg:pt-6 pb-12 sm:pb-16 space-y-8 sm:space-y-10">
    <div>
      <BackToHomeButton locale={locale} />
      <header class="border-b border-[var(--color-surface-border)] pb-8">
        <div class="flex items-center gap-2 mb-2 font-mono text-xs text-[var(--color-accent-gold)] uppercase tracking-wider">
          <span class="h-2 w-2 rounded-full bg-[var(--color-accent-status)]"></span>
          <span>
            {isEs
              ? "Disponible para Proyectos de Alto Impacto"
              : "Open for High-Impact Engagements"}
          </span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl">
          {isEs ? "Servicios Técnicos" : "Technical Services"}
        </h1>
        <p class="mt-3 max-w-2xl text-base text-[var(--color-text-secondary)] leading-relaxed">
          {isEs
            ? "Asesoría técnica estratégica, diseño de sistemas distribuidos, auditorías de latencia p99 y plantillas de código probadas en entornos de producción a gran escala."
            : "High-leverage engineering advisory, distributed systems design, backend performance audits, and production-tested codebase blueprints built from real-world high-throughput deployments."}
        </p>
      </header>
    </div>

    {sortedServices.length > 0 ? (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {sortedServices.map((service) => (
          <ServiceCard service={service} locale={locale} />
        ))}
      </div>
    ) : (
      <div class="rounded-lg border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] p-8 text-center font-mono text-xs sm:text-sm text-[var(--color-text-secondary)]">
        {isEs
          ? "No hay servicios de consultoría activos en este momento. Puedes contactarme directamente por los canales oficiales."
          : "No advisory services listed at this moment. Feel free to reach out via direct channels."}
      </div>
    )}

    <!-- Scalable Pagination Controller -->
    {sortedServices.length > 0 && (
      <PaginationController
        locale={locale}
        pageSize={4}
        targetSelector="[data-service-card]"
        totalItems={sortedServices.length}
      />
    )}

    <!-- Custom Inquiries Banner -->
    <div class="rounded-xl border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] p-6 sm:p-8 font-mono text-xs sm:text-sm text-[var(--color-text-secondary)] space-y-3">
      <div class="flex items-center gap-2 text-[var(--color-accent-gold)] font-bold text-sm sm:text-base">
        <span>
          {isEs
            ? "⚡ ¿Requieres una propuesta técnica personalizada?"
            : "⚡ Need a tailored architectural engagement?"}
        </span>
      </div>
      <p class="leading-relaxed">
        {isEs
          ? "Para consultorías empresariales, roles fraccionales de Staff/Principal o auditorías de sistemas bajo acuerdos de confidencialidad (NDA), contáctame directamente."
          : "For enterprise advisory, fractional Staff/Principal roles, or bespoke system audits with custom NDAs, get in touch directly."}
      </p>
      <div class="pt-2">
        <a
          href={`${basePath}/#contact`}
          class="btn-gold inline-flex items-center gap-2 px-4 py-2 font-semibold"
        >
          <span>{isEs ? "Contacto" : "Contact"}</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
