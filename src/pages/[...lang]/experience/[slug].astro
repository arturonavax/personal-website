---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { IndexItem } from "@/components/ui/PageIndexNav.astro";
import SimulationCard from "@/components/ui/SimulationCard.astro";
import TechIcon from "@/components/ui/TechIcon.astro";
import TypewriterTicker from "@/components/ui/TypewriterTicker.astro";
import { getCompanyInfo } from "@/data/companies";
import { getSimulationsForJob } from "@/data/simulations";
import { formatDate, useTranslations } from "@/i18n/utils";
import { DEFAULT_LOCALE, type SupportedLocale } from "@/i18n/config";
import { buildExperienceJsonLd } from "@/lib/seo/schema-builder";
import { buildExperienceMetadata } from "@/lib/seo/experience-metadata";
import { getVisibleCollection } from "@/utils/visibility";

export async function getStaticPaths() {
  const experiences = await getVisibleCollection("experience");
  const slugToLocales = new Map<string, SupportedLocale[]>();
  for (const exp of experiences) {
    const [localePart, ...slugParts] = exp.id.replace(/\.md$/, "").split("/");
    const s = slugParts.join("/");
    const list = slugToLocales.get(s) ?? [];
    list.push(localePart as SupportedLocale);
    slugToLocales.set(s, list);
  }

  return experiences.map((experience) => {
    const [localePart, ...slugParts] = experience.id
      .replace(/\.md$/, "")
      .split("/");
    const slugPart = slugParts.join("/");
    const lang = localePart === DEFAULT_LOCALE ? undefined : localePart;

    return {
      params: {
        lang,
        slug: slugPart,
      },
      props: {
        experience,
        currentLocale: localePart as SupportedLocale,
        availableLocales: slugToLocales.get(slugPart) ?? [
          localePart as SupportedLocale,
        ],
      },
    };
  });
}

const { experience, currentLocale, availableLocales } = Astro.props;
const { Content } = await render(experience);

const {
  company,
  role,
  location,
  employmentType,
  startDate,
  endDate,
  skills,
  keyAchievements,
} = experience.data;

const hasBodyContent = Boolean(
  experience.body && experience.body.trim().length > 0,
);
const isEs = currentLocale === "es";
const basePath = isEs ? "/es" : "";
const [_, ...slugParts] = experience.id.replace(/\.md$/, "").split("/");
const slug = slugParts.join("/");
const simulations = getSimulationsForJob(slug);
const companyInfo = getCompanyInfo(company, {
  industry: experience.data.companyIndustry,
  industryEs: experience.data.companyIndustry,
  description: experience.data.companyDescription,
  descriptionEs: experience.data.companyDescription,
  domain: experience.data.companyDomain,
  url: experience.data.companyUrl,
});
const t = useTranslations(currentLocale);

const startStr = formatDate(startDate, currentLocale);
const endStr = endDate ? formatDate(endDate, currentLocale) : t("meta.present");

// Retrieve all experiences for navigation rail and same-company counts
const allExperiences = await getVisibleCollection(
  "experience",
  ({ data }) => data.locale === currentLocale,
);
// Chronological ordering: Milestone 1 is the earliest job in career (Task 3)
const chronologicalExperiences = [...allExperiences].sort(
  (a, b) => a.data.startDate.getTime() - b.data.startDate.getTime(),
);
const chronoIndex = chronologicalExperiences.findIndex(
  (item) => item.id.replace(/^(en|es)\//, "").replace(/\.md$/, "") === slug,
);
const milestoneNumber = chronoIndex + 1;
const totalMilestones = chronologicalExperiences.length;

// Left arrow: Past (older roles); Right arrow: Future/Present (newer roles) (Task 3)
const pastExperience =
  chronoIndex > 0 ? chronologicalExperiences[chronoIndex - 1] : null;
const futureExperience =
  chronoIndex < chronologicalExperiences.length - 1
    ? chronologicalExperiences[chronoIndex + 1]
    : null;

const pastSlug = pastExperience
  ? pastExperience.id.replace(/^(en|es)\//, "").replace(/\.md$/, "")
  : null;
const futureSlug = futureExperience
  ? futureExperience.id.replace(/^(en|es)\//, "").replace(/\.md$/, "")
  : null;

const pastUrl = pastSlug ? `${basePath}/experience/${pastSlug}/` : null;
const futureUrl = futureSlug ? `${basePath}/experience/${futureSlug}/` : null;

// Multi-role company detection (Task 47)
const sameCompanyExperiences = allExperiences.filter(
  (e) => e.data.company.toLowerCase().trim() === company.toLowerCase().trim(),
);
const companyFilterUrl = `${basePath}/experience/?company=${encodeURIComponent(company.toLowerCase().trim())}`;

const { title: pageTitle, description: pageDescription } =
  buildExperienceMetadata({
    role,
    company,
    locale: currentLocale,
    endDate,
    hasSimulations: simulations.length > 0,
  });

const canonicalUrl = isEs
  ? `https://arturonavax.dev/es/experience/${slug}/`
  : `https://arturonavax.dev/experience/${slug}/`;

const jsonLd = buildExperienceJsonLd({
  locale: currentLocale,
  canonicalUrl,
  role,
  company,
  companyUrl: experience.data.companyUrl,
  description: pageDescription,
  startDate: startDate.toISOString(),
  endDate: endDate ? endDate.toISOString() : undefined,
  skills,
});

// Section navigation index for this job page (Task 51)
const jobIndexItems: IndexItem[] = [
  {
    id: "role-header",
    label: `${role}`,
    labelEs: `${role}`,
  },
  {
    id: "role-overview",
    label: "Overview & Profile",
    labelEs: "Resumen & Perfil",
  },
  {
    id: "achievements",
    label: "Key Achievements",
    labelEs: "Hitos Clave",
  },
  ...(simulations.length > 0
    ? [
        {
          id: "simulations",
          label: `Architecture Case Studies (${simulations.length})`,
          labelEs: `Casos de Estudio (${simulations.length})`,
        },
      ]
    : []),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  locale={currentLocale}
  type="article"
  translationKey={experience.data.translationKey}
  collectionName="experience"
  availableLocales={availableLocales}
  jsonLd={jsonLd}
>
  <!-- Page Navigation Index for Job Page (Task 2 & 51) -->
  {jobIndexItems && jobIndexItems.length > 0 && (
    <script
      type="application/json"
      id="page-index-custom-items"
      set:html={JSON.stringify(jobIndexItems)}
    />
  )}

  <!-- Sticky Experience Context Header (REQ-UXE-16) -->
  <div
    id="sticky-experience-header"
    class="fixed top-14 inset-x-0 z-40 pointer-events-none opacity-0 -translate-y-2 transition-all duration-300 border-b border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]/90 backdrop-blur-md py-2 px-4 shadow-sm"
    aria-hidden="true"
  >
    <div class="mx-auto max-w-4xl px-2 min-[360px]:px-4 flex items-center justify-between gap-4 font-mono text-xs">
      <div class="flex items-center gap-2 truncate">
        <span class="font-bold text-[var(--color-text-primary)] truncate">
          {role}
        </span>
        <span class="text-[var(--color-text-muted)]">@</span>
        <span class="text-[var(--color-accent-gold)] truncate">{company}</span>
      </div>
      <a
        href={`${basePath}/experience/`}
        class="pointer-events-auto inline-flex items-center gap-1 text-[var(--color-text-muted)] hover:text-[var(--color-accent-gold)] transition-colors shrink-0"
      >
        <span>&larr;</span>
        <span>{isEs ? "Trayectoria" : "Timeline"}</span>
      </a>
    </div>
  </div>

  <!-- Top Milestone Bar (Decoupled, never slides, REQ-UXE-08) -->
  <div class="mx-auto max-w-4xl px-2 min-[360px]:px-4 pt-1 sm:pt-2 lg:pt-3 pb-0">
    <div
      id="experience-milestone-bar"
      class="flex items-center justify-between gap-x-4 min-h-[1.75rem] h-[1.75rem] text-xs font-mono"
    >
      <a
        href={`${basePath}/experience/`}
        class="inline-flex items-center gap-1.5 text-[var(--color-accent-gold)] hover:underline transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)] py-0.5 truncate"
      >
        &larr;{" "}
        {isEs
          ? "Volver a la línea de tiempo de experiencia"
          : "Back to experience timeline"}
      </a>

      <div class="flex items-center gap-2.5 text-[var(--color-text-muted)] shrink-0">
        <span>
          {isEs
            ? `Hito ${milestoneNumber} de ${totalMilestones} en trayectoria`
            : `Timeline milestone ${milestoneNumber} of ${totalMilestones}`}
        </span>
      </div>
    </div>
  </div>

  <article
    id="experience-article"
    class="mx-auto max-w-5xl px-2 min-[360px]:px-4 pt-1 sm:pt-1.5 lg:pt-2 pb-8 sm:pb-12"
  >
    <div
      id="experience-article-content"
      class="space-y-4 sm:space-y-6 lg:space-y-8"
    >
      <!-- Timeline Rail Container with Horizontal Line & Travel Navigation Steppers (Task 3 & 53) -->
      <div
        class="relative isolate py-0 mt-1 sm:mt-1.5 mb-2 sm:mb-4"
        id="timeline-rail-container"
      >
        <!-- Horizontal Timeline Axis Line aligned behind header title row to prevent vertical jumping -->
        <div class="absolute top-[5rem] sm:top-[6rem] -left-6 -right-6 sm:-left-12 sm:-right-12 -translate-y-1/2 h-0.5 bg-[var(--color-surface-border)] pointer-events-none -z-10">
          <div class="absolute inset-0 bg-gradient-to-r from-transparent via-[var(--color-accent-gold)]/50 to-transparent"></div>
          <svg
            class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-1/2 h-3 w-3 text-[var(--color-accent-gold)] shrink-0 aspect-square"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <circle
              cx="6"
              cy="6"
              r="4.5"
              fill="var(--color-surface-card)"
              stroke="currentColor"
              stroke-width="1.5"
            />
          </svg>
          <svg
            class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/2 h-3 w-3 text-[var(--color-accent-gold)] shrink-0 aspect-square"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <circle
              cx="6"
              cy="6"
              r="4.5"
              fill="var(--color-surface-card)"
              stroke="currentColor"
              stroke-width="1.5"
            />
          </svg>
        </div>

        <!-- Role Header Card -->
        <header
          id="role-header"
          class="geometric-box relative z-10 rounded-lg p-6 sm:p-8 space-y-6 bg-[var(--color-surface-card)] shadow-card"
        >
          <div class="space-y-3 border-b border-[var(--color-surface-border-subtle)] pb-6">
            <div class="flex items-center justify-between gap-3 text-xs font-mono text-[var(--color-text-muted)] min-h-[2rem]">
              <span class="inline-flex items-center gap-2 rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-[var(--color-accent-gold)] shrink-0">
                <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent-status)]"></span>
                <span>{employmentType}</span>
              </span>
              <span class="truncate">
                {startStr} - {endStr} &bull; {location}
              </span>
            </div>

            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-[var(--color-text-primary)] min-h-[2.5rem] sm:min-h-[3rem] lg:min-h-[3.25rem] flex items-start">
              {role}
            </h1>

            <!-- Company Details & External Link -->
            <div class="flex flex-wrap items-center gap-3 pt-1">
              <div class="flex items-center gap-2 font-mono text-sm">
                <a
                  href={companyFilterUrl}
                  rel="nofollow"
                  data-company-filter={company.toLowerCase().trim()}
                  title={`${isEs ? "Filtrar trayectoria para" : "Filter career timeline for"} ${companyInfo.name}`}
                  class="font-bold text-[var(--color-accent-gold)] hover:underline"
                >
                  @{companyInfo.name}
                </a>
                <span class="text-xs text-[var(--color-text-muted)]">
                  &bull;{" "}
                  {isEs
                    ? companyInfo.industryEs || companyInfo.industry
                    : companyInfo.industry}
                </span>
              </div>

              <a
                href={companyInfo.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded border border-[var(--color-accent-gold)]/50 bg-[var(--color-accent-gold-subtle)] px-2.5 py-1 text-xs font-mono font-semibold text-[var(--color-accent-gold)] hover:bg-[var(--color-accent-gold)] hover:text-[var(--color-btn-gold-text)] transition-colors"
              >
                <span>
                  {isEs ? "Visitar " : "Visit "}
                  {companyInfo.domain}
                </span>
                <svg
                  class="h-3 w-3 stroke-current fill-none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                >
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </a>

              {sameCompanyExperiences.length > 1 && (
                <a
                  href={companyFilterUrl}
                  title={
                    isEs
                      ? `Filtrar trayectoria para los ${sameCompanyExperiences.length} puestos en ${company}`
                      : `Filter timeline for all ${sameCompanyExperiences.length} roles at ${company}`
                  }
                  class="inline-flex items-center gap-1.5 rounded border border-[var(--color-accent-gold)]/40 bg-[var(--color-accent-gold-subtle)] px-2.5 py-1 font-mono text-xs text-[var(--color-accent-gold)] hover:bg-[var(--color-accent-gold)] hover:text-[var(--color-btn-gold-text)] transition-all group/same-co shadow-xs"
                >
                  <span class="flex h-1.5 w-1.5 rounded-full bg-[var(--color-accent-gold)] group-hover/same-co:bg-[var(--color-btn-gold-text)] animate-pulse"></span>
                  <span>
                    {isEs
                      ? `${sameCompanyExperiences.length} puestos desempeñados en ${company}`
                      : `${sameCompanyExperiences.length} positions held at ${company}`}
                  </span>
                  <span class="transition-transform group-hover/same-co:translate-x-0.5">
                    &rarr;
                  </span>
                </a>
              )}
            </div>
          </div>

          <!-- Skills Used in this Role -->
          <div class="space-y-2">
            <div class="text-xs font-mono text-[var(--color-text-muted)] uppercase tracking-wider flex items-center justify-between">
              <span>
                {isEs
                  ? "Tecnologías e Infraestructura Clave"
                  : "Core Technologies & Infrastructure"}
              </span>
              <span class="text-[10px] text-[var(--color-text-muted)] lowercase">
                {isEs ? "clic para buscar" : "click to search"}
              </span>
            </div>
            <div class="flex flex-wrap gap-1.5 font-mono text-xs">
              {skills.map((skill) => (
                <button
                  type="button"
                  data-tech-search={skill}
                  title={
                    isEs
                      ? `Buscar proyectos y notas sobre ${skill}`
                      : `Search projects & posts mentioning ${skill}`
                  }
                  class="inline-flex items-center gap-1.5 rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-xs text-[var(--color-text-secondary)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
                >
                  <TechIcon
                    name={skill}
                    class="h-3.5 w-3.5 text-[var(--color-accent-gold)]"
                  />
                  <span>{skill}</span>
                </button>
              ))}
            </div>
          </div>
        </header>

        <!-- Left Stepper (Past: older roles towards beginning of career) placed AFTER header with z-50 -->
        {pastUrl && pastExperience && (
          <a
            href={pastUrl}
            data-timeline-nav="past"
            data-astro-prefetch="hover"
            title={`${isEs ? "Hito anterior:" : "Past timeline milestone:"} ${pastExperience.data.role} @ ${pastExperience.data.company}`}
            class="group/timeline-nav absolute left-0 top-[5rem] sm:top-[6rem] -translate-x-1/2 -translate-y-1/2 z-50 flex h-9 w-9 sm:h-11 sm:w-11 shrink-0 aspect-square items-center justify-center rounded-full border-2 border-[var(--color-accent-gold)] bg-[var(--color-surface-card)] text-[var(--color-accent-gold)] shadow-2xl hover:scale-110 hover:bg-[var(--color-accent-gold)] hover:text-[var(--color-btn-gold-text)] transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent-gold)]"
            aria-label={`${isEs ? "Rol anterior:" : "Past role:"} ${pastExperience.data.role} (press h)`}
          >
            <kbd class="hidden md:inline-flex pointer-events-none absolute -top-3.5 left-1/2 -translate-x-1/2 items-center justify-center rounded border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] px-1.5 py-0.2 text-[10px] font-mono font-medium text-[var(--color-text-secondary)] shadow-sm group-hover/timeline-nav:border-[var(--color-accent-gold)] group-hover/timeline-nav:text-[var(--color-accent-gold)] transition-colors">
              h
            </kbd>
            <svg
              class="h-4 w-4 sm:h-5 sm:w-5 stroke-current fill-none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span class="pointer-events-none opacity-0 group-hover/timeline-nav:opacity-100 transition-opacity absolute bottom-full mb-5.5 left-0 whitespace-nowrap rounded border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] px-2.5 py-1 text-[11px] font-mono font-medium text-[var(--color-accent-gold)] shadow-xl z-40">
              &larr; {pastExperience.data.company}
            </span>
          </a>
        )}

        <!-- Right Stepper (Future/Present: newer roles towards current career) placed AFTER header with z-50 -->
        {futureUrl && futureExperience && (
          <a
            href={futureUrl}
            data-timeline-nav="future"
            data-astro-prefetch="hover"
            title={`${isEs ? "Siguiente hito:" : "Future timeline milestone:"} ${futureExperience.data.role} @ ${futureExperience.data.company}`}
            class="group/timeline-nav absolute right-0 top-[5rem] sm:top-[6rem] translate-x-1/2 -translate-y-1/2 z-50 flex h-9 w-9 sm:h-11 sm:w-11 shrink-0 aspect-square items-center justify-center rounded-full border-2 border-[var(--color-accent-gold)] bg-[var(--color-surface-card)] text-[var(--color-accent-gold)] shadow-2xl hover:scale-110 hover:bg-[var(--color-accent-gold)] hover:text-[var(--color-btn-gold-text)] transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent-gold)]"
            aria-label={`${isEs ? "Siguiente rol:" : "Future role:"} ${futureExperience.data.role} (press l)`}
          >
            <kbd class="hidden md:inline-flex pointer-events-none absolute -top-3.5 left-1/2 -translate-x-1/2 items-center justify-center rounded border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] px-1.5 py-0.2 text-[10px] font-mono font-medium text-[var(--color-text-secondary)] shadow-sm group-hover/timeline-nav:border-[var(--color-accent-gold)] group-hover/timeline-nav:text-[var(--color-accent-gold)] transition-colors">
              l
            </kbd>
            <svg
              class="h-4 w-4 sm:h-5 sm:w-5 stroke-current fill-none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
            <span class="pointer-events-none opacity-0 group-hover/timeline-nav:opacity-100 transition-opacity absolute bottom-full mb-5.5 right-0 whitespace-nowrap rounded border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] px-2.5 py-1 text-[11px] font-mono font-medium text-[var(--color-accent-gold)] shadow-xl z-40">
              {futureExperience.data.company} &rarr;
            </span>
          </a>
        )}
      </div>

      <!-- Overview Section -->
      <section
        id="role-overview"
        class="space-y-4 text-base sm:text-lg text-[var(--color-text-secondary)] leading-relaxed border-b border-[var(--color-surface-border)] pb-8 matrix-readability-blur rounded-xl p-5 sm:p-7 border border-[var(--color-surface-border-subtle)]/50 shadow-sm"
      >
        <h2 class="text-lg font-bold font-mono text-[var(--color-text-primary)] uppercase tracking-wider">
          {isEs
            ? "Resumen del Rol & Perfil Corporativo"
            : "Role Overview & Company Profile"}
        </h2>
        <div class="rounded-lg border border-[var(--color-surface-border-subtle)] bg-[var(--color-bg-primary)]/40 p-4 sm:p-5 font-mono text-xs sm:text-sm space-y-2">
          <div class="flex items-center gap-2 text-[var(--color-accent-gold)] font-bold">
            <svg
              class="h-4 w-4 stroke-current fill-none shrink-0"
              viewBox="0 0 24 24"
              stroke-width="2"
            >
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
            <span>
              {companyInfo.name} &bull;{" "}
              {isEs
                ? companyInfo.industryEs || companyInfo.industry
                : companyInfo.industry}
            </span>
          </div>
          <p class="text-[var(--color-text-secondary)] font-sans leading-relaxed">
            {isEs
              ? companyInfo.descriptionEs || companyInfo.description
              : companyInfo.description}
          </p>
        </div>
        {hasBodyContent ? (
          <div class="mt-4 [&>p]:leading-8">
            <Content />
          </div>
        ) : (
          <div class="mt-4 p-4 sm:p-5 rounded-lg border border-dashed border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]/50 flex items-center gap-3 font-mono text-xs sm:text-sm text-[var(--color-text-secondary)]">
            <span class="h-2 w-2 rounded-full bg-[var(--color-accent-gold)] animate-pulse shrink-0"></span>
            <TypewriterTicker
              phrases={
                isEs
                  ? [
                      `Escribiendo la historia en ${company}...`,
                      "Diseñando arquitecturas distribuidas de alta concurrencia...",
                      "Consolidando nuevos hitos de ingeniería...",
                    ]
                  : [
                      `Writing history at ${company}...`,
                      "Engineering high-concurrency distributed architectures...",
                      "Establishing new engineering milestones...",
                    ]
              }
              class="text-xs sm:text-sm text-[var(--color-text-secondary)]"
            />
          </div>
        )}
      </section>

      <!-- Key Architectural Achievements -->
      <section
        id="achievements"
        class="space-y-5 border-b border-[var(--color-surface-border)] pb-8 matrix-readability-blur rounded-xl p-5 sm:p-7 border border-[var(--color-surface-border-subtle)]/50 shadow-sm"
      >
        <h2 class="text-xl font-bold tracking-tight text-[var(--color-text-primary)]">
          {isEs
            ? "Principales Hitos de Ingeniería y Arquitectura"
            : "Key Architectural & Engineering Achievements"}
        </h2>
        {keyAchievements.length > 0 ? (
          <ul class="space-y-3.5 text-sm sm:text-base text-[var(--color-text-secondary)] leading-relaxed">
            {keyAchievements.map((achievement) => (
              <li class="flex items-start gap-3">
                <span class="text-[var(--color-accent-gold)] font-bold text-sm select-none shrink-0 mt-0.5">
                  &bull;
                </span>
                <span>{achievement}</span>
              </li>
            ))}
          </ul>
        ) : (
          <div class="p-4 sm:p-5 rounded-lg border border-dashed border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]/50 flex items-center gap-3 font-mono text-xs sm:text-sm text-[var(--color-text-secondary)]">
            <span class="h-2 w-2 rounded-full bg-[var(--color-accent-gold)] animate-pulse shrink-0"></span>
            <TypewriterTicker
              phrases={
                isEs
                  ? [
                      `Escribiendo la historia en ${company}...`,
                      "Diseñando arquitecturas distribuidas de alta concurrencia...",
                      "Consolidando nuevos hitos de ingeniería...",
                    ]
                  : [
                      `Writing history at ${company}...`,
                      "Engineering high-concurrency distributed architectures...",
                      "Establishing new engineering milestones...",
                    ]
              }
              class="text-xs sm:text-sm text-[var(--color-text-secondary)]"
            />
          </div>
        )}

        {!endDate && (
          <div class="mt-6 pt-4 border-t border-[var(--color-surface-border-subtle)] flex flex-wrap items-center justify-between gap-3 font-mono text-xs">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 rounded border border-[var(--color-accent-gold)]/50 bg-[var(--color-accent-gold-subtle)] px-2.5 py-1 text-xs font-semibold text-[var(--color-accent-gold)] uppercase tracking-wider">
                <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent-gold)] animate-pulse"></span>
                <span>
                  {isEs
                    ? "[ LIVE BROADCAST // EN EMISIÓN ]"
                    : "[ LIVE BROADCAST // CURRENT ROLE ]"}
                </span>
              </span>
            </div>
            <TypewriterTicker
              phrases={
                isEs
                  ? [
                      `Escribiendo la historia en ${company}...`,
                      "Construyendo la historia...",
                      "Consolidando nuevos hitos de ingeniería...",
                      "Creando impacto...",
                    ]
                  : [
                      `Writing history at ${company}...`,
                      "Building history...",
                      "Establishing new engineering milestones...",
                      "Creating impact...",
                    ]
              }
              class="text-xs sm:text-sm"
            />
          </div>
        )}
      </section>

      <!-- Interactive Architecture Simulations -->
      {simulations.length > 0 && (
        <section
          id="simulations"
          class="space-y-6 matrix-readability-blur rounded-xl p-5 sm:p-7 border border-[var(--color-surface-border-subtle)]/50 shadow-sm"
        >
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[var(--color-surface-border)] pb-4">
            <div>
              <div class="inline-flex items-center gap-2 text-xs font-mono text-[var(--color-accent-gold)] uppercase tracking-wider mb-1">
                <span class="flex h-2 w-2 rounded-full bg-[var(--color-accent-gold)] animate-pulse"></span>
                <span>
                  {isEs
                    ? "Casos de Estudio de Arquitectura"
                    : "Interactive Architecture Case Studies"}
                </span>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--color-text-primary)]">
                {isEs
                  ? "Cargas de Trabajo Reales y Benchmarks en Producción"
                  : "Production System Workloads & Benchmarks"}
              </h2>
            </div>

            <span class="inline-flex items-center rounded border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] px-3 py-1 font-mono text-xs text-[var(--color-text-secondary)] shrink-0">
              {simulations.length}{" "}
              {simulations.length === 1
                ? isEs
                  ? "caso de estudio disponible"
                  : "case study available"
                : isEs
                  ? "casos de estudio disponibles"
                  : "case studies available"}
            </span>
          </div>

          <p class="text-xs sm:text-sm text-[var(--color-text-secondary)] leading-relaxed">
            {isEs
              ? "Los siguientes casos de estudio interactivos representan las arquitecturas reales diseñadas durante este periodo. Ejecuta cada caso de estudio para inspeccionar las fases orquestadas del pipeline, visualizar la telemetría en vivo y verificar el impacto medido antes y después de la solución."
              : "The interactive case studies below demonstrate the production architectures implemented during this engagement. Run each case study to inspect the orchestrated pipeline phases, view live stdout telemetry, and verify the measured before-and-after performance impact."}
          </p>

          <div class="space-y-8">
            {simulations.map((sim) => (
              <SimulationCard simulation={sim} locale={currentLocale} />
            ))}
          </div>
        </section>
      )}

      <!-- Bottom Navigation -->
      <div class="pt-4 flex items-center justify-between font-mono text-xs matrix-readability-blur rounded-lg p-3 sm:p-4 border border-[var(--color-surface-border-subtle)]/50">
        <a
          href={`${basePath}/experience/`}
          class="inline-flex items-center gap-1.5 text-[var(--color-accent-gold)] hover:underline py-2 px-3 -mx-2 -my-1 rounded hover:bg-[var(--color-surface-card)] transition-colors"
        >
          &larr;{" "}
          {isEs
            ? "Ver todo el historial de experiencia"
            : "View all experience records"}
        </a>
        <a
          href={`${basePath}/#contact`}
          data-contact-scroll
          class="inline-flex items-center gap-1.5 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-gold)] py-2 px-3 -mx-2 -my-1 rounded hover:bg-[var(--color-surface-card)] transition-colors"
        >
          {isEs
            ? "Discutir proyectos de arquitectura →"
            : "Discuss architecture opportunities →"}
        </a>
      </div>
    </div>
  </article>

  <!-- SPEC-007 REQ-5: expose the ClientRouter navigate() to the inline engine so every
       full-navigation fallback stays inside the SPA (keeps transition:persist Matrix alive). -->
  <script>
    import { navigate } from "astro:transitions/client";

    type RouterWindow = Window & { __astroNavigate?: (url: string) => void };
    (window as RouterWindow).__astroNavigate = (url: string): void => {
      void navigate(url);
    };
  </script>
  <!-- Keyboard Shortcuts & Touch Gestures Engine -->
  <script>
    // @ts-nocheck
    (function () {
      var isTransitioning = false;
      var cache = {};
      var currentJobPath = location.pathname.replace(/\/+$/, "");

      function routerNavigate(url) {
        if (typeof window.__astroNavigate === "function") {
          window.__astroNavigate(url);
        } else {
          window.location.assign(url);
        }
      }

      function prefetchUrl(url) {
        if (!url || cache[url]) return;
        fetch(url, { priority: "low", headers: { "X-Astro-Prefetch": "true" } })
          .then(function (res) {
            if (res.ok) return res.text();
            throw new Error("Failed to prefetch");
          })
          .then(function (html) {
            cache[url] = html;
          })
          .catch(function () {});
      }

      function navigateTo(url, dir, isPop) {
        if (isTransitioning || !url) return;
        var article = document.getElementById("experience-article");
        if (!article) {
          routerNavigate(url);
          return;
        }

        isTransitioning = true;

        if (typeof window.__showBeacon === "function") {
          window.__showBeacon(undefined, true);
        }

        var htmlPromise = cache[url]
          ? Promise.resolve(cache[url])
          : fetch(url)
              .then(function (res) {
                if (!res.ok) throw new Error("HTTP " + res.status);
                return res.text();
              })
              .then(function (text) {
                cache[url] = text;
                return text;
              });

        var isMobile = typeof window !== "undefined" && window.innerWidth < 640;
        var isFuture = dir === "future" || dir === 1;
        var exitDistance = isMobile
          ? isFuture
            ? "-16px"
            : "16px"
          : isFuture
            ? "-36px"
            : "36px";
        var enterDistance = isMobile
          ? isFuture
            ? "16px"
            : "-16px"
          : isFuture
            ? "36px"
            : "-36px";

        var animTarget =
          document.getElementById("experience-article-content") || article;
        animTarget.style.willChange = "transform, opacity";
        animTarget.style.transition =
          "transform 0.13s cubic-bezier(0.4, 0, 1, 1), opacity 0.13s cubic-bezier(0.4, 0, 1, 1)";
        animTarget.style.transform = "translate3d(" + exitDistance + ", 0, 0)";
        animTarget.style.opacity = "0";

        var timerPromise = new Promise(function (resolve) {
          setTimeout(resolve, 130);
        });

        Promise.all([htmlPromise, timerPromise])
          .then(function (results) {
            var html = results[0];
            var parser = new DOMParser();
            var doc = parser.parseFromString(html, "text/html");
            var newArticle = doc.getElementById("experience-article");

            if (!newArticle) {
              routerNavigate(url);
              return;
            }

            if (doc.title && document.title !== doc.title) {
              document.title = doc.title;
            }
            if (!isPop) {
              history.pushState(
                Object.assign({}, history.state || {}, { url: url }),
                "",
                url,
              );
            }
            try {
              currentJobPath = new URL(url, location.origin).pathname.replace(
                /\/+$/,
                "",
              );
            } catch (_) {
              currentJobPath = location.pathname.replace(/\/+$/, "");
            }

            var oldLangLinks = document.querySelectorAll("a[hreflang]");
            var newLangLinks = doc.querySelectorAll("a[hreflang]");
            if (oldLangLinks.length && newLangLinks.length) {
              oldLangLinks.forEach(function (oldLink, idx) {
                if (newLangLinks[idx]) {
                  oldLink.href = newLangLinks[idx].href;
                }
              });
            }

            // Synchronize language suggestion toast with the new page counterpart URL
            try {
              var isDocEs = document.documentElement.lang === "es";
              var altLink = doc.querySelector(
                'link[rel="alternate"][hreflang="' +
                  (isDocEs ? "en" : "es") +
                  '"]',
              );
              var banner = document.getElementById("lang-suggestion-banner");
              var acceptBtn = document.getElementById("lang-suggestion-accept");
              if (altLink && banner && acceptBtn) {
                var newHref = altLink.getAttribute("href");
                if (newHref) {
                  acceptBtn.setAttribute("href", newHref);
                  banner.setAttribute("data-target-url", newHref);
                }
              }
            } catch (_) {}

            // Synchronize page-index custom items script for the new page without default items flicker
            var oldCustomScript = document.getElementById(
              "page-index-custom-items",
            );
            var newCustomScript = doc.getElementById("page-index-custom-items");
            if (newCustomScript) {
              if (oldCustomScript) {
                oldCustomScript.textContent = newCustomScript.textContent;
              } else {
                var mainEl =
                  document.getElementById("main-content") ||
                  document.querySelector("main") ||
                  document.body;
                mainEl.appendChild(newCustomScript.cloneNode(true));
              }
            } else if (oldCustomScript) {
              oldCustomScript.remove();
            }

            // Update decoupled milestone bar without sliding
            var oldMilestone = document.getElementById(
              "experience-milestone-bar",
            );
            var newMilestone = doc.getElementById("experience-milestone-bar");
            if (oldMilestone && newMilestone) {
              oldMilestone.innerHTML = newMilestone.innerHTML;
            }

            // Update sticky header
            var oldSticky = document.getElementById("sticky-experience-header");
            var newSticky = doc.getElementById("sticky-experience-header");
            if (oldSticky && newSticky) {
              oldSticky.innerHTML = newSticky.innerHTML;
            }

            article.innerHTML = newArticle.innerHTML;
            article.className = newArticle.className;

            if (typeof window.__setupPageIndex === "function") {
              window.__setupPageIndex();
            }

            if (window.scrollY > 140) {
              window.scrollTo({ top: 0, behavior: "instant" });
            }

            var nextAnimTarget =
              document.getElementById("experience-article-content") || article;
            nextAnimTarget.style.transition = "none";
            nextAnimTarget.style.transform =
              "translate3d(" + enterDistance + ", 0, 0)";
            nextAnimTarget.style.opacity = "0";

            requestAnimationFrame(function () {
              nextAnimTarget.style.transition =
                "transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1)";
              nextAnimTarget.style.transform = "translate3d(0, 0, 0)";
              nextAnimTarget.style.opacity = "1";
            });

            setTimeout(function () {
              nextAnimTarget.style.transform = "";
              nextAnimTarget.style.opacity = "";
              nextAnimTarget.style.transition = "";
              nextAnimTarget.style.willChange = "";
              isTransitioning = false;
              if (typeof window.__hideBeacon === "function") {
                window.__hideBeacon();
              }
            }, 240);

            setupTimelineNav();
            if (typeof window.__initSimulationCards === "function") {
              window.__initSimulationCards();
            }
            if (typeof window.__setupPageIndex === "function") {
              window.__setupPageIndex();
            }
            // Notify only after the cached route and its controls are committed.
            document.dispatchEvent(new Event("site:route-committed"));
          })
          .catch(function () {
            if (typeof window.__hideBeacon === "function") {
              window.__hideBeacon();
            }
            routerNavigate(url);
          });
      }

      function setupTimelineNav() {
        var pastLink = document.querySelector('[data-timeline-nav="past"]');
        var futureLink = document.querySelector('[data-timeline-nav="future"]');

        if (pastLink) prefetchUrl(pastLink.href);
        if (futureLink) prefetchUrl(futureLink.href);

        var links = document.querySelectorAll("[data-timeline-nav]");
        links.forEach(function (link) {
          if (link.dataset.bound) return;
          link.dataset.bound = "true";

          link.addEventListener("click", function (e) {
            e.preventDefault();
            var dir = link.getAttribute("data-timeline-nav");
            navigateTo(link.href, dir);
          });
        });

        if (!window.__timelineNavKeyBound) {
          window.__timelineNavKeyBound = true;
          document.addEventListener("keydown", function (e) {
            var active = document.activeElement;
            var tag =
              active && active.tagName ? active.tagName.toLowerCase() : "";
            if (
              tag === "input" ||
              tag === "textarea" ||
              tag === "select" ||
              (active && active.isContentEditable)
            )
              return;
            var modalOpen = document.querySelector(
              'dialog[open], [role="dialog"]:not(.hidden)',
            );
            if (modalOpen) return;

            var isLeft =
              (e.key === "ArrowLeft" || e.key === "h" || e.key === "H") &&
              !e.ctrlKey &&
              !e.metaKey &&
              !e.altKey;
            var isRight =
              (e.key === "ArrowRight" || e.key === "l" || e.key === "L") &&
              !e.ctrlKey &&
              !e.metaKey &&
              !e.altKey;

            if (isLeft) {
              var p = document.querySelector('[data-timeline-nav="past"]');
              if (p) {
                e.preventDefault();
                navigateTo(p.href, "past");
              }
            } else if (isRight) {
              var f = document.querySelector('[data-timeline-nav="future"]');
              if (f) {
                e.preventDefault();
                navigateTo(f.href, "future");
              }
            }
          });

          window.addEventListener("popstate", function () {
            var newPath = location.pathname.replace(/\/+$/, "");
            if (
              newPath !== currentJobPath &&
              newPath.includes("/experience/")
            ) {
              currentJobPath = newPath;
              navigateTo(location.href, "past", true);
            }
          });

          document.addEventListener("astro:after-swap", function () {
            currentJobPath = location.pathname.replace(/\/+$/, "");
          });
        }

        if (!window.__timelineNavTouchBound) {
          window.__timelineNavTouchBound = true;

          var touchStartX = 0;
          var touchStartY = 0;
          var touchStartTime = 0;
          var isTouchActive = false;

          var MIN_SWIPE_DISTANCE_PX = 95;
          var MAX_VERTICAL_DEVIATION_PX = 45;
          var HORIZONTAL_DOMINANCE_RATIO = 2.8;
          var MIN_TIME_MS = 80;
          var MAX_TIME_MS = 400;
          var EDGE_GUTTER_PX = 28;

          document.addEventListener(
            "touchstart",
            function (e) {
              if (e.touches.length !== 1) {
                isTouchActive = false;
                return;
              }

              var t = e.touches[0];
              var screenWidth =
                window.innerWidth || document.documentElement.clientWidth;

              if (
                t.clientX < EDGE_GUTTER_PX ||
                t.clientX > screenWidth - EDGE_GUTTER_PX
              ) {
                isTouchActive = false;
                return;
              }

              touchStartX = t.clientX;
              touchStartY = t.clientY;
              touchStartTime = performance.now();
              isTouchActive = true;
            },
            { passive: true },
          );

          document.addEventListener(
            "touchend",
            function (e) {
              if (!isTouchActive || e.changedTouches.length !== 1) {
                isTouchActive = false;
                return;
              }
              isTouchActive = false;

              var target = e.target;
              if (
                target &&
                target.closest(
                  "input, textarea, select, dialog, pre, code, button, a, [data-simulation-card]",
                )
              ) {
                return;
              }

              var modalOpen = document.querySelector(
                'dialog[open], [role="dialog"]:not(.hidden)',
              );
              if (modalOpen) return;

              var t = e.changedTouches[0];
              var deltaX = t.clientX - touchStartX;
              var deltaY = t.clientY - touchStartY;
              var deltaTime = performance.now() - touchStartTime;

              var absX = Math.abs(deltaX);
              var absY = Math.abs(deltaY);

              var isValidSwipe =
                deltaTime >= MIN_TIME_MS &&
                deltaTime <= MAX_TIME_MS &&
                absX >= MIN_SWIPE_DISTANCE_PX &&
                absY <= MAX_VERTICAL_DEVIATION_PX &&
                absX >= absY * HORIZONTAL_DOMINANCE_RATIO;

              if (!isValidSwipe) return;

              if (deltaX < 0) {
                var f = document.querySelector('[data-timeline-nav="future"]');
                if (f && typeof navigateTo === "function")
                  navigateTo(f.href, "future");
              } else {
                var p = document.querySelector('[data-timeline-nav="past"]');
                if (p && typeof navigateTo === "function")
                  navigateTo(p.href, "past");
              }
            },
            { passive: true },
          );

          document.addEventListener(
            "touchcancel",
            function () {
              isTouchActive = false;
            },
            { passive: true },
          );
        }

        var isStickyShown = false;
        function updateStickyHeader() {
          var sticky = document.getElementById("sticky-experience-header");
          var roleHeader = document.getElementById("role-header");
          if (!sticky || !roleHeader) return;
          var rect = roleHeader.getBoundingClientRect();
          var shouldShow = rect.bottom < 56;
          if (shouldShow === isStickyShown) return;
          isStickyShown = shouldShow;

          if (shouldShow) {
            sticky.classList.remove(
              "pointer-events-none",
              "opacity-0",
              "-translate-y-2",
            );
            sticky.classList.add(
              "pointer-events-auto",
              "opacity-100",
              "translate-y-0",
            );
          } else {
            sticky.classList.remove(
              "pointer-events-auto",
              "opacity-100",
              "translate-y-0",
            );
            sticky.classList.add(
              "pointer-events-none",
              "opacity-0",
              "-translate-y-2",
            );
          }
        }

        if (!window.__experienceStickyBound) {
          window.__experienceStickyBound = true;
          window.addEventListener("scroll", updateStickyHeader, {
            passive: true,
          });
        }
        updateStickyHeader();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupTimelineNav);
      } else {
        setupTimelineNav();
      }
      document.addEventListener("astro:page-load", setupTimelineNav);
    })();
  </script>
</BaseLayout>
