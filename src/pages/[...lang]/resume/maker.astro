---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ResumeExportBar from "@/components/ui/ResumeExportBar.astro";
import ResumeAttributionBar from "@/components/ui/ResumeAttributionBar.astro";
import { getCollection } from "astro:content";
import { SUPPORTED_LOCALES, type Locale } from "@/i18n/locales";
import { getResumeData } from "@/data/resume";

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { lang: locale === "en" ? undefined : locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const resumeEntries = await getCollection("resume");
const activeEntry =
  resumeEntries.find((r) => r.data.locale === locale) || resumeEntries[0];
const resumeData = getResumeData(locale);
const initialBody = activeEntry?.body || resumeData.rawMarkdown || "";
const isEs = locale === "es";
---

<BaseLayout
  title={`Resume Maker Studio — ${activeEntry?.data.name || "Arturo Nava"}`}
  description={
    isEs
      ? "Generador interactivo de currículum en markdown con previsualización en tiempo real y herramientas de exportación."
      : "Interactive developer markdown resume generator with real-time preview and export tools."
  }
  locale={locale}
  canonicalUrl={
    isEs
      ? "https://arturonavax.dev/es/resume/maker/"
      : "https://arturonavax.dev/resume/maker/"
  }
  type="profile"
  hideSubtleCoffee={true}
>
  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="no-print mb-6 flex flex-wrap items-center justify-between gap-4 border-b border-[var(--color-surface-border)] pb-4">
      <div>
        <h1 class="font-mono text-xl font-bold tracking-tight text-[var(--color-text-primary)]">
          Resume Studio Maker
        </h1>
        <p class="font-mono text-xs text-[var(--color-text-muted)]">
          {isEs
            ? "Personalización en vivo y pruebas de diseño"
            : "Live customization & layout testing"}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <!-- Phone Number Controls (REQ-UXE-15) -->
        <div class="flex items-center gap-2">
          <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs font-mono text-[var(--color-text-secondary)] select-none">
            <input
              type="checkbox"
              id="phone-toggle"
              class="rounded border-[var(--color-surface-border)] text-[var(--color-accent-gold)] focus:ring-[var(--color-accent-gold)] cursor-pointer"
            />
            <span>{isEs ? "Incluir Teléfono" : "Include Phone"}</span>
          </label>
          <div id="phone-inputs-container" class="hidden items-center gap-1.5">
            <input
              type="text"
              id="phone-input"
              placeholder="+57 300 000 0000"
              value="+57 300 000 0000"
              aria-label={isEs ? "Número de teléfono" : "Phone number"}
              class="w-44 rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 font-mono text-xs text-[var(--color-text-primary)] focus:border-[var(--color-accent-gold)] focus:outline-none"
            />
          </div>
        </div>

        <!-- Reversible Strip Links Toggle (REQ-UXE-15 & REQ-UXE-29) -->
        <button
          id="strip-links-toggle"
          type="button"
          data-stripped="false"
          class="rounded border border-[var(--color-surface-border)] px-3 py-1.5 font-mono text-xs text-[var(--color-text-secondary)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] cursor-pointer transition-colors"
        >
          <span id="strip-links-label">
            {isEs ? "Eliminar Enlaces" : "Strip Links"}
          </span>
        </button>

        <!-- Reset to Default Action (REQ-UXE-15) -->
        <button
          id="reset-default-action"
          type="button"
          class="rounded border border-[var(--color-surface-border)] px-3 py-1.5 font-mono text-xs text-[var(--color-text-muted)] hover:border-[var(--color-text-primary)] hover:text-[var(--color-text-primary)] cursor-pointer transition-colors"
          title={
            isEs ? "Restaurar contenido original" : "Restore original content"
          }
        >
          {isEs ? "Restaurar Original" : "Reset to Default"}
        </button>

        <!-- Print Action -->
        <button
          id="trigger-print-action"
          type="button"
          class="rounded bg-[var(--color-accent-gold)] px-3.5 py-1.5 font-mono text-xs font-semibold text-[var(--color-btn-gold-text)] shadow-xs hover:bg-[var(--color-accent-gold-hover)] cursor-pointer transition-colors"
        >
          {isEs ? "Imprimir PDF" : "Print PDF"}
        </button>
      </div>
    </header>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <div class="flex flex-col no-print" id="editor-pane-container">
        <div class="mb-2 flex items-center justify-between">
          <label
            for="markdown-raw-input"
            class="font-mono text-xs text-[var(--color-text-muted)]"
          >
            {isEs
              ? "Fuente del Documento Markdown"
              : "Markdown Document Source"}
          </label>
          <button
            type="button"
            id="toggle-editor-collapse-btn"
            aria-label={
              isEs ? "Alternar tamaño del editor" : "Toggle editor height"
            }
            title={isEs ? "Alternar tamaño del editor" : "Toggle editor height"}
            class="inline-flex items-center justify-center p-1 rounded hover:bg-[var(--color-surface-border)] text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors cursor-pointer"
          >
            <svg
              id="editor-collapse-icon"
              class="h-4 w-4 transition-transform duration-200"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
          </button>
        </div>
        <textarea
          id="markdown-raw-input"
          data-initial-markdown={initialBody}
          class="h-[760px] w-full resize-none rounded-lg border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] p-4 font-mono text-xs leading-relaxed text-[var(--color-text-primary)] focus:border-[var(--color-accent-gold)] focus:outline-none transition-[height] duration-200"
          spellcheck="false"
        >{initialBody}</textarea>
      </div>

      <div class="flex flex-col" id="preview-pane-container">
        <div class="mb-2 flex items-center justify-between no-print">
          <span class="font-mono text-xs text-[var(--color-text-muted)]">
            {isEs
              ? "Previsualización Tipográfica en Vivo"
              : "Live Typography Preview"}
          </span>
          <button
            type="button"
            id="toggle-preview-collapse-btn"
            aria-label={
              isEs
                ? "Alternar tamaño de previsualización"
                : "Toggle preview height"
            }
            title={
              isEs
                ? "Alternar tamaño de previsualización"
                : "Toggle preview height"
            }
            class="inline-flex items-center justify-center p-1 rounded hover:bg-[var(--color-surface-border)] text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors cursor-pointer"
          >
            <svg
              id="preview-collapse-icon"
              class="h-4 w-4 transition-transform duration-200"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
          </button>
        </div>
        <div
          id="resume-live-preview"
          class="cv-document resume-document h-[760px] overflow-y-auto rounded-lg border border-[var(--color-surface-border)] bg-white p-6 sm:p-8 md:p-10 shadow-sm text-[#1e293b] transition-[height] duration-200"
        ></div>
      </div>
    </div>

    <!-- Recruiter Attribution & Serializer Exports -->
    <div class="mt-8 border-t border-[var(--color-surface-border)] pt-6 no-print space-y-6">
      <ResumeAttributionBar locale={locale} defaultMedium="maker" />
      <ResumeExportBar currentLocale={locale} />
    </div>
  </main>
</BaseLayout>

<style>
  @media print {
    header,
    .no-print {
      display: none !important;
    }
    #resume-live-preview {
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      margin: 0 !important;
      height: auto !important;
      overflow: visible !important;
      max-width: 100% !important;
      width: 100% !important;
    }
  }
</style>

<script>
  import { marked } from "marked";

  const editor = document.getElementById(
    "markdown-raw-input",
  ) as HTMLTextAreaElement | null;
  const preview = document.getElementById(
    "resume-live-preview",
  ) as HTMLDivElement | null;
  const stripToggle = document.getElementById(
    "strip-links-toggle",
  ) as HTMLButtonElement | null;
  const stripLabel = document.getElementById(
    "strip-links-label",
  ) as HTMLSpanElement | null;
  const resetBtn = document.getElementById(
    "reset-default-action",
  ) as HTMLButtonElement | null;
  const printBtn = document.getElementById(
    "trigger-print-action",
  ) as HTMLButtonElement | null;

  const phoneToggle = document.getElementById(
    "phone-toggle",
  ) as HTMLInputElement | null;
  const phoneContainer = document.getElementById(
    "phone-inputs-container",
  ) as HTMLDivElement | null;
  const phoneInput = document.getElementById(
    "phone-input",
  ) as HTMLInputElement | null;

  const toggleEditorBtn = document.getElementById(
    "toggle-editor-collapse-btn",
  ) as HTMLButtonElement | null;
  const editorCollapseIcon = document.getElementById(
    "editor-collapse-icon",
  ) as SVGElement | null;
  const togglePreviewBtn = document.getElementById(
    "toggle-preview-collapse-btn",
  ) as HTMLButtonElement | null;
  const previewCollapseIcon = document.getElementById(
    "preview-collapse-icon",
  ) as SVGElement | null;

  const isEs = document.documentElement.lang === "es";
  const initialContent = editor ? editor.value : "";
  let unstrippedContent = initialContent;

  function updateLivePreview(): void {
    if (!editor || !preview) return;
    preview.innerHTML = marked.parse(editor.value) as string;
  }

  // Single Phone Input Synchronization (REQ-UXE-22)
  function syncPhoneInEditor(): void {
    if (!editor) return;
    const isEnabled = Boolean(phoneToggle?.checked);
    const rawVal = phoneInput?.value.trim() || "";
    const cleanNum = rawVal;
    const telHref = "tel:" + rawVal.replace(/\s+/g, "");

    // Current lines
    const lines = editor.value.split("\n");
    let updated = false;

    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      if (!line) continue;
      // Find the header contact line (has mailto, linkedin, github, or existing tel)
      if (
        line.includes("mailto:") ||
        line.includes("linkedin.com") ||
        line.includes("github.com") ||
        line.includes("tel:")
      ) {
        // Strip any existing tel item from this line with delimiter
        let cleanLine = line
          .replace(/(?:\s*[•|]\s*)?\[[^\]]+\]\(tel:[^)]+\)/g, "")
          .trim();

        if (isEnabled && rawVal.length > 0) {
          // Append phone with delimiter: keep spaces in label, strip in tel:
          cleanLine = cleanLine + ` • [${cleanNum}](${telHref})`;
        }
        lines[i] = cleanLine;
        updated = true;
        break;
      }
    }

    if (updated) {
      editor.value = lines.join("\n");
      unstrippedContent = editor.value;
      updateLivePreview();
    }
  }

  editor?.addEventListener("input", () => {
    if (stripToggle?.dataset.stripped !== "true") {
      unstrippedContent = editor.value;
    }
    updateLivePreview();
  });
  updateLivePreview();

  // Reversible Strip Links Toggle (REQ-UXE-15 & REQ-UXE-29)
  stripToggle?.addEventListener("click", () => {
    if (!editor) return;
    const isStripped = stripToggle.dataset.stripped === "true";

    if (!isStripped) {
      unstrippedContent = editor.value;
      // Strip markdown links in body sections, strictly preserving header contact links before first ##
      const firstSectionIdx = editor.value.search(/\n(?=##\s)/);
      if (firstSectionIdx !== -1) {
        const headerPart = editor.value.slice(0, firstSectionIdx);
        const bodyPart = editor.value.slice(firstSectionIdx);
        const strippedBody = bodyPart.replace(/\[([^\]]+)\]\([^)]+\)/g, "$1");
        editor.value = headerPart + strippedBody;
      } else {
        editor.value = editor.value.replace(
          /\[([^\]]+)\]\(([^)]+)\)/g,
          (match, text, url) => {
            if (
              url.includes("mailto:") ||
              url.includes("tel:") ||
              url.includes("linkedin.com") ||
              url.includes("github.com")
            ) {
              return match;
            }
            return text;
          },
        );
      }
      stripToggle.dataset.stripped = "true";
      stripToggle.classList.add(
        "border-[var(--color-accent-gold)]",
        "text-[var(--color-accent-gold)]",
        "bg-[var(--color-accent-gold-subtle)]",
      );
      if (stripLabel) {
        stripLabel.textContent = isEs ? "Restaurar Enlaces" : "Restore Links";
      }
    } else {
      editor.value = unstrippedContent;
      stripToggle.dataset.stripped = "false";
      stripToggle.classList.remove(
        "border-[var(--color-accent-gold)]",
        "text-[var(--color-accent-gold)]",
        "bg-[var(--color-accent-gold-subtle)]",
      );
      if (stripLabel) {
        stripLabel.textContent = isEs ? "Eliminar Enlaces" : "Strip Links";
      }
    }
    updateLivePreview();
  });

  // Phone toggle & inputs (REQ-UXE-22)
  phoneToggle?.addEventListener("change", () => {
    if (phoneContainer) {
      phoneContainer.classList.toggle("hidden", !phoneToggle.checked);
      phoneContainer.classList.toggle("flex", phoneToggle.checked);
    }
    syncPhoneInEditor();
  });

  phoneInput?.addEventListener("input", syncPhoneInEditor);

  // Synchronized Bidirectional Scrolling (REQ-UXE-23)
  let isScrollingEditor = false;
  let isScrollingPreview = false;

  editor?.addEventListener(
    "scroll",
    () => {
      if (isScrollingEditor || !preview) return;
      isScrollingPreview = true;
      const editorMax = editor.scrollHeight - editor.clientHeight;
      if (editorMax > 0) {
        const ratio = editor.scrollTop / editorMax;
        preview.scrollTop =
          ratio * (preview.scrollHeight - preview.clientHeight);
      }
      requestAnimationFrame(() => {
        isScrollingPreview = false;
      });
    },
    { passive: true },
  );

  preview?.addEventListener(
    "scroll",
    () => {
      if (isScrollingPreview || !editor) return;
      isScrollingEditor = true;
      const previewMax = preview.scrollHeight - preview.clientHeight;
      if (previewMax > 0) {
        const ratio = preview.scrollTop / previewMax;
        editor.scrollTop = ratio * (editor.scrollHeight - editor.clientHeight);
      }
      requestAnimationFrame(() => {
        isScrollingEditor = false;
      });
    },
    { passive: true },
  );

  // Vertical Pane Collapse/Compact Toggles (REQ-UXE-23)
  let isEditorCompacted = false;
  let isPreviewCompacted = false;

  toggleEditorBtn?.addEventListener("click", () => {
    if (!editor) return;
    isEditorCompacted = !isEditorCompacted;
    if (isEditorCompacted) {
      editor.classList.remove("h-[760px]");
      editor.classList.add("h-[280px]");
      editorCollapseIcon?.classList.add("rotate-180");
    } else {
      editor.classList.remove("h-[280px]");
      editor.classList.add("h-[760px]");
      editorCollapseIcon?.classList.remove("rotate-180");
    }
  });

  togglePreviewBtn?.addEventListener("click", () => {
    if (!preview) return;
    isPreviewCompacted = !isPreviewCompacted;
    if (isPreviewCompacted) {
      preview.classList.remove("h-[760px]");
      preview.classList.add("h-[280px]");
      previewCollapseIcon?.classList.add("rotate-180");
    } else {
      preview.classList.remove("h-[280px]");
      preview.classList.add("h-[760px]");
      previewCollapseIcon?.classList.remove("rotate-180");
    }
  });

  // Reset to Default Action (REQ-UXE-15 & REQ-UXE-22)
  resetBtn?.addEventListener("click", () => {
    if (!editor) return;
    editor.value = initialContent;
    unstrippedContent = initialContent;

    if (phoneToggle) {
      phoneToggle.checked = false;
    }
    if (phoneContainer) {
      phoneContainer.classList.add("hidden");
      phoneContainer.classList.remove("flex");
    }
    if (phoneInput) phoneInput.value = "+57 300 000 0000";

    if (stripToggle) {
      stripToggle.dataset.stripped = "false";
      stripToggle.classList.remove(
        "border-[var(--color-accent-gold)]",
        "text-[var(--color-accent-gold)]",
        "bg-[var(--color-accent-gold-subtle)]",
      );
      if (stripLabel) {
        stripLabel.textContent = isEs ? "Eliminar Enlaces" : "Strip Links";
      }
    }

    updateLivePreview();
  });

  printBtn?.addEventListener("click", () => {
    window.print();
  });

  function prepareMakerPrintLinks() {
    const previewEl = document.getElementById("resume-live-preview");
    if (!previewEl) return;
    const firstH2 = previewEl.querySelector("h2");
    const links = previewEl.querySelectorAll<HTMLAnchorElement>("a[href]");
    links.forEach((link) => {
      const currentHref = link.getAttribute("href") || "";
      const isHeaderContact = firstH2
        ? Boolean(
            firstH2.compareDocumentPosition(link) &
              Node.DOCUMENT_POSITION_PRECEDING,
          )
        : currentHref.startsWith("mailto:") ||
          currentHref.startsWith("tel:") ||
          currentHref.includes("linkedin.com") ||
          currentHref.includes("github.com") ||
          currentHref.includes("arturonavax.dev");

      if (isHeaderContact) {
        return;
      }
      link.setAttribute("data-print-href", currentHref);
      link.removeAttribute("href");
    });
  }

  function restoreMakerPrintLinks() {
    const previewEl = document.getElementById("resume-live-preview");
    if (!previewEl) return;
    const strippedLinks =
      previewEl.querySelectorAll<HTMLAnchorElement>("a[data-print-href]");
    strippedLinks.forEach((link) => {
      const orig = link.getAttribute("data-print-href");
      if (orig) link.setAttribute("href", orig);
      link.removeAttribute("data-print-href");
    });
  }

  window.addEventListener("beforeprint", () => {
    (window as any).__priorDocTitle = document.title;
    const currentLang = document.documentElement.lang || "en";
    document.title = `ArturoNava-CV-${currentLang}`;
    prepareMakerPrintLinks();
  });

  window.addEventListener("afterprint", () => {
    if ((window as any).__priorDocTitle) {
      document.title = (window as any).__priorDocTitle;
    }
    restoreMakerPrintLinks();
  });
</script>
