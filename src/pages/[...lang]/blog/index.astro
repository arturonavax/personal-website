---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/ui/PostCard.astro";
import BlogFilterBar from "@/components/ui/BlogFilterBar.astro";
import PaginationController from "@/components/ui/PaginationController.astro";
import BackToHomeButton from "@/components/ui/BackToHomeButton.astro";
import { useTranslations } from "@/i18n/utils";
import type { SupportedLocale } from "@/i18n/config";
import { getVisibleCollection } from "@/utils/visibility";

export async function getStaticPaths() {
  const posts = await getVisibleCollection("posts");
  if (!posts || posts.length === 0) {
    return [];
  }
  return [
    { params: { lang: undefined }, props: { locale: "en" as const } },
    { params: { lang: "es" }, props: { locale: "es" as const } },
  ];
}

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const isEs = locale === "es";
const t = useTranslations(locale);

const allPosts = await getVisibleCollection(
  "posts",
  ({ data }) => data.locale === locale,
);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

// Categories Taxonomy
const taxonomy = [
  {
    id: "systems",
    label: { en: "Distributed Systems", es: "Sistemas Distribuidos" },
  },
  {
    id: "architecture",
    label: { en: "Architecture & OLAP", es: "Arquitectura & OLAP" },
  },
  {
    id: "performance",
    label: { en: "SIMD & Low-Level", es: "SIMD & Bajo Nivel" },
  },
  { id: "ai", label: { en: "AI Systems", es: "Sistemas de IA" } },
  { id: "research", label: { en: "Research & Labs", es: "Investigación" } },
  {
    id: "leadership",
    label: { en: "Tech Leadership", es: "Liderazgo Técnico" },
  },
  { id: "personal", label: { en: "Personal & Notes", es: "Personal & Notas" } },
];

const categoryCounts: Record<string, number> = {};
taxonomy.forEach((item) => (categoryCounts[item.id] = 0));
allPosts.forEach((post) => {
  const cat = post.data.category || "systems";
  categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
});

const categories = taxonomy.map((item) => ({
  ...item,
  count: categoryCounts[item.id] ?? 0,
}));

// Tag frequency
const tagCounts: Record<string, number> = {};
allPosts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const sortedTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([tag, count]) => ({ tag, count }));
---

<BaseLayout
  title={
    isEs
      ? "Blog & Notas de Sistemas - Arturo Nava"
      : "Blog & Systems Notes - Arturo Nava"
  }
  description={
    isEs
      ? "Publicaciones técnicas, notas de arquitectura, diseño de sistemas distribuidos y reflexiones de ingeniería."
      : "Technical posts, architecture notes, distributed systems design, and engineering reflections."
  }
  locale={locale}
>
  <div class="mx-auto max-w-4xl px-2 min-[360px]:px-4 pt-1 sm:pt-3.5 lg:pt-5 pb-8 sm:pb-12 sm:px-6 space-y-5 sm:space-y-8">
    <div>
      <BackToHomeButton locale={locale} />
      <header class="border-b border-[var(--color-surface-border)] pb-8">
        <h1 class="text-3xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl">
          {t("section.blog")}
        </h1>
        <p class="mt-3 max-w-2xl text-base text-[var(--color-text-secondary)]">
          {isEs
            ? "Análisis técnicos, benchmarks de rendimiento y diseño de sistemas distribuidos desde primeros principios basados en ingeniería real de producción."
            : "Technical analyses, performance benchmarks, and first-principles distributed systems design based on real-world production engineering."}
        </p>
      </header>
    </div>

    <!-- Category & Area Filter Bar -->
    {sortedPosts.length > 0 && (
      <BlogFilterBar
        locale={locale}
        categories={categories}
        tags={sortedTags}
        totalPosts={sortedPosts.length}
      />
    )}

    {sortedPosts.length > 0 ? (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {sortedPosts.map((post) => (
          <PostCard post={post} locale={locale} />
        ))}
      </div>
    ) : (
      <div class="rounded-lg border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] p-8 text-center font-mono text-xs sm:text-sm text-[var(--color-text-secondary)]">
        {isEs
          ? "No hay publicaciones en el blog aún. Vuelve pronto."
          : "No blog posts published yet. Check back soon."}
      </div>
    )}

    <!-- Scalable Pagination Controller -->
    {sortedPosts.length > 0 && (
      <PaginationController
        locale={locale}
        pageSize={6}
        targetSelector="[data-post-card]"
        totalItems={sortedPosts.length}
      />
    )}
  </div>
</BaseLayout>
