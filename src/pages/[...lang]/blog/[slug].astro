---
import { render } from "astro:content";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { DEFAULT_LOCALE, type SupportedLocale } from "@/i18n/config";
import { getVisibleCollection } from "@/utils/visibility";

export async function getStaticPaths() {
  const posts = await getVisibleCollection("posts");

  const slugToLocales = new Map<string, Set<SupportedLocale>>();
  for (const p of posts) {
    const [l, ...sp] = p.id.replace(/\.(md|mdx)$/, "").split("/");
    const s = sp.join("/");
    if (!slugToLocales.has(s)) slugToLocales.set(s, new Set());
    slugToLocales.get(s)!.add(l as SupportedLocale);
  }

  return posts.map((post) => {
    const [localePart, ...slugParts] = post.id
      .replace(/\.(md|mdx)$/, "")
      .split("/");
    const slugPart = slugParts.join("/");
    const lang = localePart === DEFAULT_LOCALE ? undefined : localePart;
    const availableLocales = Array.from(
      slugToLocales.get(slugPart) || [localePart as SupportedLocale],
    );

    return {
      params: {
        lang,
        slug: slugPart,
      },
      props: {
        post,
        currentLocale: localePart as SupportedLocale,
        availableLocales,
      },
    };
  });
}

const { post, currentLocale, availableLocales } = Astro.props;
const { Content } = await render(post);
const isEs = currentLocale === "es";

const siteUrl = "https://arturonavax.dev";
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath.endsWith("/") ? rawPath : `${rawPath}/`;
const canonicalUrl = `${siteUrl}${normalizedPath}`;
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  canonicalUrl={canonicalUrl}
  locale={currentLocale}
  pubDate={post.data.pubDate}
  tags={post.data.tags}
  translationKey={post.data.translationKey}
  collectionName="posts"
  availableLocales={availableLocales}
  backHref={isEs ? "/es/blog/" : "/blog/"}
  backLabel={isEs ? "Volver al blog" : "Back to blog"}
>
  <Content />
</ArticleLayout>
