---
import { render } from "astro:content";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import SeriesPagination from "@/components/blog/SeriesPagination.astro";
import { buildPostNavigation } from "@/lib/content/post-series";
import { DEFAULT_LOCALE, type SupportedLocale } from "@/i18n/config";
import { getVisibleCollection, isItemVisible } from "@/utils/visibility";

export async function getStaticPaths() {
  const posts = await getVisibleCollection("posts");

  const navigation = buildPostNavigation(posts, isItemVisible);

  return posts.map((post) => {
    const [localePart, ...slugParts] = post.id
      .replace(/\.(md|mdx)$/, "")
      .split("/");
    const slugPart = slugParts.join("/");
    const lang = localePart === DEFAULT_LOCALE ? undefined : localePart;
    const postNavigation = navigation.get(post.id)!;

    return {
      params: {
        lang,
        slug: slugPart,
      },
      props: {
        post,
        currentLocale: localePart as SupportedLocale,
        availableLocales: postNavigation.availableLocales,
        series: postNavigation.series,
      },
    };
  });
}

const { post, currentLocale, availableLocales, series } = Astro.props;
const { Content } = await render(post);
const isEs = currentLocale === "es";

const siteUrl = "https://arturonavax.dev";
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath.endsWith("/") ? rawPath : `${rawPath}/`;
const canonicalUrl = `${siteUrl}${normalizedPath}`;
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  canonicalUrl={canonicalUrl}
  locale={currentLocale}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate ?? post.data.updatedAt}
  ogImage={post.data.coverImage?.src}
  tags={post.data.tags}
  translationKey={post.data.translationKey}
  collectionName="posts"
  availableLocales={availableLocales}
  backHref={isEs ? "/es/blog/" : "/blog/"}
  backLabel={isEs ? "Volver al blog" : "Back to blog"}
>
  {series && (
    <SeriesPagination
      navigation={series}
      locale={currentLocale}
      position="start"
    />
  )}
  <Content />
  {series && (
    <SeriesPagination
      navigation={series}
      locale={currentLocale}
      position="end"
    />
  )}
</ArticleLayout>
