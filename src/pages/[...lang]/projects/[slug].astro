---
import { render } from "astro:content";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { DEFAULT_LOCALE, type SupportedLocale } from "@/i18n/config";
import { getVisibleCollection } from "@/utils/visibility";
import { buildProjectJsonLd } from "@/lib/seo/schema-builder";

export async function getStaticPaths() {
  const projects = await getVisibleCollection("projects");

  const slugToLocales = new Map<string, Set<SupportedLocale>>();
  for (const p of projects) {
    const [l, ...sp] = p.id.replace(/\.md$/, "").split("/");
    const s = sp.join("/");
    if (!slugToLocales.has(s)) slugToLocales.set(s, new Set());
    slugToLocales.get(s)!.add(l as SupportedLocale);
  }

  return projects.map((project) => {
    const [localePart, ...slugParts] = project.id
      .replace(/\.md$/, "")
      .split("/");
    const slugPart = slugParts.join("/");
    const lang = localePart === DEFAULT_LOCALE ? undefined : localePart;
    const availableLocales = Array.from(
      slugToLocales.get(slugPart) || [localePart as SupportedLocale],
    );

    return {
      params: {
        lang,
        slug: slugPart,
      },
      props: {
        project,
        currentLocale: localePart as SupportedLocale,
        availableLocales,
      },
    };
  });
}

const { project, currentLocale, availableLocales } = Astro.props;
const { Content } = await render(project);
const isEs = currentLocale === "es";

const siteUrl = "https://arturonavax.dev";
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath.endsWith("/") ? rawPath : `${rawPath}/`;
const canonicalUrl = `${siteUrl}${normalizedPath}`;

const jsonLd = buildProjectJsonLd({
  locale: currentLocale,
  canonicalUrl,
  title: project.data.title,
  description: project.data.description,
  techStack: project.data.techStack,
  repoUrl: (project.data as any).repoUrl || "https://github.com/arturonavax",
  liveUrl: (project.data as any).liveUrl,
});
---

<ArticleLayout
  title={
    isEs
      ? `${project.data.title} - Análisis de Arquitectura`
      : `${project.data.title} - Architecture Breakdown`
  }
  description={project.data.description}
  locale={currentLocale}
  translationKey={project.data.translationKey}
  collectionName="projects"
  availableLocales={availableLocales}
  backHref={isEs ? "/es/projects/" : "/projects/"}
  backLabel={isEs ? "Volver a proyectos" : "Back to projects"}
  tags={project.data.techStack}
  jsonLd={jsonLd}
>
  <Content />
</ArticleLayout>
