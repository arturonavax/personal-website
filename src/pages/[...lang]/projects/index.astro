---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ui/ProjectCard.astro";
import ProjectsFilterBar from "@/components/ui/ProjectsFilterBar.astro";
import PaginationController from "@/components/ui/PaginationController.astro";
import BackToHomeButton from "@/components/ui/BackToHomeButton.astro";
import { useTranslations } from "@/i18n/utils";
import type { SupportedLocale } from "@/i18n/config";
import { getVisibleCollection } from "@/utils/visibility";

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { locale: "en" as const } },
    { params: { lang: "es" }, props: { locale: "es" as const } },
  ];
}

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const isEs = locale === "es";
const t = useTranslations(locale);

const allProjects = await getVisibleCollection(
  "projects",
  ({ data }) => data.locale === locale,
);
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

// Calculate Tech Stack Frequency
const techCounts: Record<string, number> = {};
sortedProjects.forEach((p) => {
  p.data.techStack.forEach((tech) => {
    techCounts[tech] = (techCounts[tech] || 0) + 1;
  });
});
const sortedTags = Object.entries(techCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10)
  .map(([tag, count]) => ({ tag, count }));

// Calculate Companies
const companyCounts: Record<string, number> = {};
sortedProjects.forEach((p) => {
  const comp = p.data.company ?? "Independent";
  companyCounts[comp] = (companyCounts[comp] || 0) + 1;
});
const companies = Object.entries(companyCounts).map(([name, count]) => ({
  name,
  count,
}));
---

<BaseLayout
  title={
    isEs
      ? "Proyectos & Arquitectura — Arturo Nava"
      : "Projects & Architecture — Arturo Nava"
  }
  description={
    isEs
      ? "Sistemas distribuidos, motores antifraude en tiempo real, plataformas criptográficas e infraestructura de baja latencia por Arturo Nava."
      : "Distributed systems, real-time fraud engines, cryptographic platforms, and low-latency infrastructure built by Arturo Nava."
  }
  locale={locale}
>
  <div class="mx-auto max-w-5xl px-2 min-[360px]:px-3 sm:px-6 pt-1.5 sm:pt-4 lg:pt-6 pb-12 sm:pb-16 space-y-8 sm:space-y-10">
    <div>
      <BackToHomeButton locale={locale} />
      <header class="border-b border-[var(--color-surface-border)] pb-8">
        <h1 class="text-3xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl">
          {t("section.projects")}
        </h1>
        <p class="mt-3 max-w-2xl text-base text-[var(--color-text-secondary)]">
          {isEs
            ? "Desgloses arquitecturales, sistemas de producción críticos y contribuciones técnicas enfocadas en alta concurrencia, estado distribuido y aceleración por hardware."
            : "Architectural breakdowns, core production systems, and open-source contributions focusing on high concurrency, distributed state, and hardware acceleration."}
        </p>
      </header>
    </div>

    <!-- Collapsible Projects Filter Bar -->
    {sortedProjects.length > 0 && (
      <ProjectsFilterBar
        locale={locale}
        tags={sortedTags}
        companies={companies}
        totalProjects={sortedProjects.length}
      />
    )}

    {sortedProjects.length > 0 ? (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {sortedProjects.map((project) => (
          <ProjectCard project={project} locale={locale} />
        ))}
      </div>
    ) : (
      <div class="rounded-lg border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] p-8 text-center font-mono text-xs sm:text-sm text-[var(--color-text-secondary)]">
        {isEs
          ? "No hay proyectos publicados aún. Vuelve pronto."
          : "No projects published yet. Check back soon."}
      </div>
    )}

    <!-- Scalable Pagination Controller -->
    {sortedProjects.length > 0 && (
      <PaginationController
        locale={locale}
        pageSize={6}
        targetSelector="[data-project-card]"
        totalItems={sortedProjects.length}
      />
    )}
  </div>
</BaseLayout>
