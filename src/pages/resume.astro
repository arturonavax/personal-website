---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIndexNav from "@/components/ui/PageIndexNav.astro";
import CvAttributionBar from "@/components/ui/CvAttributionBar.astro";
// import CvExportBar from "@/components/ui/CvExportBar.astro";
import { getCVData, hasResume } from "@/data/cv";

const locale = "en";
// const { html, items, rawMarkdown, json, toml, xml } = getCVData("en");
const { html, items } = getCVData("en");
---

<BaseLayout
  title="Arturo Nava — Senior Software Engineer | Resume"
  description="Professional CV of Arturo Nava, Senior Software Engineer specializing in Go, Rust, and Python. Distributed Systems, High-Concurrency & Security."
  locale={locale}
  canonicalUrl="https://arturonavax.dev/resume/"
  type="profile"
  hideSubtleCoffee={true}
>
  {hasResume && (
    <PageIndexNav
      locale={locale}
      customItems={items}
      containerMaxWidth="cv"
      alignTargetId="cv-document-sheet"
      showPdfPrint={true}
    />
  )}

  <main class="w-full pt-1.5 sm:pt-4 lg:pt-6 pb-12 sm:pb-16 px-2 min-[360px]:px-3 sm:px-6 flex flex-col items-center">
    {hasResume ? (
      <>
        <article
          id="cv-document-sheet"
          class="cv-document bg-white text-[#1e293b] rounded-none border border-[var(--color-surface-border)] shadow-2xl p-3.5 min-[360px]:p-5 sm:p-9 md:p-12 w-full max-w-[210mm] relative"
        >
          <Fragment set:html={html} />
        </article>

        <!-- TODO: reactive by ai-task
        <CvExportBar
          locale={locale}
          rawMarkdown={rawMarkdown}
          jsonCV={json}
          tomlCV={toml}
          xmlCV={xml}
        />
        -->

        <CvAttributionBar locale={locale} defaultMedium="html" />
      </>
    ) : (
      <div class="rounded-lg border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] p-8 text-center font-mono text-xs sm:text-sm text-[var(--color-text-secondary)]">
        Curriculum / Resume file not available.
      </div>
    )}
  </main>
</BaseLayout>

<style is:global>
  /* ==========================================================================
     PRINT STYLES: Cross-Browser Clean CV Engine (Chromium, Firefox, WebKit)
     ========================================================================== */
  @media print {
    @page {
      size: A4;
      margin: 12mm 14mm 14mm 14mm;
    }

    @page {
      @top-left {
        content: "";
      }
      @top-center {
        content: "";
      }
      @top-right {
        content: "";
      }
      @bottom-left {
        content: "ARTURO NAVA • CV";
        font-family: "Geist Mono", var(--font-mono), ui-monospace, monospace;
        font-size: 7.5pt;
        font-weight: 500;
        color: #64748b;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      @bottom-center {
        content: "";
      }
      @bottom-right {
        content: "";
      }
    }

    a[href]::after,
    a::after {
      content: none !important;
    }

    #cv-document-sheet a:not([href]) {
      color: inherit !important;
      text-decoration: none !important;
      cursor: default !important;
    }

    *,
    *::before,
    *::after {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
      color-adjust: exact !important;
    }

    :root,
    html,
    body {
      color-scheme: light !important;
      background: #ffffff !important;
      background-color: #ffffff !important;
      color: #1e293b !important;
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
      border: none !important;
      box-shadow: none !important;
      outline: none !important;
      --color-surface-bg: #ffffff !important;
      --color-surface-card: #ffffff !important;
      --color-surface-border: #e2e8f0 !important;
      --color-text-primary: #0f172a !important;
      --color-text-secondary: #334155 !important;
    }

    #matrix-container,
    #matrix-canvas,
    canvas {
      display: none !important;
      visibility: hidden !important;
    }

    header,
    footer,
    aside,
    #desktop-page-index,
    #mobile-page-index-root,
    #mobile-page-index-container,
    [data-shortcuts-root],
    dialog,
    nav,
    .no-print {
      display: none !important;
    }

    main {
      margin: 0 !important;
      padding: 0 !important;
      max-width: none !important;
      display: block !important;
    }

    #cv-document-sheet.cv-document {
      margin: 0 !important;
      padding: 0 !important;
      border: none !important;
      box-shadow: none !important;
      border-radius: 0 !important;
      max-width: none !important;
      width: 100% !important;
      background: #ffffff !important;
    }

    * {
      content-visibility: visible !important;
    }
  }

  /* ==========================================================================
     SCOPED CV TYPOGRAPHY & COMPONENT STYLING
     ========================================================================== */
  .cv-document {
    font-family:
      "Geist Sans",
      var(--font-sans),
      system-ui,
      -apple-system,
      sans-serif;
    font-size: 11.5pt;
    line-height: 1.38;
    color: #1e293b;
    background-color: #ffffff;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  .cv-document h1 {
    font-family: "Geist Sans", var(--font-sans), sans-serif;
    font-size: 21pt;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 2px 0;
    color: #0f172a !important;
  }

  .cv-document h2 {
    font-family: "Geist Sans", var(--font-sans), sans-serif;
    font-size: 12pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #0f172a !important;
    border-bottom: 1.5px solid #1e293b !important;
    padding-bottom: 2px;
    margin: 14px 0 6px 0;
    page-break-after: avoid;
    break-after: avoid;
    scroll-margin-top: 5rem;
  }

  .cv-document h3 {
    font-family: "Geist Sans", var(--font-sans), sans-serif;
    font-size: 11.5pt;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 10px 0 1px 0;
    color: #0f172a !important;
    page-break-after: avoid;
    break-after: avoid;
    scroll-margin-top: 5rem;
  }

  .cv-document h4 {
    font-family: "Geist Sans", var(--font-sans), sans-serif;
    font-size: 10.5pt;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 8px 0 2px 0;
    color: #7a1c16 !important;
    page-break-after: avoid;
    break-after: avoid;
    scroll-margin-top: 5rem;
  }

  .cv-document h1 + p > strong:first-child {
    font-family: "Geist Sans", var(--font-sans), sans-serif;
    font-size: 11.5pt;
    font-weight: 600;
    color: #7a1c16 !important;
    letter-spacing: -0.01em;
    display: inline-block;
    margin-bottom: 2px;
  }

  .cv-document h3 + p {
    margin: 0 0 4px 0;
    font-size: 10pt;
    page-break-after: avoid;
    break-after: avoid;
  }

  .cv-document h3 + p > strong {
    font-family: "Geist Sans", var(--font-sans), sans-serif;
    color: #7a1c16 !important;
    font-weight: 600;
  }

  .cv-document h3 + p > em {
    font-family: "Geist Mono", var(--font-mono), monospace;
    font-style: normal;
    font-variant-numeric: tabular-nums;
    font-size: 9.5pt;
    color: #475569 !important;
    margin-left: 2px;
  }

  .cv-document ul {
    margin: 2px 0 6px 0;
    padding-left: 16px;
    list-style-type: disc;
  }

  .cv-document li {
    margin-bottom: 3px;
    color: #1e293b;
    page-break-inside: avoid;
    break-inside: avoid;
  }

  .cv-document li::marker {
    color: #7a1c16 !important;
    font-size: 0.8em;
  }

  .cv-document strong {
    font-family: "Geist Sans", var(--font-sans), sans-serif;
    font-weight: 600;
    color: #0f172a;
  }

  .cv-document p {
    margin: 0 0 4px 0;
    text-align: left;
  }

  .cv-document code {
    font-family: "Geist Mono", var(--font-mono), monospace;
    font-size: 0.88em !important;
    font-weight: 500;
    background-color: #faf5f5 !important;
    border: 1px solid #ebdada !important;
    border-radius: 2px;
    padding: 0.5px 3px;
    margin: 0 1px;
    color: #7a1c16 !important;
    vertical-align: baseline;
    white-space: nowrap;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }

  .cv-document li em,
  .cv-document p em {
    font-family: "Geist Mono", var(--font-mono), monospace;
    color: #7a1c16 !important;
    font-style: normal;
    font-weight: 600;
    font-size: 9.5pt;
    margin-right: 2px;
  }

  .cv-document hr {
    display: none;
  }

  .cv-document a,
  .cv-document a[href^="tel:"],
  .cv-document p a,
  .cv-document li a {
    color: #0369a1 !important;
    text-decoration: none;
  }

  .cv-document p a:hover,
  .cv-document li a:hover {
    text-decoration: underline;
  }

  .cv-document h1 a,
  .cv-document h2 a,
  .cv-document h3 a {
    color: #0f172a !important;
    text-decoration: none;
  }
  .cv-document h1 a:hover,
  .cv-document h2 a:hover,
  .cv-document h3 a:hover {
    text-decoration: underline;
  }

  .cv-document h4,
  .cv-document h4 a,
  .cv-document a:has(> h4) {
    color: #7a1c16 !important;
    text-decoration: none;
  }
  .cv-document h4 a:hover {
    text-decoration: underline;
  }

  .cv-document em a,
  .cv-document a em,
  .cv-document code a,
  .cv-document a code,
  .cv-document h1 + p > strong:first-child a,
  .cv-document h3 + p > strong a {
    color: #7a1c16 !important;
    text-decoration: none;
  }
  .cv-document em a:hover,
  .cv-document h3 + p > strong a:hover {
    text-decoration: underline;
  }
</style>

<script is:inline>
  (function () {
    var origDocTitle = "";
    var origTagTitle = "";
    var isPrintTitleApplied = false;
    var isPrintPrepared = false;

    function getCvFileName() {
      var isEs =
        document.documentElement.lang === "es" ||
        window.location.pathname === "/es/" ||
        window.location.pathname.indexOf("/es/") === 0;
      return isEs ? "ArturoNava-CV-es" : "ArturoNava-CV-en";
    }

    function applyPrintTitle() {
      if (isPrintTitleApplied) return;
      isPrintTitleApplied = true;

      if (!origDocTitle) {
        origDocTitle = document.title;
        var titleEl = document.querySelector("title");
        if (titleEl && !origTagTitle) {
          origTagTitle = titleEl.textContent;
        }
      }

      var targetTitle = getCvFileName();
      document.title = targetTitle;
      var titleEl = document.querySelector("title");
      if (titleEl) {
        titleEl.textContent = targetTitle;
      }
    }

    function restoreOriginalTitle() {
      if (!isPrintTitleApplied) return;
      isPrintTitleApplied = false;

      if (origDocTitle) {
        document.title = origDocTitle;
      }
      var titleEl = document.querySelector("title");
      if (titleEl && origTagTitle) {
        titleEl.textContent = origTagTitle;
      }
      origDocTitle = "";
      origTagTitle = "";
    }

    function preparePrintLinks() {
      if (isPrintPrepared) return;
      var cvSheet = document.getElementById("cv-document-sheet");
      if (!cvSheet) return;
      isPrintPrepared = true;

      var headerP = cvSheet.querySelector("h1 + p");
      var links = cvSheet.querySelectorAll("a[href]");

      links.forEach(function (link) {
        if (headerP && headerP.contains(link)) {
          var currentHref = link.getAttribute("href");
          if (currentHref) {
            if (!link.getAttribute("data-screen-href")) {
              link.setAttribute("data-screen-href", currentHref);
            }
            try {
              var url = new URL(currentHref, window.location.origin);
              url.searchParams.set("utm_medium", "pdf");
              link.setAttribute("href", url.toString());
            } catch (_) {
              link.setAttribute(
                "href",
                currentHref.replace(/([?&]utm_medium=)html/g, "$1pdf"),
              );
            }
          }
          return;
        }
        link.setAttribute("data-print-href", link.getAttribute("href"));
        link.removeAttribute("href");
      });
    }

    function restorePrintLinks() {
      if (!isPrintPrepared) return;
      isPrintPrepared = false;

      var cvSheet = document.getElementById("cv-document-sheet");
      if (!cvSheet) return;

      var strippedLinks = cvSheet.querySelectorAll("a[data-print-href]");
      strippedLinks.forEach(function (link) {
        var originalHref = link.getAttribute("data-print-href");
        if (originalHref) {
          link.setAttribute("href", originalHref);
        }
        link.removeAttribute("data-print-href");
      });

      var headerLinks = cvSheet.querySelectorAll("a[data-screen-href]");
      headerLinks.forEach(function (link) {
        var screenHref = link.getAttribute("data-screen-href");
        if (screenHref) {
          try {
            var url = new URL(screenHref, window.location.origin);
            url.searchParams.set("utm_medium", "html");
            link.setAttribute("href", url.toString());
          } catch (_) {
            link.setAttribute(
              "href",
              screenHref.replace(/([?&]utm_medium=)pdf/g, "$1html"),
            );
          }
        }
        link.removeAttribute("data-screen-href");
      });

      var contentInput = document.getElementById("cv-utm-content");
      if (contentInput) {
        contentInput.dispatchEvent(new Event("input"));
      }
    }

    window.printCleanCV = function () {
      applyPrintTitle();
      preparePrintLinks();

      window.addEventListener(
        "afterprint",
        function () {
          restoreOriginalTitle();
          restorePrintLinks();
        },
        { once: true },
      );

      setTimeout(function () {
        restoreOriginalTitle();
        restorePrintLinks();
      }, 3500);

      setTimeout(function () {
        window.print();
      }, 70);
    };

    window.addEventListener("beforeprint", function () {
      applyPrintTitle();
      preparePrintLinks();
    });

    window.addEventListener("afterprint", function () {
      restoreOriginalTitle();
      restorePrintLinks();
    });
  })();
</script>
