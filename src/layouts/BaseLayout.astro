---
import { ClientRouter } from "astro:transitions";
import SEOHead from "@/components/common/SEOHead.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import MatrixBackground from "@/components/ui/MatrixBackground.astro";
import PageIndexNav from "@/components/ui/PageIndexNav.astro";
import ShortcutsModal from "@/components/ui/ShortcutsModal.astro";
import BackToTopButton from "@/components/ui/BackToTopButton.astro";
import LanguageSuggestionBanner from "@/components/ui/LanguageSuggestionBanner.astro";
import UniversalSearchModal from "@/components/ui/UniversalSearchModal.astro";
import CoffeeSponsorshipModal from "@/components/ui/CoffeeSponsorshipModal.astro";
import ContactFormModal from "@/components/ui/ContactFormModal.astro";
import OnlineJudgesModal from "@/components/ui/OnlineJudgesModal.astro";
import { hasSponsorshipMethods } from "@/data/sponsorships";
import { judgeProfiles } from "@/data/onlineJudges";
import { shortcuts } from "@/data/shortcuts";
import type { Locale } from "@/i18n/ui";
import { getCounterpartUrl } from "@/i18n/utils";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  locale?: Locale | undefined;
  canonicalUrl?: string | undefined;
  type?: "website" | "article" | "profile" | undefined;
  ogImage?: string | undefined;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>> | undefined;
  translationKey?: string | undefined;
  collectionName?:
    | "posts"
    | "projects"
    | "experience"
    | "services"
    | "case-studies"
    | undefined;
  availableLocales?: readonly Locale[] | undefined;
  hideSubtleCoffee?: boolean | undefined;
  noindex?: boolean | undefined;
  hideFooter?: boolean | undefined;
}

const {
  title,
  description,
  locale = "en",
  canonicalUrl,
  type = "website",
  ogImage,
  jsonLd,
  translationKey,
  collectionName,
  availableLocales,
  hideSubtleCoffee = false,
  noindex = false,
  hideFooter = false,
} = Astro.props;

const alternateEnUrl =
  locale === "es"
    ? await getCounterpartUrl(
        "es",
        "en",
        Astro.url.pathname,
        collectionName,
        translationKey,
      )
    : undefined;

const alternateEsUrl =
  locale === "en"
    ? await getCounterpartUrl(
        "en",
        "es",
        Astro.url.pathname,
        collectionName,
        translationKey,
      )
    : undefined;

const FALLBACK_TITLE = "Arturo Nava | Senior Backend & AI Systems Engineer";
const FALLBACK_DESCRIPTION =
  "Senior Software Engineer & AI Architect specializing in Go, Rust, Python, high-concurrency distributed systems, and edge infrastructure.";
const finalTitle =
  title && title.trim().length > 0 ? title.trim() : FALLBACK_TITLE;
const finalDescription =
  description && description.trim().length > 0
    ? description.trim()
    : FALLBACK_DESCRIPTION;

const hasSponsorships = hasSponsorshipMethods;
const hasJudges = Boolean(judgeProfiles?.length);
const hasShortcuts = Boolean(shortcuts?.length);
---

<!doctype html>
<html
  lang={locale}
  data-theme="dark"
  class="dark"
  style="background-color: var(--surface-backdrop); color-scheme: dark;"
>
  <head>
    <SEOHead
      title={finalTitle}
      description={finalDescription}
      locale={locale}
      canonicalUrl={canonicalUrl}
      type={type}
      ogImage={ogImage}
      jsonLd={jsonLd}
      alternateEnUrl={alternateEnUrl}
      alternateEsUrl={alternateEsUrl}
      availableLocales={availableLocales}
      noindex={noindex}
    />
    <ClientRouter />

    <!-- Anti-FOUC de tema, neutralizador JSD de Cloudflare y redirección de idioma -->
    <script is:inline>
      (function () {
        // 1. Complete Neutralization of Cloudflare Edge JSD Challenge Script & 1x1 Iframe
        const origAppend = Node.prototype.appendChild;
        Node.prototype.appendChild = function (node) {
          try {
            if (node && node.nodeType === 1) {
              const tag = node.tagName;
              if (tag === "SCRIPT") {
                const src = node.getAttribute("src") || "";
                const txt = node.textContent || "";
                if (
                  src.includes("/cdn-cgi/challenge-platform/") ||
                  txt.includes("__CF$cv$params")
                ) {
                  return node;
                }
              }
              if (tag === "IFRAME") {
                const style = node.getAttribute("style") || "";
                if (
                  (node.height === "1" || node.height === 1) &&
                  (node.width === "1" || node.width === 1) &&
                  (style.includes("visibility: hidden") ||
                    style.includes("display: none"))
                ) {
                  return node;
                }
              }
            }
          } catch (_) {}
          return origAppend.call(this, node);
        };

        const origInsertBefore = Node.prototype.insertBefore;
        Node.prototype.insertBefore = function (node, child) {
          try {
            if (node && node.nodeType === 1) {
              const tag = node.tagName;
              if (tag === "SCRIPT") {
                const src = node.getAttribute("src") || "";
                const txt = node.textContent || "";
                if (
                  src.includes("/cdn-cgi/challenge-platform/") ||
                  txt.includes("__CF$cv$params")
                ) {
                  return node;
                }
              }
              if (tag === "IFRAME") {
                const style = node.getAttribute("style") || "";
                if (
                  (node.height === "1" || node.height === 1) &&
                  (node.width === "1" || node.width === 1) &&
                  (style.includes("visibility: hidden") ||
                    style.includes("display: none"))
                ) {
                  return node;
                }
              }
            }
          } catch (_) {}
          return origInsertBefore.call(this, node, child);
        };

        // 2. Zero-FOUC Theme Initialization & View Transition Swap Sync
        function applyTheme(doc) {
          var targetDoc = doc || document;
          var stored =
            window.__currentTheme === "light" ||
            window.__currentTheme === "dark"
              ? window.__currentTheme
              : null;
          if (!stored) {
            try {
              stored = localStorage.getItem("theme");
            } catch (_) {}
          }
          if (!stored) {
            try {
              stored = sessionStorage.getItem("theme");
            } catch (_) {}
          }
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          var isDark = stored ? stored === "dark" : prefersDark;
          var resolved = isDark ? "dark" : "light";
          window.__currentTheme = resolved;
          var root = targetDoc.documentElement;
          if (!root) return;
          root.classList.toggle("dark", isDark);
          root.classList.toggle("light", !isDark);
          root.setAttribute("data-theme", resolved);
          root.style.colorScheme = resolved;
          if (!isDark) {
            root.style.removeProperty("background-color");
          } else {
            root.style.backgroundColor = "var(--surface-backdrop)";
          }
        }

        applyTheme(document);

        document.addEventListener("astro:before-swap", function (ev) {
          applyTheme(ev.newDocument);

          // SPA HUD & Banner Continuity Pre-Sync:
          // Sincronizar el estado del banner y la elevación del stack en ev.newDocument ANTES de swapDOM
          if (ev && ev.newDocument) {
            var banner = document.getElementById("lang-suggestion-banner");
            var stack = document.getElementById("floating-actions-stack");
            var isBannerVisible =
              banner &&
              !banner.hidden &&
              banner.style.display !== "none" &&
              !banner.classList.contains("hidden") &&
              banner.classList.contains("opacity-100");
            var isStackElevated =
              stack && stack.classList.contains("elevated-for-toast");

            var newBanner = ev.newDocument.getElementById(
              "lang-suggestion-banner",
            );
            var newStack = ev.newDocument.getElementById(
              "floating-actions-stack",
            );
            var newMobileRoot = ev.newDocument.getElementById(
              "mobile-page-index-root",
            );

            if (isBannerVisible && newBanner) {
              newBanner.classList.remove(
                "hidden",
                "opacity-0",
                "translate-y-3",
              );
              newBanner.classList.add(
                "flex",
                "opacity-100",
                "translate-y-0",
                "no-transition",
              );
              newBanner.hidden = false;
              newBanner.style.display = "";
            }
            if (isStackElevated) {
              if (newStack)
                newStack.classList.add("elevated-for-toast", "no-transition");
              if (newMobileRoot)
                newMobileRoot.classList.add(
                  "elevated-for-toast",
                  "no-transition",
                );
            }
          }
        });
        document.addEventListener("astro:after-swap", function () {
          applyTheme(document);
        });
        document.addEventListener("astro:page-load", function () {
          applyTheme(document);
        });
        window.addEventListener("storage", function (e) {
          if (e.key === "theme") {
            applyTheme(document);
          }
        });

        // 3. Multilingual Route & Navigation Language Persistence
        var host = (window.location.hostname || "").toLowerCase();
        var path = window.location.pathname;
        if (
          host === "admin.arturonavax.dev" ||
          host === "dash.arturonavax.dev" ||
          path.indexOf("/admin") !== -1
        ) {
          return;
        }
        var isRoot = path === "/" || path === "/es" || path === "/es/";
        var isEsPath = path === "/es/" || path.indexOf("/es/") === 0;

        var savedLocale = null;
        try {
          savedLocale =
            localStorage.getItem("preferred_locale") ||
            sessionStorage.getItem("preferred_locale");
        } catch (_) {}

        var ref = document.referrer ? document.referrer.toLowerCase() : "";
        var isSearchEngine =
          ref.indexOf("google.") !== -1 ||
          ref.indexOf("bing.") !== -1 ||
          ref.indexOf("duckduckgo.") !== -1 ||
          ref.indexOf("yahoo.") !== -1 ||
          ref.indexOf("ecosia.") !== -1 ||
          ref.indexOf("yandex.") !== -1;

        if (isRoot && savedLocale && !isSearchEngine) {
          if (savedLocale === "es" && path === "/") {
            window.location.replace(
              "/es/" + window.location.search + window.location.hash,
            );
            return;
          } else if (
            savedLocale === "en" &&
            (path === "/es" || path === "/es/")
          ) {
            window.location.replace(
              "/" + window.location.search + window.location.hash,
            );
            return;
          }
        }

        // Intercept pending SPA view transitions to synchronize active language preference
        document.addEventListener("astro:before-preparation", function (ev) {
          if (!ev.to) return;
          var toUrl = ev.to;
          if (toUrl.origin !== window.location.origin) return;
          var p = toUrl.pathname;
          if (
            p.startsWith("/_") ||
            p.startsWith("/api") ||
            p.startsWith("/admin") ||
            p.includes(".")
          ) {
            return;
          }
          var toIsEs = p === "/es" || p === "/es/" || p.startsWith("/es/");
          try {
            var active = toIsEs ? "es" : "en";
            sessionStorage.setItem("preferred_locale", active);
            localStorage.setItem("preferred_locale", active);
          } catch (_) {}
        });

        document.addEventListener("astro:after-swap", function () {
          var currentPath = window.location.pathname;
          var currentIsEs =
            currentPath === "/es" ||
            currentPath === "/es/" ||
            currentPath.startsWith("/es/");
          var activeLocale = currentIsEs ? "es" : "en";
          if (document.body) {
            document.body.setAttribute("data-current-locale", activeLocale);
            document.body.setAttribute("data-current-path", currentPath);
          }
          if (document.documentElement) {
            document.documentElement.setAttribute("lang", activeLocale);
          }
        });

        // Sync locale attribute and storage on page load
        document.addEventListener("astro:page-load", function () {
          var currentPath = window.location.pathname;
          var currentIsEs =
            currentPath === "/es" ||
            currentPath === "/es/" ||
            currentPath.startsWith("/es/");
          var activeLocale = currentIsEs ? "es" : "en";
          if (document.body) {
            document.body.setAttribute("data-current-locale", activeLocale);
          }
          if (document.documentElement) {
            document.documentElement.setAttribute("lang", activeLocale);
          }
        });

        // 4. Conditional No-Translate
        try {
          var supported = ["en", "es"];
          var langs = (navigator.languages || [navigator.language || ""]).map(
            function (l) {
              return (l || "").toLowerCase().split("-")[0];
            },
          );
          if (
            langs.some(function (l) {
              return supported.indexOf(l) !== -1;
            })
          ) {
            document.documentElement.setAttribute("translate", "no");
            document.documentElement.classList.add("notranslate");
          }
        } catch (_) {}
      })();
    </script>
  </head>

  <body
    data-current-locale={locale}
    data-current-path={Astro.url.pathname}
    class="relative flex min-h-screen flex-col bg-[var(--color-surface-bg)] text-[var(--color-text-primary)] antialiased selection:bg-[var(--color-accent-gold)] selection:text-[var(--color-btn-gold-text)]"
  >
    <MatrixBackground transition:persist="matrix-background" data-semi=";" />

    <Header
      locale={locale}
      translationKey={translationKey}
      collectionName={collectionName}
    />

    <LanguageSuggestionBanner
      currentLocale={locale}
      counterpartUrl={locale === "en" ? alternateEsUrl : alternateEnUrl}
      transition:persist="language-banner"
      data-semi=";"
    />

    <aside
      id="floating-actions-stack"
      class="fixed bottom-5 right-5 z-40 flex flex-col-reverse items-end gap-2.5 pointer-events-none select-none"
      aria-label="Floating Actions"
    >
      <PageIndexNav
        locale={locale}
        transition:persist="page-index-nav"
        data-semi=";"
      />
      <BackToTopButton
        locale={locale}
        transition:persist="backtotop"
        data-semi=";"
      />
    </aside>

    <script>
      import { installEdgeTelemetry } from "../scripts/edge-telemetry";
      installEdgeTelemetry();
    </script>
    <script>
      // @ts-nocheck
      (function () {
        function updateToastCollision(immediate) {
          var banner = document.getElementById("lang-suggestion-banner");
          var stack = document.getElementById("floating-actions-stack");
          var mobileRoot = document.getElementById("mobile-page-index-root");
          if (!stack) return;

          if (immediate) {
            stack.classList.add("no-transition");
            if (mobileRoot) mobileRoot.classList.add("no-transition");
          }

          if (
            !banner ||
            banner.hidden ||
            banner.style.display === "none" ||
            banner.classList.contains("hidden") ||
            !banner.classList.contains("opacity-100")
          ) {
            if (stack.classList.contains("elevated-for-toast")) {
              stack.classList.remove("elevated-for-toast");
            }
            if (
              mobileRoot &&
              mobileRoot.classList.contains("elevated-for-toast")
            ) {
              mobileRoot.classList.remove("elevated-for-toast");
            }
          } else {
            var bannerRect = banner.getBoundingClientRect();
            var stackRect = stack.getBoundingClientRect();

            // Only elevate when the banner and the floating buttons horizontally collide / overlap
            var isColliding = bannerRect.right + 12 > stackRect.left;
            if (isColliding) {
              if (!stack.classList.contains("elevated-for-toast")) {
                stack.classList.add("elevated-for-toast");
              }
              if (
                mobileRoot &&
                !mobileRoot.classList.contains("elevated-for-toast")
              ) {
                mobileRoot.classList.add("elevated-for-toast");
              }
            } else {
              if (stack.classList.contains("elevated-for-toast")) {
                stack.classList.remove("elevated-for-toast");
              }
              if (
                mobileRoot &&
                mobileRoot.classList.contains("elevated-for-toast")
              ) {
                mobileRoot.classList.remove("elevated-for-toast");
              }
            }
          }

          if (immediate && typeof requestAnimationFrame === "function") {
            requestAnimationFrame(function () {
              stack.classList.remove("no-transition");
              if (mobileRoot) mobileRoot.classList.remove("no-transition");
            });
          }
        }
        window.__updateToastCollision = updateToastCollision;

        function autoOrderFloatingStack() {}
        window.__autoOrderFloatingStack = autoOrderFloatingStack;

        if (typeof window !== "undefined") {
          var resizeRaf = 0;
          var handleStackResize = function () {
            if (resizeRaf) return;
            resizeRaf = window.requestAnimationFrame(function () {
              resizeRaf = 0;
              if (typeof window.__syncResponsiveMode === "function") {
                window.__syncResponsiveMode();
              }
            });
          };

          window.addEventListener("resize", handleStackResize, {
            passive: true,
          });
          if (window.visualViewport) {
            window.visualViewport.addEventListener(
              "resize",
              handleStackResize,
              {
                passive: true,
              },
            );
          }
          document.addEventListener("astro:page-load", function () {
            if (typeof window.__syncResponsiveMode === "function") {
              window.__syncResponsiveMode();
            }
          });
          document.addEventListener("astro:after-swap", function () {
            var canonicalLink = document.querySelector('link[rel="canonical"]');
            if (canonicalLink) {
              var p = window.location.pathname.endsWith("/")
                ? window.location.pathname
                : window.location.pathname + "/";
              canonicalLink.setAttribute("href", window.location.origin + p);
            }
            if (typeof window.__syncResponsiveMode === "function") {
              window.__syncResponsiveMode();
            }
          });
          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", function () {
              if (typeof window.__syncResponsiveMode === "function") {
                window.__syncResponsiveMode();
              }
            });
          } else {
            if (typeof window.__syncResponsiveMode === "function") {
              window.__syncResponsiveMode();
            }
          }
        }
      })();
    </script>
    <main id="main-content" class="relative z-10 flex-1">
      <slot />
    </main>

    {!hideFooter && <Footer locale={locale} />}

    <div id="modals-portal" class="modals-portal">
      <UniversalSearchModal
        locale={locale}
        transition:persist="search-modal"
        data-semi=";"
      />
      {hasShortcuts && (
        <ShortcutsModal
          locale={locale}
          transition:persist="shortcuts-modal"
          data-semi=";"
        />
      )}
      {!hideSubtleCoffee && hasSponsorships && (
        <CoffeeSponsorshipModal
          locale={locale}
          variant="subtle"
          transition:persist="coffee-modal"
          data-semi=";"
        />
      )}
      {hasJudges && (
        <OnlineJudgesModal
          locale={locale}
          transition:persist="judges-modal"
          data-semi=";"
        />
      )}
      <ContactFormModal
        locale={locale}
        transition:persist="contact-modal"
        data-semi=";"
      />
    </div>

    <!-- Edge Fetch Navigation Loading Beacon -->
    <div
      id="page-navigation-beacon"
      data-astro-transition-persist="page-navigation-beacon"
      class="pointer-events-none fixed z-[9999] top-16 sm:top-[4.25rem] left-1/2 -translate-x-1/2 flex items-center gap-2 rounded-full border border-[var(--color-accent-gold)]/40 bg-[var(--color-surface-card)]/95 backdrop-blur-md px-3 py-1 font-mono text-[10px] text-[var(--color-accent-gold)] shadow-lg opacity-0 scale-95 transition-[opacity,transform] duration-150 ease-out select-none"
      aria-hidden="true"
    >
      <svg
        class="h-2.5 w-2.5 animate-spin text-[var(--color-accent-gold)] shrink-0"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
      >
        <circle
          class="opacity-25"
          cx="12"
          cy="12"
          r="10"
          stroke="currentColor"
          stroke-width="4"
        ></circle>
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        ></path>
      </svg>
      <span class="tracking-wider uppercase font-semibold text-[9px]">
        {locale === "es" ? "Cargando..." : "Fetching..."}
      </span>
    </div>

    <!-- Script de runtime: expone APIs a window, mantiene polyfills y gestiona eventos -->
    <script>
      import { handleEscapeKey } from "@/lib/navigation/escape-router";
      import { setupHistoryScrollRouter } from "@/lib/navigation/history-scroll-router";
      import { navigate } from "astro:transitions/client";

      (window as any).__astroNavigate = (url: string) => void navigate(url);
      setupHistoryScrollRouter();

      // 1. Resiliencia contra extensiones externas mal implementadas
      if (typeof Document !== "undefined") {
        if (!(Document.prototype as any).closest) {
          (Document.prototype as any).closest = () => null;
        }
        if (!("tagName" in Document.prototype)) {
          try {
            Object.defineProperty(Document.prototype, "tagName", {
              get: () => "",
              configurable: true,
            });
          } catch (_) {}
        }
      }
      if (typeof Window !== "undefined" && !(Window.prototype as any).closest) {
        (Window.prototype as any).closest = () => null;
      }

      // 2. Control del Beacon de Carga
      let isBeaconShown = false;
      let beaconShownTime = 0;
      let beaconShowTimeout: ReturnType<typeof setTimeout> | null = null;
      let beaconHideTimeout: ReturnType<typeof setTimeout> | null = null;
      let beaconSafetyTimeout: ReturnType<typeof setTimeout> | null = null;
      const DEBOUNCE_SHOW_MS = 240;
      const MIN_VISIBLE_MS = 120;
      const BEACON_MAX_DURATION_MS = 6000;

      function renderBeaconVisible(customText?: string) {
        const beacon = document.getElementById("page-navigation-beacon");
        if (beacon) {
          const txt = beacon.querySelector("span");
          if (txt) {
            txt.textContent =
              typeof customText === "string" && customText.trim().length > 0
                ? customText
                : document.documentElement.lang === "es"
                  ? "Cargando..."
                  : "Fetching...";
          }
          beacon.classList.remove("opacity-0", "scale-95");
          beacon.classList.add("opacity-100", "scale-100");
        }
        isBeaconShown = true;
        beaconShownTime = performance.now();

        // Safety timeout to prevent stuck beacon if navigation is cancelled or file is downloaded
        if (beaconSafetyTimeout) clearTimeout(beaconSafetyTimeout);
        beaconSafetyTimeout = setTimeout(() => {
          hideBeacon();
          beaconSafetyTimeout = null;
        }, BEACON_MAX_DURATION_MS);
      }

      function showBeacon(customText?: string, immediate = false) {
        if (beaconHideTimeout) {
          clearTimeout(beaconHideTimeout);
          beaconHideTimeout = null;
        }

        if (immediate) {
          if (beaconShowTimeout) clearTimeout(beaconShowTimeout);
          renderBeaconVisible(customText);
          return;
        }

        if (isBeaconShown) return;
        if (beaconShowTimeout) clearTimeout(beaconShowTimeout);
        beaconShowTimeout = setTimeout(() => {
          renderBeaconVisible(customText);
          beaconShowTimeout = null;
        }, DEBOUNCE_SHOW_MS);
      }

      function hideBeacon(immediate = false) {
        if (beaconSafetyTimeout) {
          clearTimeout(beaconSafetyTimeout);
          beaconSafetyTimeout = null;
        }

        if (beaconShowTimeout) {
          clearTimeout(beaconShowTimeout);
          beaconShowTimeout = null;
        }

        if (!isBeaconShown) {
          return;
        }

        const doHide = () => {
          const beacon = document.getElementById("page-navigation-beacon");
          if (beacon) {
            beacon.classList.remove("opacity-100", "scale-100");
            beacon.classList.add("opacity-0", "scale-95");
          }
          isBeaconShown = false;
          beaconHideTimeout = null;
        };

        if (immediate) {
          if (beaconHideTimeout) clearTimeout(beaconHideTimeout);
          doHide();
          return;
        }

        const elapsed = performance.now() - beaconShownTime;
        const remaining = Math.max(0, MIN_VISIBLE_MS - elapsed);

        if (beaconHideTimeout) clearTimeout(beaconHideTimeout);
        beaconHideTimeout = setTimeout(doHide, remaining);
      }

      // Exposición global requerida por LanguageSwitcher.astro
      (window as any).__showBeacon = showBeacon;
      (window as any).__hideBeacon = hideBeacon;

      document.addEventListener("astro:before-preparation", () => {
        showBeacon();
        const mobileMenu = document.getElementById("mobile-nav-details");
        if (mobileMenu && mobileMenu.hasAttribute("open")) {
          mobileMenu.removeAttribute("open");
        }
      });
      document.addEventListener("astro:before-swap", () => {
        hideBeacon(true);
        document.querySelectorAll("dialog[open]").forEach((d) => {
          try {
            (d as HTMLDialogElement).close();
          } catch (_) {}
        });
        document
          .querySelectorAll(".copy-feedback, #email-copy-toast")
          .forEach((toast) => {
            try {
              if (typeof (toast as any).hidePopover === "function") {
                (toast as any).hidePopover();
              }
              toast.classList.add("opacity-0", "pointer-events-none");
              toast.classList.remove("opacity-100");
            } catch (_) {}
          });
        document.body.style.overflow = "";
      });
      document.addEventListener("astro:page-load", () => {
        hideBeacon();
        try {
          sessionStorage.removeItem("lang_switch_scroll");
        } catch (_) {}
      });
      window.addEventListener("pageshow", () => hideBeacon());

      // Task 5: Instant Section Hydration for Seamless Anchor & Cross-Page Hash Navigation
      function hydrateSections() {
        document.documentElement.classList.add("hydrated-sections");
      }
      function setupSectionHydration() {
        if (
          window.location.hash ||
          (typeof window !== "undefined" && window.scrollY > 0)
        ) {
          hydrateSections();
          return;
        }
        window.addEventListener("scroll", hydrateSections, {
          once: true,
          passive: true,
        });
        window.addEventListener("pointerdown", hydrateSections, {
          once: true,
          passive: true,
        });
        window.addEventListener("pointerenter", hydrateSections, {
          once: true,
          passive: true,
        });
        window.addEventListener("touchstart", hydrateSections, {
          once: true,
          passive: true,
        });
      }
      setupSectionHydration();
      window.addEventListener("hashchange", hydrateSections, { passive: true });
      document.addEventListener("astro:page-load", setupSectionHydration);
      document.addEventListener("astro:after-swap", () => {
        hideBeacon(true);
        try {
          if (
            sessionStorage.getItem("nav_reset_scroll") === "1" &&
            !window.location.hash
          ) {
            sessionStorage.removeItem("nav_reset_scroll");
            window.scrollTo({ top: 0, left: 0, behavior: "instant" });
          }
        } catch (_) {}
        setupSectionHydration();
      });

      document.addEventListener(
        "click",
        (e: MouseEvent) => {
          const link = (e.target as Element)?.closest?.("a[href]");
          if (
            !link ||
            e.defaultPrevented ||
            e.ctrlKey ||
            e.metaKey ||
            e.shiftKey ||
            e.altKey ||
            e.button !== 0
          )
            return;

          const anchor = link as HTMLAnchorElement;
          const href = anchor.getAttribute("href");
          if (
            !href ||
            href.startsWith("#") ||
            href.startsWith("mailto:") ||
            href.startsWith("tel:") ||
            href.startsWith("javascript:") ||
            anchor.target === "_blank" ||
            anchor.hasAttribute("download") ||
            anchor.getAttribute("download") !== null ||
            anchor.hasAttribute("data-no-beacon") ||
            Boolean(anchor.closest("[data-no-beacon]")) ||
            /\.(?:pdf|zip|tar|gz|epub|docx|xlsx|pptx)$/i.test(anchor.pathname)
          )
            return;

          if (anchor.origin === window.location.origin) {
            if (
              anchor.hasAttribute("data-timeline-nav") ||
              anchor.closest("[data-timeline-nav]")
            ) {
              return;
            }
            const currentPath =
              window.location.pathname.replace(/\/+$/, "") || "/";
            const destPath = anchor.pathname.replace(/\/+$/, "") || "/";
            if (destPath !== currentPath) {
              showBeacon();
            }
          }
        },
        { passive: true },
      );

      // 3. Vim Navigation System
      let isContinuousScrolling = false;
      let scrollVelocity = 0;
      let scrollDirection = 0;
      let rafId: number | null = null;
      let lastKeyRepeatTime = 0;

      function setVimKeyActive(key: "j" | "k", active: boolean) {
        document.querySelectorAll(`[data-vim-key="${key}"]`).forEach((el) => {
          el.classList.toggle("border-[var(--color-accent-gold)]", active);
          el.classList.toggle("text-[var(--color-accent-gold)]", active);
        });
      }

      function kineticScrollLoop() {
        if (!isContinuousScrolling) return;
        const now = performance.now();
        if (now - lastKeyRepeatTime > 180) {
          scrollVelocity *= 0.88;
          if (Math.abs(scrollVelocity) < 0.8) {
            isContinuousScrolling = false;
            if (rafId) cancelAnimationFrame(rafId);
            return;
          }
        } else {
          if (Math.abs(scrollVelocity) < 48) {
            scrollVelocity += scrollDirection * 3.5;
          }
        }
        window.scrollBy(0, scrollVelocity);
        rafId = requestAnimationFrame(kineticScrollLoop);
      }

      function startKineticScroll(dir: number) {
        lastKeyRepeatTime = performance.now();
        scrollDirection = dir;
        if (!isContinuousScrolling) {
          isContinuousScrolling = true;
          scrollVelocity = dir * 18;
          rafId = requestAnimationFrame(kineticScrollLoop);
        }
      }

      // Infallible Hierarchical Esc State Machine (REQ-UXE-07) & Vim Navigation (REQ-UXE-09)
      window.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Escape" || e.key === "Esc") {
          const handled = handleEscapeKey(window.location.pathname, (url) => {
            void navigate(url);
          });
          if (handled) {
            e.preventDefault();
            return;
          }
        }

        if (e.ctrlKey || e.metaKey || e.altKey) return;
        const active = document.activeElement;
        const tag = active?.tagName?.toUpperCase() || "";
        const isInput =
          tag === "INPUT" ||
          tag === "TEXTAREA" ||
          tag === "SELECT" ||
          (active as HTMLElement)?.isContentEditable;
        if (isInput) return;

        if (
          document.querySelector('dialog[open], [role="dialog"]:not(.hidden)')
        ) {
          return;
        }

        const isJ = e.key === "j" || e.key === "J";
        const isK = e.key === "k" || e.key === "K";
        if (!isJ && !isK) return;

        e.preventDefault();
        const dir = isJ ? 1 : -1;
        setVimKeyActive(isJ ? "j" : "k", true);

        const hasPageIndex = Boolean(
          (window as any).__hasPageIndex ||
          document.getElementById("desktop-page-index") ||
          document.getElementById("mobile-page-index-root"),
        );

        const pageIndexStep = (window as any).__pageIndexStep;
        if (hasPageIndex && typeof pageIndexStep === "function") {
          pageIndexStep(dir);
          return;
        }

        if (!e.repeat) {
          window.scrollBy({ top: dir * 260, behavior: "smooth" });
        } else {
          startKineticScroll(dir);
        }
      });

      window.addEventListener("keyup", (e: KeyboardEvent) => {
        const isJ = e.key === "j" || e.key === "J";
        const isK = e.key === "k" || e.key === "K";
        if (isJ || isK) {
          setVimKeyActive(isJ ? "j" : "k", false);
          if (isContinuousScrolling) lastKeyRepeatTime = 0;
        }
      });

      window.addEventListener("blur", () => {
        setVimKeyActive("j", false);
        setVimKeyActive("k", false);
        isContinuousScrolling = false;
        if (rafId) cancelAnimationFrame(rafId);
      });
    </script>
  </body>
</html>
