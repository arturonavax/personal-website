---
import { ClientRouter } from "astro:transitions";
import SEOHead from "@/components/common/SEOHead.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import MatrixBackground from "@/components/ui/MatrixBackground.astro";
import ShortcutsModal from "@/components/ui/ShortcutsModal.astro";
import BackToTopButton from "@/components/ui/BackToTopButton.astro";
import LanguageSuggestionBanner from "@/components/ui/LanguageSuggestionBanner.astro";
import UniversalSearchModal from "@/components/ui/UniversalSearchModal.astro";
import CoffeeSponsorshipModal from "@/components/ui/CoffeeSponsorshipModal.astro";
import OnlineJudgesModal from "@/components/ui/OnlineJudgesModal.astro";
import { hasSponsorshipMethods } from "@/data/sponsorships";
import { judgeProfiles } from "@/data/onlineJudges";
import { shortcuts } from "@/data/shortcuts";
import type { Locale } from "@/i18n/ui";
import { getCounterpartUrl } from "@/i18n/utils";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  locale?: Locale | undefined;
  canonicalUrl?: string | undefined;
  type?: "website" | "article" | "profile" | undefined;
  ogImage?: string | undefined;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>> | undefined;
  translationKey?: string | undefined;
  collectionName?:
    | "posts"
    | "projects"
    | "experience"
    | "services"
    | "case-studies"
    | undefined;
  hideSubtleCoffee?: boolean | undefined;
}

const {
  title,
  description,
  locale = "en",
  canonicalUrl,
  type = "website",
  ogImage,
  jsonLd,
  translationKey,
  collectionName,
  hideSubtleCoffee = false,
} = Astro.props;

const alternateEnUrl =
  locale === "es"
    ? await getCounterpartUrl(
        "es",
        "en",
        Astro.url.pathname,
        collectionName,
        translationKey,
      )
    : undefined;

const alternateEsUrl =
  locale === "en"
    ? await getCounterpartUrl(
        "en",
        "es",
        Astro.url.pathname,
        collectionName,
        translationKey,
      )
    : undefined;

const hasSponsorships = hasSponsorshipMethods;
const hasJudges = Boolean(judgeProfiles?.length);
const hasShortcuts = Boolean(shortcuts?.length);
---

<!doctype html>
<html
  lang={locale}
  data-theme="dark"
  class="dark"
  style="background-color: var(--surface-backdrop); color-scheme: dark;"
>
  <head>
    <ClientRouter />
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      canonicalUrl={canonicalUrl}
      type={type}
      ogImage={ogImage}
      jsonLd={jsonLd}
      alternateEnUrl={alternateEnUrl}
      alternateEsUrl={alternateEsUrl}
    />

    <!-- Anti-FOUC de tema, bloqueo condicional de traducción y restauración de Scroll -->
    <script is:inline>
      (function () {
        var path = window.location.pathname;
        var isRoot = path === "/" || path === "/es" || path === "/es/";
        var isEsPath = path === "/es/" || path.indexOf("/es/") === 0;

        // 1. Recuperar preferencia explícita guardada (localStorage tiene precedencia, con fallback a sessionStorage)
        var savedLocale = null;
        try {
          savedLocale =
            localStorage.getItem("preferred_locale") ||
            sessionStorage.getItem("preferred_locale");
        } catch (_) {}

        // Redirección limpia en la raíz: respeta preferencia explícita o detecta idioma en primer ingreso
        if (isRoot) {
          if (savedLocale === "es" && !isEsPath) {
            window.location.replace(
              "/es/" + window.location.search + window.location.hash,
            );
          } else if (savedLocale === "en" && isEsPath) {
            window.location.replace(
              "/" + window.location.search + window.location.hash,
            );
          } else if (!savedLocale) {
            // Primer visitante sin preferencia guardada:
            // Solo redirigir si no proviene de un motor de búsqueda externo
            var ref = document.referrer ? document.referrer.toLowerCase() : "";
            var isSearchEngine =
              ref.indexOf("google.") !== -1 ||
              ref.indexOf("bing.") !== -1 ||
              ref.indexOf("duckduckgo.") !== -1 ||
              ref.indexOf("yahoo.") !== -1 ||
              ref.indexOf("ecosia.") !== -1 ||
              ref.indexOf("yandex.") !== -1;

            if (!isSearchEngine && path === "/") {
              var userLangs = (
                navigator.languages || [navigator.language || ""]
              ).map(function (l) {
                return (l || "").toLowerCase().split("-")[0];
              });
              if (userLangs[0] === "es") {
                window.location.replace(
                  "/es/" + window.location.search + window.location.hash,
                );
              }
            }
          }
        }

        // 2. Supresión condicional del popup de traducción solo para usuarios que dominen EN o ES
        function applyConditionalNoTranslate() {
          try {
            var supported = ["en", "es"];
            var userLangs = (
              navigator.languages || [navigator.language || ""]
            ).map(function (l) {
              return (l || "").toLowerCase().split("-")[0];
            });

            var speaksSupported = userLangs.some(function (l) {
              return supported.indexOf(l) !== -1;
            });

            if (speaksSupported) {
              var root = document.documentElement;
              root.setAttribute("translate", "no");
              root.classList.add("notranslate");

              if (
                !document.querySelector(
                  'meta[name="google"][content="notranslate"]',
                )
              ) {
                var meta = document.createElement("meta");
                meta.name = "google";
                meta.content = "notranslate";
                document.head.appendChild(meta);
              }
            }
          } catch (_) {}
        }

        applyConditionalNoTranslate();
        document.addEventListener(
          "astro:after-swap",
          applyConditionalNoTranslate,
        );

        // 3. Anti-FOUC de tema
        function applyStoredTheme() {
          try {
            var theme = localStorage.getItem("theme") || "dark";
            var root = document.documentElement;
            root.setAttribute("data-theme", theme);
            if (theme === "light") {
              root.classList.remove("dark");
              root.classList.add("light");
              root.style.colorScheme = "light";
            } else {
              root.classList.add("dark");
              root.classList.remove("light");
              root.style.colorScheme = "dark";
            }
            root.style.removeProperty("background-color");
          } catch (_) {}
        }

        applyStoredTheme();
        document.addEventListener("astro:after-swap", applyStoredTheme);

        // 4. Sincronización y restauración de scroll
        try {
          var navReset = sessionStorage.getItem("nav_reset_scroll");
          var isSubpage =
            window.location.pathname !== "/" &&
            window.location.pathname !== "/es";
          var hasHash = !!window.location.hash;
          var hasContactPending =
            sessionStorage.getItem("pending_contact_scroll") === "1" ||
            window.location.hash === "#contact";

          if (
            !hasContactPending &&
            (navReset === "1" || (isSubpage && !hasHash))
          ) {
            sessionStorage.removeItem("nav_reset_scroll");
            sessionStorage.removeItem("lang_switch_scroll");
            if ("scrollRestoration" in history) {
              history.scrollRestoration = "manual";
            }
            window.scrollTo(0, 0);
          } else {
            var savedScroll = sessionStorage.getItem("lang_switch_scroll");
            if (savedScroll !== null) {
              var targetY = parseInt(savedScroll, 10);
              if ("scrollRestoration" in history) {
                history.scrollRestoration = "manual";
              }
              window.scrollTo(0, targetY);
            }
          }
        } catch (_) {}
      })();
    </script>
  </head>

  <body class="relative flex min-h-screen flex-col bg-[var(--color-surface-bg)] text-[var(--color-text-primary)] antialiased selection:bg-[var(--color-accent-gold)] selection:text-[var(--color-btn-gold-text)]">
    <MatrixBackground />

    <Header
      locale={locale}
      translationKey={translationKey}
      collectionName={collectionName}
    />

    <LanguageSuggestionBanner
      currentLocale={locale}
      counterpartUrl={locale === "en" ? alternateEsUrl : alternateEnUrl}
    />

    <aside
      id="floating-actions-stack"
      class="fixed bottom-5 right-5 z-40 flex flex-col-reverse items-end gap-2.5 pointer-events-none select-none"
      aria-label="Floating Actions"
    >
      {hasShortcuts && <ShortcutsModal locale={locale} />}
      <BackToTopButton locale={locale} />
    </aside>

    <main class="relative z-10 flex-1">
      <slot />
      {!hideSubtleCoffee && hasSponsorships && (
        <CoffeeSponsorshipModal locale={locale} variant="subtle" />
      )}
    </main>

    <Footer locale={locale} />
    <UniversalSearchModal locale={locale} />
    {hasJudges && <OnlineJudgesModal locale={locale} />}

    <!-- Edge Navigation Loading Bar (Top-layer Slim Progress Line) -->
    <div
      id="page-navigation-bar"
      data-astro-transition-persist="page-navigation-bar"
      class="pointer-events-none fixed top-0 left-0 right-0 h-[2px] z-[10000] bg-gradient-to-r from-transparent via-[var(--color-accent-gold)] to-transparent opacity-0 transition-opacity duration-150 ease-out select-none"
      aria-hidden="true"
    ></div>

    <!-- Edge Fetch Navigation Loading Beacon -->
    <div
      id="page-navigation-beacon"
      data-astro-transition-persist="page-navigation-beacon"
      class="pointer-events-none fixed z-[9999] top-16 sm:top-[4.25rem] left-1/2 -translate-x-1/2 flex items-center gap-2 rounded-full border border-[var(--color-accent-gold)]/40 bg-[var(--color-surface-card)]/95 backdrop-blur-md px-3 py-1 font-mono text-[10px] text-[var(--color-accent-gold)] shadow-lg opacity-0 scale-95 transition-[opacity,transform] duration-150 ease-out select-none"
      aria-hidden="true"
    >
      <svg
        class="h-2.5 w-2.5 animate-spin text-[var(--color-accent-gold)] shrink-0"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
      >
        <circle
          class="opacity-25"
          cx="12"
          cy="12"
          r="10"
          stroke="currentColor"
          stroke-width="4"
        ></circle>
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        ></path>
      </svg>
      <span class="tracking-wider uppercase font-semibold text-[9px]">
        {locale === "es" ? "Cargando..." : "Fetching..."}
      </span>
    </div>

    <!-- Script de runtime: expone APIs a window, mantiene polyfills y gestiona eventos -->
    <script>
      import { handleEscapeKey } from "@/lib/navigation/escape-router";

      // 1. Resiliencia contra extensiones externas mal implementadas
      if (typeof Document !== "undefined") {
        if (!(Document.prototype as any).closest) {
          (Document.prototype as any).closest = () => null;
        }
        if (!("tagName" in Document.prototype)) {
          try {
            Object.defineProperty(Document.prototype, "tagName", {
              get: () => "",
              configurable: true,
            });
          } catch (_) {}
        }
      }
      if (typeof Window !== "undefined" && !(Window.prototype as any).closest) {
        (Window.prototype as any).closest = () => null;
      }

      // 2. Control del Beacon y Barra de Carga Perimetral
      let isBeaconShown = false;
      let beaconShownTime = 0;
      let beaconShowTimeout: ReturnType<typeof setTimeout> | null = null;
      let beaconHideTimeout: ReturnType<typeof setTimeout> | null = null;
      const DEBOUNCE_SHOW_MS = 120;
      const MIN_VISIBLE_MS = 120;

      function renderBeaconVisible(customText?: string) {
        const beacon = document.getElementById("page-navigation-beacon");
        const bar = document.getElementById("page-navigation-bar");
        if (beacon) {
          const txt = beacon.querySelector("span");
          if (txt) {
            txt.textContent =
              typeof customText === "string" && customText.trim().length > 0
                ? customText
                : document.documentElement.lang === "es"
                  ? "Cargando..."
                  : "Fetching...";
          }
          beacon.classList.remove("opacity-0", "scale-95");
          beacon.classList.add("opacity-100", "scale-100");
        }
        if (bar) {
          bar.classList.remove("opacity-0");
          bar.classList.add("opacity-100");
        }
        isBeaconShown = true;
        beaconShownTime = performance.now();
      }

      function showBeacon(customText?: string, immediate = false) {
        if (beaconHideTimeout) {
          clearTimeout(beaconHideTimeout);
          beaconHideTimeout = null;
        }

        if (immediate) {
          if (beaconShowTimeout) clearTimeout(beaconShowTimeout);
          renderBeaconVisible(customText);
          return;
        }

        if (isBeaconShown) return;
        if (beaconShowTimeout) clearTimeout(beaconShowTimeout);
        beaconShowTimeout = setTimeout(() => {
          renderBeaconVisible(customText);
          beaconShowTimeout = null;
        }, DEBOUNCE_SHOW_MS);
      }

      function hideBeacon() {
        if (beaconShowTimeout) {
          clearTimeout(beaconShowTimeout);
          beaconShowTimeout = null;
        }

        const bar = document.getElementById("page-navigation-bar");
        if (!isBeaconShown) {
          if (bar) {
            bar.classList.remove("opacity-100");
            bar.classList.add("opacity-0");
          }
          return;
        }

        const elapsed = performance.now() - beaconShownTime;
        const remaining = Math.max(0, MIN_VISIBLE_MS - elapsed);

        if (beaconHideTimeout) clearTimeout(beaconHideTimeout);
        beaconHideTimeout = setTimeout(() => {
          const beacon = document.getElementById("page-navigation-beacon");
          if (beacon) {
            beacon.classList.remove("opacity-100", "scale-100");
            beacon.classList.add("opacity-0", "scale-95");
          }
          if (bar) {
            bar.classList.remove("opacity-100");
            bar.classList.add("opacity-0");
          }
          isBeaconShown = false;
          beaconHideTimeout = null;
        }, remaining);
      }

      // Exposición global requerida por LanguageSwitcher.astro
      (window as any).__showBeacon = showBeacon;
      (window as any).__hideBeacon = hideBeacon;

      document.addEventListener("astro:before-preparation", () => showBeacon());
      document.addEventListener("astro:page-load", () => {
        hideBeacon();
        try {
          sessionStorage.removeItem("lang_switch_scroll");
        } catch (_) {}
      });
      window.addEventListener("pageshow", hideBeacon);

      document.addEventListener(
        "click",
        (e: MouseEvent) => {
          const link = (e.target as Element)?.closest?.("a[href]");
          if (
            !link ||
            e.defaultPrevented ||
            e.ctrlKey ||
            e.metaKey ||
            e.shiftKey ||
            e.altKey ||
            e.button !== 0
          )
            return;

          const anchor = link as HTMLAnchorElement;
          const href = anchor.getAttribute("href");
          if (
            !href ||
            href.startsWith("#") ||
            href.startsWith("mailto:") ||
            href.startsWith("tel:") ||
            anchor.target === "_blank"
          )
            return;

          if (anchor.origin === window.location.origin) {
            if (
              anchor.hasAttribute("data-timeline-nav") ||
              anchor.closest("[data-timeline-nav]")
            ) {
              return;
            }
            const currentPath =
              window.location.pathname.replace(/\/+$/, "") || "/";
            const destPath = anchor.pathname.replace(/\/+$/, "") || "/";
            if (destPath !== currentPath) {
              showBeacon();
            }
          }
        },
        { passive: true },
      );

      // 3. Vim Navigation System
      let isContinuousScrolling = false;
      let scrollVelocity = 0;
      let scrollDirection = 0;
      let rafId: number | null = null;
      let lastKeyRepeatTime = 0;

      function setVimKeyActive(key: "j" | "k", active: boolean) {
        document.querySelectorAll(`[data-vim-key="${key}"]`).forEach((el) => {
          el.classList.toggle("border-[var(--color-accent-gold)]", active);
          el.classList.toggle("text-[var(--color-accent-gold)]", active);
        });
      }

      function kineticScrollLoop() {
        if (!isContinuousScrolling) return;
        const now = performance.now();
        if (now - lastKeyRepeatTime > 180) {
          scrollVelocity *= 0.88;
          if (Math.abs(scrollVelocity) < 0.8) {
            isContinuousScrolling = false;
            if (rafId) cancelAnimationFrame(rafId);
            return;
          }
        } else {
          if (Math.abs(scrollVelocity) < 48) {
            scrollVelocity += scrollDirection * 3.5;
          }
        }
        window.scrollBy(0, scrollVelocity);
        rafId = requestAnimationFrame(kineticScrollLoop);
      }

      function startKineticScroll(dir: number) {
        lastKeyRepeatTime = performance.now();
        scrollDirection = dir;
        if (!isContinuousScrolling) {
          isContinuousScrolling = true;
          scrollVelocity = dir * 18;
          rafId = requestAnimationFrame(kineticScrollLoop);
        }
      }

      // Infallible Hierarchical Esc State Machine (REQ-UXE-07) & Vim Navigation (REQ-UXE-09)
      window.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Escape" || e.key === "Esc") {
          const handled = handleEscapeKey(window.location.pathname, (url) => {
            window.location.href = url;
          });
          if (handled) {
            e.preventDefault();
            return;
          }
        }

        if (e.ctrlKey || e.metaKey || e.altKey) return;
        const active = document.activeElement;
        const tag = active?.tagName?.toUpperCase() || "";
        const isInput =
          tag === "INPUT" ||
          tag === "TEXTAREA" ||
          tag === "SELECT" ||
          (active as HTMLElement)?.isContentEditable;
        if (isInput) return;

        if (
          document.querySelector('dialog[open], [role="dialog"]:not(.hidden)')
        ) {
          return;
        }

        const isJ = e.key === "j" || e.key === "J";
        const isK = e.key === "k" || e.key === "K";
        if (!isJ && !isK) return;

        e.preventDefault();
        const dir = isJ ? 1 : -1;
        setVimKeyActive(isJ ? "j" : "k", true);

        const hasPageIndex = Boolean(
          (window as any).__hasPageIndex ||
          document.getElementById("desktop-page-index") ||
          document.getElementById("mobile-page-index-root"),
        );

        const pageIndexStep = (window as any).__pageIndexStep;
        if (hasPageIndex && typeof pageIndexStep === "function") {
          pageIndexStep(dir);
          return;
        }

        if (!e.repeat) {
          window.scrollBy({ top: dir * 260, behavior: "smooth" });
        } else {
          startKineticScroll(dir);
        }
      });

      window.addEventListener("keyup", (e: KeyboardEvent) => {
        const isJ = e.key === "j" || e.key === "J";
        const isK = e.key === "k" || e.key === "K";
        if (isJ || isK) {
          setVimKeyActive(isJ ? "j" : "k", false);
          if (isContinuousScrolling) lastKeyRepeatTime = 0;
        }
      });

      window.addEventListener("blur", () => {
        setVimKeyActive("j", false);
        setVimKeyActive("k", false);
        isContinuousScrolling = false;
        if (rafId) cancelAnimationFrame(rafId);
      });
    </script>
  </body>
</html>
