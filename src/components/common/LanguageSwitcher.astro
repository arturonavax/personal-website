---
import type { Locale } from "@/i18n/ui";
import { getCounterpartUrl } from "@/i18n/utils";

interface Props {
  currentLocale: Locale;
  translationKey?: string | undefined;
  collectionName?:
    | "posts"
    | "projects"
    | "experience"
    | "services"
    | "case-studies"
    | undefined;
}

const { currentLocale, translationKey, collectionName } = Astro.props;
const targetLocale: Locale = currentLocale === "en" ? "es" : "en";
const targetUrl = await getCounterpartUrl(
  currentLocale,
  targetLocale,
  Astro.url.pathname,
  collectionName,
  translationKey,
);
const effectiveTargetUrl =
  targetUrl ??
  (targetLocale === "es"
    ? collectionName
      ? `/es/${collectionName === "posts" ? "blog" : collectionName}/`
      : "/es/"
    : collectionName
      ? `/${collectionName === "posts" ? "blog" : collectionName}/`
      : "/");
---

<nav
  aria-label="Language selector"
  class="hidden min-[391px]:inline-flex items-center text-xs font-mono shrink-0 whitespace-nowrap"
>
  <div class="group inline-flex h-8 items-center rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-1.5 sm:px-2 gap-1 sm:gap-1.5 hover:border-[var(--color-accent-gold)] transition-colors">
    <span
      class="hidden min-[420px]:flex h-4 w-4 items-center justify-center text-[var(--color-text-muted)] group-hover:text-[var(--color-accent-gold)] transition-colors select-none shrink-0"
      aria-hidden="true"
      title={currentLocale === "en" ? "Switch language (Spanish)" : "Cambiar idioma (Inglés)"}
    >
      <svg class="h-3.5 w-3.5 stroke-current fill-none shrink-0 transition-transform duration-300 group-hover:scale-105" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m5 8 6 6"></path><path d="M4 14 6 6 2 3"></path><path d="M2 5h12"></path><path d="M7 2h1"></path><path d="m22 22-5-10-5 10"></path><path d="M14 18h6"></path>
      </svg>
    </span>
    {currentLocale === "en" ? (
      <span class="h-6 px-2 sm:px-2.5 min-w-[28px] sm:min-w-[32px] inline-flex items-center justify-center rounded font-semibold text-center text-xs bg-[var(--color-surface-border)] text-[var(--color-text-primary)] shadow-xs select-none">EN</span>
    ) : (
      <a href={effectiveTargetUrl} hreflang="en" lang="en" data-astro-prefetch="hover" data-lang-switch="en" class="h-6 px-2 sm:px-2.5 min-w-[28px] sm:min-w-[32px] inline-flex items-center justify-center rounded font-medium text-center text-xs text-[var(--color-text-muted)] hover:text-[var(--color-accent-gold)] hover:bg-[var(--color-surface-border)]/40 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)] cursor-pointer">EN</a>
    )}
    <span class="text-[var(--color-surface-border)] select-none text-[10px] leading-none" aria-hidden="true">/</span>
    {currentLocale === "es" ? (
      <span class="h-6 px-2 sm:px-2.5 min-w-[28px] sm:min-w-[32px] inline-flex items-center justify-center rounded font-semibold text-center text-xs bg-[var(--color-surface-border)] text-[var(--color-text-primary)] shadow-xs select-none">ES</span>
    ) : (
      <a href={effectiveTargetUrl} hreflang="es" lang="es" data-astro-prefetch="hover" data-lang-switch="es" class="h-6 px-2 sm:px-2.5 min-w-[28px] sm:min-w-[32px] inline-flex items-center justify-center rounded font-medium text-center text-xs text-[var(--color-text-muted)] hover:text-[var(--color-accent-gold)] hover:bg-[var(--color-surface-border)]/40 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)] cursor-pointer">ES</a>
    )}
  </div>
</nav>

<script>
  // Astro owns navigation and history; only the locale click's viewport offset
  // is restored after Astro has performed its default scroll for the new page.
  let pendingScroll: { url: string; y: number } | null = null;
  function syncLanguageSwitcherTargetUrls() {
    const targetUrls: Record<string, string> = {};
    document.head.querySelectorAll<HTMLLinkElement>('link[rel="alternate"][hreflang]').forEach((link) => {
      const href = new URL(link.href, location.href);
      if (href.origin === location.origin) {
        targetUrls[link.hreflang] = href.pathname + href.search + href.hash;
      }
    });
    document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]").forEach((link) => {
      const url = targetUrls[link.dataset.langSwitch || ""];
      if (url) link.href = url;
    });
  }

  if (!(window as Window & { __languageSwitcherInstalled?: boolean }).__languageSwitcherInstalled) {
    (window as Window & { __languageSwitcherInstalled?: boolean }).__languageSwitcherInstalled = true;
    document.addEventListener("astro:after-swap", () => {
      syncLanguageSwitcherTargetUrls();
      const pending = pendingScroll;
      pendingScroll = null;
      if (pending && location.href === pending.url) {
        window.scrollTo({ top: pending.y, behavior: "instant" });
      }
    });
    document.addEventListener("click", (event) => {
      const link = (event.target as Element)?.closest<HTMLAnchorElement>("[data-lang-switch]");
      if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const target = new URL(link.href, location.href);
      if (target.origin !== location.origin) return;
      const lang = link.dataset.langSwitch;
      if (!lang) return;
      if (!target.search) target.search = location.search;
      if (!target.hash) target.hash = location.hash;
      link.href = target.href;
      pendingScroll = { url: target.href, y: window.scrollY };
      try {
        sessionStorage.setItem("preferred_locale", lang);
        sessionStorage.setItem("lang_manual_override", "true");
        sessionStorage.setItem("lang_banner_dismissed", "true");
        localStorage.setItem("lang-banner-dismissed", "true");
        localStorage.setItem("preferred_locale", lang);
        document.cookie = `preferred_locale=${lang}; path=/; max-age=31536000; SameSite=Lax`;
      } catch { /* Storage is optional. */ }
      const banner = document.getElementById("lang-suggestion-banner");
      if (banner) {
        banner.hidden = true;
        banner.style.display = "none";
      }
    }, { capture: true });
  }
</script>
