---
// ThemeToggle.astro - Zero-Framework Accessible Theme Switcher (Dark / Light)
---

<button
  type="button"
  id="theme-toggle"
  aria-label="Toggle color theme"
  title="Toggle dark / light theme"
  class="relative flex h-8 w-8 min-w-[32px] min-h-[32px] items-center justify-center rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-secondary)] transition-all hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)] shrink-0 cursor-pointer"
>
  <!-- Sun Icon (shown when theme is dark, to switch to light) -->
  <svg
    id="theme-icon-sun"
    class="h-3.5 w-3.5 stroke-current fill-none"
    viewBox="0 0 24 24"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>

  <!-- Moon Icon (shown when theme is light, to switch to dark) -->
  <svg
    id="theme-icon-moon"
    class="hidden h-3.5 w-3.5 stroke-current fill-none"
    viewBox="0 0 24 24"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script is:inline>
  // Rapid Master Toggle to enable/disable circular theme animation
  // Can be toggled in code (ENABLE_THEME_ANIMATION = false) or dynamically at runtime:
  //   window.__DISABLE_THEME_ANIMATION__ = true;
  // or
  //   localStorage.setItem('disable_theme_anim', 'true');
  var ENABLE_THEME_ANIMATION = true;

  function setupThemeToggle() {
    var toggleBtn = document.getElementById("theme-toggle");
    var sunIcon = document.getElementById("theme-icon-sun");
    var moonIcon = document.getElementById("theme-icon-moon");

    if (!toggleBtn || !sunIcon || !moonIcon) return;

    function syncIcons(currentTheme) {
      if (currentTheme === "light") {
        sunIcon?.classList.add("hidden");
        moonIcon?.classList.remove("hidden");
        toggleBtn?.setAttribute("aria-label", "Switch to dark theme");
      } else {
        sunIcon?.classList.remove("hidden");
        moonIcon?.classList.add("hidden");
        toggleBtn?.setAttribute("aria-label", "Switch to light theme");
      }
    }

    var current =
      localStorage.getItem("theme") ||
      document.documentElement.getAttribute("data-theme") ||
      "dark";
    syncIcons(current);

    function applyTheme(nextTheme) {
      document.documentElement.setAttribute("data-theme", nextTheme);
      if (nextTheme === "light") {
        document.documentElement.classList.remove("dark");
        document.documentElement.classList.add("light");
        document.documentElement.style.backgroundColor = "#F4F6F8";
        document.documentElement.style.colorScheme = "light";
      } else {
        document.documentElement.classList.add("dark");
        document.documentElement.classList.remove("light");
        document.documentElement.style.backgroundColor = "#260205";
        document.documentElement.style.colorScheme = "dark";
      }
      localStorage.setItem("theme", nextTheme);
      syncIcons(nextTheme);

      window.dispatchEvent(
        new CustomEvent("theme-changed", {
          detail: { theme: nextTheme },
        }),
      );
    }

    toggleBtn.onclick = function (event) {
      var activeTheme =
        document.documentElement.getAttribute("data-theme") || "dark";
      var nextTheme = activeTheme === "light" ? "dark" : "light";

      var prefersReduced =
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var isAnimationDisabled =
        !ENABLE_THEME_ANIMATION ||
        window.__DISABLE_THEME_ANIMATION__ === true ||
        (function () {
          try {
            return localStorage.getItem("disable_theme_anim") === "true";
          } catch (_) {
            return false;
          }
        })();

      if (
        !document.startViewTransition ||
        prefersReduced ||
        isAnimationDisabled
      ) {
        applyTheme(nextTheme);
        return;
      }

      var rect = toggleBtn.getBoundingClientRect();
      var x =
        event && typeof event.clientX === "number" && event.clientX > 0
          ? event.clientX
          : rect.left + rect.width / 2;
      var y =
        event && typeof event.clientY === "number" && event.clientY > 0
          ? event.clientY
          : rect.top + rect.height / 2;
      var endRadius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y),
      );

      document.documentElement.setAttribute("data-theme-transitioning", "true");
      document.documentElement.classList.add("theme-transitioning");

      var transition = document.startViewTransition(function () {
        applyTheme(nextTheme);
      });

      var cleanUp = function () {
        requestAnimationFrame(function () {
          document.documentElement.classList.remove("theme-transitioning");
          document.documentElement.removeAttribute("data-theme-transitioning");
          window.dispatchEvent(new CustomEvent("theme-transition-end"));
        });
      };

      transition.ready
        .then(function () {
          var animation = document.documentElement.animate(
            {
              clipPath: [
                "circle(0px at " + x + "px " + y + "px)",
                "circle(" + endRadius + "px at " + x + "px " + y + "px)",
              ],
            },
            {
              duration: 950,
              easing: "cubic-bezier(0.2, 0.9, 0.2, 1)",
              pseudoElement: "::view-transition-new(root)",
            },
          );
          animation.onfinish = cleanUp;
          animation.oncancel = cleanUp;
        })
        .catch(cleanUp);

      transition.finished.then(cleanUp).catch(cleanUp);
    };
  }

  setupThemeToggle();
  document.addEventListener("astro:page-load", setupThemeToggle);
</script>
