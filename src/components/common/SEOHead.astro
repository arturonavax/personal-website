---
import { ensureUnifiedGraphJsonLd } from "@/lib/seo/schema-builder";
import { resolveVerifiedHreflang } from "@/utils/seo";
import {
  resolveSocialImageUrl,
  SOCIAL_IMAGE_WIDTH,
  SOCIAL_IMAGE_HEIGHT,
} from "@/lib/seo/og-image";

interface Props {
  title: string;
  description: string;
  locale: "en" | "es";
  canonicalUrl?: string | undefined;
  type?: "website" | "article" | "profile" | undefined;
  ogImage?: string | undefined;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>> | undefined;
  alternateEnUrl?: string | undefined;
  alternateEsUrl?: string | undefined;
  availableLocales?: readonly ("en" | "es")[] | undefined;
  noindex?: boolean | undefined;
}

const {
  title,
  description,
  locale,
  canonicalUrl,
  type = "website",
  ogImage,
  jsonLd,
  alternateEnUrl,
  alternateEsUrl,
  availableLocales,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.origin ?? "https://arturonavax.dev";
const rawPath = Astro.url.pathname;

// Ensure trailing slash on normalized routes
const normalizedPath = rawPath.endsWith("/") ? rawPath : `${rawPath}/`;

const rawCanonical = canonicalUrl ?? `${siteUrl}${normalizedPath}`;
let cleanCanonicalUrl = rawCanonical;
try {
  const parsed = new URL(rawCanonical, siteUrl);
  parsed.search = "";
  parsed.hash = "";
  if (
    !parsed.pathname.endsWith("/") &&
    !/\.[a-zA-Z0-9]+$/i.test(parsed.pathname)
  ) {
    parsed.pathname = `${parsed.pathname}/`;
  }
  cleanCanonicalUrl = parsed.toString();
} catch (_) {
  cleanCanonicalUrl = rawCanonical.split("?")[0]!.split("#")[0]!;
  if (
    !cleanCanonicalUrl.endsWith("/") &&
    !/\.[a-zA-Z0-9]+$/i.test(cleanCanonicalUrl)
  ) {
    cleanCanonicalUrl = `${cleanCanonicalUrl}/`;
  }
}

const { enUrl, esUrl, xDefaultUrl } = resolveVerifiedHreflang({
  locale,
  canonicalUrl: cleanCanonicalUrl,
  alternateEnUrl,
  alternateEsUrl,
  availableLocales,
  siteUrl,
});

const FALLBACK_TITLE = "Arturo Nava | Senior Backend & AI Systems Engineer";
const FALLBACK_DESCRIPTION =
  "Senior Software Engineer & AI Architect specializing in Go, Rust, Python, high-concurrency distributed systems, and edge infrastructure.";

const finalTitle =
  title && title.trim().length > 0 ? title.trim() : FALLBACK_TITLE;
const finalDescription =
  description && description.trim().length > 0
    ? description.trim()
    : FALLBACK_DESCRIPTION;

const pageTitle = finalTitle.includes("Arturo Nava")
  ? finalTitle
  : `${finalTitle} | Arturo Nava`;
const resolvedOgImage = resolveSocialImageUrl({
  explicitImage: ogImage,
  pathname: Astro.url.pathname,
  siteUrl,
  production: import.meta.env.PROD,
  noindex,
});
const socialImageAlt = `${finalTitle} — ${locale === "es" ? "Arturo Nava, ingeniería de software" : "Arturo Nava, software engineering"}`;

const normalizedJsonLd = ensureUnifiedGraphJsonLd(jsonLd, {
  locale,
  canonicalUrl: cleanCanonicalUrl,
  title: pageTitle,
  description: finalDescription,
});
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={finalDescription} />
<link rel="canonical" href={cleanCanonicalUrl} />
{enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
{esUrl && <link rel="alternate" hreflang="es" href={esUrl} />}
{xDefaultUrl && (
  <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
)}

<link
  rel="preload"
  href="/fonts/Geist-Variable.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  href="/fonts/GeistMono-Variable.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>

<!-- 1. SVG para navegadores modernos con soporte vectorial -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<!-- 2. PNG de 48px para Googlebot-Favicon -->
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
<!-- 3. Fallback clásico de compatibilidad -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<!-- 4. iOS / Safari Web Clip -->
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<!-- 5. Web App Manifest -->
<link rel="manifest" href="/site.webmanifest" />

<meta name="generator" content={Astro.generator} />

<!-- RSS Auto-Discovery -->
<link
  rel="alternate"
  type="application/rss+xml"
  title="Arturo Nava — Engineering &amp; AI RSS Feed"
  href="/rss.xml"
/>

<!-- Primary Meta Tags -->
<meta name="title" content={pageTitle} />
<meta name="author" content="Arturo Nava" />
<meta name="color-scheme" content="dark light" />
<meta
  name="theme-color"
  content="#1E0103"
  media="(prefers-color-scheme: dark)"
/>
<meta
  name="theme-color"
  content="#F4F6F8"
  media="(prefers-color-scheme: light)"
/>

<!-- Dynamic Canonical Synchronization across ClientRouter Transitions -->
<script>
  (function () {
    function syncCanonical() {
      const canonicalLink = document.querySelector('link[rel="canonical"]');
      const ogUrlMeta = document.querySelector('meta[property="og:url"]');
      const pathname = window.location.pathname.endsWith("/")
        ? window.location.pathname
        : window.location.pathname + "/";
      const cleanUrl = window.location.origin + pathname;
      if (canonicalLink) {
        canonicalLink.setAttribute("href", cleanUrl);
      }
      if (ogUrlMeta) {
        ogUrlMeta.setAttribute("content", cleanUrl);
      }
    }

    if (!(window as any).__hasWrappedCanonicalHistory) {
      (window as any).__hasWrappedCanonicalHistory = true;
      document.addEventListener("astro:page-load", syncCanonical);
      document.addEventListener("astro:after-swap", syncCanonical);
      window.addEventListener("popstate", syncCanonical);
      const originalReplaceState = history.replaceState;
      history.replaceState = function (
        data: any,
        unused: string,
        url?: string | URL | null,
      ) {
        originalReplaceState.call(this, data, unused, url);
        syncCanonical();
      };
      const originalPushState = history.pushState;
      history.pushState = function (
        data: any,
        unused: string,
        url?: string | URL | null,
      ) {
        originalPushState.call(this, data, unused, url);
        syncCanonical();
      };
    }
  })();
</script>

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={cleanCanonicalUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={finalDescription} />
<meta property="og:image" content={resolvedOgImage} />
{resolvedOgImage.startsWith("https:") && (
  <meta property="og:image:secure_url" content={resolvedOgImage} />
)}
{!ogImage && (
  <>
    <meta property="og:image:width" content={String(SOCIAL_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(SOCIAL_IMAGE_HEIGHT)} />
    <meta property="og:image:type" content="image/png" />
  </>
)}
<meta property="og:image:alt" content={socialImageAlt} />
<meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
{(locale === "es" ? enUrl : esUrl) && (
  <meta
    property="og:locale:alternate"
    content={locale === "es" ? "en_US" : "es_ES"}
  />
)}
<meta
  property="og:site_name"
  content="Arturo Nava - Senior Software / AI Engineer"
/>

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@arturonavax" />
<meta name="twitter:creator" content="@arturonavax" />
<meta name="twitter:url" content={cleanCanonicalUrl} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={finalDescription} />
<meta name="twitter:image" content={resolvedOgImage} />
<meta name="twitter:image:alt" content={socialImageAlt} />

<!-- llms.txt -->
<link
  rel="describedby"
  type="text/plain"
  href="https://arturonavax.dev/llms.txt"
/>

<!-- robots.txt / search engine directives -->
<meta
  name="robots"
  content={
    noindex
      ? "noindex, nofollow"
      : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  }
/>

<!-- Structured Data (JSON-LD) -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(normalizedJsonLd)}
/>
