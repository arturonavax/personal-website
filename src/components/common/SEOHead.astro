---
interface Props {
  title: string;
  description: string;
  locale: "en" | "es";
  canonicalUrl?: string | undefined;
  type?: "website" | "article" | "profile" | undefined;
  ogImage?: string | undefined;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>> | undefined;
  alternateEnUrl?: string | undefined;
  alternateEsUrl?: string | undefined;
}

const {
  title,
  description,
  locale,
  canonicalUrl,
  type = "website",
  ogImage = "/og-default.png",
  jsonLd,
  alternateEnUrl,
  alternateEsUrl,
} = Astro.props;

const siteUrl = Astro.site?.origin ?? "https://arturonavax.dev";
const rawPath = Astro.url.pathname;

// Asegurar siempre trailing slash en rutas normalizadas
const normalizedPath = rawPath.endsWith("/") ? rawPath : `${rawPath}/`;

const rawCanonical = canonicalUrl ?? `${siteUrl}${normalizedPath}`;
let cleanCanonicalUrl = rawCanonical;
try {
  const parsed = new URL(rawCanonical, siteUrl);
  parsed.search = "";
  if (
    !parsed.pathname.endsWith("/") &&
    !/\.[a-zA-Z0-9]+$/i.test(parsed.pathname)
  ) {
    parsed.pathname = `${parsed.pathname}/`;
  }
  cleanCanonicalUrl = parsed.toString();
} catch (_) {
  cleanCanonicalUrl = rawCanonical.split("?")[0]!;
}

// Hreflang URLs con trailing slash estricto (solo si la contraparte existe)
const enUrl =
  locale === "en"
    ? cleanCanonicalUrl
    : alternateEnUrl
      ? `${siteUrl}${alternateEnUrl.endsWith("/") ? alternateEnUrl : `${alternateEnUrl}/`}`
      : undefined;

const esUrl =
  locale === "es"
    ? cleanCanonicalUrl
    : alternateEsUrl
      ? `${siteUrl}${alternateEsUrl.endsWith("/") ? alternateEsUrl : `${alternateEsUrl}/`}`
      : undefined;

const xDefaultUrl = enUrl ?? `${siteUrl}/`;

const pageTitle = title.includes("Arturo Nava")
  ? title
  : `${title} | Arturo Nava`;
const resolvedOgImage = ogImage.startsWith("http")
  ? ogImage
  : `${siteUrl}${ogImage}`;
---

<!-- RSS Auto-Discovery -->
<link
  rel="alternate"
  type="application/rss+xml"
  title="Arturo Nava — Engineering Blog &amp; Systems Notes"
  href="https://arturonavax.dev/rss.xml"
/>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- 1. SVG para navegadores modernos con soporte vectorial -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<!-- 2. PNG de 48px para Googlebot-Favicon -->
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
<!-- 3. Fallback clásico de compatibilidad -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<!-- 4. iOS / Safari Web Clip -->
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<meta name="generator" content={Astro.generator} />

<!-- Critical Body Font Preload (AGENTS.md: Critical body font only) -->
<link
  rel="preload"
  href="/fonts/Geist-Variable.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
<meta name="author" content="Arturo Nava" />
<meta name="color-scheme" content="dark light" />
<meta
  name="theme-color"
  content="#1E0103"
  media="(prefers-color-scheme: dark)"
/>
<meta
  name="theme-color"
  content="#F4F6F8"
  media="(prefers-color-scheme: light)"
/>

<!-- Canonical URL -->
<link rel="canonical" href={cleanCanonicalUrl} />

<!-- Alternate Multilingual Hreflang Tags -->
{enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
{esUrl && <link rel="alternate" hreflang="es" href={esUrl} />}
{xDefaultUrl && (
  <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
)}

<!-- Dynamic Canonical Synchronization across ClientRouter Transitions -->
<script is:inline>
  (function () {
    function syncCanonical() {
      const canonicalLink = document.querySelector('link[rel="canonical"]');
      const ogUrlMeta = document.querySelector('meta[property="og:url"]');
      const pathname = window.location.pathname.endsWith("/")
        ? window.location.pathname
        : window.location.pathname + "/";
      const cleanUrl = window.location.origin + pathname;
      if (canonicalLink) {
        canonicalLink.setAttribute("href", cleanUrl);
      }
      if (ogUrlMeta) {
        ogUrlMeta.setAttribute("content", cleanUrl);
      }
    }

    document.addEventListener("astro:page-load", syncCanonical);
    window.addEventListener("popstate", syncCanonical);
    const originalReplaceState = history.replaceState;
    history.replaceState = function () {
      originalReplaceState.apply(this, arguments);
      syncCanonical();
    };
    const originalPushState = history.pushState;
    history.pushState = function () {
      originalPushState.apply(this, arguments);
      syncCanonical();
    };
  })();
</script>

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={cleanCanonicalUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:secure_url" content={resolvedOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta
  property="og:image:alt"
  content="Arturo Nava — Senior Software / AI Engineer"
/>
<meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
<meta
  property="og:locale:alternate"
  content={locale === "es" ? "en_US" : "es_ES"}
/>
<meta
  property="og:site_name"
  content="Arturo Nava — Senior Software / AI Engineer"
/>

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@arturonavax" />
<meta name="twitter:creator" content="@arturonavax" />
<meta name="twitter:url" content={cleanCanonicalUrl} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />
<meta
  name="twitter:image:alt"
  content="Arturo Nava — Senior Software / AI Engineer"
/>

<!-- llms.txt -->
<link
  rel="describedby"
  type="text/plain"
  href="https://arturonavax.dev/llms.txt"
/>

<!-- robots.txt -->
<meta
  name="robots"
  content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
/>

<!-- Structured Data (JSON-LD) -->
{jsonLd && (
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(
      Array.isArray(jsonLd) && jsonLd.length === 1 ? jsonLd[0] : jsonLd,
    )}
  />
)}
