---
interface Props {
  title: string;
  description: string;
  locale: "en" | "es";
  canonicalUrl?: string | undefined;
  type?: "website" | "article" | "profile" | undefined;
  ogImage?: string | undefined;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>> | undefined;
  alternateEnUrl?: string | undefined;
  alternateEsUrl?: string | undefined;
}

const {
  title,
  description,
  locale,
  canonicalUrl,
  type = "website",
  ogImage = "/og-default.png",
  jsonLd,
  alternateEnUrl,
  alternateEsUrl,
} = Astro.props;

const siteUrl = Astro.site?.origin ?? "https://arturonavax.dev";
const rawPath = Astro.url.pathname;
const normalizedPath =
  rawPath.length > 1 && rawPath.endsWith("/") ? rawPath.slice(0, -1) : rawPath;
const currentCanonical =
  canonicalUrl ?? `${siteUrl}${normalizedPath === "/" ? "" : normalizedPath}`;

// Hreflang URLs
const enPath =
  alternateEnUrl ??
  (locale === "es"
    ? normalizedPath.replace(/^\/es/, "") || "/"
    : normalizedPath);
const esPath =
  alternateEsUrl ??
  (locale === "en"
    ? `/es${normalizedPath === "/" ? "" : normalizedPath}`
    : normalizedPath);

const enUrl = `${siteUrl}${enPath === "/" ? "" : enPath}`;
const esUrl = `${siteUrl}${esPath === "/" ? "" : esPath}`;
const xDefaultUrl = enUrl;

const pageTitle = title.includes("Arturo Nava")
  ? title
  : `${title} | Arturo Nava`;
const resolvedOgImage = ogImage.startsWith("http")
  ? ogImage
  : `${siteUrl}${ogImage}`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Critical Body Font Preload (AGENTS.md: Critical body font only) -->
<link
  rel="preload"
  href="/fonts/Geist-Variable.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
<meta name="author" content="Arturo Nava" />
<meta name="color-scheme" content="dark light" />
<meta
  name="theme-color"
  content="#1E0103"
  media="(prefers-color-scheme: dark)"
/>
<meta
  name="theme-color"
  content="#F4F6F8"
  media="(prefers-color-scheme: light)"
/>

<!-- Canonical URL -->
<link rel="canonical" href={currentCanonical} />

<!-- Alternate Multilingual Hreflang Tags -->
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="es" href={esUrl} />
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={currentCanonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
<meta
  property="og:locale:alternate"
  content={locale === "es" ? "en_US" : "es_ES"}
/>
<meta
  property="og:site_name"
  content="Arturo Nava — Senior Software / AI Engineer"
/>

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@arturonavax" />
<meta name="twitter:creator" content="@arturonavax" />
<meta name="twitter:url" content={currentCanonical} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />

<!-- Structured Data (JSON-LD) -->
{jsonLd && (
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd])}
  />
)}
