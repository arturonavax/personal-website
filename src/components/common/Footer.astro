---
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const rssUrl = locale === "es" ? "/es/rss.xml" : "/rss.xml";
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[var(--color-surface-border)] bg-[var(--color-surface-card)] text-xs text-[var(--color-text-muted)]">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-6 px-4 pt-8 pb-20 sm:py-8 sm:px-6 lg:flex-row">
    <div class="flex flex-col items-center gap-1 font-mono text-center lg:items-start lg:text-left">
      <p class="text-[var(--color-text-primary)] font-medium">
        &copy; {currentYear} Arturo Nava.
      </p>
      <p class="text-[11px] text-[var(--color-text-secondary)] flex flex-wrap items-center justify-center lg:justify-start gap-x-2 gap-y-1">
        <span>
          High-Performance Edge Architecture &bull; 0 KB Baseline Client JS
        </span>
        <span class="hidden sm:inline-flex items-center gap-1 text-[var(--color-text-muted)] border-l border-[var(--color-surface-border)] pl-2">
          <span>{locale === "es" ? "Scroll:" : "Scroll:"}</span>
          <kbd
            data-vim-key="j"
            class="rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-1 py-0.2 text-[9px] text-[var(--color-text-secondary)] transition-colors"
          >
            j
          </kbd>
          <kbd
            data-vim-key="k"
            class="rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-1 py-0.2 text-[9px] text-[var(--color-text-secondary)] transition-colors"
          >
            k
          </kbd>
        </span>
      </p>
    </div>

    <!-- Social & Communication Outlines -->
    <div class="flex flex-wrap items-center justify-center gap-x-4 sm:gap-x-5 gap-y-2.5 font-mono lg:justify-end">
      <!-- GitHub -->
      <a
        href="https://github.com/arturonavax"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="group flex items-center gap-1.5 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-gold)] transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)] shrink-0"
      >
        <svg
          class="h-4 w-4 stroke-current fill-none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
        </svg>
        <span>{t("cta.github")}</span>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/arturonavax"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn Profile"
        class="group flex items-center gap-1.5 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-gold)] transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)] shrink-0"
      >
        <svg
          class="h-4 w-4 stroke-current fill-none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect x="2" y="9" width="4" height="12"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
        <span>{t("cta.linkedin")}</span>
      </a>

      <!-- X (Twitter) -->
      <a
        href="https://x.com/arturonavax"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="X Profile"
        class="group flex items-center gap-1.5 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-gold)] transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)] shrink-0"
      >
        <svg
          class="h-3.5 w-3.5 stroke-current fill-none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 4l16 16M4 20L20 4"></path>
        </svg>
        <span>X</span>
      </a>

      <!-- Instagram -->
      <a
        href="https://instagram.com/arturonavax"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram Profile"
        class="group flex items-center gap-1.5 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-gold)] transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)] shrink-0"
      >
        <svg
          class="h-3.5 w-3.5 stroke-current fill-none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
        <span>Instagram</span>
      </a>

      <!-- Email -->
      <!--email_off-->
      <a
        href="mailto:arturonavax@gmail.com"
        aria-label="Email Arturo Nava"
        class="group flex items-center gap-1.5 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-gold)] transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)] shrink-0"
      >
        <svg
          class="h-4 w-4 stroke-current fill-none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <span>{t("cta.email")}</span>
      </a>
      <!--/email_off-->

      <!-- RSS -->
      <a
        href={rssUrl}
        aria-label="Technical RSS Feed"
        class="group flex items-center gap-1.5 text-[var(--color-accent-gold)] hover:underline focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)] shrink-0"
      >
        <svg
          class="h-3.5 w-3.5 stroke-current fill-none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1" fill="currentColor"></circle>
        </svg>
        <span>RSS</span>
      </a>
    </div>
  </div>
</footer>
