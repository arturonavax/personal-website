---
interface Props {
  email: string;
  label?: string;
  class?: string;
  buttonClass?: string;
  locale?: "en" | "es" | undefined;
}

const {
  email,
  label,
  class: className = "",
  buttonClass = "group inline-flex items-center gap-1.5 font-mono text-sm text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-accent-gold)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-gold)] cursor-pointer",
  locale,
} = Astro.props;

const isEs = locale === "es";
const copiedText = isEs ? "Copiado al portapapeles" : "Copied to clipboard";
---

<email-copy-trigger
  data-email={email}
  data-copied-en="Copied to clipboard"
  data-copied-es="Copiado al portapapeles"
  class={`inline-flex items-center gap-1.5 ${className}`}
>
  <button
    type="button"
    class={buttonClass}
    aria-label={`Copy email address ${email} to clipboard`}
  >
    <span>{label || email}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-3.5 w-3.5 opacity-60 transition-transform group-hover:scale-110 group-active:scale-95"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
    </svg>
  </button>

  <span
    class="copy-feedback hidden no-lang-react pointer-events-none fixed bottom-8 left-1/2 -translate-x-1/2 z-[70] rounded-lg border border-[var(--color-surface-border)] bg-[var(--color-surface-card)]/95 px-4 py-2 font-mono text-xs text-[var(--color-text-primary)] opacity-0 shadow-2xl backdrop-blur-md transition-opacity duration-200 whitespace-nowrap"
    role="status"
    aria-live="polite"
    aria-hidden="true"
  >
    {copiedText}
  </span>
</email-copy-trigger>

<script>
  class EmailCopyTrigger extends HTMLElement {
    private button: HTMLButtonElement | null = null;
    private feedback: HTMLElement | null = null;
    private timeoutId: ReturnType<typeof setTimeout> | null = null;

    connectedCallback(): void {
      this.button = this.querySelector("button");
      this.feedback = this.querySelector(".copy-feedback");
      this.button?.addEventListener("click", this.handleCopy);
    }

    disconnectedCallback(): void {
      this.button?.removeEventListener("click", this.handleCopy);
      if (this.timeoutId) clearTimeout(this.timeoutId);
    }

    private handleCopy = async (e: Event): Promise<void> => {
      e.preventDefault();
      e.stopPropagation();
      const email = this.dataset.email;
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
        if (this.feedback) {
          const isDocEs = document.documentElement.lang === "es";
          const dynamicText = isDocEs
            ? this.dataset.copiedEs || "Copiado al portapapeles"
            : this.dataset.copiedEn || "Copied to clipboard";
          this.feedback.textContent = dynamicText;
          this.feedback.setAttribute("aria-hidden", "false");
          this.feedback.classList.remove("hidden", "opacity-0");
          this.feedback.classList.add("opacity-100");
          if (this.timeoutId) clearTimeout(this.timeoutId);
          this.timeoutId = setTimeout(() => {
            this.feedback?.classList.remove("opacity-100");
            this.feedback?.classList.add("opacity-0");
            this.feedback?.setAttribute("aria-hidden", "true");
            setTimeout(() => {
              this.feedback?.classList.add("hidden");
            }, 200);
          }, 2000);
        }
      } catch (err) {
        console.error("Clipboard write operation failed:", err);
      }
    };
  }

  if (!customElements.get("email-copy-trigger")) {
    customElements.define("email-copy-trigger", EmailCopyTrigger);
  }
</script>
