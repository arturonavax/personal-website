---
import type { Locale } from "@/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEs = locale === "es";

const aiWorkflowPillars = [
  {
    tool: "Spec-Driven Dev (SDD)",
    badge: "Schema-First",
    detail: isEs
      ? "Especificaciones formales, diseño de invariantes y contratos de tipos estrictos antes de cualquier ciclo generativo para evitar desvíos."
      : "Formal architectural specs, system invariants, and strict type contracts defined before generative execution loops to prevent drift.",
  },
  {
    tool: "Continuous Evals & Guardrails",
    badge: "Zero Hallucination",
    detail: isEs
      ? "Evaluación continua y testing adversarial con Promptfoo y Langfuse para detectar alucinaciones y regresiones antes de producción."
      : "Continuous evaluation and adversarial testing with Promptfoo and Langfuse to eliminate hallucinations and regressions before production.",
  },
  {
    tool: "Context Protocol & Multi-Agent DAGs",
    badge: "MCP / Workflows",
    detail: isEs
      ? "Descomposición jerárquica de tareas en grafos estructurados e integración directa de herramientas mediante Model Context Protocol (MCP)."
      : "Hierarchical task decomposition into structured graphs and external tool execution via standard Model Context Protocol (MCP).",
  },
  {
    tool: "Stateful Daemon Supervision",
    badge: "Crash-Resilient",
    detail: isEs
      ? "Supervisión de daemons de larga duración con checkpoints de sesión incrementales y recuperación resiliente ante caídas de procesos."
      : "Long-running daemon supervision with resilient session checkpointing and automated crash recovery for autonomous coding workflows.",
  },
];
---

<section
  id="ai-workflow"
  aria-labelledby="ai-workflow-heading"
  class="space-y-4"
>
  <div class="flex items-center justify-between border-b border-[var(--color-surface-border)] pb-3">
    <div>
      <span class="font-mono text-xs text-[var(--color-accent-gold)] tracking-widest uppercase font-semibold">
        {isEs
          ? "ORQUESTACIÓN DE IA & SISTEMAS AGÉNTICOS"
          : "AI ORCHESTRATION & AGENTIC SYSTEMS"}
      </span>
      <h2
        id="ai-workflow-heading"
        class="text-xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-2xl mt-0.5"
      >
        {isEs
          ? "Ingeniería de IA en Producción & Guardrails Deterministas"
          : "Production AI Engineering & Deterministic Toolchains"}
      </h2>
    </div>
    <span class="text-xs font-mono text-[var(--color-text-muted)] hidden sm:inline">
      Ghostty : Multi-Agent : Test Harnesses
    </span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4 font-mono">
    {aiWorkflowPillars.map((p) => (
      <div class="geometric-box relative p-4 sm:p-5 rounded-sm space-y-3 flex flex-col justify-between group">
        <div class="space-y-2">
          <div class="flex items-center justify-between gap-2">
            <span class="inline-block rounded-sm border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2 py-0.5 text-xs text-[var(--color-accent-gold)] font-medium">
              {p.badge}
            </span>
          </div>
          <strong class="text-[var(--color-text-primary)] font-bold text-sm sm:text-base leading-snug block group-hover:text-[var(--color-accent-gold)] transition-colors">
            {p.tool}
          </strong>
        </div>
        <p class="text-xs sm:text-sm text-[var(--color-text-secondary)] font-sans leading-relaxed">
          {p.detail}
        </p>
      </div>
    ))}
  </div>
</section>
