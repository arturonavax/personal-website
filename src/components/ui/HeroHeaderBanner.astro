---
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import TechIcon from "@/components/ui/TechIcon.astro";
import { Image } from "astro:assets";
import arturoPhoto from "@/assets/arturonava.png";
import { hasResume } from "@/data/resume";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const isEs = locale === "es";

const techStack = [
  { name: "Go / Golang", category: "core" },
  { name: "Rust", category: "core" },
  { name: "Python", category: "core" },
  { name: "TypeScript", category: "core" },
  { name: "Assembly (SIMD)", category: "core" },
  { name: "SQL", category: "core" },
  { name: "AWS DynamoDB", category: "data" },
  { name: "Snowflake OLAP", category: "data" },
  { name: "Redis", category: "data" },
  { name: "PostgreSQL", category: "data" },
  { name: "GCP BigQuery", category: "data" },
  { name: "Docker / K8s", category: "infra" },
  { name: "gRPC / Protobuf", category: "infra" },
  { name: "Ghostty", category: "tools" },
  { name: "Zero-Trust / SOC 2", category: "security" },
  { name: "Linux / eBPF", category: "infra" },
];
---

<section
  id="about"
  aria-labelledby="hero-heading"
  class="geometric-box relative p-5 sm:p-7 lg:p-9 rounded-sm flex flex-col justify-between lg:min-h-[calc(100dvh-5.5rem)] lg:max-h-[840px] overflow-hidden"
>
  <!-- Top Split: Technical Identity & Blueprint Specimen -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center my-auto">
    <!-- Left Column: 4 Strict Text Elements -->
    <div class="lg:col-span-8 space-y-4 sm:space-y-5 text-left min-w-0">
      <!-- 1. Eyebrow: Strict domain title without version tags or timezones -->
      <p class="text-xs sm:text-sm font-mono tracking-widest text-[var(--color-accent-gold)] uppercase font-semibold">
        {isEs
          ? "SISTEMAS DISTRIBUIDOS & ARQUITECTURA DE IA"
          : "DISTRIBUTED SYSTEMS & AI ARCHITECTURE"}
      </p>

      <!-- 2. Headline: Arturo Nava -->
      <h1
        id="hero-heading"
        class="text-4xl sm:text-6xl font-extrabold tracking-tight text-[var(--color-text-primary)] leading-tight"
      >
        Arturo Nava
      </h1>

      <!-- 3. Subtext: Strictly under 20 words -->
      <p class="text-base sm:text-lg text-[var(--color-text-secondary)] font-normal leading-relaxed max-w-2xl [overflow-wrap:anywhere]">
        {isEs
          ? "Diseño arquitecturas de alta concurrencia en Go y Rust, motores anti-fraude sub-50ms y pipelines de agentes autónomos."
          : "Designing high-concurrency Go and Rust architectures, sub-50ms fraud engines, and autonomous AI pipelines with zero-trust DevSecOps."}
      </p>

      <!-- 4. CTAs: Single-line desktop action bar with Primary & Secondary -->
      <div class="pt-2 flex flex-wrap items-center gap-3 font-mono text-xs sm:text-sm">
        <a
          href="#contact"
          class="btn-gold px-5 py-2.5 inline-flex items-center gap-2 shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
        >
          <svg
            class="h-4 w-4 stroke-current fill-none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
          <span>{isEs ? "Contactar" : "Get in touch"}</span>
        </a>

        {hasResume && (
          <a
            href={isEs ? "/es/resume/" : "/resume/"}
            data-astro-prefetch="hover"
            class="btn-secondary px-5 py-2.5 inline-flex items-center gap-2 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
          >
            <svg
              class="h-4 w-4 stroke-current fill-none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            <span>{isEs ? "Ver CV" : "View CV"}</span>
          </a>
        )}
      </div>
    </div>

    <!-- Right Column: Technical Blueprint Profile Frame -->
    <div class="lg:col-span-4 flex justify-center lg:justify-end">
      <div class="relative rounded-sm border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]/80 p-4 sm:p-5 max-w-[260px] sm:max-w-[280px] w-full shadow-sm">
        <!-- Blueprint Corner Datum Marks -->
        <span class="absolute top-1 left-1.5 font-mono text-[9px] text-[var(--color-text-muted)] select-none">
          +
        </span>
        <span class="absolute top-1 right-1.5 font-mono text-[9px] text-[var(--color-text-muted)] select-none">
          +
        </span>
        <span class="absolute bottom-1 left-1.5 font-mono text-[9px] text-[var(--color-text-muted)] select-none">
          +
        </span>
        <span class="absolute bottom-1 right-1.5 font-mono text-[9px] text-[var(--color-text-muted)] select-none">
          +
        </span>

        <!-- Header Telemetry Strip -->
        <div class="flex items-center justify-between text-[10px] font-mono text-[var(--color-text-muted)] border-b border-[var(--color-surface-border-subtle)] pb-2 mb-3">
          <span class="text-[var(--color-accent-gold)] font-bold">
            SPEC // ARCH_01
          </span>
          <span>LATENCY: &lt;50ms</span>
        </div>

        <!-- Arturo Photo Specimen -->
        <div class="relative mx-auto flex justify-center py-1">
          <div class="h-32 w-32 sm:h-36 sm:w-36 rounded-full border-2 border-[var(--color-surface-border)] p-1 bg-[var(--color-surface-card)] transition-colors hover:border-[var(--color-accent-gold)]">
            <Image
              src={arturoPhoto}
              alt="Arturo Nava - Senior Software / AI Engineer"
              width={144}
              height={144}
              format="webp"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="h-full w-full rounded-full object-cover"
            />
          </div>
        </div>

        <!-- Footer Blueprint Metadata -->
        <div class="mt-3 pt-2 border-t border-[var(--color-surface-border-subtle)] font-mono text-[11px] text-[var(--color-text-secondary)] space-y-1">
          <div class="flex items-center justify-between">
            <span class="text-[var(--color-text-muted)]">STATUS:</span>
            <span class="text-[var(--color-accent-status)] font-medium flex items-center gap-1.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent-status)] inline-block"></span>
              {t("hero.badge")}
            </span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-[var(--color-text-muted)]">STACK:</span>
            <span class="text-[var(--color-accent-gold)] font-medium">
              GO / RUST / AI
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Production Technical Arsenal: Refined Hairline Strip at Base of Hero -->
  <div class="border-t border-[var(--color-surface-border-subtle)] pt-3.5 mt-6 space-y-2.5">
    <div class="flex items-center justify-between text-xs font-mono">
      <span class="text-[var(--color-accent-gold)] uppercase tracking-wider font-semibold">
        {isEs
          ? "Stack Tecnológico en Producción"
          : "Production Technical Arsenal"}
      </span>
      <span class="text-[var(--color-text-muted)] text-[11px] hidden sm:inline">
        {isEs ? "Clic para inspeccionar" : "Click to inspect"}
      </span>
    </div>

    <div class="flex flex-wrap gap-2 font-mono text-xs">
      {techStack.map((tech) => (
        <button
          type="button"
          data-tech-search={tech.name}
          title={
            isEs
              ? `Buscar proyectos y notas sobre ${tech.name}`
              : `Search projects & posts mentioning ${tech.name}`
          }
          class="inline-flex items-center gap-1.5 rounded-sm border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]/80 px-2.5 py-1 text-[var(--color-text-secondary)] transition-colors hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
        >
          <TechIcon
            name={tech.name}
            class="h-3.5 w-3.5 text-[var(--color-accent-gold)]"
          />
          <span>{tech.name}</span>
        </button>
      ))}
    </div>
  </div>
</section>
