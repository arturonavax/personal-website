---
import type { Locale } from "@/i18n/ui";
import TechIcon from "@/components/ui/TechIcon.astro";
import { Picture } from "astro:assets";
import arturoPhoto from "@/assets/arturonava.jpg";
import { hasResume } from "@/data/resume";
import ScheduleButton from "@/components/ScheduleButton.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEs = locale === "es";

const techStack = [
  { name: "Go / Golang", category: "core" },
  { name: "Rust", category: "core" },
  { name: "Python", category: "core" },
  { name: "TypeScript", category: "core" },
  { name: "Assembly (SIMD)", category: "core" },
  { name: "SQL", category: "core" },
  { name: "AWS DynamoDB", category: "data" },
  { name: "Snowflake OLAP", category: "data" },
  { name: "Redis", category: "data" },
  { name: "PostgreSQL", category: "data" },
  { name: "GCP BigQuery", category: "data" },
  { name: "Docker / K8s", category: "infra" },
  { name: "gRPC / Protobuf", category: "infra" },
  { name: "Ghostty", category: "tools" },
  { name: "Zero-Trust / SOC 2", category: "security" },
  { name: "Linux / eBPF", category: "infra" },
];
---

<section
  id="about"
  aria-labelledby="hero-heading"
  class="geometric-box relative p-4 sm:p-6 lg:p-7 rounded-sm flex flex-col justify-between shadow-card"
>
  <!-- Top Split: Technical Identity & Blueprint Specimen -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
    <!-- Left Column: 4 Strict Text Elements -->
    <div class="lg:col-span-8 space-y-3.5 sm:space-y-4 text-left sm:text-center lg:text-left min-w-0 flex flex-col items-start sm:items-center lg:items-start">
      <!-- 1. Headline: Arturo Nava -->
      <h1
        id="hero-heading"
        class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[var(--color-text-primary)] leading-tight sm:text-center lg:text-left"
      >
        Arturo Nava
      </h1>

      <!-- 2. Role Title: Senior Software / AI Engineer (Debajo del nombre) -->
      <p class="text-xs sm:text-sm font-mono tracking-widest text-[var(--color-accent-gold)] uppercase font-semibold sm:text-center lg:text-left">
        {isEs
          ? "SENIOR SOFTWARE / AI ENGINEER · +8 AÑOS DE EXPERIENCIA"
          : "SENIOR SOFTWARE / AI ENGINEER · +8 YEARS EXPERIENCE"}
      </p>

      <!-- 3. Subtext: Strictly under 20 words -->
      <p class="text-sm sm:text-base text-[var(--color-text-secondary)] font-normal leading-relaxed max-w-xl [overflow-wrap:anywhere] sm:text-center lg:text-left sm:mx-auto lg:mx-0">
        {isEs
          ? "Especializado en Go, Rust y sistemas backend con IA, arquitecturas distribuidas de alto rendimiento, Web3 y AppSec."
          : "Specializing in Go, Rust, and AI-integrated backend systems across high-performance distributed architectures, Web3, and AppSec."}
      </p>

      <!-- 4. CTAs: Single-line desktop action bar with Primary & Secondary -->
      <div class="pt-1.5 flex flex-wrap items-center justify-start sm:justify-center lg:justify-start gap-3 font-mono text-xs sm:text-sm w-full">
        <ScheduleButton
          calLink="arturonavax"
          variant="direct"
          label={isEs ? "Agendar llamada" : "Schedule a call"}
          locale={locale}
          class="btn-gold px-5 py-2.5 inline-flex items-center gap-2 shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)] cursor-pointer"
        />

        <a
          href="#contact"
          class="btn-secondary px-5 py-2.5 inline-flex items-center gap-2 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
        >
          <svg
            class="h-4 w-4 stroke-current fill-none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
          <span>{isEs ? "Contactar" : "Get in touch"}</span>
        </a>

        {hasResume && (
          <a
            href={isEs ? "/es/resume/" : "/resume/"}
            data-astro-prefetch="hover"
            class="btn-secondary px-5 py-2.5 inline-flex items-center gap-2 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
          >
            <svg
              class="h-4 w-4 stroke-current fill-none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            <span>{isEs ? "Ver CV" : "View CV"}</span>
          </a>
        )}
      </div>
    </div>

    <!-- Right Column: Architectural Specimen & Telemetry Console -->
    <div class="lg:col-span-4 flex justify-center lg:justify-end w-full">
      <div class="relative rounded-sm border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]/80 p-3.5 sm:p-4 max-w-[280px] min-[530px]:max-w-[320px] w-full lg:max-w-[300px] shadow-sm">
        <!-- Blueprint Corner Datum Marks -->
        <span
          class="absolute top-1 left-1.5 font-mono text-[9px] text-[var(--color-text-muted)] select-none"
          aria-hidden="true"
        >
          +
        </span>
        <span
          class="absolute top-1 right-1.5 font-mono text-[9px] text-[var(--color-text-muted)] select-none"
          aria-hidden="true"
        >
          +
        </span>
        <span
          class="absolute bottom-1 left-1.5 font-mono text-[9px] text-[var(--color-text-muted)] select-none"
          aria-hidden="true"
        >
          +
        </span>
        <span
          class="absolute bottom-1 right-1.5 font-mono text-[9px] text-[var(--color-text-muted)] select-none"
          aria-hidden="true"
        >
          +
        </span>

        <!-- Header Telemetry Strip -->
        <div class="flex items-center justify-between text-[10px] font-mono text-[var(--color-text-muted)] border-b border-[var(--color-surface-border-subtle)] pb-2 mb-2.5">
          <div class="flex items-center gap-1.5">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--color-accent-status)] opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--color-accent-status)]"></span>
            </span>
            <span class="text-[var(--color-accent-gold)] font-bold tracking-wider uppercase">
              {isEs
                ? "STATUS: ACTIVO // DISPONIBLE"
                : "STATUS: ACTIVE // AVAILABLE"}
            </span>
          </div>
          <span class="tracking-wider text-[var(--color-text-secondary)] font-medium">
            {isEs ? "BOGOTÁ (UTC-5 · EE. UU.)" : "BOGOTA (UTC-5 · US-ALIGNED)"}
          </span>
        </div>

        <!-- Arturo Photo Specimen (Round portrait) -->
        <div class="relative mx-auto flex justify-center py-1">
          <div class="h-28 w-28 sm:h-32 sm:w-32 rounded-full border-2 border-[var(--color-surface-border)] p-1 bg-[var(--color-surface-card)] transition-colors hover:border-[var(--color-accent-gold)] overflow-hidden shadow-sm">
            <Picture
              src={arturoPhoto}
              alt="Arturo Nava - Senior Software / AI Engineer"
              formats={["avif", "webp"]}
              widths={[160, 320]}
              sizes="(max-width: 640px) 112px, 152px"
              quality={82}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              pictureAttributes={{
                class: "block h-full w-full rounded-full overflow-hidden",
              }}
              class="h-full w-full rounded-full object-cover"
            />
          </div>
        </div>

        <!-- Integrated Telemetry Chips Grid -->
        <div class="mt-2.5 pt-2.5 border-t border-[var(--color-surface-border-subtle)] grid grid-cols-2 gap-1.5 font-mono text-[10px]">
          <div class="rounded-sm border border-[var(--color-surface-border-subtle)] bg-[var(--color-surface-card)]/70 px-2 py-1.5 flex flex-col justify-center">
            <span class="text-[var(--color-text-muted)] text-[9px] uppercase tracking-wider">
              p99 LATENCY
            </span>
            <span class="text-[var(--color-accent-gold)] font-semibold">
              // &lt;1.2ms
            </span>
          </div>
          <div class="rounded-sm border border-[var(--color-surface-border-subtle)] bg-[var(--color-surface-card)]/70 px-2 py-1.5 flex flex-col justify-center">
            <span class="text-[var(--color-text-muted)] text-[9px] uppercase tracking-wider">
              THROUGHPUT
            </span>
            <span class="text-[var(--color-accent-gold)] font-semibold">
              // 120k+ RPS
            </span>
          </div>
          <div class="rounded-sm border border-[var(--color-surface-border-subtle)] bg-[var(--color-surface-card)]/70 px-2 py-1.5 flex flex-col justify-center">
            <span class="text-[var(--color-text-muted)] text-[9px] uppercase tracking-wider">
              RUNTIME
            </span>
            <span
              class="text-[var(--color-accent-gold)] font-semibold text-[9.5px] truncate"
              title="GO · RUST · LINUX"
            >
              // GO · RUST · LINUX
            </span>
          </div>
          <div class="rounded-sm border border-[var(--color-surface-border-subtle)] bg-[var(--color-surface-card)]/70 px-2 py-1.5 flex flex-col justify-center">
            <span class="text-[var(--color-text-muted)] text-[9px] uppercase tracking-wider">
              ZERO-ALLOC
            </span>
            <span
              class="text-[var(--color-accent-gold)] font-semibold text-[9.5px] truncate"
              title="SIMD & CONCURRENCY"
            >
              // SIMD &amp; CONCURRENCY
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Production Technical Arsenal: Refined Hairline Strip at Base of Hero -->
  <div class="border-t border-[var(--color-surface-border-subtle)] pt-3 mt-5 space-y-2">
    <div class="flex items-center justify-between text-xs font-mono">
      <span class="text-[var(--color-accent-gold)] uppercase tracking-wider font-semibold">
        {isEs
          ? "Stack Tecnológico en Producción"
          : "Production Technical Arsenal"}
      </span>
      <span class="text-[var(--color-text-muted)] text-[11px] hidden sm:inline">
        {isEs ? "Clic para inspeccionar" : "Click to inspect"}
      </span>
    </div>

    <div class="flex flex-wrap gap-2 font-mono text-xs">
      {techStack.map((tech) => (
        <button
          type="button"
          data-tech-search={tech.name}
          title={
            isEs
              ? `Buscar proyectos y notas sobre ${tech.name}`
              : `Search projects & posts mentioning ${tech.name}`
          }
          class="inline-flex items-center gap-1.5 rounded-sm border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]/80 px-2.5 py-1 text-[var(--color-text-secondary)] transition-colors hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
        >
          <TechIcon
            name={tech.name}
            class="h-3.5 w-3.5 text-[var(--color-accent-gold)]"
          />
          <span>{tech.name}</span>
        </button>
      ))}
    </div>
  </div>
</section>
