---
interface Props {
  name: string;
  class?: string;
}

const { name, class: classNameProp } = Astro.props;
const className = classNameProp
  ? `${classNameProp} shrink-0`
  : "h-3.5 w-3.5 shrink-0 inline-block";

const n = name.toLowerCase().trim();

// Specific identifiable icon types
type IconType =
  | "go"
  | "rust"
  | "typescript"
  | "javascript"
  | "python"
  | "docker"
  | "kubernetes"
  | "linux"
  | "postgres"
  | "mysql"
  | "redis"
  | "snowflake"
  | "aws"
  | "cloud"
  | "graphql"
  | "grpc"
  | "cpu"
  | "crypto"
  | "github"
  | "git"
  | "terminal"
  | "code"
  | "none";

function getIconType(tech: string): IconType {
  // Programming languages
  if (
    tech === "go" ||
    tech === "golang" ||
    tech.startsWith("golang") ||
    tech.startsWith("go ") ||
    tech.includes("(go)")
  ) {
    return "go";
  }
  if (tech === "rust") return "rust";
  if (tech === "typescript" || tech === "ts") return "typescript";
  if (tech === "javascript" || tech === "js") return "javascript";
  if (tech === "python") return "python";
  if (tech === "assembly" || tech.includes("simd") || tech === "cpu")
    return "cpu";

  // DevOps & Cloud Infrastructure
  if (tech === "docker") return "docker";
  if (tech === "kubernetes" || tech === "k8s") return "kubernetes";
  if (tech.includes("linux")) return "linux";
  if (tech.includes("aws") || tech.includes("dynamodb") || tech.includes("sqs"))
    return "aws";
  if (
    tech === "gcp" ||
    tech === "cloudflare" ||
    tech.includes("google cloud") ||
    tech.includes("bigquery")
  )
    return "cloud";

  // Databases & Storage
  if (tech.includes("postgres")) return "postgres";
  if (tech.includes("mysql")) return "mysql";
  if (tech.includes("redis")) return "redis";
  if (tech.includes("snowflake")) return "snowflake";

  // APIs & Protocols
  if (tech === "graphql") return "graphql";
  if (tech === "grpc") return "grpc";

  // Cryptography & Distributed ledger
  if (
    tech.includes("bitcoin") ||
    tech.includes("cripto") ||
    tech.includes("crypto") ||
    tech.includes("merkle")
  ) {
    return "crypto";
  }

  // Version Control & Tools
  if (tech === "github") return "github";
  if (tech === "git") return "git";
  if (tech === "bash" || tech === "cli" || tech.includes("terminal"))
    return "terminal";
  if (tech === "terraform" || tech === "php" || tech === "c") return "code";

  // Architecture concepts (do not display icons)
  if (
    tech.includes("architecture") ||
    tech.includes("arquitectura") ||
    tech.includes("distributed") ||
    tech.includes("distribuidos") ||
    tech.includes("latency") ||
    tech.includes("latencia") ||
    tech.includes("rendimiento") ||
    tech.includes("performance") ||
    tech.includes("zero-trust")
  ) {
    return "none";
  }

  return "code";
}

const icon = getIconType(n);

const BRAND_COLORS: Record<IconType, string> = {
  go: "#00ADD8",
  rust: "#DEA584",
  typescript: "#3178C6",
  javascript: "#F7DF1E",
  python: "#3776AB",
  docker: "#2496ED",
  kubernetes: "#326CE5",
  linux: "#FCC624",
  postgres: "#336791",
  mysql: "#00758F",
  redis: "#DC382D",
  snowflake: "#29B5E8",
  aws: "#FF9900",
  cloud: "#F38020",
  graphql: "#E10098",
  grpc: "#244C5A",
  cpu: "#A855F7",
  crypto: "#F7931A",
  github: "#E6EDF3",
  git: "#F05032",
  terminal: "#10B981",
  code: "#E5A93C",
  none: "inherit",
};

const brandColor = BRAND_COLORS[icon];
const iconStyle =
  brandColor && brandColor !== "inherit" ? `color: ${brandColor};` : undefined;
