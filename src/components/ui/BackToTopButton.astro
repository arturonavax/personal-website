---
interface Props {
  locale?: "en" | "es" | undefined;
}

const { locale = "en" } = Astro.props;
const isEs = locale === "es";
---

<button
  type="button"
  id="back-to-top-btn"
  transition:persist="btt"
  data-semi=";"
  aria-label={isEs ? "Volver arriba" : "Back to top"}
  title={isEs ? "Volver arriba" : "Back to top"}
  class="pointer-events-none opacity-0 translate-y-2 hidden flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-[var(--color-surface-border)] bg-[var(--color-surface-card)]/95 text-[var(--color-text-secondary)] shadow-card backdrop-blur-md transition-all duration-300 hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent-gold)] cursor-pointer order-3 relative z-10 no-print print:hidden"
>
  <svg
    class="h-4 w-4 stroke-current fill-none shrink-0"
    viewBox="0 0 24 24"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
</button>

<script>
  // @ts-nocheck
  (function () {
    function updateBackToTopVisibility(animate) {
      var btn = document.getElementById("back-to-top-btn");
      if (!btn) return;

      var isResettingScroll = false;
      try {
        isResettingScroll =
          sessionStorage.getItem("nav_reset_scroll") === "1" &&
          !window.location.hash;
      } catch (_) {}

      var scrollY = isResettingScroll
        ? 0
        : window.pageYOffset || document.documentElement.scrollTop || 0;
      var shouldShow = scrollY > 400;

      // Scrolling within the same visibility range should not rewrite classes
      // or queue a transition frame on every native scroll event.
      if (animate && btn.classList.contains("opacity-100") === shouldShow) return;

      if (!animate) {
        btn.classList.add("no-transition");
      }

      if (shouldShow) {
        btn.classList.remove("hidden");
        requestAnimationFrame(function () {
          btn.classList.remove(
            "pointer-events-none",
            "opacity-0",
            "translate-y-2",
          );
          btn.classList.add(
            "pointer-events-auto",
            "opacity-100",
            "translate-y-0",
          );
        });
      } else {
        btn.classList.remove(
          "pointer-events-auto",
          "opacity-100",
          "translate-y-0",
        );
        btn.classList.add("pointer-events-none", "opacity-0", "translate-y-2");
        if (!animate) {
          btn.classList.add("hidden");
        } else {
          setTimeout(function () {
            var currScroll =
              window.pageYOffset || document.documentElement.scrollTop || 0;
            if (currScroll <= 400) {
              btn.classList.add("hidden");
            }
          }, 300);
        }
      }

      if (!animate) {
        requestAnimationFrame(function () {
          btn.classList.remove("no-transition");
        });
      }
    }

    function syncBackToTopLocale() {
      var btn = document.getElementById("back-to-top-btn");
      if (!btn) return;
      var lang =
        (document.documentElement &&
          document.documentElement.getAttribute("lang")) ||
        "en";
      var isEs = lang.indexOf("es") === 0;
      btn.setAttribute("aria-label", isEs ? "Volver arriba" : "Back to top");
      btn.setAttribute("title", isEs ? "Volver arriba" : "Back to top");
    }

    var cancelTopScroll = null;
    function cancelPendingTopScroll() {
      if (cancelTopScroll) cancelTopScroll();
    }
    document.addEventListener(
      "astro:before-preparation",
      cancelPendingTopScroll,
    );
    document.addEventListener("astro:before-swap", cancelPendingTopScroll);
    window.addEventListener("popstate", cancelPendingTopScroll);
    window.addEventListener("hashchange", cancelPendingTopScroll);
    document.addEventListener("site:route-committed", cancelPendingTopScroll);

    function setupBackToTop() {
      var btn = document.getElementById("back-to-top-btn");
      if (!btn) return;

      // Omit button on mobile browsers with built-in native Scroll-to-Top feature
      var ua = (typeof navigator !== "undefined" && navigator.userAgent) || "";
      var hasNativeScrollToTop =
        /SamsungBrowser|MiuiBrowser|XiaoMi\/Miui|HuaweiBrowser|UCBrowser/i.test(
          ua,
        );
      if (hasNativeScrollToTop) {
        btn.style.display = "none";
        btn.remove();
        return;
      }

      syncBackToTopLocale();
      window.__backToTopInitialized = true;

      if (!btn.dataset.bttBound) {
        btn.dataset.bttBound = "true";
        btn.addEventListener("click", function (e) {
          e.preventDefault();
          cancelPendingTopScroll();
          var startingUrl = window.location.href;
          var startingRoute = window.location.pathname + window.location.search;
          var startingHash = window.location.hash;
          var finished = false;
          var timeout;
          var cleanup = function (releaseNav = true) {
            if (finished) return;
            finished = true;
            clearTimeout(timeout);
            window.removeEventListener("scrollend", complete);
            cancelTopScroll = null;
            if (releaseNav) window.__isProgrammaticNav = false;
          };
          var complete = function () {
            if (finished) return;
            var sameRoute =
              window.location.href === startingUrl ||
              (window.location.pathname + window.location.search ===
                startingRoute &&
                startingHash === "#contact" &&
                window.location.hash === "");
            var atTop =
              (window.pageYOffset || document.documentElement.scrollTop || 0) <=
              1;
            cleanup(sameRoute);
            if (!sameRoute || !atTop) return;

            // Replace only the anchor, retaining the router's state and query.
            if (window.location.hash === "#contact") {
              history.replaceState(
                history.state,
                "",
                window.location.pathname + window.location.search,
              );
            }
            // Final reconciliation also covers an already-at-top fallback.
            window.__isContactInView = false;
            if (typeof window.__updateActiveNavState === "function") {
              window.__updateActiveNavState(true);
            }
          };
          cancelTopScroll = cleanup;
          window.__isProgrammaticNav = true;
          var reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          var alreadyAtTop =
            (window.pageYOffset || document.documentElement.scrollTop || 0) <=
            1;
          window.addEventListener("scrollend", complete, { once: true });
          timeout = setTimeout(complete, 1500);
          if ("scrollTo" in window) {
            window.scrollTo({
              top: 0,
              behavior: reduceMotion ? "instant" : "smooth",
            });
          } else {
            document.documentElement.scrollTop = 0;
            document.body.scrollTop = 0;
          }
          if (reduceMotion || alreadyAtTop || !("scrollTo" in window))
            complete();
        });
      }

      if (!window.__backToTopScrollBound) {
        window.__backToTopScrollBound = true;
        window.addEventListener(
          "scroll",
          function () {
            updateBackToTopVisibility(true);
          },
          { passive: true },
        );
      }

      updateBackToTopVisibility(false);
    }

    // Pre-paint sync on route transitions
    document.addEventListener("astro:after-swap", function () {
      syncBackToTopLocale();
      updateBackToTopVisibility(false);
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupBackToTop);
    } else {
      setupBackToTop();
    }
    document.addEventListener("astro:page-load", setupBackToTop);
  })();
</script>
