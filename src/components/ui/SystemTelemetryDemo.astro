  }
  :global(
    [data-company-tooltip-root]:not([data-placement="top"])
      .company-tooltip-caret
  ) {
    top: -0.375rem;
    bottom: auto;
    border-top: 1px solid var(--color-accent-gold);
    border-left: 1px solid var(--color-accent-gold);
  }

  /* When headroom allows opening upward */
  :global(
    [data-company-tooltip-root][data-placement="top"] #viewer-company-tooltip
  ) {
    bottom: 100%;
    margin-bottom: 0.5rem;
    top: auto;
    margin-top: 0;
  }
  :global(
    [data-company-tooltip-root][data-placement="top"] #viewer-company-tooltip
  )::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: -0.75rem;
    height: 0.75rem;
  }
  :global(
    [data-company-tooltip-root][data-placement="top"] .company-tooltip-caret
  ) {
