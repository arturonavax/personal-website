---
import type { Locale } from "@/i18n/ui";
import { simulationsData } from "@/data/simulations";
import { getCompanyInfo, companiesData } from "@/data/companies";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEs = locale === "es";

// Start deterministically with the most impactful architecture simulation (first in ordered list)
const hasSimulations = Boolean(simulationsData && simulationsData.length > 0);
const initialIndex = 0;
const initialSim = hasSimulations ? simulationsData[0] : null;
const initialCompanyInfo = initialSim
  ? getCompanyInfo(initialSim.company)
  : null;
const initialCompanyFilterUrl = initialSim
  ? isEs
    ? `/es/experience?company=${encodeURIComponent(initialSim.company.toLowerCase().trim())}`
    : `/experience?company=${encodeURIComponent(initialSim.company.toLowerCase().trim())}`
  : "";
---

{hasSimulations && initialSim && initialCompanyInfo && (
  <>
    <div
      id="random-telemetry-viewer"
      class="geometric-box no-corner-accents w-full relative rounded bg-[var(--color-surface-card)] has-[[data-company-tooltip-root]:hover]:z-50 has-[[data-tooltip-open='true']]:z-50"
      data-telemetry-random-viewer
      data-initial-index={initialIndex}
      data-locale={locale}
    >
      <!-- Chrome header with controls -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]/80 px-4 py-2.5 font-mono text-xs">
        <div class="flex items-center gap-2.5 flex-wrap">
          <span class="flex gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-accent-garnet)] shrink-0 aspect-square"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-accent-gold)]/60 shrink-0 aspect-square"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-accent-status)] shrink-0 aspect-square"></span>
          </span>
          <span
            class="text-[var(--color-accent-gold)] font-medium text-xs font-mono truncate max-w-[170px] min-[360px]:max-w-[220px] sm:max-w-none"
            id="viewer-script-name"
            title={initialSim.scriptName}
          >
            {initialSim.scriptName}
          </span>

          <!-- Dedicated Company Badge & Tooltip Trigger (Task 7) -->
          <div
            id="viewer-company-root"
            class="relative inline-flex items-center gap-1.5 group/company shrink-0 rounded border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] px-2 py-0.5 shadow-xs"
            data-company-tooltip-root
          >
            <!-- Click @Company links directly to timeline with company filter -->
            <a
              id="viewer-company-link"
              href={initialCompanyFilterUrl}
              title={
                isEs
                  ? `Ver trayectoria filtrada para ${initialSim.company}`
                  : `Filter timeline for ${initialSim.company}`
              }
              class="text-xs font-semibold font-mono text-[var(--color-accent-gold)] hover:underline whitespace-nowrap focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
            >
              @{initialSim.company}
            </a>

            <!-- High-visibility Info (i) Icon Badge Trigger -->
            <button
              type="button"
              id="viewer-company-trigger"
              aria-expanded="false"
              aria-label={
                isEs
                  ? `Ver información sobre ${initialSim.company}`
                  : `View information about ${initialSim.company}`
              }
              title={
                isEs
                  ? `Información sobre ${initialSim.company}`
                  : `About ${initialSim.company}`
              }
              class="inline-flex items-center justify-center h-3.5 w-3.5 rounded-full border border-[var(--color-accent-gold)]/60 bg-[var(--color-accent-gold-subtle)] text-[9px] font-mono font-bold text-[var(--color-accent-gold)] group-hover/company:bg-[var(--color-accent-gold)] group-hover/company:text-[var(--color-btn-gold-text)] transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)] cursor-pointer shrink-0"
              data-company-trigger
            >
              <span aria-hidden="true">i</span>
            </button>

            <!-- Tooltip Popup with Dynamic Placement and Compact Responsive Sizing -->
            <div
              role="tooltip"
              id="viewer-company-tooltip"
              data-company-tooltip
              class="pointer-events-none group-hover/company:pointer-events-auto opacity-0 group-hover/company:opacity-100 translate-y-1 group-hover/company:translate-y-0 transition-all duration-200 absolute left-0 sm:left-1/2 sm:-translate-x-1/2 w-[min(280px,calc(100vw-2.5rem))] max-w-[calc(100vw-2.5rem)] sm:w-80 rounded-lg border border-[var(--color-accent-gold)] bg-[var(--color-surface-card)] p-2.5 sm:p-3.5 z-[70] text-left font-sans"
              style="box-shadow: 0 8px 16px -2px rgba(0, 0, 0, 0.35), 0 3px 6px -2px rgba(0, 0, 0, 0.25); background-color: var(--color-surface-card);"
            >
              <div class="border-b border-[var(--color-surface-border-subtle)] pb-1.5 mb-1.5 sm:pb-2.5 sm:mb-2.5 space-y-0.5">
                <div
                  id="viewer-tt-name"
                  class="font-bold font-mono text-xs text-[var(--color-text-primary)]"
                >
                  {initialCompanyInfo.name}
                </div>
                <p
                  id="viewer-tt-industry"
                  class="text-[10px] sm:text-[11px] font-sans font-medium text-[var(--color-accent-gold)] leading-snug"
                >
                  {isEs
                    ? initialCompanyInfo.industryEs
                    : initialCompanyInfo.industry}
                </p>
              </div>

              <p
                id="viewer-tt-desc"
                class="text-[11px] sm:text-xs text-[var(--color-text-secondary)] leading-normal sm:leading-relaxed mb-2 sm:mb-2.5"
              >
                {isEs
                  ? initialCompanyInfo.descriptionEs
                  : initialCompanyInfo.description}
              </p>

              <div class="pt-1.5 sm:pt-2 border-t border-[var(--color-surface-border-subtle)] flex items-center justify-between font-mono text-xs">
                <span
                  id="viewer-tt-domain"
                  class="text-[10px] text-[var(--color-text-muted)] truncate max-w-[110px] sm:max-w-[130px]"
                >
                  {initialCompanyInfo.domain}
                </span>
                <a
                  id="viewer-tt-url"
                  href={initialCompanyInfo.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 sm:gap-1.5 rounded border border-[var(--color-accent-gold)]/50 bg-[var(--color-accent-gold-subtle)] px-2 py-0.5 sm:px-2.5 sm:py-1 text-[10px] sm:text-[11px] font-semibold text-[var(--color-accent-gold)] hover:bg-[var(--color-accent-gold)] hover:text-[var(--color-btn-gold-text)] transition-colors"
                >
                  <span>{isEs ? "Sitio Web" : "Visit Website"}</span>
                  <svg
                    class="h-2.5 w-2.5 sm:h-3 sm:w-3 stroke-current fill-none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                  >
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </a>
              </div>

              <!-- Pointer Caret Arrow -->
              <div class="company-tooltip-caret absolute w-2.5 h-2.5 sm:w-3 sm:h-3 bg-[var(--color-surface-card)] rotate-45 left-4 sm:left-1/2 sm:-translate-x-1/2"></div>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2.5 self-start sm:self-auto">
          <!-- Ordered Simulation Carousel Arrow Steppers -->
          <div class="inline-flex items-center rounded border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] p-0.5 text-xs font-mono">
            <button
              type="button"
              id="sim-prev-btn"
              aria-label={
                isEs ? "Caso de estudio anterior" : "Previous case study"
              }
              title={isEs ? "Caso de estudio anterior" : "Previous case study"}
              class="flex h-6 w-6 items-center justify-center rounded text-[var(--color-text-secondary)] hover:bg-[var(--color-surface-border)]/60 hover:text-[var(--color-accent-gold)] transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
            >
              <svg
                class="h-3.5 w-3.5 stroke-current fill-none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>

            <span
              id="viewer-sim-stepper-label"
              class="px-2 text-[11px] font-semibold text-[var(--color-accent-gold)] select-none whitespace-nowrap"
            >
              1 / {simulationsData.length}
            </span>

            <button
              type="button"
              id="sim-next-btn"
              aria-label={
                isEs ? "Siguiente caso de estudio" : "Next case study"
              }
              title={isEs ? "Siguiente caso de estudio" : "Next case study"}
              class="flex h-6 w-6 items-center justify-center rounded text-[var(--color-text-secondary)] hover:bg-[var(--color-surface-border)]/60 hover:text-[var(--color-accent-gold)] transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
            >
              <svg
                class="h-3.5 w-3.5 stroke-current fill-none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>

          <span class="inline-flex items-center gap-1.5 rounded border border-[var(--color-accent-status)]/30 bg-[var(--color-accent-status)]/10 px-2 py-1 text-xs font-semibold text-[var(--color-accent-status)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent-status)] shrink-0 aspect-square animate-pulse"></span>
            <span>{isEs ? "En Vivo" : "Live Runtime"}</span>
          </span>
        </div>
      </div>

      <div class="p-5 sm:p-7 space-y-6">
        <!-- Active scenario prompt & simulate button -->
        <div class="space-y-2 font-sans">
          <div class="flex items-center justify-between gap-3">
            <h3
              id="viewer-title"
              class="text-base sm:text-lg font-bold text-[var(--color-text-primary)] tracking-tight"
            >
              {isEs ? initialSim.titleEs : initialSim.title}
            </h3>
            <a
              id="viewer-job-link"
              href={
                isEs
                  ? `/es/experience/${initialSim.jobSlug}`
                  : `/experience/${initialSim.jobSlug}`
              }
              class="shrink-0 text-xs font-mono text-[var(--color-accent-gold)] hover:underline inline-flex items-center gap-1"
            >
              <span>{isEs ? "Ver Puesto" : "View Role"}</span>
              <span>&nearr;</span>
            </a>
          </div>
          <p
            id="viewer-description"
            class="text-xs sm:text-sm text-[var(--color-text-secondary)] leading-relaxed"
          >
            {isEs ? initialSim.descriptionEs : initialSim.description}
          </p>
        </div>

        <!-- Execution Pipeline: Steps Container -->
        <div class="space-y-2 font-mono">
          <div class="text-[11px] text-[var(--color-text-muted)] uppercase tracking-wider flex items-center justify-between">
            <span>
              {isEs
                ? "Fases de Ejecución en Pipeline"
                : "Execution Pipeline Phases"}
            </span>
            <span
              id="viewer-phase-status"
              class="text-[var(--color-accent-gold)]"
            >
              {isEs ? "En espera" : "Idle state"}
            </span>
          </div>
          <div
            id="viewer-steps-grid"
            class="grid grid-cols-2 lg:grid-cols-4 gap-2 font-mono"
          >
            {initialSim.steps.map((step, idx) => (
              <div
                class="viewer-step-node rounded border border-[var(--color-surface-border-subtle)] bg-[var(--color-bg-primary)]/40 p-2.5 transition-all"
                data-step-index={idx}
              >
                <div class="flex items-center justify-between text-[11px] mb-1">
                  <span class="text-[var(--color-accent-gold)] font-bold">
                    {step.stepNumber}
                  </span>
                  <span class="viewer-step-dot h-1.5 w-1.5 rounded-full bg-[var(--color-surface-border)]"></span>
                </div>
                <div class="viewer-step-title text-xs font-bold text-[var(--color-text-primary)] truncate">
                  {isEs ? step.titleEs : step.title}
                </div>
                <div class="viewer-step-detail text-[10px] text-[var(--color-text-muted)] mt-0.5 line-clamp-1">
                  {isEs ? step.detailEs : step.detail}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Real-time Terminal Log Output -->
        <div class="rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]/70 p-3.5 text-xs font-mono">
          <div class="flex items-center justify-between text-[10px] text-[var(--color-text-muted)] border-b border-[var(--color-surface-border-subtle)] pb-1.5 mb-2 uppercase tracking-wider">
            <span>
              {isEs ? "Terminal Telemetría stdout" : "Live Telemetry stdout"}
            </span>
            <span id="viewer-timer" class="text-[var(--color-accent-gold)]">
              0.0ms
            </span>
          </div>
          <div
            id="viewer-log-feed"
            class="text-[11px] text-[var(--color-text-secondary)] space-y-1 min-h-[3.5rem] leading-relaxed"
          >
            <div class="text-[var(--color-text-muted)] italic">
              {isEs
                ? '$ Presiona "Ejecutar Caso de Estudio" para disparar la carga en tiempo real...'
                : '$ Click "Run Case Study" to execute the real-time architectural workload...'}
            </div>
          </div>
        </div>

        <!-- Before vs NOW Telemetry Impact Grid -->
        <div class="space-y-3 pt-2 border-t border-[var(--color-surface-border-subtle)] font-mono">
          <div class="flex items-center justify-between text-xs">
            <span class="text-[var(--color-accent-gold)] uppercase tracking-wider font-semibold">
              {isEs
                ? "Métricas de Impacto: Antes vs AHORA"
                : "Impact Telemetry: Before vs NOW"}
            </span>
            <span class="text-[11px] text-[var(--color-text-muted)]">
              {isEs ? "Medido en Producción" : "Production Measured"}
            </span>
          </div>

          <div
            id="viewer-metrics-grid"
            class="grid grid-cols-1 sm:grid-cols-2 gap-3"
          >
            {initialSim.metrics.map((metric) => (
              <div class="viewer-metric-card rounded border border-[var(--color-surface-border-subtle)] bg-[var(--color-bg-primary)]/40 p-3 space-y-2">
                <div class="text-xs font-semibold text-[var(--color-text-primary)] flex items-center justify-between">
                  <span class="metric-name">
                    {isEs ? metric.nameEs : metric.name}
                  </span>
                  {metric.improvement && (
                    <span class="metric-improvement text-[10px] rounded bg-[var(--color-accent-gold)]/10 px-1.5 py-0.2 text-[var(--color-accent-gold)]">
                      {isEs ? metric.improvementEs : metric.improvement}
                    </span>
                  )}
                </div>

                <div class="space-y-1.5 text-xs">
                  <!-- Old / Before Data -->
                  <div class="flex items-center gap-2 text-[var(--color-text-muted)]">
                    <span class="text-[10px] uppercase font-bold text-[var(--color-text-muted)] shrink-0 line-through">
                      before:
                    </span>
                    <span class="metric-before text-[11px] line-through opacity-75">
                      {metric.beforeValue}
                    </span>
                  </div>

                  <!-- New / NOW Data -->
                  <div class="viewer-now-row flex items-center gap-2 text-[var(--color-text-primary)] bg-[var(--color-surface-card)] rounded p-1.5 border border-[var(--color-surface-border)]">
                    <span class="text-[10px] uppercase font-bold text-[var(--color-accent-status)] shrink-0 flex items-center gap-1">
                      <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent-status)]"></span>
                      now:
                    </span>
                    <span class="metric-now text-xs font-bold text-[var(--color-accent-gold)]">
                      {metric.nowValue}
                    </span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Actions: Run Simulation & Randomize trigger -->
        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
          <button
            type="button"
            id="viewer-run-btn"
            class="btn-gold px-5 py-2.5 inline-flex items-center justify-center gap-2 font-mono text-xs font-semibold tracking-wide shadow-md transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent-gold)]"
          >
            <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <span>
              {isEs
                ? "Ejecutar Caso de Estudio"
                : "Run Architecture Case Study"}
            </span>
          </button>

          <div class="flex items-center justify-between sm:justify-end gap-3 text-xs font-mono text-[var(--color-text-muted)]">
            <span id="viewer-sim-counter">
              {initialIndex + 1} / {simulationsData.length}{" "}
              {isEs ? "casos de estudio" : "case studies"}
            </span>
          </div>
        </div>
      </div>
    </div>

    <script
      type="application/json"
      id="telemetry-data"
      set:html={JSON.stringify({
        simulations: simulationsData,
        companies: companiesData,
      })}
    />
    <script is:inline>
      // @ts-nocheck
      (function () {
        function setupRandomViewer() {
          var root = document.getElementById("random-telemetry-viewer");
          if (!root || root.dataset.bound) return;
          root.dataset.bound = "true";

          var dataEl = document.getElementById("telemetry-data");
          var telemetryData = dataEl
            ? JSON.parse(dataEl.textContent || "{}")
            : {};
          var allSimulations = telemetryData.simulations || [];
          var allCompanies = telemetryData.companies || {};

          var locale =
            root.dataset.locale ||
            (document.documentElement.lang === "es" ? "es" : "en");
          var isEs = locale === "es";
          var initialIndex = parseInt(root.dataset.initialIndex || "0", 10);
          var currentIndex = initialIndex;

          var scriptNameEl = document.getElementById("viewer-script-name");
          var companyRoot = document.getElementById("viewer-company-root");
          var companyLinkEl = document.getElementById("viewer-company-link");
          var companyTriggerEl = document.getElementById(
            "viewer-company-trigger",
          );
          var companyTooltip = document.getElementById(
            "viewer-company-tooltip",
          );
          var ttNameEl = document.getElementById("viewer-tt-name");
          var ttIndustryEl = document.getElementById("viewer-tt-industry");
          var ttDescEl = document.getElementById("viewer-tt-desc");
          var ttDomainEl = document.getElementById("viewer-tt-domain");
          var ttUrlEl = document.getElementById("viewer-tt-url");

          var titleEl = document.getElementById("viewer-title");
          var descEl = document.getElementById("viewer-description");
          var jobLinkEl = document.getElementById("viewer-job-link");
          var stepsGrid = document.getElementById("viewer-steps-grid");
          var metricsGrid = document.getElementById("viewer-metrics-grid");
          var logFeed = document.getElementById("viewer-log-feed");
          var timerEl = document.getElementById("viewer-timer");
          var phaseStatus = document.getElementById("viewer-phase-status");
          var counterEl = document.getElementById("viewer-sim-counter");

          var runBtn = document.getElementById("viewer-run-btn");
          var prevBtn = document.getElementById("sim-prev-btn");
          var nextBtn = document.getElementById("sim-next-btn");
          var stepperLabel = document.getElementById(
            "viewer-sim-stepper-label",
          );

          function getCompInfo(name) {
            var k = (name || "").toLowerCase().trim();
            if (allCompanies[k]) return allCompanies[k];
            for (var key in allCompanies) {
              if (k.indexOf(key) !== -1 || key.indexOf(k) !== -1)
                return allCompanies[key];
            }
            return {
              name: name,
              url:
                "https://www.google.com/search?q=" + encodeURIComponent(name),
              domain: name.toLowerCase().replace(/[^a-z0-9]/g, "") + ".com",
              industry: "Enterprise Software & Systems",
              industryEs: "Software & Sistemas Empresariales",
              description:
                "Enterprise architecture and production systems engagement.",
              descriptionEs:
                "Proyecto de arquitectura e infraestructura en producción empresarial.",
            };
          }

          // Tooltip interactive state
          if (companyRoot && companyTriggerEl && companyTooltip) {
            var hideTimeout;

            function updatePlacement() {
              var header = document.querySelector("header");
              var headerBottom = header
                ? header.getBoundingClientRect().bottom
                : 56;
              var triggerRect = companyTriggerEl.getBoundingClientRect();
              var rootRect = companyRoot.getBoundingClientRect();
              var spaceAbove = triggerRect.top - headerBottom;
              var ttHeight = companyTooltip.offsetHeight || 180;
              if (spaceAbove < ttHeight + 16) {
                companyRoot.dataset.placement = "bottom";
              } else {
                companyRoot.dataset.placement = "top";
              }

              // Horizontal bounds clamping for small screens to prevent right overflow
              var viewportWidth =
                window.innerWidth || document.documentElement.clientWidth;
              var ttWidth = companyTooltip.offsetWidth || 280;
              var caret = companyRoot.querySelector(".company-tooltip-caret");
              if (viewportWidth < 640) {
                var safeMarginRight = 18;
                var safeMarginLeft = 12;
                var maxViewportX = viewportWidth - ttWidth - safeMarginRight;
                var minViewportX = safeMarginLeft;
                var idealViewportX = rootRect.left;
                var clampedViewportX = Math.max(
                  minViewportX,
                  Math.min(idealViewportX, maxViewportX),
                );
                var relativeLeft = clampedViewportX - rootRect.left;
                companyTooltip.style.left = relativeLeft + "px";
                if (caret) {
                  var caretPos =
                    rootRect.left + rootRect.width / 2 - clampedViewportX;
                  caret.style.left =
                    Math.max(16, Math.min(ttWidth - 16, caretPos)) + "px";
                }
              } else {
                companyTooltip.style.left = "";
                if (caret) caret.style.left = "";
              }
            }

            function openTooltip() {
              clearTimeout(hideTimeout);
              updatePlacement();
              companyRoot.dataset.tooltipOpen = "true";
              companyTriggerEl.setAttribute("aria-expanded", "true");
              companyTooltip.classList.remove(
                "opacity-0",
                "pointer-events-none",
                "translate-y-1",
              );
              companyTooltip.classList.add(
                "opacity-100",
                "pointer-events-auto",
                "translate-y-0",
              );
            }

            function closeTooltip() {
              hideTimeout = setTimeout(function () {
                companyRoot.dataset.tooltipOpen = "false";
                companyTriggerEl.setAttribute("aria-expanded", "false");
                companyTooltip.classList.add(
                  "opacity-0",
                  "pointer-events-none",
                  "translate-y-1",
                );
                companyTooltip.classList.remove(
                  "opacity-100",
                  "pointer-events-auto",
                  "translate-y-0",
                );
              }, 200);
            }

            companyRoot.addEventListener("mouseenter", openTooltip);
            companyRoot.addEventListener("mouseleave", closeTooltip);
            window.addEventListener(
              "scroll",
              function () {
                if (companyRoot.dataset.tooltipOpen === "true") {
                  updatePlacement();
                }
              },
              { passive: true },
            );

            companyTriggerEl.addEventListener("click", function (e) {
              e.stopPropagation();
              var isOpen =
                companyTriggerEl.getAttribute("aria-expanded") === "true";
              if (isOpen) {
                closeTooltip();
              } else {
                openTooltip();
              }
            });

            document.addEventListener("click", function (e) {
              if (companyRoot && !companyRoot.contains(e.target)) {
                companyRoot.dataset.tooltipOpen = "false";
                companyTriggerEl.setAttribute("aria-expanded", "false");
                companyTooltip.classList.add(
                  "opacity-0",
                  "pointer-events-none",
                  "translate-y-1",
                );
                companyTooltip.classList.remove(
                  "opacity-100",
                  "pointer-events-auto",
                  "translate-y-0",
                );
              }
            });

            document.addEventListener("keydown", function (e) {
              if (e.key === "Escape") {
                companyRoot.dataset.tooltipOpen = "false";
                companyTriggerEl.setAttribute("aria-expanded", "false");
                companyTooltip.classList.add(
                  "opacity-0",
                  "pointer-events-none",
                  "translate-y-1",
                );
                companyTooltip.classList.remove(
                  "opacity-100",
                  "pointer-events-auto",
                  "translate-y-0",
                );
              }
            });
          }

          function renderCurrentSim() {
            var sim = allSimulations[currentIndex];
            if (!sim) return;

            if (scriptNameEl) scriptNameEl.textContent = sim.scriptName;

            var comp = sim.company;
            var info = getCompInfo(comp);
            var compFilterUrl =
              (isEs ? "/es/experience?company=" : "/experience?company=") +
              encodeURIComponent(comp.toLowerCase().trim());

            if (companyLinkEl) {
              companyLinkEl.textContent = "@" + comp;
              companyLinkEl.href = compFilterUrl;
              companyLinkEl.title = isEs
                ? "Ver trayectoria filtrada para " + comp
                : "Filter timeline for " + comp;
            }
            if (companyTriggerEl) {
              companyTriggerEl.setAttribute(
                "aria-label",
                (isEs ? "Ver información sobre " : "View information about ") +
                  comp,
              );
              companyTriggerEl.title =
                (isEs ? "Información sobre " : "About ") + comp;
            }
            if (ttNameEl) ttNameEl.textContent = info.name;
            if (ttIndustryEl)
              ttIndustryEl.textContent = isEs ? info.industryEs : info.industry;
            if (ttDescEl)
              ttDescEl.textContent = isEs
                ? info.descriptionEs
                : info.description;
            if (ttDomainEl) ttDomainEl.textContent = info.domain;
            if (ttUrlEl) ttUrlEl.href = info.url;

            if (titleEl) titleEl.textContent = isEs ? sim.titleEs : sim.title;
            if (descEl)
              descEl.textContent = isEs ? sim.descriptionEs : sim.description;
            if (jobLinkEl) {
              jobLinkEl.href =
                (isEs
                  ? "/es/experience/" + sim.jobSlug
                  : "/experience/" + sim.jobSlug) + "#simulations";
            }
            if (stepperLabel) {
              stepperLabel.textContent =
                currentIndex + 1 + " / " + allSimulations.length;
            }
            if (counterEl) {
              counterEl.textContent =
                currentIndex +
                1 +
                " / " +
                allSimulations.length +
                (isEs ? " casos de estudio" : " case studies");
            }

            // Render Steps Grid
            if (stepsGrid) {
              stepsGrid.innerHTML = "";
              sim.steps.forEach(function (step, idx) {
                var node = document.createElement("div");
                node.className =
                  "viewer-step-node rounded border border-[var(--color-surface-border-subtle)] bg-[var(--color-bg-primary)]/40 p-2.5 transition-all";
                node.setAttribute("data-step-index", idx);
                node.innerHTML =
                  '<div class="flex items-center justify-between text-[11px] mb-1">' +
                  '<span class="text-[var(--color-accent-gold)] font-bold">' +
                  step.stepNumber +
                  "</span>" +
                  '<span class="viewer-step-dot h-1.5 w-1.5 rounded-full bg-[var(--color-surface-border)]"></span>' +
                  "</div>" +
                  '<div class="viewer-step-title text-xs font-bold text-[var(--color-text-primary)] truncate">' +
                  (isEs ? step.titleEs : step.title) +
                  "</div>" +
                  '<div class="viewer-step-detail text-[10px] text-[var(--color-text-muted)] mt-0.5 line-clamp-1">' +
                  (isEs ? step.detailEs : step.detail) +
                  "</div>";
                stepsGrid.appendChild(node);
              });
            }

            // Render Metrics Grid
            if (metricsGrid) {
              metricsGrid.innerHTML = "";
              sim.metrics.forEach(function (m) {
                var card = document.createElement("div");
                card.className =
                  "viewer-metric-card rounded border border-[var(--color-surface-border-subtle)] bg-[var(--color-bg-primary)]/40 p-3 space-y-2";
                var impBadge = (isEs ? m.improvementEs : m.improvement)
                  ? '<span class="metric-improvement text-[10px] rounded bg-[var(--color-accent-gold)]/10 px-1.5 py-0.2 text-[var(--color-accent-gold)]">' +
                    (isEs ? m.improvementEs : m.improvement) +
                    "</span>"
                  : "";
                card.innerHTML =
                  '<div class="text-xs font-semibold text-[var(--color-text-primary)] flex items-center justify-between">' +
                  "<span>" +
                  (isEs ? m.nameEs : m.name) +
                  "</span>" +
                  impBadge +
                  "</div>" +
                  '<div class="space-y-1.5 text-xs">' +
                  '<div class="flex items-center gap-2 text-[var(--color-text-muted)]">' +
                  '<span class="text-[10px] uppercase font-bold text-[var(--color-text-muted)] shrink-0 line-through">before:</span>' +
                  '<span class="text-[11px] line-through opacity-75">' +
                  m.beforeValue +
                  "</span>" +
                  "</div>" +
                  '<div class="viewer-now-row flex items-center gap-2 text-[var(--color-text-primary)] bg-[var(--color-surface-card)] rounded p-1.5 border border-[var(--color-surface-border)]">' +
                  '<span class="text-[10px] uppercase font-bold text-[var(--color-accent-status)] shrink-0 flex items-center gap-1">' +
                  '<span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent-status)]"></span>' +
                  "now:" +
                  "</span>" +
                  '<span class="text-xs font-bold text-[var(--color-accent-gold)]">' +
                  m.nowValue +
                  "</span>" +
                  "</div>" +
                  "</div>";
                metricsGrid.appendChild(card);
              });
            }

            // Reset logs and timer
            if (logFeed) {
              logFeed.innerHTML =
                '<div class="text-[var(--color-text-muted)] italic">' +
                (isEs
                  ? '$ Presiona "Ejecutar Caso de Estudio" para disparar la carga...'
                  : '$ Click "Run Case Study" to execute the workload...') +
                "</div>";
            }
            if (timerEl) timerEl.textContent = "0.0ms";
            if (phaseStatus)
              phaseStatus.textContent = isEs ? "En espera" : "Idle state";
          }

          // Stepper navigation arrows
          if (prevBtn) {
            prevBtn.addEventListener("click", function () {
              currentIndex =
                (currentIndex - 1 + allSimulations.length) %
                allSimulations.length;
              renderCurrentSim();
            });
          }

          if (nextBtn) {
            nextBtn.addEventListener("click", function () {
              currentIndex = (currentIndex + 1) % allSimulations.length;
              renderCurrentSim();
            });
          }

          // Run Simulation button
          if (runBtn) {
            runBtn.addEventListener("click", function () {
              var sim = allSimulations[currentIndex];
              if (!sim || runBtn.disabled) return;

              runBtn.disabled = true;
              runBtn.classList.add("opacity-60", "cursor-not-allowed");

              if (logFeed) logFeed.innerHTML = "";
              if (phaseStatus)
                phaseStatus.textContent = isEs
                  ? "Ejecutando pipeline..."
                  : "Executing pipeline...";

              var stepNodes = root.querySelectorAll(".viewer-step-node");
              var nowRows = root.querySelectorAll(".viewer-now-row");

              stepNodes.forEach(function (node) {
                node.classList.remove(
                  "border-[var(--color-accent-gold)]",
                  "bg-[var(--color-surface-card)]",
                );
                var dot = node.querySelector(".viewer-step-dot");
                if (dot)
                  dot.classList.replace(
                    "bg-[var(--color-accent-status)]",
                    "bg-[var(--color-surface-border)]",
                  );
              });

              nowRows.forEach(function (r) {
                r.classList.add("opacity-40");
              });

              var currentStep = 0;
              var startTime = performance.now();

              function executeNextStep() {
                if (currentStep < sim.steps.length) {
                  var step = sim.steps[currentStep];
                  var node = stepNodes[currentStep];
                  if (node) {
                    node.classList.add(
                      "border-[var(--color-accent-gold)]",
                      "bg-[var(--color-surface-card)]",
                    );
                    var dot = node.querySelector(".viewer-step-dot");
                    if (dot) {
                      dot.classList.remove("bg-[var(--color-surface-border)]");
                      dot.classList.add(
                        "bg-[var(--color-accent-status)]",
                        "animate-ping",
                      );
                      setTimeout(function () {
                        dot.classList.remove("animate-ping");
                      }, 400);
                    }
                  }

                  var elapsed = (performance.now() - startTime).toFixed(1);
                  if (timerEl) timerEl.textContent = elapsed + "ms";

                  if (logFeed) {
                    var line = document.createElement("div");
                    line.className =
                      "text-[var(--color-text-primary)] flex items-start gap-1.5 animate-fade-in";
                    line.innerHTML =
                      '<span class="text-[var(--color-accent-gold)]">&rarr;</span> <span>' +
                      step.log +
                      "</span>";
                    logFeed.appendChild(line);
                    logFeed.scrollTop = logFeed.scrollHeight;
                  }

                  currentStep++;
                  setTimeout(executeNextStep, step.durationMs * 25 + 150);
                } else {
                  var totalElapsed = (performance.now() - startTime).toFixed(1);
                  if (timerEl) timerEl.textContent = totalElapsed + "ms (DONE)";
                  if (phaseStatus)
                    phaseStatus.textContent = isEs
                      ? "Completado con Éxito ✓"
                      : "Completed Successfully ✓";

                  nowRows.forEach(function (r) {
                    r.classList.remove("opacity-40");
                    r.classList.add("border-[var(--color-accent-status)]");
                    setTimeout(function () {
                      r.classList.remove("border-[var(--color-accent-status)]");
                    }, 2000);
                  });

                  runBtn.disabled = false;
                  runBtn.classList.remove("opacity-60", "cursor-not-allowed");
                }
              }

              executeNextStep();
            });
          }
        }

        function scheduleInit() {
          var root = document.getElementById("random-telemetry-viewer");
          if (!root || root.dataset.bound === "true") return;
          if ("IntersectionObserver" in window) {
            var obs = new IntersectionObserver(
              function (entries) {
                if (entries[0] && entries[0].isIntersecting) {
                  obs.disconnect();
                  setupRandomViewer();
                }
              },
              { rootMargin: "300px" },
            );
            obs.observe(root);
          } else {
            root.addEventListener("pointerenter", setupRandomViewer, {
              once: true,
            });
            root.addEventListener("focusin", setupRandomViewer, { once: true });
          }
        }

        var telemetryInitStarted = false;
        function startTelemetryInit() {
          if (telemetryInitStarted) return;
          telemetryInitStarted = true;
          scheduleInit();
        }

        window.addEventListener("scroll", startTelemetryInit, {
          once: true,
          passive: true,
        });
        window.addEventListener("pointerdown", startTelemetryInit, {
          once: true,
          passive: true,
        });
        document.addEventListener("astro:page-load", scheduleInit);
      })();
    </script>
  </>
)}

