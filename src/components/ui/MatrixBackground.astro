---
// Subtle Matrix / Hexadecimal Code Stream Background (Zero-Dependency Offscreen Canvas Worker + Fallback)
export const ENABLE_MATRIX_BACKGROUND = true;

interface Props {
  density?: number;
  opacity?: number;
  enabled?: boolean;
}

const {
  density = 0.08,
  opacity = 0.15,
  enabled = ENABLE_MATRIX_BACKGROUND,
} = Astro.props;
---

{enabled && (
  <div
    id="matrix-container"
    data-density={density}
    data-opacity={opacity}
    transition:persist="matrix-background"
    transition:animate="none"
    class="pointer-events-none fixed inset-0 z-0 overflow-hidden select-none print:hidden opacity-20 hidden md:block"
    aria-hidden="true"
  >
    <div class="matrix-static-backdrop absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(212,139,56,0.06),rgba(10,2,3,0))]"></div>
    <canvas
      id="matrix-canvas"
      class="block w-full h-full opacity-0 transition-opacity duration-700 ease-out"
    ></canvas>
  </div>
)}

<script>
  import { MatrixGrid } from "../../scripts/matrix-grid";
  import {
    MatrixQuality,
    MatrixScrollQuality,
  } from "../../scripts/matrix-quality";
  import {
    resizeMatrixSurface,
    observeMatrixViewport,
    observeMatrixPointer,
  } from "../../scripts/matrix-viewport";
  interface MatrixSingleton {
    initialized: boolean;
    bootScheduled: boolean;
    worker: Worker | null;
    rafId: number | null;
    canvas: HTMLCanvasElement | null;
    lastIsDark: boolean | null;
    syncTheme: () => void;
    setPaused: (paused: boolean) => void;
    setQuality: (level: 0 | 1 | 2) => void;
  }

  declare global {
    interface Window {
      __matrixSingleton?: MatrixSingleton;
      __matrixState?: any;
      __matrixDrops?: number[];
      __matrixCanvas?: HTMLCanvasElement | null;
      __matrixListenersBound?: boolean;
    }
  }

  function observeMatrixScrollQuality(singleton: MatrixSingleton) {
    const quality = new MatrixScrollQuality();
    let frameId = 0;
    let last = 0;
    let activeUntil = 0;
    const frame = (now: number) => {
      if (last) {
        const level = quality.record(now - last, now);
        if (level !== undefined) singleton.setQuality(level);
      }
      last = now;
      if (now < activeUntil) {
        frameId = requestAnimationFrame(frame);
      } else {
        frameId = 0;
        last = 0;
        singleton.setQuality(quality.reset());
      }
    };
    const activate = () => {
      activeUntil = performance.now() + 700;
      if (!frameId) frameId = requestAnimationFrame(frame);
    };
    for (const event of ["wheel", "touchmove", "scroll"]) {
      window.addEventListener(event, activate, { passive: true });
    }
  }

  function setupMatrixSingleton() {
    // If singleton already exists and is running on the persisted canvas, just sync theme & visibility
    if (window.__matrixSingleton?.initialized) {
      const existingCanvas = document.getElementById(
        "matrix-canvas",
      ) as HTMLCanvasElement | null;
      if (
        existingCanvas &&
        existingCanvas === window.__matrixSingleton.canvas
      ) {
        existingCanvas.classList.remove(
          "opacity-0",
          "transition-opacity",
          "duration-700",
        );
        existingCanvas.classList.add("opacity-100");
        window.__matrixSingleton.syncTheme();
        window.__matrixSingleton.setPaused(
          document.visibilityState === "hidden",
        );
        return;
      }
    }

    if (window.__matrixSingleton?.bootScheduled) {
      return;
    }

    const prefersReducedMotion =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion || navigator.webdriver === true) {
      return;
    }

    const singleton: MatrixSingleton = {
      initialized: false,
      bootScheduled: true,
      worker: null,
      rafId: null,
      canvas: null,
      lastIsDark: null,
      syncTheme: () => {},
      setPaused: () => {},
      setQuality: () => {},
    };
    window.__matrixSingleton = singleton;
    window.__matrixState = {
      worker: null,
      drops: window.__matrixDrops || [],
      animationFrameId: null,
    };

    const bootMatrix = () => {
      if (singleton.initialized) return;
      const canvas = document.getElementById(
        "matrix-canvas",
      ) as HTMLCanvasElement | null;
      if (!canvas) {
        singleton.bootScheduled = false;
        return;
      }

      singleton.initialized = true;
      singleton.canvas = canvas;
      window.__matrixCanvas = canvas;

      const getIsDark = () =>
        document.documentElement.getAttribute("data-theme") === "dark" ||
        (document.documentElement.getAttribute("data-theme") !== "light" &&
          document.documentElement.classList.contains("dark"));
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      singleton.lastIsDark = getIsDark();

      const width = canvas.clientWidth || window.innerWidth;
      const height = canvas.clientHeight || window.innerHeight;

      const markCanvasVisible = () => {
        requestAnimationFrame(() => {
          canvas.classList.remove("opacity-0");
          canvas.classList.add("opacity-100");
          window.setTimeout(() => {
            canvas.classList.remove("transition-opacity", "duration-700");
          }, 750);
        });
      };

      const supportsOffscreen =
        typeof canvas.transferControlToOffscreen === "function" &&
        typeof Worker !== "undefined";

      if (supportsOffscreen && !canvas.dataset.offscreenTransferred) {
        try {
          canvas.dataset.offscreenTransferred = "true";
          const offscreen = canvas.transferControlToOffscreen();
          const worker = new Worker(
            new URL("../../scripts/matrix.worker.ts", import.meta.url),
            { type: "module" },
          );
          singleton.worker = worker;
          if (window.__matrixState) window.__matrixState.worker = worker;

          worker.postMessage(
            {
              type: "init",
              canvas: offscreen,
              width,
              height,
              dpr,
              isLight: !singleton.lastIsDark,
            },
            [offscreen],
          );

          singleton.syncTheme = () => {
            const currentIsDark = getIsDark();
            if (singleton.lastIsDark !== currentIsDark) {
              singleton.lastIsDark = currentIsDark;
              worker.postMessage({ type: "theme", isLight: !currentIsDark });
            }
          };

          singleton.setPaused = (paused: boolean) => {
            worker.postMessage({ type: paused ? "pause" : "resume" });
          };

          singleton.setQuality = (level) => {
            worker.postMessage({ type: "quality", level });
          };
          observeMatrixScrollQuality(singleton);

          observeMatrixViewport(canvas, (width, height, dpr) => {
            worker.postMessage({ type: "resize", width, height, dpr });
          });
          observeMatrixPointer((x, y, active) => {
            worker.postMessage({ type: "pointer", x, y, active });
          });

          markCanvasVisible();
          return;
        } catch {
          // Fallback to 2D context if OffscreenCanvas fails
        }
      }

      // 2D Canvas Fallback (persisted across navigations)
      const ctx = canvas.getContext("2d", { alpha: true });
      if (!ctx) return;

      let w = width;
      let h = height;
      const quality = new MatrixQuality();
      resizeMatrixSurface(canvas, ctx, w, h, dpr, quality.scale);
      const grid = new MatrixGrid(ctx);
      grid.setTheme(!getIsDark());
      grid.resize(w, h);
      let paused = false;
      let lastFrame = 0;
      const frameInterval = 1000 / 60;

      singleton.syncTheme = () => {
        const isDark = getIsDark();
        singleton.lastIsDark = isDark;
        grid.setTheme(!isDark);
      };
      singleton.setPaused = (p: boolean) => {
        if (paused !== p) lastFrame = 0;
        paused = p;
      };

      singleton.setQuality = (level) => {
        if (!quality.setMinimumLevel(level)) return;
        resizeMatrixSurface(
          canvas,
          ctx,
          w,
          h,
          window.devicePixelRatio || 1,
          quality.scale,
        );
        grid.resize(w, h);
      };
      observeMatrixScrollQuality(singleton);

      const draw = (now: number) => {
        singleton.rafId = requestAnimationFrame(draw);
        if (paused || now - lastFrame < quality.frameInterval - 1) return;
        const elapsed =
          lastFrame === 0
            ? frameInterval
            : Math.min(now - lastFrame, frameInterval * 2);
        lastFrame = now;
        const started = performance.now();
        grid.draw(elapsed);
        if (quality.record(performance.now() - started, performance.now())) {
          resizeMatrixSurface(
            canvas,
            ctx,
            w,
            h,
            window.devicePixelRatio || 1,
            quality.scale,
          );
          grid.resize(w, h);
        }
      };

      observeMatrixViewport(canvas, (width, height, dpr) => {
        w = width;
        h = height;
        resizeMatrixSurface(canvas, ctx, w, h, dpr, quality.scale);
        grid.resize(w, h);
      });
      observeMatrixPointer((x, y, active) => grid.setPointer(x, y, active));

      singleton.rafId = requestAnimationFrame(draw);
      markCanvasVisible();
    };

    const interactionEvents = [
      "pointerdown",
      "pointermove",
      "wheel",
      "touchstart",
      "keydown",
      "scroll",
    ];
    let idleTimerId: number | undefined;

    const onFirstInteraction = () => {
      interactionEvents.forEach((evt) =>
        window.removeEventListener(evt, onFirstInteraction),
      );
      if (idleTimerId) window.clearTimeout(idleTimerId);
      bootMatrix();
    };

    interactionEvents.forEach((evt) =>
      window.addEventListener(evt, onFirstInteraction, {
        once: true,
        passive: true,
      }),
    );

    const scheduleIdleBoot = () => {
      idleTimerId = window.setTimeout(bootMatrix, 5500);
    };

    if (document.readyState === "complete") {
      scheduleIdleBoot();
    } else {
      window.addEventListener("load", scheduleIdleBoot, {
        once: true,
        passive: true,
      });
    }

    function resumeMatrixOnNav() {
      const state = window.__matrixState;
      if (state?.worker) {
        state.worker.postMessage({ type: "resume" });
      }
      if (singleton.initialized && singleton.canvas) {
        singleton.canvas.classList.remove(
          "opacity-0",
          "transition-opacity",
          "duration-700",
        );
        singleton.canvas.classList.add("opacity-100");
        singleton.syncTheme();
        singleton.setPaused(document.visibilityState === "hidden");
      } else {
        onFirstInteraction();
      }
    }

    if (!window.__matrixListenersBound) {
      window.__matrixListenersBound = true;
      document.addEventListener("visibilitychange", () => {
        singleton.setPaused(document.visibilityState === "hidden");
      });
      window.addEventListener("theme-changed", () => {
        singleton.syncTheme();
      });
      document.addEventListener("theme-changed", () => {
        singleton.syncTheme();
      });
      document.addEventListener("astro:after-swap", resumeMatrixOnNav);
      document.addEventListener("astro:page-load", resumeMatrixOnNav);
    }
  }

  setupMatrixSingleton();
</script>
