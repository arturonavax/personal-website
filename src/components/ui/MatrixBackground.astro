---
// Subtle Matrix / Hexadecimal Code Stream Background (Zero-Dependency Vanilla Canvas)
// Manual Code Toggle: Set to false to completely deactivate and unmount from DOM
export const ENABLE_MATRIX_BACKGROUND = true;

interface Props {
  enabled?: boolean;
}

const { enabled = ENABLE_MATRIX_BACKGROUND } = Astro.props;
---

{enabled && (
  <div
    id="matrix-container"
    transition:persist="matrix-canvas-background"
    class="pointer-events-none fixed inset-0 z-0 overflow-hidden opacity-20 dark:opacity-15 transition-opacity duration-500 hidden md:block"
    aria-hidden="true"
  >
    <canvas id="matrix-canvas" class="h-full w-full"></canvas>
  </div>
)}

<script is:inline>
  (function () {
    if (typeof window === "undefined") return;

    var chars = "01010123456789ABCDEFλ§µsGoRustSIMDAVX2ptrchnsync".split("");
    var fontSize = 14;
    var fpsInterval = 75; // ~13 FPS for minimal desktop background CPU footprint
    var timeoutId = null;

    function getCanvasAndCtx() {
      var canvas = document.getElementById("matrix-canvas");
      if (!canvas) return null;
      var ctx = canvas.getContext("2d");
      return ctx ? { canvas: canvas, ctx: ctx } : null;
    }

    function ensureDrops(canvas) {
      var columns = Math.floor(canvas.width / fontSize);
      var maxRows = Math.floor(canvas.height / fontSize);
      var drops = window.__matrixDrops;
      if (!drops || drops.length === 0) {
        drops = [];
        for (var i = 0; i < columns; i++) {
          drops[i] = Math.floor(Math.random() * maxRows);
        }
      } else if (drops.length !== columns) {
        while (drops.length < columns) {
          drops.push(Math.floor(Math.random() * maxRows));
        }
        if (drops.length > columns) {
          drops.length = columns;
        }
      }
      window.__matrixDrops = drops;
      return drops;
    }

    function resize() {
      if (window.innerWidth < 768) return;
      var pair = getCanvasAndCtx();
      if (!pair) return;
      var canvas = pair.canvas;
      if (
        canvas.width !== window.innerWidth ||
        canvas.height !== window.innerHeight
      ) {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      ensureDrops(canvas);
    }

    function draw() {
      if (window.innerWidth < 768) return;
      var pair = getCanvasAndCtx();
      if (!pair) return;
      var canvas = pair.canvas;
      var ctx = pair.ctx;

      var drops = ensureDrops(canvas);
      var isLight =
        document.documentElement.getAttribute("data-theme") === "light";
      ctx.fillStyle = isLight
        ? "rgba(244, 246, 248, 0.16)"
        : "rgba(26, 2, 5, 0.12)";
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.fillStyle = isLight ? "#7A1C16" : "#D48B38";
      ctx.font = fontSize + "px ui-monospace, monospace";

      for (var i = 0; i < drops.length; i++) {
        var char = chars[Math.floor(Math.random() * chars.length)] || "0";
        var x = i * fontSize;
        var y = drops[i] * fontSize;

        if (drops[i] > 0) {
          ctx.fillText(char, x, y);
        }

        if (y > canvas.height && Math.random() > 0.985) {
          drops[i] = 0;
        }
        drops[i]++;
      }
    }

    function loop() {
      if (document.hidden || window.innerWidth < 768) {
        window.__matrixRunning = false;
        return;
      }
      window.__matrixRunning = true;
      draw();
      timeoutId = setTimeout(function () {
        requestAnimationFrame(loop);
      }, fpsInterval);
    }

    function start() {
      if (
        window.innerWidth < 768 ||
        (window.matchMedia && window.matchMedia("(max-width: 767px)").matches)
      )
        return;
      if (
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      )
        return;

      resize();

      if (!window.__matrixRunning) {
        clearTimeout(timeoutId);
        loop();
      }
    }

    function stop() {
      clearTimeout(timeoutId);
      timeoutId = null;
      window.__matrixRunning = false;
    }

    if (!window.__matrixListenersAttached) {
      window.__matrixListenersAttached = true;

      window.addEventListener(
        "resize",
        function () {
          if (window.innerWidth >= 768) {
            resize();
            if (!window.__matrixRunning) start();
          } else {
            stop();
          }
        },
        { passive: true },
      );

      document.addEventListener("visibilitychange", function () {
        if (document.hidden) {
          stop();
        } else {
          start();
        }
      });

      document.addEventListener("astro:after-swap", function () {
        if (window.innerWidth >= 768 && !window.__matrixRunning) {
          start();
        }
      });

      document.addEventListener("astro:page-load", function () {
        if (window.innerWidth >= 768 && !window.__matrixRunning) {
          start();
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start, { once: true });
    } else {
      start();
    }
  })();
</script>
