---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/i18n/ui";
import { formatDate, useTranslations } from "@/i18n/utils";

interface Props {
  post: CollectionEntry<"posts">;
  locale: Locale;
}

const { post, locale } = Astro.props;
const t = useTranslations(locale);
const { title, description, pubDate, tags, category = "systems" } = post.data;

const slug = post.id
  .replace(new RegExp(`^${locale}/`), "")
  .replace(/\.(md|mdx)$/, "");
const postUrl = locale === "es" ? `/es/blog/${slug}` : `/blog/${slug}`;
const dateStr = formatDate(pubDate, locale);

const categoryLabels: Record<string, { en: string; es: string }> = {
  systems: { en: "Distributed Systems", es: "Sistemas Distribuidos" },
  architecture: { en: "Architecture & OLAP", es: "Arquitectura & OLAP" },
  performance: { en: "SIMD & Low-Level", es: "SIMD & Bajo Nivel" },
  ai: { en: "AI Systems", es: "Sistemas de IA" },
  research: { en: "Research", es: "Investigación" },
  leadership: { en: "Tech Leadership", es: "Liderazgo Técnico" },
  personal: { en: "Personal & Notes", es: "Personal & Notas" },
};

const categoryLabel = categoryLabels[category]?.[locale] ?? category;
---

<article
  data-post-card
  data-category={category}
  data-tags={tags.map((t) => t.toLowerCase().trim()).join("|")}
  class="geometric-box group flex flex-col justify-between p-5 sm:p-6 rounded transition-all"
>
  <div>
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs sm:text-sm font-mono text-[var(--color-text-muted)]">
      <div class="flex items-center gap-2">
        <span class="rounded border border-[var(--color-accent-gold)]/50 bg-[var(--color-accent-gold-subtle)] px-2.5 py-0.5 text-xs font-semibold text-[var(--color-accent-gold)] uppercase tracking-wider">
          {categoryLabel}
        </span>
        <time
          datetime={pubDate.toISOString()}
          class="text-[var(--color-text-muted)]"
        >
          {dateStr}
        </time>
      </div>
    </div>

    <h3 class="mt-3 text-lg sm:text-xl font-bold tracking-tight text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-gold)] transition-colors">
      <a
        href={postUrl}
        class="focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
      >
        {title}
      </a>
    </h3>

    <div class="mt-2.5 flex flex-wrap items-center gap-1.5 font-mono">
      {tags.map((tag) => (
        <button
          type="button"
          data-tech-search={tag}
          title={
            locale === "es"
              ? `Buscar notas y proyectos sobre ${tag}`
              : `Search essays & projects mentioning ${tag}`
          }
          class="rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2 py-0.5 text-xs text-[var(--color-text-secondary)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] transition-colors cursor-pointer"
        >
          {tag}
        </button>
      ))}
    </div>

    <p class="mt-2.5 text-sm sm:text-base leading-relaxed text-[var(--color-text-secondary)]">
      {description}
    </p>
  </div>

  <div class="mt-5 border-t border-[var(--color-surface-border-subtle)] pt-3.5 flex items-center justify-end">
    <a
      href={postUrl}
      class="text-xs font-mono font-medium text-[var(--color-accent-gold)] hover:underline inline-flex items-center gap-1.5 py-2 px-3 -mx-2 -my-1.5 rounded hover:bg-[var(--color-accent-gold-subtle)] transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
    >
      <span>{t("cta.readEssay")}</span>
      <span>&rarr;</span>
    </a>
  </div>
</article>
