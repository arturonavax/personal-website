---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/i18n/ui";

interface Props {
  service: CollectionEntry<"services">;
  locale: Locale;
}

const { service, locale } = Astro.props;
const isEs = locale === "es";
const {
  title,
  description,
  type,
  price,
  deliveryTime,
  tags = [],
  deliverables = [],
  ctaText,
  featured,
} = service.data;

const slug = service.id
  .replace(new RegExp(`^${locale}/`), "")
  .replace(/\.(md|mdx)$/, "");
const serviceUrl = isEs ? `/es/services/${slug}` : `/services/${slug}`;

const typeLabels: Record<string, { en: string; es: string }> = {
  service: { en: "Architecture Consulting", es: "Consultoría de Arquitectura" },
  product: {
    en: "Engineering Kit & Template",
    es: "Kit & Plantilla de Código",
  },
  mentorship: { en: "1-on-1 Staff Mentorship", es: "Mentoría 1-a-1 Staff" },
};

const typeLabel = typeLabels[type]?.[locale] ?? type;
---

<article
  data-service-card
  data-type={type}
  class="geometric-box group flex flex-col justify-between p-5 sm:p-6 rounded transition-all bg-[var(--color-surface-card)] hover:border-[var(--color-accent-gold)]/60"
>
  <div>
    <!-- Top Metadata Bar -->
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-[var(--color-text-muted)]">
      <div class="flex items-center gap-2">
        <span class="rounded border border-[var(--color-accent-gold)]/50 bg-[var(--color-accent-gold-subtle)] px-2.5 py-0.5 text-xs font-semibold text-[var(--color-accent-gold)] uppercase tracking-wider">
          {typeLabel}
        </span>
        {featured && (
          <span class="rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2 py-0.5 text-[11px] text-[var(--color-accent-status)] font-medium">
            ★ {isEs ? "Destacado" : "Featured"}
          </span>
        )}
      </div>

      {price && (
        <span class="font-bold text-[var(--color-text-primary)] font-mono text-xs">
          {price}
        </span>
      )}
    </div>

    <!-- Title Link -->
    <h3 class="mt-3 text-lg sm:text-xl font-bold tracking-tight text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-gold)] transition-colors">
      <a
        href={serviceUrl}
        class="focus-visible:outline-none focus-visible:underline"
      >
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="mt-2 text-xs sm:text-sm text-[var(--color-text-secondary)] font-sans leading-relaxed line-clamp-3">
      {description}
    </p>

    {deliveryTime && (
      <div class="mt-2.5 flex items-center gap-1.5 text-[11px] font-mono text-[var(--color-text-muted)]">
        <span class="text-[var(--color-accent-gold)]">⏱</span>
        <span>{deliveryTime}</span>
      </div>
    )}

    <!-- Key Deliverables List Preview -->
    {deliverables.length > 0 && (
      <ul class="mt-4 space-y-1.5 border-t border-[var(--color-surface-border-subtle)] pt-3 text-xs text-[var(--color-text-secondary)] font-mono">
        {deliverables.slice(0, 3).map((item) => (
          <li class="flex items-start gap-2">
            <span class="text-[var(--color-accent-gold)] shrink-0 font-bold">
              ✓
            </span>
            <span class="line-clamp-1">{item}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <!-- Bottom Action & Tags -->
  <div class="mt-6 pt-4 border-t border-[var(--color-surface-border-subtle)] flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
    <div class="flex flex-wrap items-center gap-1.5">
      {tags.slice(0, 3).map((tag) => (
        <span class="rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2 py-0.5 text-[11px] text-[var(--color-text-muted)]">
          {tag}
        </span>
      ))}
    </div>

    <a
      href={serviceUrl}
      class="inline-flex items-center gap-1.5 font-semibold text-[var(--color-accent-gold)] hover:underline py-2 px-3 -mx-2 -my-1.5 rounded hover:bg-[var(--color-accent-gold-subtle)] transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)] group-hover:translate-x-0.5"
    >
      <span>{ctaText || (isEs ? "Ver detalles" : "View details")}</span>
      <span>&rarr;</span>
    </a>
  </div>
</article>
