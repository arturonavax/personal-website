---
import type { Locale } from "@/i18n/ui";
import type { ArchitectureSimulation } from "@/data/simulations";
import { getCompanyInfo } from "@/data/companies";

interface Props {
  simulation: ArchitectureSimulation;
  locale: Locale;
  showCompany?: boolean;
}

const { simulation, locale, showCompany = false } = Astro.props;
const isEs = locale === "es";
const rootId = `sim-card-${simulation.id}`;
const companyInfo = getCompanyInfo(simulation.company);
const companyFilterUrl = isEs
  ? `/es/experience/?company=${encodeURIComponent(simulation.company.toLowerCase().trim())}`
  : `/experience/?company=${encodeURIComponent(simulation.company.toLowerCase().trim())}`;
const jobDetailUrl = isEs
  ? `/es/experience/${simulation.jobSlug}/`
  : `/experience/${simulation.jobSlug}/`;
---

<div
  id={rootId}
  class="geometric-box rounded-lg p-5 sm:p-7 space-y-6 font-mono border border-[var(--color-surface-border)] bg-[var(--color-surface-card)]"
  data-simulation-card
  data-sim-id={simulation.id}
  data-steps={JSON.stringify(simulation.steps)}
  data-is-es={isEs ? "true" : "false"}
>
  <!-- Top Bar: Service Script & Status -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[var(--color-surface-border-subtle)] pb-4 text-xs">
    <div class="flex items-center gap-2.5 flex-wrap">
      <span class="flex gap-1.5" aria-hidden="true">
        <span class="h-2 w-2 rounded-full bg-[var(--color-accent-garnet)] shrink-0 aspect-square"></span>
        <span class="h-2 w-2 rounded-full bg-[var(--color-accent-gold)]/60 shrink-0 aspect-square"></span>
        <span class="h-2 w-2 rounded-full bg-[var(--color-accent-status)] shrink-0 aspect-square"></span>
      </span>
      <code
        class="rounded bg-[var(--color-bg-primary)] px-2 py-0.5 text-[var(--color-accent-gold)] font-bold text-xs truncate max-w-[170px] min-[360px]:max-w-[220px] sm:max-w-none"
        title={simulation.scriptName}
      >
        {simulation.scriptName}
      </code>
      {showCompany && (
        <div
          class="relative inline-flex items-center gap-1.5 group/company shrink-0 rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2 py-0.5 shadow-xs"
          data-company-tooltip-root
        >
          <a
            href={companyFilterUrl}
            title={
              isEs
                ? `Ver trayectoria filtrada para ${simulation.company}`
                : `Filter timeline for ${simulation.company}`
            }
            class="text-xs font-semibold font-mono text-[var(--color-accent-gold)] hover:underline whitespace-nowrap focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
          >
            @{simulation.company}
          </a>

          <button
            type="button"
            aria-expanded="false"
            aria-label={
              isEs
                ? `Ver información sobre ${simulation.company}`
                : `View information about ${simulation.company}`
            }
            title={
              isEs
                ? `Información sobre ${simulation.company}`
                : `About ${simulation.company}`
            }
            class="inline-flex items-center justify-center h-3.5 w-3.5 rounded-full border border-[var(--color-accent-gold)]/60 bg-[var(--color-accent-gold-subtle)] text-[9px] font-mono font-bold text-[var(--color-accent-gold)] group-hover/company:bg-[var(--color-accent-gold)] group-hover/company:text-[var(--color-btn-gold-text)] transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)] cursor-pointer shrink-0"
            data-company-trigger
          >
            <span aria-hidden="true">i</span>
          </button>

          <div
            role="tooltip"
            data-company-tooltip
            class="pointer-events-none group-hover/company:pointer-events-auto opacity-0 group-hover/company:opacity-100 translate-y-1 group-hover/company:translate-y-0 transition-all duration-200 absolute left-0 sm:left-1/2 sm:-translate-x-1/2 w-[min(280px,calc(100vw-2.5rem))] max-w-[calc(100vw-2.5rem)] sm:w-80 rounded-lg border border-[var(--color-accent-gold)] bg-[var(--color-surface-card)] p-2.5 sm:p-3.5 z-[70] text-left font-sans"
            style="box-shadow: 0 8px 16px -2px rgba(0, 0, 0, 0.35), 0 3px 6px -2px rgba(0, 0, 0, 0.25); background-color: var(--color-surface-card);"
          >
            <div class="border-b border-[var(--color-surface-border-subtle)] pb-1.5 mb-1.5 sm:pb-2.5 sm:mb-2.5 space-y-0.5">
              <div class="font-bold font-mono text-xs text-[var(--color-text-primary)]">
                {companyInfo.name}
              </div>
              <p class="text-[10px] sm:text-[11px] font-sans font-medium text-[var(--color-accent-gold)] leading-snug">
                {isEs ? companyInfo.industryEs : companyInfo.industry}
              </p>
            </div>
            <p class="text-[11px] sm:text-xs text-[var(--color-text-secondary)] leading-normal sm:leading-relaxed mb-2 sm:mb-2.5">
              {isEs ? companyInfo.descriptionEs : companyInfo.description}
            </p>
            <div class="pt-1.5 sm:pt-2 border-t border-[var(--color-surface-border-subtle)] flex items-center justify-between font-mono text-xs">
              <span class="text-[10px] text-[var(--color-text-muted)] truncate max-w-[110px] sm:max-w-[130px]">
                {companyInfo.domain}
              </span>
              <a
                href={companyInfo.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 sm:gap-1.5 rounded border border-[var(--color-accent-gold)]/50 bg-[var(--color-accent-gold-subtle)] px-2 py-0.5 sm:px-2.5 sm:py-1 text-[10px] sm:text-[11px] font-semibold text-[var(--color-accent-gold)] hover:bg-[var(--color-accent-gold)] hover:text-[var(--color-btn-gold-text)] transition-colors"
              >
                <span>{isEs ? "Visitar Web" : "Visit Website"}</span>
                <span aria-hidden="true">&nearr;</span>
              </a>
            </div>
          </div>
        </div>
      )}
    </div>

    <div class="flex items-center gap-2 self-start sm:self-auto">
      <span class="inline-flex items-center gap-1.5 rounded border border-[var(--color-accent-status)]/40 bg-[var(--color-accent-status)]/10 px-2.5 py-0.5 text-xs font-semibold text-[var(--color-accent-status)]">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent-status)] shrink-0 aspect-square animate-pulse"></span>
        <span>
          {isEs ? "Caso de Estudio Interactivo" : "Interactive Case Study"}
        </span>
      </span>
    </div>
  </div>

  <!-- Title & Description with Direct Experience Role Link -->
  <div class="space-y-2 font-sans">
    <div class="flex items-center justify-between gap-3">
      <h4 class="text-base sm:text-lg font-bold text-[var(--color-text-primary)] tracking-tight">
        {isEs ? simulation.titleEs : simulation.title}
      </h4>
      <a
        href={jobDetailUrl}
        class="shrink-0 text-xs font-mono text-[var(--color-accent-gold)] hover:underline inline-flex items-center gap-1 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
      >
        <span>{isEs ? "Ver Puesto" : "View Role"}</span>
        <span aria-hidden="true">&nearr;</span>
      </a>
    </div>
    <p class="text-xs sm:text-sm text-[var(--color-text-secondary)] leading-relaxed">
      {isEs ? simulation.descriptionEs : simulation.description}
    </p>
  </div>

  <!-- Execution Pipeline: Steps -->
  <div class="space-y-2">
    <div class="text-[11px] text-[var(--color-text-muted)] font-mono uppercase tracking-wider flex items-center justify-between">
      <span>
        {isEs ? "Pipeline de Ejecución & Fases" : "Execution Pipeline & Phases"}
      </span>
      <span class="sim-phase-status text-[var(--color-accent-gold)]">
        {isEs ? "Esperando inicio..." : "Idle state"}
      </span>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 font-mono">
      {simulation.steps.map((step, idx) => (
        <div
          class="sim-step-node rounded border border-[var(--color-surface-border-subtle)] bg-[var(--color-bg-primary)]/40 p-2.5 transition-all"
          data-step-index={idx}
        >
          <div class="flex items-center justify-between text-[11px] mb-1">
            <span class="text-[var(--color-accent-gold)] font-bold">
              {step.stepNumber}
            </span>
            <span class="sim-step-dot h-1.5 w-1.5 rounded-full bg-[var(--color-surface-border)]"></span>
          </div>
          <div class="text-xs font-bold text-[var(--color-text-primary)] truncate">
            {isEs ? step.titleEs : step.title}
          </div>
          <div class="text-[10px] text-[var(--color-text-muted)] mt-0.5 line-clamp-1">
            {isEs ? step.detailEs : step.detail}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Real-time Terminal Log Output -->
  <div class="rounded border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] p-3 text-xs font-mono">
    <div class="flex items-center justify-between text-[10px] text-[var(--color-text-muted)] border-b border-[var(--color-surface-border-subtle)] pb-1.5 mb-2 uppercase tracking-wider">
      <span>{isEs ? "Salida de Terminal stdout" : "Live Terminal stdout"}</span>
      <span class="sim-timer text-[var(--color-accent-gold)]">0.0ms</span>
    </div>
    <div class="sim-log-feed text-[11px] text-[var(--color-text-secondary)] space-y-1 min-h-[3.5rem] leading-relaxed">
      <div class="text-[var(--color-text-muted)] italic">
        {isEs
          ? '$ Presiona "Ejecutar Simulación" para disparar la prueba de latencia...'
          : '$ Click "Run Simulation" to execute the low-latency workload...'}
      </div>
    </div>
  </div>

  <!-- Before vs NOW Telemetry Impact Grid -->
  <div class="space-y-3 pt-2 border-t border-[var(--color-surface-border-subtle)]">
    <div class="flex items-center justify-between text-xs font-mono">
      <span class="text-[var(--color-accent-gold)] uppercase tracking-wider font-semibold">
        {isEs
          ? "Métricas de Impacto: Antes vs AHORA"
          : "Impact Telemetry: Before vs NOW"}
      </span>
      <span class="text-[11px] text-[var(--color-text-muted)]">
        {isEs ? "Medido en Producción" : "Production Measured"}
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-mono">
      {simulation.metrics.map((metric) => (
        <div class="rounded border border-[var(--color-surface-border-subtle)] bg-[var(--color-bg-primary)]/40 p-3 space-y-2">
          <div class="text-xs font-semibold text-[var(--color-text-primary)] flex items-center justify-between">
            <span>{isEs ? metric.nameEs : metric.name}</span>
            {metric.improvement && (
              <span class="text-[10px] rounded bg-[var(--color-accent-gold)]/10 px-1.5 py-0.2 text-[var(--color-accent-gold)]">
                {isEs ? metric.improvementEs : metric.improvement}
              </span>
            )}
          </div>

          <div class="space-y-1.5 text-xs">
            <!-- Old / Before Data -->
            <div class="flex items-center gap-2 text-[var(--color-text-muted)]">
              <span class="text-[10px] uppercase font-bold text-[var(--color-text-muted)] shrink-0 line-through">
                before:
              </span>
              <span class="text-[11px] line-through opacity-75">
                {metric.beforeValue}
              </span>
            </div>

            <!-- New / NOW Data -->
            <div class="sim-now-row flex items-center gap-2 text-[var(--color-text-primary)] bg-[var(--color-surface-card)] rounded p-1.5 border border-[var(--color-surface-border)]">
              <span class="text-[10px] uppercase font-bold text-[var(--color-accent-status)] shrink-0 flex items-center gap-1">
                <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent-status)]"></span>
                now:
              </span>
              <span class="text-xs font-bold text-[var(--color-accent-gold)]">
                {metric.nowValue}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Run Simulation CTA Trigger -->
  <div class="pt-2 flex items-center justify-between gap-3">
    <button
      type="button"
      data-run-sim-btn
      class="btn-gold px-5 py-2 inline-flex items-center gap-2 font-mono text-xs font-semibold tracking-wide shadow-md transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent-gold)]"
    >
      <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
      <span>
        {isEs ? "Ejecutar Caso de Estudio" : "Run Architecture Case Study"}
      </span>
    </button>

    <span class="text-[11px] text-[var(--color-text-muted)] font-mono hidden sm:inline">
      {simulation.steps.length}{" "}
      {isEs ? "fases orquestadas" : "orchestrated phases"}
    </span>
  </div>
</div>

<script is:inline>
  (function () {
    function initSimulationCards() {
      var cards = document.querySelectorAll("[data-simulation-card]");
      cards.forEach(function (root) {
        if (!root || root.dataset.bound) return;
        root.dataset.bound = "true";

        var steps = [];
        try {
          steps = JSON.parse(root.dataset.steps || "[]");
        } catch (_) {}

        var isEs = root.dataset.isEs === "true";
        var runBtn = root.querySelector("[data-run-sim-btn]");
        var logFeed = root.querySelector(".sim-log-feed");
        var phaseStatus = root.querySelector(".sim-phase-status");
        var timerEl = root.querySelector(".sim-timer");
        var stepNodes = root.querySelectorAll(".sim-step-node");
        var nowRows = root.querySelectorAll(".sim-now-row");

        if (!runBtn) return;

        runBtn.addEventListener("click", function () {
          if (runBtn.disabled) return;
          runBtn.disabled = true;
          runBtn.classList.add("opacity-60", "cursor-not-allowed");

          if (logFeed) logFeed.innerHTML = "";
          if (phaseStatus)
            phaseStatus.textContent = isEs
              ? "Ejecutando pipeline..."
              : "Executing pipeline...";

          // Reset step nodes
          stepNodes.forEach(function (node) {
            node.classList.remove(
              "border-[var(--color-accent-gold)]",
              "bg-[var(--color-surface-card)]",
            );
            var dot = node.querySelector(".sim-step-dot");
            if (dot)
              dot.classList.replace(
                "bg-[var(--color-accent-status)]",
                "bg-[var(--color-surface-border)]",
              );
          });

          // Flash now rows
          nowRows.forEach(function (r) {
            r.classList.add("opacity-40");
          });

          var currentStep = 0;
          var startTime = performance.now();

          function executeNextStep() {
            if (currentStep < steps.length) {
              var step = steps[currentStep];
              var node = stepNodes[currentStep];
              if (node) {
                node.classList.add(
                  "border-[var(--color-accent-gold)]",
                  "bg-[var(--color-surface-card)]",
                );
                var dot = node.querySelector(".sim-step-dot");
                if (dot) {
                  dot.classList.remove("bg-[var(--color-surface-border)]");
                  dot.classList.add(
                    "bg-[var(--color-accent-status)]",
                    "animate-ping",
                  );
                  setTimeout(function () {
                    dot.classList.remove("animate-ping");
                  }, 400);
                }
              }

              var elapsed = (performance.now() - startTime).toFixed(1);
              if (timerEl) timerEl.textContent = elapsed + "ms";

              if (logFeed) {
                var line = document.createElement("div");
                line.className =
                  "text-[var(--color-text-primary)] flex items-start gap-1.5 animate-fade-in";
                line.innerHTML =
                  '<span class="text-[var(--color-accent-gold)]">&rarr;</span> <span>' +
                  step.log +
                  "</span>";
                logFeed.appendChild(line);
                logFeed.scrollTop = logFeed.scrollHeight;
              }

              currentStep++;
              setTimeout(executeNextStep, step.durationMs * 25 + 150);
            } else {
              // Completed
              var totalElapsed = (performance.now() - startTime).toFixed(1);
              if (timerEl) timerEl.textContent = totalElapsed + "ms (DONE)";
              if (phaseStatus)
                phaseStatus.textContent = isEs
                  ? "Completado con Éxito ✓"
                  : "Completed Successfully ✓";

              // Reveal now rows in full glory
              nowRows.forEach(function (r) {
                r.classList.remove("opacity-40");
                r.classList.add("border-[var(--color-accent-status)]");
                setTimeout(function () {
                  r.classList.remove("border-[var(--color-accent-status)]");
                }, 2000);
              });

              runBtn.disabled = false;
              runBtn.classList.remove("opacity-60", "cursor-not-allowed");
            }
          }

          executeNextStep();
        });
      });

      // Initialize tooltips on simulation cards
      var roots = document.querySelectorAll("[data-company-tooltip-root]");
      roots.forEach(function (root) {
        if (!root || root.dataset.simBound) return;
        root.dataset.simBound = "true";
        var trigger = root.querySelector("[data-company-trigger]");
        var tooltip = root.querySelector("[data-company-tooltip]");
        if (!trigger || !tooltip) return;

        trigger.addEventListener("click", function (e) {
          e.preventDefault();
          e.stopPropagation();
          var isOpen = root.dataset.tooltipOpen === "true";
          root.dataset.tooltipOpen = isOpen ? "false" : "true";
          trigger.setAttribute("aria-expanded", isOpen ? "false" : "true");
          if (!isOpen) {
            tooltip.classList.remove("opacity-0", "pointer-events-none");
            tooltip.classList.add("opacity-100", "pointer-events-auto");
          } else {
            tooltip.classList.remove("opacity-100", "pointer-events-auto");
            tooltip.classList.add("opacity-0", "pointer-events-none");
          }
        });

        document.addEventListener("click", function (e) {
          if (!root.contains(e.target)) {
            root.dataset.tooltipOpen = "false";
            trigger.setAttribute("aria-expanded", "false");
            tooltip.classList.remove("opacity-100", "pointer-events-auto");
            tooltip.classList.add("opacity-0", "pointer-events-none");
          }
        });
      });
    }

    window.__initSimulationCards = initSimulationCards;

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSimulationCards);
    } else {
      initSimulationCards();
    }
    document.addEventListener("astro:page-load", initSimulationCards);
  })();
</script>
