---
import type { Locale } from "@/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEs = locale === "es";

const pillars = [
  {
    index: "01",
    tag: "HEXAGONAL_CORE",
    title: isEs
      ? "Arquitectura Limpia y Hexagonal"
      : "Clean & Hexagonal Architecture",
    desc: isEs
      ? "Aislamiento estricto entre lógica de negocio, persistencia relacional y protocolos de transporte. Cambiar bases de datos o APIs nunca altera el dominio."
      : "Strict boundary isolation between domain logic, relational storage, and delivery protocols. Infrastructure migrations never compromise business rules.",
  },
  {
    index: "02",
    tag: "CONCURRENCY_RUNTIME",
    title: isEs
      ? "Concurrencia de Primeros Principios & Alto Throughput"
      : "First-Principles Concurrency & High Throughput",
    desc: isEs
      ? "Worker pools concurrentes en Go, canales sin bloqueos y reutilización de memoria con sync.Pool. Máxima saturación del hardware sin picos de latencia."
      : "Non-blocking Go worker pools, lockless channels, and memory reuse via sync.Pool. Hardware resources saturate efficiently without garbage collection latency spikes.",
  },
  {
    index: "03",
    tag: "ZERO_TRUST_DEVSECOPS",
    title: isEs
      ? "Seguridad Zero-Trust & Shift-Left AppSec"
      : "Zero-Trust Security & Shift-Left AppSec",
    desc: isEs
      ? "Detección continua de secretos en CI/CD, autenticación criptográfica TOTP/HMAC y gobernanza de accesos auditada bajo estándares SOC 2 y Vanta."
      : "Continuous secret detection in CI/CD, cryptographic TOTP/HMAC authentication, and automated access governance audited under SOC 2 and Vanta baselines.",
  },
  {
    index: "04",
    tag: "DATA_PIPELINES_RESILIENCE",
    title: isEs
      ? "Desacople OLTP/OLAP & Resiliencia de Datos"
      : "OLTP/OLAP Decoupling & Streaming Resilience",
    desc: isEs
      ? "Protección de bases de datos transaccionales desviando analítica masiva y telemetría hacia Snowflake y BigQuery mediante pipelines asíncronos."
      : "Shielding transactional checkout databases by routing heavy analytics, telemetry, and reporting directly into Snowflake and BigQuery via asynchronous pipelines.",
  },
];
---

<section
  id="philosophies"
  aria-labelledby="philosophies-heading"
  class="space-y-4"
>
  <div class="flex items-center justify-between border-b border-[var(--color-surface-border)] pb-3">
    <div>
      <span class="font-mono text-xs text-[var(--color-accent-gold)] tracking-widest uppercase font-semibold">
        {isEs ? "PRINCIPIOS DE SISTEMAS" : "CORE SYSTEM PRINCIPLES"}
      </span>
      <h2
        id="philosophies-heading"
        class="text-xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-2xl mt-0.5"
      >
        {isEs
          ? "Filosofías de Arquitectura & Soluciones"
          : "Architectural Philosophies & Engineering Principles"}
      </h2>
    </div>
    <span class="text-xs font-mono text-[var(--color-text-muted)] hidden sm:inline">
      {isEs
        ? "Mecánica de Sistemas Distribuidos"
        : "Distributed Systems Mechanics"}
    </span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-4">
    {pillars.map((item) => (
      <div class="geometric-box relative p-4 sm:p-5 rounded-sm space-y-2.5 font-mono group">
        <div class="flex items-center justify-between text-xs border-b border-[var(--color-surface-border-subtle)] pb-2 text-[var(--color-text-muted)]">
          <span class="text-[var(--color-accent-gold)] font-bold">
            {item.index} //
          </span>
          <span class="text-[10px] tracking-wider uppercase">{item.tag}</span>
        </div>
        <div class="text-base sm:text-lg font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-gold)] transition-colors">
          {item.title}
        </div>
        <p class="text-xs sm:text-sm text-[var(--color-text-secondary)] font-sans leading-relaxed">
          {item.desc}
        </p>
      </div>
    ))}
  </div>
</section>
