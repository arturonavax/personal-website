---
import type { Locale } from "@/i18n/ui";
import { judgeProfiles } from "@/data/onlineJudges";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEs = locale === "es";
const hasJudges = judgeProfiles && judgeProfiles.length > 0;
---

{hasJudges && (
  <dialog
    id="online-judges-dialog"
    aria-labelledby="judges-dialog-title"
    class="fixed inset-0 m-auto max-h-[85vh] w-[94vw] max-w-2xl rounded-xl border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] p-0 text-[var(--color-text-primary)] backdrop:bg-black/80 backdrop:backdrop-blur-sm open:animate-fade-in"
    style="box-shadow: var(--shadow-modal);"
  >
    <div class="flex flex-col h-full max-h-[85vh]">
      {/* Header */}
      <div class="flex items-center justify-between border-b border-[var(--color-surface-border)] bg-[var(--color-bg-primary)]/80 px-4 py-3.5 sm:px-6 sm:py-4">
        <div class="flex items-center gap-2.5">
          <span class="flex h-7 w-7 items-center justify-center rounded border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] text-[var(--color-accent-gold)] shrink-0 aspect-square">
            <svg
              class="h-4 w-4 stroke-current fill-none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </span>
          <div>
            <h3
              id="judges-dialog-title"
              class="font-mono text-sm sm:text-base font-bold text-[var(--color-text-primary)]"
            >
              {isEs
                ? "Jueces en Línea & Programación Competitiva"
                : "Online Judges & Competitive Programming"}
            </h3>
            <p class="text-xs text-[var(--color-text-muted)] font-mono">
              {isEs
                ? "Perfiles de algoritmia, resolución de problemas y teoría CS"
                : "Algorithmic profiles, problem solving & computer science theory"}
            </p>
          </div>
        </div>

        <button
          type="button"
          id="close-judges-btn"
          aria-label={isEs ? "Cerrar ventana" : "Close modal"}
          class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] p-1.5 text-[var(--color-text-muted)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-text-primary)] transition-colors cursor-pointer"
        >
          <svg
            class="h-4 w-4 stroke-current fill-none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      {/* Judges List Body (Task 2: Permanent Custom Scrollbar & Bottom Overflow Hint) */}
      <div class="relative flex-1 min-h-0">
        <div
          id="judges-list-scroll"
          class="overflow-y-auto p-4 sm:p-6 space-y-3.5 max-h-[60vh]"
          data-scrollable
        >
          {judgeProfiles.map((judge) => (
            <a
              href={judge.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block rounded-lg border border-[var(--color-surface-border-subtle)] bg-[var(--color-bg-primary)]/50 p-4 font-mono transition-all hover:border-[var(--color-accent-gold)] hover:bg-[var(--color-bg-primary)] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent-gold)]"
            >
              <div class="flex items-center justify-between gap-2 mb-1.5 text-xs">
                <span class="font-bold text-[var(--color-accent-gold)] text-[11px] uppercase tracking-wider">
                  {isEs ? judge.categoryEs : judge.category}
                </span>
                <span class="inline-flex items-center gap-1 text-[var(--color-text-muted)] text-[11px] group-hover:text-[var(--color-accent-gold)] transition-colors">
                  <span>@{judge.handle}</span>
                  <svg
                    class="h-3 w-3 stroke-current fill-none shrink-0"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </span>
              </div>

              <h4 class="text-base font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-gold)] transition-colors flex items-center gap-2">
                <span>{judge.name}</span>
              </h4>

              <p class="mt-1 text-xs text-[var(--color-text-secondary)] font-sans leading-relaxed">
                {isEs ? judge.descriptionEs : judge.description}
              </p>

              {/* Attractive Metrics: Score, Level/Rank, Solved Problems */}
              <div class="mt-3 pt-3 border-t border-[var(--color-surface-border-subtle)] grid grid-cols-3 gap-2">
                {judge.metrics.map((m) => (
                  <div class="rounded border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] px-2.5 py-1.5 flex flex-col justify-center transition-colors group-hover:border-[var(--color-accent-gold)]/40">
                    <span class="text-[9px] uppercase tracking-wider text-[var(--color-text-muted)] font-semibold">
                      {isEs ? m.labelEs : m.label}
                    </span>
                    <span
                      class="text-xs font-bold text-[var(--color-accent-gold)] truncate"
                      title={isEs ? m.valueEs : m.value}
                    >
                      {isEs ? m.valueEs : m.value}
                    </span>
                  </div>
                ))}
              </div>
            </a>
          ))}

          {/* GitHub Competitive Programming Repositories Link */}
          <div class="rounded-lg border border-[var(--color-surface-border-subtle)] bg-[var(--color-surface-card)]/60 p-4 text-xs font-mono text-[var(--color-text-secondary)] flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
              <svg
                class="h-4 w-4 text-[var(--color-accent-gold)] shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
              <span>
                {isEs
                  ? "Soluciones en Go, Rust y C++ en GitHub"
                  : "Solutions in Go, Rust & C++ on GitHub"}
              </span>
            </div>
            <a
              href="https://github.com/arturonavax"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--color-accent-gold)] font-bold hover:underline inline-flex items-center gap-1 shrink-0"
            >
              <span>github.com/arturonavax</span>
              <span>&rarr;</span>
            </a>
          </div>
          {/* Bottom subtle gradient indicator */}
          <div
            id="judges-scroll-hint"
            class="pointer-events-none absolute bottom-0 inset-x-0 h-9 bg-gradient-to-t from-[var(--color-surface-card)] via-[var(--color-surface-card)]/90 to-transparent flex items-end justify-center pb-1.5 text-[11px] font-mono text-[var(--color-accent-gold)] tracking-wide opacity-0 transition-opacity duration-200 select-none"
            aria-hidden="true"
          >
            <span class="flex items-center gap-1.5 opacity-90 drop-shadow-sm font-medium">
              <svg
                class="h-3 w-3 animate-bounce shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
              <span>{isEs ? "Más perfiles abajo" : "More profiles below"}</span>
            </span>
          </div>
        </div>
      </div>

      {/* Footer */}
      <div class="flex items-center justify-between border-t border-[var(--color-surface-border-subtle)] bg-[var(--color-bg-primary)]/80 px-4 py-2.5 sm:px-6 font-mono text-xs text-[var(--color-text-muted)]">
        <span>
          <kbd class="rounded border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] px-1.5 py-0.5 text-xs font-semibold">
            Esc
          </kbd>{" "}
          {isEs ? "cerrar" : "close"}
        </span>
        <span class="text-[var(--color-accent-gold)] font-semibold">
          {judgeProfiles.length}{" "}
          {isEs ? "plataformas conectadas" : "connected platforms"}
        </span>
      </div>
    </div>
  </dialog>
)}

<script is:inline>
  // @ts-nocheck
  (function () {
    var boundElements =
      window.__judgesBoundElements ||
      (window.__judgesBoundElements = new WeakSet());

    function setupOnlineJudgesModal() {
      var dialog = document.getElementById("online-judges-dialog");
      var closeBtn = document.getElementById("close-judges-btn");
      var listScroll = document.getElementById("judges-list-scroll");
      var listHint = document.getElementById("judges-scroll-hint");
      if (!dialog) return;

      function updateJudgesScrollHint() {
        if (!listScroll || !listHint) return;
        var hasMore =
          listScroll.scrollHeight >
          listScroll.clientHeight + listScroll.scrollTop + 14;
        if (hasMore) {
          listHint.classList.remove("opacity-0");
          listHint.classList.add("opacity-100");
        } else {
          listHint.classList.remove("opacity-100");
          listHint.classList.add("opacity-0");
        }
      }

      if (listScroll && !boundElements.has(listScroll)) {
        boundElements.add(listScroll);
        listScroll.addEventListener("scroll", updateJudgesScrollHint, {
          passive: true,
        });
      }

      function openJudgesModal() {
        var curDialog = document.getElementById("online-judges-dialog");
        if (
          curDialog &&
          typeof curDialog.showModal === "function" &&
          !curDialog.open
        ) {
          curDialog.showModal();
          requestAnimationFrame(updateJudgesScrollHint);
        }
      }

      window.openOnlineJudges = openJudgesModal;

      if (!boundElements.has(dialog)) {
        boundElements.add(dialog);
        dialog.addEventListener("click", function (e) {
          var rect = dialog.getBoundingClientRect();
          var isInDialog =
            rect.top <= e.clientY &&
            e.clientY <= rect.top + rect.height &&
            rect.left <= e.clientX &&
            e.clientX <= rect.left + rect.width;
          if (!isInDialog) {
            dialog.close();
          }
        });
      }

      // Document-level delegation for opening/closing online judges modal
      if (!window.__globalJudgesDocDelegationBound) {
        window.__globalJudgesDocDelegationBound = true;
        document.addEventListener("click", function (e) {
          var target = e.target;
          if (!target) return;

          var openBtnEl = target.closest("[data-open-judges-modal]");
          if (openBtnEl) {
            e.preventDefault();
            var details = openBtnEl.closest("details");
            if (details) details.removeAttribute("open");
            var d = document.getElementById("online-judges-dialog");
            if (d && typeof d.showModal === "function") {
              d.showModal();
              var ls = document.getElementById("judges-list-scroll");
              var lh = document.getElementById("judges-scroll-hint");
              if (ls && lh) {
                var hm = ls.scrollHeight > ls.clientHeight + ls.scrollTop + 14;
                if (hm) {
                  lh.classList.remove("opacity-0");
                  lh.classList.add("opacity-100");
                } else {
                  lh.classList.remove("opacity-100");
                  lh.classList.add("opacity-0");
                }
              }
            }
            return;
          }

          var closeBtnEl = target.closest("#close-judges-btn");
          if (closeBtnEl) {
            e.preventDefault();
            var d = document.getElementById("online-judges-dialog");
            if (d && typeof d.close === "function") d.close();
            return;
          }

          var activeDialog = document.getElementById("online-judges-dialog");
          if (activeDialog && activeDialog.open && target === activeDialog) {
            var rect = activeDialog.getBoundingClientRect();
            var isIn =
              rect.top <= e.clientY &&
              e.clientY <= rect.top + rect.height &&
              rect.left <= e.clientX &&
              e.clientX <= rect.left + rect.width;
            if (!isIn) {
              activeDialog.close();
            }
          }
        });
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupOnlineJudgesModal);
    } else {
      setupOnlineJudgesModal();
    }
    document.addEventListener("astro:page-load", setupOnlineJudgesModal);
  })();
</script>
