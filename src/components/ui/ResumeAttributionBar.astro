---
import type { Locale } from "@/i18n/locales";
import { BASE_ORIGIN } from "@/utils/attribution";

interface Props {
  locale: Locale;
  defaultMedium?: string;
}

const { locale, defaultMedium = "html" } = Astro.props;

const t = {
  en: {
    title: "Resume Link Attribution & Recruiter Tagging",
    description:
      "All internal links in this Resume are automatically tagged. Customize the recruiter or placement ID below to update document links in real-time before sharing or printing.",
    customPrefixCheck: "Custom prefix",
    prefixPlaceholder: "Prefix (ref)",
    contentPlaceholder: "e.g. google-recruiter, inmail-john, q3-lead",
    clearTitle: "Clear ID",
    randomBtn: "Random ID",
    copyIdBtn: "Copy ID",
    copiedIdBtn: "Copied!",
    taggedCountLabel: "Links dynamically tagged in Resume:",
  },
  es: {
    title: "Atribución de Enlaces del CV / Resume y Etiquetado",
    description:
      "Todos los enlaces internos de este Currículum están etiquetados automáticamente. Personaliza el identificador de reclutador o vacante para actualizarlos en tiempo real antes de compartir o imprimir.",
    customPrefixCheck: "Personalizar prefijo",
    prefixPlaceholder: "Prefijo (ref)",
    contentPlaceholder: "ej. reclutador-google, inmail-juan, vacante-sr",
    clearTitle: "Limpiar ID",
    randomBtn: "ID Aleatorio",
    copyIdBtn: "Copiar ID",
    copiedIdBtn: "¡Copiado!",
    taggedCountLabel: "Enlaces etiquetados en el CV:",
  },
}[locale];
---

<div
  class="no-print mt-10 w-full max-w-[210mm] mx-auto rounded-lg border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] p-4 sm:p-5 shadow-lg space-y-4 font-mono text-xs"
  data-resume-attribution-root
  data-cv-attribution-root
  data-locale={locale}
  data-base-origin={BASE_ORIGIN}
  data-default-medium={defaultMedium}
>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[var(--color-surface-border-subtle)] pb-3">
    <div>
      <h3 class="font-bold text-sm text-[var(--color-text-primary)]">
        {t.title}
      </h3>
      <p class="text-[11px] text-[var(--color-text-secondary)] font-sans mt-0.5">
        {t.description}
      </p>
    </div>
    <div class="text-[11px] text-[var(--color-accent-gold)] font-bold shrink-0">
      <span>{t.taggedCountLabel} </span>
      <span id="cv-tagged-counter" class="underline">
        0
      </span>
    </div>
  </div>

  <div class="space-y-3">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
      <div class="relative flex-1 flex items-center rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-3 py-2 focus-within:border-[var(--color-accent-gold)] focus-within:ring-1 focus-within:ring-[var(--color-accent-gold)]">
        <input
          type="text"
          id="cv-utm-content"
          value=""
          placeholder={t.contentPlaceholder}
          class="w-full bg-transparent pr-6 text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none text-xs"
        />
        <button
          type="button"
          id="cv-clear-content-btn"
          title={t.clearTitle}
          class="hidden text-[var(--color-text-muted)] hover:text-[var(--color-accent-gold)] transition-colors cursor-pointer shrink-0"
        >
          <svg
            class="h-3.5 w-3.5 stroke-current fill-none"
            viewBox="0 0 24 24"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </button>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button
          type="button"
          id="cv-random-btn"
          title="Generate random ID"
          class="inline-flex items-center justify-center gap-1.5 rounded border border-[var(--color-surface-border)] bg-[var(--color-surface-card)] px-3 py-2 text-xs font-semibold text-[var(--color-text-secondary)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] transition-colors cursor-pointer"
        >
          <svg
            class="h-3.5 w-3.5 stroke-current fill-none"
            viewBox="0 0 24 24"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
            />
          </svg>
          <span>{t.randomBtn}</span>
        </button>

        <button
          type="button"
          id="cv-copy-id-btn"
          data-copied-label={t.copiedIdBtn}
          title="Copy ID to clipboard"
          class="inline-flex items-center justify-center gap-1.5 rounded border border-[var(--color-accent-gold)] bg-[var(--color-accent-gold)] text-[var(--color-btn-gold-text)] px-3.5 py-2 text-xs font-semibold hover:brightness-105 active:scale-95 transition-all cursor-pointer"
        >
          <svg
            class="h-3.5 w-3.5 stroke-current fill-none"
            viewBox="0 0 24 24"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"
            />
          </svg>
          <span id="cv-copy-id-text">{t.copyIdBtn}</span>
        </button>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-3 text-[11px] text-[var(--color-text-muted)]">
      <label class="inline-flex items-center gap-1.5 cursor-pointer select-none hover:text-[var(--color-text-primary)] transition-colors">
        <input
          type="checkbox"
          id="cv-prefix-check"
          class="rounded border-[var(--color-surface-border)] text-[var(--color-accent-gold)] focus:ring-0 cursor-pointer"
        />
        <span>{t.customPrefixCheck}</span>
      </label>

      <div id="cv-prefix-wrapper" class="hidden items-center gap-1.5">
        <div class="relative flex items-center rounded border border-[var(--color-surface-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 focus-within:border-[var(--color-accent-gold)]">
          <input
            type="text"
            id="cv-prefix-input"
            value="ref"
            placeholder={t.prefixPlaceholder}
            class="w-24 bg-transparent text-xs text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none"
          />
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    function setupCvLinkAttribution() {
      var root = document.querySelector(
        "[data-resume-attribution-root], [data-cv-attribution-root]",
      );
      var cvSheet =
        document.getElementById("cv-document-sheet") ||
        document.getElementById("resume-live-preview");
      if (!root || !cvSheet) return;

      var locale = root.getAttribute("data-locale") || "en";
      var baseOrigin =
        root.getAttribute("data-base-origin") || "https://arturonavax.dev";
      var targetMedium = root.getAttribute("data-default-medium") || "html";

      var contentInput = root.querySelector("#cv-utm-content");
      var clearBtn = root.querySelector("#cv-clear-content-btn");
      var prefixCheck = root.querySelector("#cv-prefix-check");
      var prefixWrapper = root.querySelector("#cv-prefix-wrapper");
      var prefixInput = root.querySelector("#cv-prefix-input");
      var randomBtn = root.querySelector("#cv-random-btn");
      var copyIdBtn = root.querySelector("#cv-copy-id-btn");
      var counterEl = root.querySelector("#cv-tagged-counter");

      function generateId(prefix) {
        var cleanPrefix = (prefix || "ref").trim() || "ref";
        var hash = Math.random().toString(36).substring(2, 8);
        return cleanPrefix + "-" + hash;
      }

      function syncClearBtn() {
        if (!clearBtn || !contentInput) return;
        if (contentInput.value.length > 0) {
          clearBtn.classList.remove("hidden");
          clearBtn.classList.add("block");
        } else {
          clearBtn.classList.remove("block");
          clearBtn.classList.add("hidden");
        }
      }

      function getCampaign(rawHref) {
        var lower = rawHref.toLowerCase();
        if (lower.indexOf("/projects") !== -1) return "resume-project";
        if (lower.indexOf("/experience") !== -1) return "resume-experience";
        if (lower.indexOf("/blog") !== -1) return "resume-article";
        if (lower.indexOf("/services") !== -1) return "resume-service";
        return "resume-header";
      }

      function applyAttributionToLinks() {
        var targetSheet =
          document.getElementById("cv-document-sheet") ||
          document.getElementById("resume-live-preview");
        if (!targetSheet) return;

        var contentVal = (contentInput ? contentInput.value : "").trim();
        var links = targetSheet.querySelectorAll("a[href]");
        var taggedCount = 0;

        links.forEach(function (link) {
          var rawHref = link.getAttribute("href") || "";
          if (
            !rawHref ||
            rawHref.startsWith("#") ||
            rawHref.startsWith("mailto:") ||
            rawHref.startsWith("tel:")
          ) {
            return;
          }

          var isInternal = false;
          var urlObj;
          try {
            if (
              rawHref.startsWith("http://") ||
              rawHref.startsWith("https://")
            ) {
              urlObj = new URL(rawHref);
              var baseHost = new URL(baseOrigin).host;
              if (urlObj.host === baseHost) isInternal = true;
            } else {
              urlObj = new URL(rawHref, baseOrigin);
              isInternal = true;
            }
          } catch (_) {
            return;
          }

          if (!isInternal) return;

          if (!link.getAttribute("data-raw-original-href")) {
            link.setAttribute("data-raw-original-href", rawHref);
          }

          var originalHref =
            link.getAttribute("data-raw-original-href") || rawHref;
          var workingUrl = new URL(originalHref, baseOrigin);

          if (!workingUrl.pathname.endsWith("/")) {
            if (!/\.[a-zA-Z0-9]+$/i.test(workingUrl.pathname)) {
              workingUrl.pathname =
                workingUrl.pathname.replace(/\/+$/, "") + "/";
            }
          }

          var isSpanish =
            workingUrl.pathname === "/es" ||
            workingUrl.pathname.indexOf("/es/") === 0 ||
            locale === "es";
          var source = isSpanish ? "cv-es" : "cv-en";
          var campaign = getCampaign(workingUrl.pathname);

          workingUrl.searchParams.set("utm_source", source);
          workingUrl.searchParams.set("utm_medium", targetMedium);
          workingUrl.searchParams.set("utm_campaign", campaign);

          if (contentVal) {
            workingUrl.searchParams.set("utm_content", contentVal);
          } else {
            workingUrl.searchParams.delete("utm_content");
          }

          link.setAttribute("href", workingUrl.toString());
          taggedCount++;
        });

        if (counterEl) {
          counterEl.textContent = taggedCount.toString();
        }
      }

      if (contentInput && !contentInput.dataset.bound) {
        contentInput.dataset.bound = "true";
        contentInput.addEventListener("input", function () {
          syncClearBtn();
          applyAttributionToLinks();
        });
      }

      if (clearBtn && !clearBtn.dataset.bound) {
        clearBtn.dataset.bound = "true";
        clearBtn.addEventListener("click", function () {
          if (contentInput) {
            contentInput.value = "";
            syncClearBtn();
            applyAttributionToLinks();
            contentInput.focus();
          }
        });
      }

      if (prefixCheck && prefixWrapper && !prefixCheck.dataset.bound) {
        prefixCheck.dataset.bound = "true";
        prefixCheck.addEventListener("change", function () {
          if (prefixCheck.checked) {
            prefixWrapper.classList.remove("hidden");
            prefixWrapper.classList.add("inline-flex");
            if (prefixInput) prefixInput.focus();
          } else {
            prefixWrapper.classList.remove("inline-flex");
            prefixWrapper.classList.add("hidden");
          }
        });
      }

      if (randomBtn && !randomBtn.dataset.bound) {
        randomBtn.dataset.bound = "true";
        randomBtn.addEventListener("click", function () {
          var pfx =
            prefixCheck && prefixCheck.checked && prefixInput
              ? prefixInput.value
              : "ref";
          if (contentInput) {
            contentInput.value = generateId(pfx);
            syncClearBtn();
            applyAttributionToLinks();
          }
        });
      }

      if (copyIdBtn && !copyIdBtn.dataset.bound) {
        copyIdBtn.dataset.bound = "true";
        copyIdBtn.addEventListener("click", function () {
          var idText = contentInput ? contentInput.value.trim() : "";
          if (!idText) return;

          navigator.clipboard.writeText(idText).then(function () {
            var textSpan = copyIdBtn.querySelector("#cv-copy-id-text");
            var original = textSpan ? textSpan.textContent : "Copy ID";
            var copied =
              copyIdBtn.getAttribute("data-copied-label") || "Copied!";

            if (textSpan) textSpan.textContent = copied;
            setTimeout(function () {
              if (textSpan) textSpan.textContent = original;
            }, 2000);
          });
        });
      }

      syncClearBtn();
      applyAttributionToLinks();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupCvLinkAttribution);
    } else {
      setupCvLinkAttribution();
    }
    document.addEventListener("astro:page-load", setupCvLinkAttribution);
  })();
</script>
