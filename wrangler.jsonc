{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "account_id": "d4986ed43391f516630760f10ada092f",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "build": {
    "command": "node scripts/r2-pull.mjs && pnpm run build",
  },
  "routes": [
    {
      "pattern": "arturonavax.dev",
      "custom_domain": true,
    },
    {
      "pattern": "admin.arturonavax.dev",
      "custom_domain": true,
    },
    {
      "pattern": "blog.arturonavax.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin*",
      "/*/admin*",
      "/__admin_vault__*",
      "/api/*",
      "/*",
      "!/_astro/*",
      "!/fonts/*",
      "!/remote-assets/*",
      "!/downloads/*",
      "!/favicon*",
      "!/apple-touch-icon*",
      "!/icon-*",
      "!/og-default.png",
      "!/site.webmanifest",
      "!/robots.txt",
      "!/sitemap*.xml",
      "!/llms.txt",
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "triggers": {
    "crons": ["0 2 * * *", "5 0 * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-website-analytics",
      "database_id": "8b881d48-f08b-4e77-9731-541eab349f16",
      "migrations_dir": "./cloudflare/d1/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE_BUCKET",
      "bucket_name": "arturonavax-production-assets",
    },
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE_INDEX",
      "index_name": "knowledge-embeddings",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "observability": {
    "enabled": true,
  },
  // Configurable Quota & Progressive Degradation Strategy (Free Tier -> Paid Plans)
  // Upgrade to Workers Paid with zero code changes by setting CLOUDFLARE_PLAN_TIER="paid"
  // Optional overrides: D1_DAILY_WRITE_BUDGET, D1_DAILY_READ_BUDGET, WORKERS_DAILY_REQUEST_BUDGET,
  // D1_TIER_CONSERVATIVE_RATIO (0.50), D1_TIER_COMPACT_RATIO (0.70), D1_TIER_SURVIVAL_RATIO (0.85),
  // D1_TIER_WAL_RATIO (0.95), D1_BOT_BUDGET_RATIO (0.15), D1_PREFETCH_BUDGET_RATIO (0.25),
  // D1_VISIT_BUDGET_RATIO (0.65), D1_PREFETCH_SAMPLE_RATE (0.10 free / 1.0 paid)
  "vars": {
    "CLOUDFLARE_PLAN_TIER": "free",
    "D1_DAILY_WRITE_BUDGET": "100000",
    "D1_DAILY_READ_BUDGET": "5000000",
    "ENABLE_BOT_TELEMETRY": "false",
    "REQUIRE_CF_ACCESS": "true",
    "REQUIRE_ADMIN_AUTH": "true",
    "ADMIN_AUTHORIZED_EMAILS": "arturonavax@gmail.com,contact@arturonava.com",
  },
}
