{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "preinstall": "only-allow pnpm",
    "dev": "node scripts/r2-pull.mjs --auto && astro dev --host",
    "dev:r2": "node scripts/r2-pull.mjs && astro dev --host",
    "dev:local": "astro dev --host",
    "dev:worker": "wrangler dev -c wrangler.jsonc --port 8788 --ip 0.0.0.0",
    "prebuild": "node scripts/r2-pull.mjs --auto",
    "build": "astro build && node scripts/isolate-admin-build.mjs",
    "content:pull": "node scripts/r2-pull.mjs",
    "content:push": "node scripts/r2-push.mjs",
    "content:push:dry": "node scripts/r2-push.mjs --dry-run",
    "cv:optimize": "node scripts/optimize-pdf.mjs",
    "cv:publish": "node scripts/optimize-pdf.mjs && node scripts/r2-push.mjs",
    "preview": "astro preview --host",
    "check": "astro check",
    "typecheck": "astro check",
    "types:worker": "wrangler types -c wrangler.jsonc",
    "test": "bun test",
    "audit": "bun scripts/audit-codebase.ts",
    "build:assets": "node scripts/generate-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "wrangler deploy -c wrangler.jsonc",
    "dev-prod": "pnpm check && pnpm build && wrangler dev -c wrangler.jsonc --port 8788 --ip 0.0.0.0",
    "audit:mobile": "pnpm dlx lighthouse http://127.0.0.1:8788 --output=json --output-path=./lh-raw.json --chrome-flags=\"--headless\" --quiet && node scripts/filter-lh.mjs",
    "predeploy": "node scripts/r2-pull.mjs && pnpm run build",
    "db:reset:local": "wrangler d1 execute personal-website-analytics --local --file=./cloudflare/d1/reset.sql",
    "db:reset:remote": "wrangler d1 execute personal-website-analytics --remote --file=./cloudflare/d1/reset.sql",
    "db:schema:local": "wrangler d1 execute personal-website-analytics --local --file=./cloudflare/d1/schema.sql",
    "db:schema:remote": "wrangler d1 execute personal-website-analytics --remote --file=./cloudflare/d1/schema.sql"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.4",
    "marked": "^18.0.14",
    "nanostores": "^1.5.4",
    "satori": "^0.36.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "only-allow": "^1.2.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "5.9.3",
    "wrangler": "^4.142.0"
  }
}
