{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "preinstall": "only-allow pnpm",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev-prod": "pnpm check && pnpm build && pnpm dlx wrangler pages dev ./dist --port 8788 --ip 0.0.0.0",
    "audit:mobile": "pnpm dlx lighthouse http://127.0.0.1:8788 --output=json --output-path=./lh-raw.json --chrome-flags=\"--headless\" --quiet && node scripts/filter-lh.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.4",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "esbuild": "^0.28.2",
    "only-allow": "^1.2.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "5.9.3"
  }
}
