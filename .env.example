# Content source for builds: "local" (default, git-tracked/synced files) or "r2"
CONTENT_SOURCE=local

# R2 bucket holding editorial content (private; no public r2.dev / custom domain)
R2_BUCKET_NAME=personal-website-content

# OPTIONAL. Only needed for CI / Workers Builds. Locally the scripts fall back to the
# authenticated Wrangler CLI (`wrangler login`), so no secrets are required on disk.
# Create a bucket-scoped R2 API token (Object Read & Write) in the Cloudflare dashboard.
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
