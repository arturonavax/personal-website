# "r2": always sync content from R2 on dev/build. Unset/"local": only pull when content is missing.
CONTENT_SOURCE=local

# Private R2 bucket holding editorial content
R2_BUCKET_NAME=personal-website-content
# Max parallel transfers (default 8)
# R2_CONCURRENCY=8

# OPTIONAL: only for CI / Workers Builds. Locally the scripts use `cf auth login`.
# Create a bucket-scoped R2 API token (Object Read & Write) in the Cloudflare dashboard.
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Automated IndexNow Push Key (Bing, Yandex, Naver, Seznam, Copilot/ChatGPT Search)
INDEXNOW_KEY=

# Configurable Edge Quota & Progressive Degradation Strategy (Free Tier -> Paid Plans)
# CLOUDFLARE_PLAN_TIER=free
# D1_DAILY_WRITE_BUDGET=100000
# D1_DAILY_READ_BUDGET=5000000
# WORKERS_DAILY_REQUEST_BUDGET=100000
# D1_TIER_CONSERVATIVE_RATIO=0.50
# D1_TIER_COMPACT_RATIO=0.70
# D1_TIER_SURVIVAL_RATIO=0.85
# D1_TIER_WAL_RATIO=0.95
# D1_BOT_BUDGET_RATIO=0.15
# D1_PREFETCH_BUDGET_RATIO=0.25
# D1_VISIT_BUDGET_RATIO=0.65
# D1_PREFETCH_SAMPLE_RATE=0.10

# Admin Security & Cloudflare Access Zero Trust Isolation (REQ-PCD-02)
# Set REQUIRE_CF_ACCESS=true to enforce Cloudflare Access Zero Trust on /admin and admin APIs
REQUIRE_CF_ACCESS=true
REQUIRE_ADMIN_AUTH=true
# Comma-separated authorized admin emails
ADMIN_AUTHORIZED_EMAILS=your-admin-email@example.com
# Optional: Admin Secret Token for direct bearer/cookie authorization (set via `wrangler secret put ADMIN_API_KEY`)
# ADMIN_API_KEY=

