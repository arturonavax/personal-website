# Immutable Cache Strategy for Fingerprinted Production Assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# Assets gráficos estáticos (OG cards, favicons, logos, avatares)
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.avif
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.webmanifest
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Content-Type: application/manifest+json; charset=UTF-8

# Edge Caching for Documents and PDFs (SPEC-003 Section 3.2.3)
/*.pdf
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400

# Índices de búsqueda desacoplados
/search-index*.json
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# Raw Feeds and Discovery Artifacts
/sitemap*.xml
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400
  Content-Type: application/xml; charset=UTF-8

/rss.xml
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400

/robots.txt
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400

/llms*.txt
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400
  Content-Type: text/plain; charset=UTF-8

# Document Delivery with Instant Revalidation
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=(), accelerometer=(), gyroscope=(), magnetometer=(), payment=(), usb=()
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1
  Vary: Accept

# API endpoints: estrictamente no indexables
/api/*
  Cache-Control: no-store, private
  X-Robots-Tag: noindex, nofollow, noarchive

# Admin surface: estrictamente privado y sin caché (Zero Trust)
/admin*
  Cache-Control: no-store, private
  X-Robots-Tag: noindex, nofollow, noarchive

/es/admin*
  Cache-Control: no-store, private
  X-Robots-Tag: noindex, nofollow, noarchive

# Revalidación determinista para todas las rutas HTML (soporta trailing slashes y subrutas)
/
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept
/resume*
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept
/experience*
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept
/projects*
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept
/services*
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept
/blog*
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept
/case-studies*
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept
/search*
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept
/es*
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept

# Seguridad y descubrimiento universal
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Alt-Svc: h3=":443"; ma=86400
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=(), accelerometer=(), gyroscope=(), magnetometer=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' data: https://static.cloudflareinsights.com https://app.cal.com https://challenges.cloudflare.com; script-src-elem 'self' 'unsafe-inline' data: https://static.cloudflareinsights.com https://app.cal.com https://challenges.cloudflare.com; frame-src 'self' https://app.cal.com https://cal.com https://challenges.cloudflare.com; child-src 'self' https://app.cal.com https://cal.com https://challenges.cloudflare.com; connect-src 'self' https://cloudflareinsights.com https://cal.com https://app.cal.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; frame-ancestors 'none'; base-uri 'self'; object-src 'none';
  Link: <https://arturonavax.dev/llms.txt>; rel="llms-txt", <https://arturonavax.dev/llms-full.txt>; rel="alternate"; type="text/plain"
  X-Llms-Txt: /llms.txt

# Downloadable CVs synced from R2 (public/downloads/)
/downloads/*
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff
